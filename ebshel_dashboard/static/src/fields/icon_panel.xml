<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="ebshel_dashboard.IconPanel">
        <div class="o_dbf_icon_panel" t-ref="this.rootRef">
            <div class="o_dbf_icon_search">
                <i class="oi" data-icon="search" role="img" aria-label="Search"/>
                <input type="text" t-ref="this.searchRef" class="o_input"
                       placeholder="Search by name or meaning: late, revenue, team..."
                       t-att-value="this.state.query" t-on-input="this.onQueryInput" t-on-keydown="this.onQueryKeydown"/>
                <span class="o_dbf_icon_count"><t t-out="this.matches.length"/> icons</span>
            </div>
            <div class="o_dbf_icon_groups">
                <t t-foreach="this.groups" t-as="group" t-key="group.key">
                    <button type="button"
                            t-attf-class="o_dbf_icon_group {{ group.key === this.state.group ? 'o_dbf_icon_group_on' : '' }}"
                            t-on-click="() => this.pickGroup(group.key)" t-out="group.label"/>
                </t>
            </div>
            <t t-if="this.recent.length">
                <div class="o_dbf_icon_section">Recent</div>
                <div class="o_dbf_icon_grid">
                    <t t-foreach="this.recent" t-as="icon" t-key="'r' + icon">
                        <button type="button"
                                t-attf-class="o_dbf_icon_cell {{ icon === this.props.current ? 'o_dbf_icon_cell_on' : '' }}"
                                t-att-title="icon" t-on-click="() => this.select(icon)">
                            <i class="oi" t-att-data-icon="icon" role="img" t-att-aria-label="icon"/>
                        </button>
                    </t>
                </div>
            </t>
            <div class="o_dbf_icon_grid">
                <t t-foreach="this.matches" t-as="icon" t-key="icon">
                    <button type="button"
                            t-attf-class="o_dbf_icon_cell {{ icon === this.props.current ? 'o_dbf_icon_cell_on' : '' }}"
                            t-att-title="icon" t-on-click="() => this.select(icon)">
                        <i class="oi" t-att-data-icon="icon" role="img" t-att-aria-label="icon"/>
                    </button>
                </t>
                <t t-if="!this.matches.length">
                    <div class="o_dbf_icon_none">No icon matches. Any Material Symbols name can still be typed in the box.</div>
                </t>
            </div>
        </div>
    </t>

</templates>
