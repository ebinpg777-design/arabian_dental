<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="ebshel_dashboard.BoardAction">
        <div t-attf-class="o_dbb_action o_action {{ this.state.presenting ? 'o_dbb_presenting' : '' }} {{ this.compact ? 'o_dbb_compact' : '' }} {{ this.state.sidebarMin ? 'o_dbb_side_min' : '' }}"
             t-ref="this.rootRef" t-att-style="this.accentStyle">

            <!-- ============================ sidebar ============================ -->
            <aside class="o_dbb_side" t-if="!this.state.presenting">
                <div class="o_dbb_side_head">
                    <span class="o_dbb_brand">
                        <i class="oi" data-icon="speed" role="img" aria-label="Dashboards"/>
                        <span class="o_dbb_side_label">Dashboards</span>
                    </span>
                    <button class="o_dbb_side_toggle" t-on-click="this.toggleSidebar"
                            t-att-title="this.state.sidebarMin ? 'Expand the sidebar' : 'Collapse the sidebar'">
                        <i class="oi" t-att-data-icon="this.state.sidebarMin ? 'keyboard_double_arrow_right' : 'keyboard_double_arrow_left'" role="img" aria-label="Toggle"/>
                    </button>
                </div>

                <button t-if="this.canBuild" class="btn btn-primary btn-sm o_dbb_build" t-on-click="this.buildBoard" title="Build a dashboard from a model">
                    <i class="oi" data-icon="wand_stars" role="img" aria-label="Build"/>
                    <span class="o_dbb_side_label">Build a dashboard</span>
                </button>

                <div class="o_dbb_side_sec"><span class="o_dbb_side_label">My dashboards</span></div>
                <t t-if="this.state.boards.length &gt; 6 and !this.state.sidebarMin">
                    <div class="o_dbb_side_search">
                        <i class="oi" data-icon="search" role="img" aria-label="Filter"/>
                        <input type="text" placeholder="Filter dashboards" t-att-value="this.state.boardFilter"
                               t-on-input="(ev) => this.state.boardFilter = ev.target.value"/>
                    </div>
                </t>
                <nav class="o_dbb_side_list">
                    <t t-foreach="this.sideBoards" t-as="board" t-key="board.id">
                        <a t-attf-class="o_dbb_side_item {{ this.state.board and board.id === this.state.board.id ? 'o_dbb_side_on' : '' }}"
                           href="#" t-att-title="board.name" t-on-click.prevent="() => this.switchBoard(board.id)">
                            <i class="oi o_dbb_side_icon" t-att-data-icon="board.icon" role="img" aria-label="Dashboard"
                               t-att-style="'color: ' + this.boardColor(board)"/>
                            <span class="o_dbb_side_label o_dbb_side_name" t-out="board.name"/>
                            <i t-if="board.is_default" class="oi o_dbb_side_star" data-icon="star" role="img" aria-label="Favourite"/>
                            <span t-if="board.personal" class="o_dbb_side_dot" title="Personal"/>
                        </a>
                    </t>
                    <div t-if="!this.sideBoards.length" class="o_dbb_side_none o_dbb_side_label">No dashboard yet</div>
                </nav>

                <div class="o_dbb_side_sec"><span class="o_dbb_side_label">Tools</span></div>
                <nav class="o_dbb_side_list">
                    <a href="#" class="o_dbb_side_item" t-on-click.prevent="this.openQuickFind" title="Quick find (Q)">
                        <i class="oi o_dbb_side_icon" data-icon="search" role="img" aria-label="Quick find"/>
                        <span class="o_dbb_side_label o_dbb_side_name">Quick find</span>
                        <kbd class="o_dbb_side_label">Q</kbd>
                    </a>
                    <a href="#" t-attf-class="o_dbb_side_item {{ this.state.watchOpen ? 'o_dbb_side_on' : '' }}"
                       t-on-click.prevent="this.toggleWatchlist" title="KPI watchlist">
                        <i class="oi o_dbb_side_icon" data-icon="push_pin" role="img" aria-label="Watchlist"/>
                        <span class="o_dbb_side_label o_dbb_side_name">Watchlist</span>
                        <span t-if="this.state.watchlist.length" class="o_dbb_side_count o_dbb_side_label" t-out="this.state.watchlist.length"/>
                    </a>
                    <a href="#" t-attf-class="o_dbb_side_item {{ this.state.notesOpen ? 'o_dbb_side_on' : '' }}"
                       t-on-click.prevent="this.toggleNotes" title="My notes on this dashboard">
                        <i class="oi o_dbb_side_icon" data-icon="sticky_note_2" role="img" aria-label="Notes"/>
                        <span class="o_dbb_side_label o_dbb_side_name">My notes</span>
                        <i t-if="this.state.note" class="oi o_dbb_side_hint" data-icon="circle" role="img" aria-label="Has a note"/>
                    </a>
                    <a href="#" class="o_dbb_side_item" t-on-click.prevent="this.togglePresenting" title="Present full screen (F)">
                        <i class="oi o_dbb_side_icon" data-icon="fullscreen" role="img" aria-label="Present"/>
                        <span class="o_dbb_side_label o_dbb_side_name">Present</span>
                        <kbd class="o_dbb_side_label">F</kbd>
                    </a>
                    <a href="#" class="o_dbb_side_item" t-on-click.prevent="this.print" title="Print (P)">
                        <i class="oi o_dbb_side_icon" data-icon="print" role="img" aria-label="Print"/>
                        <span class="o_dbb_side_label o_dbb_side_name">Print</span>
                        <kbd class="o_dbb_side_label">P</kbd>
                    </a>
                </nav>

                <div class="o_dbb_side_foot o_dbb_side_label">
                    R refresh · E arrange · M mine · Shift+&#8592;&#8594; switch · Esc clear
                </div>
            </aside>

            <!-- ============================ the tour ========================== -->
            <div class="o_dbb_tour" t-if="this.state.tourStep &gt;= 0 and this.state.board and !this.state.presenting" role="dialog">
                <div class="o_dbb_tour_card">
                    <div class="o_dbb_tour_step">
                        <i class="oi" t-att-data-icon="this.tourSteps[this.state.tourStep].icon" role="img" aria-label="Step"/>
                        <span t-out="(this.state.tourStep + 1) + ' / ' + this.tourSteps.length"/>
                    </div>
                    <h3 t-out="this.tourSteps[this.state.tourStep].title"/>
                    <p t-out="this.tourSteps[this.state.tourStep].text"/>
                    <div class="o_dbb_tour_actions">
                        <button class="btn btn-secondary btn-sm" t-on-click="this.tourDone">Skip</button>
                        <button class="btn btn-primary btn-sm" t-on-click="this.tourNext">
                            <t t-if="this.state.tourStep + 1 &gt;= this.tourSteps.length">Done</t>
                            <t t-else="">Next</t>
                        </button>
                    </div>
                </div>
            </div>

            <!-- ============================ main ============================== -->
            <div class="o_dbb_main">
                <header class="o_dbb_hero">
                    <div class="o_dbb_hero_text">
                        <t t-if="this.state.board">
                            <h1 class="o_dbb_title" t-att-title="this.state.board.description or this.state.board.name">
                                <span class="o_dbb_iconpick">
                                    <button t-attf-class="o_dbb_title_icon {{ this.canEdit and !this.state.presenting ? 'o_dbb_title_icon_edit' : '' }}"
                                            t-on-click="this.toggleIconPicker"
                                            t-att-title="this.canEdit and !this.state.presenting ? 'Click to change the icon' : ''"
                                            t-att-disabled="!this.canEdit or this.state.presenting">
                                        <i class="oi" t-att-data-icon="this.state.board.icon" role="img" aria-label="Dashboard"/>
                                    </button>
                                    <IconPanel t-if="this.state.iconOpen" current="this.state.board.icon"
                                               anchor="'.o_dbb_iconpick'" onPick.bind="this.applyIcon"
                                               onClose="() => this.state.iconOpen = false"/>
                                </span>
                                <input t-if="this.state.renaming" type="text" class="o_dbb_title_input"
                                       t-att-value="this.state.newName" aria-label="Dashboard name"
                                       t-on-input="(ev) => this.state.newName = ev.target.value"
                                       t-on-keydown="this.onRenameKeydown" t-on-blur="this.applyRename"/>
                                <span t-else="" t-attf-class="o_dbb_title_name {{ this.canEdit and !this.state.presenting ? 'o_dbb_title_edit' : '' }}"
                                      t-on-click="this.startRenaming"
                                      t-att-title="this.canEdit and !this.state.presenting ? 'Click to rename' : ''"
                                      t-out="this.state.board.name"/>
                                <button t-if="!this.state.presenting"
                                        t-attf-class="o_dbb_star {{ this.state.board.is_default ? 'o_dbb_star_on' : '' }}"
                                        t-on-click="this.toggleDefault"
                                        t-att-title="this.state.board.is_default ? 'Opens first - click to forget' : 'Open this dashboard first'">
                                    <i t-attf-class="oi {{ this.state.board.is_default ? 'oi-filled' : '' }}" data-icon="star" role="img" aria-label="Favourite"/>
                                </button>
                                <span t-if="this.state.board.personal" class="o_dbb_tag">
                                    <i class="oi" data-icon="person" role="img" aria-label="Personal"/> Personal
                                </span>
                                <span t-if="this.state.board.can_edit and !this.state.board.personal" class="o_dbb_tag o_dbb_tag_shared">
                                    <i class="oi" data-icon="group" role="img" aria-label="Shared"/> Shared
                                </span>
                                <span t-if="this.state.board.companies and this.state.board.companies.length" class="o_dbb_tag o_dbb_tag_company"
                                      t-att-title="this.state.board.companies.join(', ')">
                                    <i class="oi" data-icon="business" role="img" aria-label="Companies"/>
                                    <t t-out="this.state.board.companies.length === 1 ? this.state.board.companies[0] : this.state.board.companies.length + ' companies'"/>
                                </span>
                            </h1>
                        </t>
                        <t t-else="">
                            <h1 class="o_dbb_title"><i class="oi o_dbb_title_icon" data-icon="speed" role="img" aria-label="Dashboards"/> Dashboards</h1>
                        </t>
                    </div>

                    <div class="o_dbb_hero_tools" t-if="this.state.board">
                        <!-- A magnifier at rest; it opens into a box on focus and stays open while it holds a search. -->
                        <div t-attf-class="o_dbb_search {{ this.state.filter ? 'o_dbb_search_open' : '' }}"
                             t-if="!this.state.presenting and this.state.items.length &gt; 3"
                             t-on-click="(ev) => ev.currentTarget.querySelector('input').focus()" title="Search the tiles">
                            <i class="oi" data-icon="search" role="img" aria-label="Search"/>
                            <input type="text" placeholder="Search tiles…" t-att-value="this.state.filter"
                                   t-on-input="(ev) => this.state.filter = ev.target.value"/>
                            <button t-if="this.state.filter" class="o_dbb_search_clear" t-on-click="() => this.state.filter = ''" title="Clear">
                                <i class="oi" data-icon="close" role="img" aria-label="Clear"/>
                            </button>
                        </div>
                        <!-- The reader's scope - the period and "Mine" - as one joined control. -->
                        <div class="o_dbb_cluster" t-if="this.state.board.allow_period or (this.state.board.allow_mine and !this.state.presenting)">
                        <div class="o_dbb_period" t-if="this.state.board.allow_period" t-ref="this.periodRef">
                            <button t-attf-class="btn btn-secondary btn-sm o_dbb_pill o_dbb_period_btn {{ this.state.periodOpen ? 'active' : '' }}"
                                    t-on-click="this.togglePeriod" aria-haspopup="true" t-att-aria-expanded="this.state.periodOpen"
                                    title="The period every card is read over">
                                <i class="oi" data-icon="calendar_today" role="img" aria-label="Period"/>
                                <span class="o_dbb_period_label" t-out="this.periodLabel"/>
                                <i class="oi o_dbb_caret" data-icon="arrow_drop_down" role="img" aria-label="Open"/>
                            </button>
                            <div t-if="this.state.periodOpen" class="dropdown-menu show o_dbb_period_menu" role="menu">
                                <button t-if="this.allTimePeriod"
                                        t-attf-class="o_dbb_period_item o_dbb_period_all {{ this.periodKey === 'all' ? 'o_dbb_period_on' : '' }}"
                                        role="menuitem" t-on-click="() => this.pickPeriod('all')">
                                    <i class="oi" data-icon="schedule" role="img" aria-label="All time"/>
                                    <span t-out="this.allTimePeriod.label"/>
                                    <i t-if="this.periodKey === 'all'" class="oi ms-auto" data-icon="check" role="img" aria-label="Current"/>
                                </button>
                                <div class="o_dbb_period_grid">
                                    <t t-foreach="this.periodGroups" t-as="group" t-key="group.key">
                                        <div class="o_dbb_period_col">
                                            <div class="o_dbb_period_head" t-out="group.label"/>
                                            <t t-foreach="group.periods" t-as="period" t-key="period.key">
                                                <button t-attf-class="o_dbb_period_item {{ period.key === this.periodKey ? 'o_dbb_period_on' : '' }}"
                                                        role="menuitem" t-on-click="() => this.pickPeriod(period.key)">
                                                    <span t-out="period.label"/>
                                                    <i t-if="period.key === this.periodKey" class="oi ms-auto" data-icon="check" role="img" aria-label="Current"/>
                                                </button>
                                            </t>
                                        </div>
                                    </t>
                                </div>
                                <div t-if="this.state.board.allow_range" class="o_dbb_period_range">
                                    <div class="o_dbb_period_head">
                                        Any two dates
                                        <span t-if="this.periodKey === 'custom'" class="o_dbb_period_current" t-out="this.periodLabel"/>
                                    </div>
                                    <div class="o_dbb_period_range_row">
                                        <input type="date" class="o_dbb_range_input" aria-label="From" t-att-value="this.state.range.start"
                                               t-on-change="(ev) => this.onRangeInput('start', ev)"/>
                                        <span class="o_dbb_period_dash">–</span>
                                        <input type="date" class="o_dbb_range_input" aria-label="To" t-att-value="this.state.range.end"
                                               t-on-change="(ev) => this.onRangeInput('end', ev)"/>
                                        <button class="btn btn-primary btn-sm ms-auto" t-on-click="this.applyRange">Apply</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button t-if="this.state.board.allow_mine and !this.state.presenting"
                                t-attf-class="btn btn-secondary btn-sm o_dbb_pill {{ this.state.mine ? 'active' : '' }}"
                                t-on-click="this.toggleMine" title="Only my records (M)">
                            <i class="oi" data-icon="person" role="img" aria-label="Only mine"/>
                            <span>Mine</span>
                        </button>
                        </div>
                        <button class="btn btn-secondary btn-sm o_dbb_pill o_dbb_updated" t-on-click="this.refresh"
                                t-attf-title="{{ this.agoLabel }} · Refresh (R)">
                            <span class="o_dbb_ring_wrap">
                                <!-- Re-keyed on every refresh, so the countdown ring starts over. -->
                                <t t-foreach="[this.refreshCycle]" t-as="cycle" t-key="cycle">
                                    <svg t-if="this.state.board.auto_refresh and !this.state.loading" class="o_dbb_ring"
                                         viewBox="0 0 20 20" aria-hidden="true">
                                        <circle class="o_dbb_ring_track" cx="10" cy="10" r="8"/>
                                        <circle class="o_dbb_ring_fill" cx="10" cy="10" r="8"
                                                t-attf-style="animation-duration: {{ this.state.board.auto_refresh }}s"/>
                                    </svg>
                                </t>
                                <i t-attf-class="oi {{ this.state.loading ? 'oi-spin' : '' }}" data-icon="refresh" role="img" aria-label="Refresh"/>
                            </span>
                            <span class="o_dbb_updated_label" t-out="this.agoLabel"/>
                        </button>
                        <t t-if="this.canEdit and !this.state.presenting">
                            <t t-if="this.state.editing">
                                <button class="btn btn-primary btn-sm o_dbb_btn" t-on-click="this.doneEditing"
                                        title="Keep this arrangement (Esc)">
                                    <i class="oi" data-icon="check" role="img" aria-label="Done"/>
                                    <span>Done</span>
                                </button>
                                <button class="btn btn-secondary btn-sm o_dbb_btn" t-on-click="this.discardEditing"
                                        title="Put the cards back where they were">
                                    <i class="oi" data-icon="undo" role="img" aria-label="Discard"/>
                                    <span>Discard</span>
                                </button>
                            </t>
                            <button t-else="" class="btn btn-secondary btn-sm o_dbb_btn"
                                    t-on-click="this.toggleEditing" title="Arrange the cards (E)">
                                <i class="oi" data-icon="open_with" role="img" aria-label="Arrange"/>
                                <span>Arrange</span>
                            </button>
                            <button class="btn btn-primary btn-sm o_dbb_btn" t-on-click="this.addCard" title="Add a card">
                                <i class="oi" data-icon="add" role="img" aria-label="Add"/>
                                <span>Card</span>
                            </button>
                        </t>
                        <t t-if="!this.state.presenting">
                            <div class="o_dbb_more" t-ref="this.moreRef">
                                <button class="btn btn-secondary btn-sm o_dbb_btn o_dbb_btn_icon" t-on-click="this.toggleMenu" title="More">
                                    <i class="oi" data-icon="more_vert" role="img" aria-label="More"/>
                                </button>
                                <div t-if="this.state.menuOpen" class="dropdown-menu show o_dbb_menu" role="menu">
                                    <t t-if="this.canBuild">
                                        <a href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="() => this.menuAction('buildBoard')"><i class="oi" data-icon="wand_stars"/> Build from a model</a>
                                        <a href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="() => this.menuAction('newBoard')"><i class="oi" data-icon="add_box"/> New empty dashboard</a>
                                    </t>
                                    <t t-if="this.canEdit">
                                        <div class="dropdown-divider"/>
                                        <a href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="this.startRenaming"><i class="oi" data-icon="edit"/> Rename dashboard</a>
                                    <a href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="this.assignMenu"><i class="oi" data-icon="format_list_bulleted"/> Add to the menu&#8230;</a>
                                    <a href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="() => this.menuAction('editBoard')"><i class="oi" data-icon="settings"/> Settings</a>
                                        <a href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="() => this.menuAction('duplicateBoard')"><i class="oi" data-icon="content_copy"/> Duplicate dashboard</a>
                                    <a href="#" class="dropdown-item text-danger" role="menuitem" t-on-click.prevent="this.deleteBoard"><i class="oi" data-icon="delete"/> Delete dashboard</a>
                                        <a href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="() => this.menuAction('fillGaps')"><i class="oi" data-icon="grid_view"/> Tidy the layout</a>
                                    </t>
                                    <div class="dropdown-divider"/>
                                    <a href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="this.startSavingView"><i class="oi" data-icon="bookmark"/> Save this view…</a>
                                    <a href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="this.startTour"><i class="oi" data-icon="help"/> Show the tour</a>
                                    <div class="dropdown-divider"/>
                                    <a href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="() => this.menuAction('downloadPdf')"><i class="oi" data-icon="picture_as_pdf"/> Download as PDF</a>
                                    <a href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="() => this.menuAction('downloadXlsx')"><i class="oi" data-icon="table_chart"/> Download as a spreadsheet</a>
                                    <a href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="() => this.menuAction('exportBoard')"><i class="oi" data-icon="download"/> Export as file</a>
                                    <a t-if="this.canBuild" href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="() => this.menuAction('importBoard')"><i class="oi" data-icon="upload"/> Import a file</a>
                                    <div class="dropdown-divider"/>
                                    <a href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="() => this.menuAction('togglePresenting')"><i class="oi" data-icon="fullscreen"/> Present</a>
                                    <a href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="() => this.menuAction('print')"><i class="oi" data-icon="print"/> Print</a>
                                </div>
                            </div>
                        </t>
                        <button t-else="" class="btn btn-secondary btn-sm o_dbb_btn o_dbb_btn_icon" t-on-click="this.togglePresenting" title="Leave presentation (Esc)">
                            <i class="oi" data-icon="fullscreen_exit" role="img" aria-label="Leave"/>
                        </button>
                    </div>
                </header>

                <!-- the filter bar: questions the board asks every time -->
                <div class="o_dbb_bar" t-if="this.state.board and this.state.board.filters and this.state.board.filters.length and !this.state.presenting">
                    <i class="oi o_dbb_bar_icon" data-icon="tune" role="img" aria-label="Filters"/>
                    <t t-foreach="this.state.board.filters" t-as="filter" t-key="filter.id">
                        <label t-attf-class="o_dbb_bar_filter {{ this.state.filters[filter.id] ? 'o_dbb_bar_on' : '' }}">
                            <span class="o_dbb_bar_label" t-out="filter.label"/>
                            <select class="o_dbb_bar_select" t-att-aria-label="filter.label"
                                    t-on-change="(ev) => this.onFilterPicked(filter, ev)">
                                <option value="">Any</option>
                                <t t-foreach="filter.options" t-as="option" t-key="option.key">
                                    <option t-att-value="option.key"
                                            t-att-selected="this.isFilterValue(filter, option)"
                                            t-out="option.label"/>
                                </t>
                            </select>
                        </label>
                    </t>
                    <button t-if="this.filterChips.length" class="btn btn-link btn-sm o_dbb_bar_clear"
                            t-on-click="this.clearFilters" title="Clear every filter (Esc)">Clear</button>
                </div>

                <!-- what stands out: the board's own insights, one chip each -->
                <div class="o_dbb_story" t-if="this.story.length and !this.state.presenting" role="status">
                    <div class="o_dbb_story_head">
                        <span class="o_dbb_story_badge"><i class="oi" data-icon="lightbulb" role="img" aria-label="Insights"/></span>
                        <span class="o_dbb_story_title">What stands out</span>
                    </div>
                    <div class="o_dbb_story_items">
                        <t t-foreach="this.story" t-as="insight" t-key="insight_index">
                            <button type="button" t-attf-class="o_dbb_story_item o_dbb_story_{{ insight.tone }}"
                                    t-on-click="() => this.jumpTo(insight)"
                                    t-att-title="insight.itemId ? 'Show this card' : ''">
                                <i class="oi o_dbb_story_item_icon" t-att-data-icon="insight.icon" role="img" aria-label="Insight"/>
                                <span class="o_dbb_story_text" t-out="insight.html"/>
                            </button>
                        </t>
                    </div>
                    <button class="o_dbb_story_close" t-on-click="this.hideStory" title="Hide for this dashboard">
                        <i class="oi" data-icon="close" role="img" aria-label="Hide"/>
                    </button>
                </div>

                <!-- the pages of the board -->
                <div class="o_dbb_tabs" t-if="this.state.board and !this.state.presenting and (this.tabs.length or (this.state.editing and this.canEdit))">
                    <t t-foreach="this.tabs" t-as="page" t-key="page.id || 'overview'">
                        <button t-attf-class="o_dbb_tab {{ (page.id || null) === (this.state.tab || null) ? 'o_dbb_tab_on' : '' }}"
                                t-on-click="() => this.pickTab(page.id)">
                            <i class="oi" t-att-data-icon="page.icon" role="img" aria-label="Tab"/>
                            <span t-out="page.name"/>
                            <span class="o_dbb_tab_count" t-out="page.count"/>
                        </button>
                    </t>
                    <t t-if="this.canEdit and this.state.editing">
                        <input t-if="this.state.addingTab" type="text" class="o_dbb_tab_input" placeholder="Tab name, Enter to add"
                               t-att-value="this.state.tabName" t-on-input="(ev) => this.state.tabName = ev.target.value"
                               t-on-keydown="this.onTabKeydown"/>
                        <button t-else="" class="o_dbb_tab o_dbb_tab_add" t-on-click="this.startAddingTab" title="Add a tab">
                            <i class="oi" data-icon="add" role="img" aria-label="Add"/>
                            <span>Tab</span>
                        </button>
                    </t>
                </div>

                <!-- chips: what narrows the whole page -->
                <div class="o_dbb_chips" t-if="this.filterChips.length and !this.state.presenting">
                    <t t-foreach="this.filterChips" t-as="chip" t-key="chip.id">
                        <span class="o_dbb_chip o_dbb_chip_filter">
                            <i class="oi" data-icon="filter_alt" role="img" aria-label="Filter"/>
                            <b t-out="chip.label"/>: <span t-out="chip.value"/>
                            <button class="o_dbb_chip_x" t-on-click="() => this.clearFilter(chip.id)" title="Clear">
                                <i class="oi" data-icon="close" role="img" aria-label="Clear"/>
                            </button>
                        </span>
                    </t>
                </div>
                <div class="o_dbb_chips" t-if="this.state.focus or this.state.mine">
                    <span t-if="this.state.focus" class="o_dbb_chip" title="Every card of the same model is narrowed to this">
                        <i class="oi" data-icon="filter_alt" role="img" aria-label="Focus"/>
                        <span t-out="this.focusLabel"/>
                        <button class="o_dbb_chip_btn" t-on-click="this.openFocusRecords" title="Open these records">
                            <i class="oi" data-icon="open_in_new" role="img" aria-label="Open"/>
                        </button>
                        <button class="o_dbb_chip_btn" t-on-click="this.clearFocus" title="Clear the focus (Esc)">
                            <i class="oi" data-icon="close" role="img" aria-label="Clear"/>
                        </button>
                    </span>
                    <span t-if="this.state.mine" class="o_dbb_chip o_dbb_chip_mine" title="Only your own records, on every card that knows its user">
                        <i class="oi" data-icon="person" role="img" aria-label="Mine"/> Only mine
                        <button class="o_dbb_chip_btn" t-on-click="this.toggleMine" title="Show everybody's">
                            <i class="oi" data-icon="close" role="img" aria-label="Clear"/>
                        </button>
                    </span>
                </div>

                <!-- saved views: a period, a focus and the mine switch, under a name -->
                <div class="o_dbb_views" t-if="this.state.board and !this.state.presenting and (this.state.views.length or this.state.savingView)">
                    <i class="oi" data-icon="bookmark" role="img" aria-label="Saved views"/>
                    <t t-foreach="this.state.views" t-as="view" t-key="view.id">
                        <span class="o_dbb_view" role="button" t-on-click="() => this.applyView(view)"
                              t-att-title="'Period: ' + (view.period or 'as is') + (view.mine ? ' · only mine' : '') + (view.focus ? ' · ' + view.focus.label : '')">
                            <span t-out="view.name"/>
                            <button class="o_dbb_chip_btn" t-on-click.stop="() => this.removeView(view)" title="Forget this view">
                                <i class="oi" data-icon="close" role="img" aria-label="Remove"/>
                            </button>
                        </span>
                    </t>
                    <t t-if="this.state.savingView">
                        <input type="text" class="o_dbb_view_input" placeholder="Name this view, Enter to save"
                               t-att-value="this.state.viewName"
                               t-on-input="(ev) => this.state.viewName = ev.target.value"
                               t-on-keydown="this.onViewKeydown"/>
                        <button class="btn btn-secondary btn-sm o_dbb_mini" t-on-click="this.saveView" title="Save"><i class="oi" data-icon="check" role="img" aria-label="Save"/></button>
                    </t>
                </div>

                <!-- the watchlist: pinned numbers, whatever board they live on -->
                <div class="o_dbb_watch" t-if="this.state.watchOpen and !this.state.presenting">
                    <div class="o_dbb_watch_head">
                        <i class="oi" data-icon="push_pin" role="img" aria-label="Watchlist"/>
                        <span>Watchlist</span>
                        <span class="o_dbb_watch_hint">Pin any number card with its thumb-tack; it follows you to every dashboard.</span>
                    </div>
                    <div class="o_dbb_watch_strip" t-if="this.state.watchlist.length">
                        <t t-foreach="this.state.watchlist" t-as="watch" t-key="watch.id">
                            <div t-attf-class="o_dbb_watch_item {{ watch.alert ? 'o_dbb_watch_' + watch.alert : '' }}"
                                 t-att-style="'--dbc-color: ' + this.cardColor(watch)"
                                 role="button" t-on-click="() => this.goToCard(watch.board_id, watch.id)">
                                <div class="o_dbb_watch_board" t-out="watch.board_name"/>
                                <div class="o_dbb_watch_name">
                                    <i class="oi" t-att-data-icon="watch.icon" role="img" aria-label="Card"/>
                                    <span t-out="watch.name"/>
                                </div>
                                <div class="o_dbb_watch_value">
                                    <span t-out="this.watchValue(watch)"/>
                                    <span t-if="watch.symbol" class="o_dbb_watch_unit" t-out="watch.symbol"/>
                                    <span t-if="watch.delta !== undefined and watch.delta !== null"
                                          t-attf-class="o_dbb_watch_delta {{ watch.delta &gt;= 0 ? 'up' : 'down' }}"
                                          t-out="(watch.delta &gt; 0 ? '+' : '') + this.watchValue(watch, watch.delta)"/>
                                </div>
                                <button class="o_dbb_watch_unpin" t-on-click.stop="() => this.togglePin(watch)" title="Unpin">
                                    <i class="oi" data-icon="close" role="img" aria-label="Unpin"/>
                                </button>
                            </div>
                        </t>
                    </div>
                    <div t-else="" class="o_dbb_watch_empty">Nothing pinned yet.</div>
                </div>

                <!-- ============================ body ========================= -->
                <div class="o_dbb_body">
                    <div class="o_dbb_content" t-att-style="this.contentStyle">
                        <t t-if="this.state.loading and !this.state.board">
                            <div class="text-center p-5">
                                <i class="oi oi-spin oi-2x" data-icon="progress_activity" role="img" aria-label="Loading"/>
                            </div>
                        </t>

                        <t t-elif="!this.state.board">
                            <div class="o_dbb_nocontent">
                                <i class="oi oi-3x mb-3" data-icon="speed" role="img" aria-label="Dashboards"/>
                                <h3>No dashboard yet</h3>
                                <p class="text-muted">
                                    A dashboard is a page of cards, each one a live question asked of a
                                    model. Nothing here is code.
                                </p>
                                <div class="d-flex gap-2 justify-content-center">
                                    <button t-if="this.canBuild" class="btn btn-primary o_dbb_btn" t-on-click="this.buildBoard">
                                        <i class="oi" data-icon="wand_stars" role="img" aria-label="Build"/>
                                        <span>Build one from a model</span>
                                    </button>
                                    <button t-if="this.canBuild" class="btn btn-secondary o_dbb_btn" t-on-click="this.newBoard"><span>Start empty</span></button>
                                </div>
                            </div>
                        </t>

                        <t t-else="">
                            <t t-if="!this.state.items.length">
                                <div class="o_dbb_nocontent">
                                    <i class="oi oi-3x mb-3" data-icon="grid_view" role="img" aria-label="Cards"/>
                                    <h3>This dashboard has no cards</h3>
                                    <p class="text-muted">Add a number, a chart, a table or a note to it.</p>
                                    <t t-if="this.canEdit">
                                        <button class="btn btn-primary o_dbb_btn" t-on-click="this.addCard"><i class="oi" data-icon="add"/> <span>Add a card</span></button>
                                    </t>
                                </div>
                            </t>
                            <t t-elif="!this.visibleItems.length">
                                <div class="o_dbb_nocontent">
                                    <i class="oi oi-2x mb-3" data-icon="search" role="img" aria-label="Search"/>
                                    <h3>No tile matches "<t t-out="this.state.filter"/>"</h3>
                                </div>
                            </t>

                            <div t-if="this.showSkeletons" class="o_dbb_grid" t-att-style="this.gridStyle" aria-hidden="true">
                                <t t-foreach="this.skeletons" t-as="span" t-key="span_index">
                                    <div class="o_dbb_cell" t-attf-style="grid-column: span {{ span }};">
                                        <div t-attf-class="o_dbb_skel {{ span &lt; 4 ? 'o_dbb_skel_number' : '' }}">
                                            <span class="o_dbb_skel_line o_dbb_skel_title"/>
                                            <span class="o_dbb_skel_block"/>
                                        </div>
                                    </div>
                                </t>
                            </div>
                            <div t-attf-class="o_dbb_grid {{ this.state.editing ? 'o_dbb_editing' : '' }} {{ this.state.loading ? 'o_dbb_loading' : '' }}"
                                 t-att-style="this.gridStyle">
                                <t t-foreach="this.visibleItems" t-as="item" t-key="item.id">
                                    <div t-attf-class="o_dbb_cell {{ this.state.flashId === item.id ? 'o_dbb_flash' : '' }}"
                                         t-att-style="this.cardStyle(item)" t-att-data-item-id="item.id">
                                        <BoardCard item="item"
                                                   editable="this.state.editing"
                                                   focus="this.state.focus or undefined"
                                                   compact="this.compact"
                                                   palette="this.palette"
                                                   pinned="this.isPinned(item)"
                                                   onDrill.bind="this.onDrill"
                                                   onFocus.bind="this.onFocus"
                                                   onEdit.bind="this.openCard"
                                                   onRefresh.bind="this.refreshItem"
                                                   onPin.bind="this.togglePin"
                                                   onPdf.bind="this.onCardPdf"
                                                   onXlsx.bind="this.onCardXlsx"
                                                   onRemove.bind="this.removeCard"
                                                   canEdit="this.canEdit"/>
                                        <t t-if="this.state.editing">
                                            <div class="o_dbb_resize">
                                                <button class="o_dbb_mini" title="Narrower" t-on-click="() => this.widen(item, -1)">
                                                    <i class="oi" data-icon="remove" role="img" aria-label="Narrower"/>
                                                </button>
                                                <span class="o_dbb_resize_label" t-out="item.width + '/12'"/>
                                                <button class="o_dbb_mini" title="Wider" t-on-click="() => this.widen(item, 1)">
                                                    <i class="oi" data-icon="add" role="img" aria-label="Wider"/>
                                                </button>
                                                <button class="o_dbb_mini" title="Duplicate this card" t-on-click="() => this.duplicateCard(item)">
                                                    <i class="oi" data-icon="content_copy" role="img" aria-label="Duplicate"/>
                                                </button>
                                                <button class="o_dbb_mini o_dbb_mini_danger" title="Remove this card"
                                                        t-on-click="() => this.removeCard(item)">
                                                    <i class="oi" data-icon="delete" role="img" aria-label="Remove"/>
                                                </button>
                                                <select class="o_dbb_mini_select" title="Move to a tab of this dashboard"
                                                        t-if="this.state.board.tabs and this.state.board.tabs.length"
                                                        t-on-change="(ev) => this.moveToTab(item, ev)">
                                                    <option value="">Tab…</option>
                                                    <option value="none">Overview</option>
                                                    <t t-foreach="this.state.board.tabs" t-as="tab" t-key="tab.id">
                                                        <option t-att-value="tab.id" t-out="tab.name"/>
                                                    </t>
                                                </select>
                                                <select class="o_dbb_mini_select" title="Move to another dashboard"
                                                        t-if="this.state.boards.length &gt; 1"
                                                        t-on-change="(ev) => this.moveCard(item, ev)">
                                                    <option value="">Move to…</option>
                                                    <t t-foreach="this.state.boards" t-as="board" t-key="board.id">
                                                        <option t-if="board.id !== this.state.board.id and board.can_edit" t-att-value="board.id" t-out="board.name"/>
                                                    </t>
                                                </select>
                                            </div>
                                            <span class="o_dbb_grip" title="Drag to resize"
                                                  t-on-pointerdown="(ev) => this.startResize(ev, item)">
                                                <i class="oi" data-icon="fullscreen" role="img" aria-label="Resize"/>
                                            </span>
                                        </t>
                                    </div>
                                </t>
                            </div>

                            <div class="o_dbb_foot text-muted">
                                <t t-if="!this.state.presenting"><span t-out="this.greeting"/> · </t>
                                <t t-if="this.state.board.description and !this.state.presenting"><span class="o_dbb_foot_desc" t-out="this.state.board.description"/> · </t>
                                <t t-if="this.periodLabel"><span t-out="this.periodLabel"/> · </t>
                                <span t-out="this.visibleItems.length"/><t t-if="this.state.filter"> of <t t-out="this.state.items.length"/></t> cards
                                <t t-if="this.state.board.auto_refresh"> · refreshing every <t t-out="this.state.board.auto_refresh"/>s</t>
                                <t t-if="this.hiddenCount and !this.state.editing"> · <span t-out="this.hiddenCount"/> hidden until their rule fires</t>
                                <t t-if="this.state.presenting and this.state.board.slide_seconds and this.state.boards.length &gt; 1"> · next dashboard in <t t-out="this.state.board.slide_seconds"/>s</t>
                                <t t-if="this.state.resizeLabel"> · <span class="o_dbb_resize_live" t-out="this.state.resizeLabel"/></t>
                            </div>
                        </t>
                    </div>

                    <!-- my notes: a drawer beside the grid -->
                    <aside class="o_dbb_notes" t-if="this.state.notesOpen and this.state.board and !this.state.presenting">
                        <div class="o_dbb_notes_head">
                            <i class="oi" data-icon="sticky_note_2" role="img" aria-label="Notes"/>
                            <span>My notes</span>
                            <span class="o_dbb_notes_state" t-out="this.state.noteState"/>
                            <button class="o_dbb_chip_btn ms-auto" t-on-click="this.toggleNotes" title="Close">
                                <i class="oi" data-icon="close" role="img" aria-label="Close"/>
                            </button>
                        </div>
                        <textarea class="o_dbb_notes_text" placeholder="Only you can see this. What to check, whom to ask, what changed…"
                                  t-att-value="this.state.noteText" t-on-input="this.onNoteInput"/>
                        <div class="o_dbb_notes_foot">Private to you, saved as you type, one note per dashboard.</div>
                    </aside>
                </div>
            </div>
        </div>
    </t>

</templates>
