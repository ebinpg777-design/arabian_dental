<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="ebshel_dashboard.BoardCard">
        <div t-att-class="this.cardClass"
             t-att-style="'--dbc-color: ' + this.color + '; min-height: ' + this.item.height + 'px'"
             t-att-data-item-id="this.item.id"
             t-att-title="this.item.tooltip or false">

            <div class="o_dbc_head">
                <i t-attf-class="fa #{this.item.icon} o_dbc_icon" role="img" t-att-aria-label="this.item.name"/>
                <span class="o_dbc_title" t-esc="this.item.name"/>
                <span t-if="this.periodBadge" class="o_dbc_badge" t-esc="this.periodBadge"/>
                <span t-if="this.item.focused" class="o_dbc_badge o_dbc_badge_focus" title="Narrowed by the focus">
                    <i class="fa fa-filter" role="img" aria-label="Focused"/>
                </span>
                <span t-if="this.alert" t-attf-class="o_dbc_badge o_dbc_badge_{{ this.alert }}"
                      t-att-title="this.item.alert_message or 'Threshold crossed'">
                    <i class="fa fa-exclamation-triangle" role="img" aria-label="Threshold"/>
                </span>
                <span t-if="!this.isNumber and this.item.compare and this.deltaLabel" t-attf-class="o_dbc_badge o_dbc_delta_badge {{ this.deltaClass }}"
                      t-att-title="this.compareLabel">
                    <i t-attf-class="fa {{ (this.item.delta or 0) &gt;= 0 ? 'fa-arrow-up' : 'fa-arrow-down' }}" role="img" aria-label="Change"/>
                    <t t-esc="this.deltaLabel"/>
                </span>
                <span class="o_dbc_spacer"/>
                <t t-if="this.item.kind !== 'text' and !this.item.error">
                    <span class="o_dbc_info" t-att-title="this.infoTitle" tabindex="0">
                        <i class="fa fa-info-circle" role="img" aria-label="What this card computes"/>
                    </span>
                    <button t-if="this.isNumber and this.props.onPin"
                            t-attf-class="o_dbc_tool o_dbc_pin {{ this.props.pinned ? 'o_dbc_pin_on' : '' }}"
                            t-on-click="this.onPinClick"
                            t-att-title="this.props.pinned ? 'Unpin from the watchlist' : 'Pin to the watchlist'">
                        <i class="fa fa-thumb-tack" role="img" aria-label="Pin"/>
                    </button>
                    <button class="o_dbc_tool" t-on-click="this.onRefreshClick"
                            t-if="this.props.onRefresh" title="Refresh this card">
                        <i class="fa fa-refresh" role="img" aria-label="Refresh"/>
                    </button>
                    <button class="o_dbc_tool" t-on-click="this.onOpenClick"
                            title="Open the records">
                        <i class="fa fa-external-link" role="img" aria-label="Open"/>
                    </button>
                    <span class="o_dbc_menu_wrap" t-custom-ref="menu">
                        <button class="o_dbc_tool" t-on-click="this.toggleMenu" title="More">
                            <i class="fa fa-ellipsis-v" role="img" aria-label="More"/>
                        </button>
                        <div t-if="this.state.menuOpen" class="dropdown-menu show o_dbc_menu" role="menu">
                            <a t-if="this.isChart" href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="this.toggleTable">
                                <i t-attf-class="fa {{ this.state.showTable ? 'fa-bar-chart' : 'fa-table' }}"/>
                                <t t-if="this.state.showTable">Show as a chart</t>
                                <t t-else="">Show as a table</t>
                            </a>
                            <a t-if="this.isChart and !this.state.showTable" href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="this.exportImage">
                                <i class="fa fa-picture-o"/> Download as image
                            </a>
                            <t t-if="this.props.canEdit">
                                <a t-if="this.props.onEdit" href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="this.onEditClick">
                                    <i class="fa fa-pencil"/> Edit this card
                                </a>
                                <a t-if="this.props.onRemove" href="#" class="dropdown-item text-danger" role="menuitem"
                                   t-on-click.prevent="() => this.props.onRemove(this.item)">
                                    <i class="fa fa-trash-o"/> Remove this card
                                </a>
                                <div class="dropdown-divider"/>
                            </t>
                            <a t-if="this.props.onPdf" href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="this.exportPdf">
                                <i class="fa fa-file-pdf-o"/> Download as PDF
                            </a>
                            <a t-if="this.props.onXlsx" href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="this.exportXlsx">
                                <i class="fa fa-file-excel-o"/> Download as a spreadsheet
                            </a>
                            <a href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="this.exportCsv">
                                <i class="fa fa-file-text-o"/> Download as CSV
                            </a>
                            <a href="#" class="dropdown-item" role="menuitem" t-on-click.prevent="this.exportJson">
                                <i class="fa fa-code"/> Download as JSON
                            </a>
                        </div>
                    </span>
                </t>
                <t t-if="this.props.canEdit and !this.props.editable and this.props.onEdit">
                    <button class="o_dbc_tool" t-on-click="this.onEditClick" title="Edit this card">
                        <i class="fa fa-pencil" role="img" aria-label="Edit"/>
                    </button>
                </t>
                <t t-if="this.props.editable">
                    <button t-if="this.props.onRemove" class="o_dbc_tool o_dbc_tool_danger"
                            t-on-click="() => this.props.onRemove(this.item)" title="Remove this card">
                        <i class="fa fa-trash-o" role="img" aria-label="Remove"/>
                    </button>
                    <button class="o_dbc_tool" t-on-click="this.onEditClick"
                            title="Edit this card">
                        <i class="fa fa-pencil" role="img" aria-label="Edit"/>
                    </button>
                    <span class="o_dbc_handle" title="Drag to move">
                        <i class="fa fa-arrows" role="img" aria-label="Move"/>
                    </span>
                </t>
            </div>

            <!-- ============================ a number ============================ -->
            <!-- ============================ still loading ===================== -->
            <t t-if="this.item.pending">
                <div class="o_dbc_body o_dbc_waiting" aria-busy="true">
                    <span class="o_dbc_wait_line o_dbc_wait_value"/>
                    <span class="o_dbc_wait_line o_dbc_wait_sub"/>
                </div>
            </t>

            <t t-elif="this.item.kind === 'kpi' or this.item.kind === 'formula'">
                <div class="o_dbc_body o_dbc_kpi_body" role="button" t-on-click="this.onCardClick">
                    <t t-if="this.item.target">
                        <div class="o_dbc_ring">
                            <svg viewBox="0 0 36 36" class="o_dbc_ring_svg" aria-hidden="true">
                                <circle class="o_dbc_ring_track" cx="18" cy="18" r="15.9155"
                                        fill="none" stroke-width="2.5"/>
                                <circle class="o_dbc_ring_fill" cx="18" cy="18" r="15.9155"
                                        fill="none" stroke-width="2.5"
                                        stroke-dasharray="100"
                                        t-att-stroke-dashoffset="this.ringOffset"
                                        transform="rotate(-90 18 18)"/>
                            </svg>
                            <span class="o_dbc_ring_label" t-esc="Math.round(this.targetPercent) + '%'"/>
                        </div>
                    </t>
                    <div class="o_dbc_numbers">
                        <div class="o_dbc_value">
                            <span t-if="this.item.prefix" class="o_dbc_prefix" t-esc="this.item.prefix"/>
                            <span t-esc="this.displayValue"/>
                            <span t-if="this.displayUnit" class="o_dbc_unit" t-esc="this.displayUnit"/>
                        </div>
                        <div t-if="this.item.as_ratio and this.item.ratio !== undefined" class="o_dbc_sub">
                            <t t-esc="this.formatValue(this.item.value)"/> of <t t-esc="this.formatValue(this.item.whole)"/>
                        </div>
                        <div t-elif="this.item.show_count and this.item.aggregate !== 'count'" class="o_dbc_sub">
                            <t t-esc="this.formatValue(this.item.count)"/> records
                        </div>
                        <div t-if="this.item.kind === 'formula' and this.item.variables" class="o_dbc_vars">
                            <t t-foreach="this.item.variables" t-as="variable" t-key="variable.name">
                                <span class="o_dbc_var" t-att-title="variable.label">
                                    <b t-esc="variable.name"/>
                                    <span t-esc="this.formatValue(variable.value)"/>
                                </span>
                            </t>
                        </div>
                        <div t-if="this.item.compare and this.deltaLabel" class="o_dbc_delta_row">
                            <span t-attf-class="o_dbc_pill {{ this.deltaClass }}">
                                <i t-attf-class="fa {{ (this.item.delta or 0) &gt;= 0 ? 'fa-arrow-up' : 'fa-arrow-down' }}"
                                   role="img" aria-label="Change"/>
                                <span t-esc="this.deltaLabel"/>
                            </span>
                            <span class="o_dbc_delta_note" t-esc="this.compareLabel"/>
                        </div>
                        <div t-elif="this.snapshotLabel" class="o_dbc_delta_row">
                            <span class="o_dbc_delta_note" t-esc="this.snapshotLabel"/>
                        </div>
                        <div t-elif="this.item.target" class="o_dbc_delta_row">
                            <span class="o_dbc_delta_note">Target <t t-esc="this.formatValue(this.item.target)"/></span>
                        </div>
                        <div t-if="this.anomaly" t-attf-class="o_dbc_anomaly o_dbc_anomaly_{{ this.anomaly.above ? 'up' : 'down' }}"
                             t-att-title="this.anomaly.text">
                            <i t-attf-class="fa {{ this.anomaly.above ? 'fa-arrow-up' : 'fa-arrow-down' }}" role="img" aria-label="Unusual"/>
                            <span>Unusual · <t t-esc="this.anomaly.z"/>σ</span>
                        </div>
                        <div t-if="this.item.subvalues and this.item.subvalues.length" class="o_dbc_subs">
                            <t t-foreach="this.item.subvalues" t-as="sub" t-key="sub.id">
                                <button type="button" class="o_dbc_sub" t-att-style="this.subStyle(sub)"
                                        t-att-title="this.subTitle(sub)"
                                        t-on-click.stop="() => this.onSubClick(sub)">
                                    <span class="o_dbc_sub_label" t-esc="sub.label"/>
                                    <span class="o_dbc_sub_value" t-esc="this.formatValue(sub.value)"/>
                                    <span t-if="sub.share !== null and sub.share !== undefined"
                                          class="o_dbc_sub_share" t-esc="sub.share + '%'"/>
                                    <span t-if="sub.share !== null and sub.share !== undefined"
                                          class="o_dbc_sub_bar" t-att-style="this.subBarStyle(sub)"/>
                                </button>
                            </t>
                        </div>
                        <div t-if="this.pace" t-attf-class="o_dbc_pace o_dbc_pace_{{ this.pace.status }}" t-att-title="this.pace.text">
                            <div class="o_dbc_pace_track">
                                <div class="o_dbc_pace_fill" t-att-style="'width: ' + this.pace.fill + '%'"/>
                                <div class="o_dbc_pace_mark" t-att-style="'left: ' + this.pace.mark + '%'" title="Where the calendar stands"/>
                            </div>
                            <div class="o_dbc_pace_text">
                                <b t-esc="this.pace.label"/> · <span t-esc="this.pace.text"/>
                            </div>
                        </div>
                        <div t-if="this.alert and this.item.alert_message" class="o_dbc_alert_text" t-esc="this.item.alert_message"/>
                    </div>
                    <t t-if="this.spark">
                        <div class="o_dbc_spark_col" t-att-title="this.sparkTitle">
                            <svg class="o_dbc_spark" viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true">
                                <path class="o_dbc_spark_area" t-att-d="this.spark.area"/>
                                <polyline class="o_dbc_spark_line" fill="none" t-att-points="this.spark.line"/>
                                <circle class="o_dbc_spark_dot" r="2" t-att-cx="this.spark.last[0]" t-att-cy="this.spark.last[1]"/>
                            </svg>
                            <span class="o_dbc_spark_caption" t-esc="this.sparkCaption"/>
                        </div>
                    </t>
                </div>
            </t>

            <!-- ============================ a gauge ============================= -->
            <t t-elif="this.item.kind === 'gauge'">
                <div class="o_dbc_body o_dbc_gauge_body" role="button" t-on-click="this.onCardClick">
                    <svg viewBox="0 0 100 58" class="o_dbc_gauge" aria-hidden="true">
                        <path class="o_dbc_gauge_track" d="M10,52 A40,40 0 0 1 90,52" fill="none"
                              stroke-width="9" pathLength="100" stroke-linecap="round"/>
                        <path class="o_dbc_gauge_fill" d="M10,52 A40,40 0 0 1 90,52" fill="none"
                              stroke-width="9" pathLength="100" stroke-linecap="round"
                              t-att-stroke-dasharray="Math.max(0.5, this.targetPercent) + ' 100'"/>
                    </svg>
                    <div class="o_dbc_gauge_value">
                        <span t-if="this.item.prefix" class="o_dbc_prefix" t-esc="this.item.prefix"/>
                        <span t-esc="this.displayValue"/>
                        <span t-if="this.displayUnit" class="o_dbc_unit" t-esc="this.displayUnit"/>
                    </div>
                    <div class="o_dbc_gauge_foot">
                        <span t-esc="Math.round(this.targetPercent) + '%'"/> of <span t-esc="this.formatValue(this.item.target)"/>
                        <t t-if="this.item.compare and this.deltaLabel">
                            · <span t-attf-class="{{ this.deltaClass }}" t-esc="this.deltaLabel"/>
                        </t>
                    </div>
                    <div t-if="this.alert and this.item.alert_message" class="o_dbc_alert_text" t-esc="this.item.alert_message"/>
                </div>
            </t>

            <!-- ============================ a bullet ============================ -->
            <t t-elif="this.item.kind === 'bullet'">
                <div class="o_dbc_body o_dbc_bullet_body" role="button" t-on-click="this.onCardClick">
                    <div class="o_dbc_value">
                        <span t-if="this.item.prefix" class="o_dbc_prefix" t-esc="this.item.prefix"/>
                        <span t-esc="this.displayValue"/>
                        <span t-if="this.displayUnit" class="o_dbc_unit" t-esc="this.displayUnit"/>
                        <span class="o_dbc_sub ms-2">of <t t-esc="this.formatValue(this.item.target)"/> · <t t-esc="Math.round(this.targetPercent)"/>%</span>
                    </div>
                    <div class="o_dbc_bullet_track">
                        <div class="o_dbc_bullet_range" t-att-style="'width: ' + this.bullet.range + '%'"/>
                        <div class="o_dbc_bullet_fill" t-att-style="'width: ' + this.bullet.fill + '%'"/>
                        <div class="o_dbc_bullet_mark" t-att-style="'left: ' + this.bullet.mark + '%'" title="Target"/>
                    </div>
                    <div class="o_dbc_bullet_scale">
                        <span>0</span>
                        <span t-if="this.item.compare and this.deltaLabel" t-attf-class="{{ this.deltaClass }}">
                            <t t-esc="this.deltaLabel"/> <t t-esc="this.compareLabel"/>
                        </span>
                        <span t-esc="this.bullet.max"/>
                    </div>
                    <div t-if="this.alert and this.item.alert_message" class="o_dbc_alert_text" t-esc="this.item.alert_message"/>
                </div>
            </t>

            <!-- ============================ a status light ===================== -->
            <t t-elif="this.item.kind === 'status'">
                <div t-attf-class="o_dbc_body o_dbc_status_body {{ this.statusClass }}" role="button" t-on-click="this.onCardClick">
                    <span class="o_dbc_light" aria-hidden="true"/>
                    <div class="o_dbc_numbers">
                        <div class="o_dbc_value">
                            <span t-if="this.item.prefix" class="o_dbc_prefix" t-esc="this.item.prefix"/>
                            <span t-esc="this.displayValue"/>
                            <span t-if="this.displayUnit" class="o_dbc_unit" t-esc="this.displayUnit"/>
                        </div>
                        <div class="o_dbc_sub">
                            <t t-if="this.alert and this.item.alert_message"><t t-esc="this.item.alert_message"/></t>
                            <t t-elif="this.alert">Threshold crossed</t>
                            <t t-elif="this.item.alert_operator !== 'none'">Within limits</t>
                            <t t-else="">No threshold set</t>
                        </div>
                    </div>
                </div>
            </t>

            <!-- ============================ a chart ============================= -->
            <t t-elif="this.isChart">
                <div t-if="this.state.showTable and this.hasContent" class="o_dbc_body o_dbc_astable">
                    <table class="o_dbc_table">
                        <thead>
                            <tr>
                                <t t-foreach="this.tableHead" t-as="head" t-key="head_index">
                                    <th t-att-class="head_index ? 'o_dbc_num' : ''" t-esc="head"/>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="this.tableRows" t-as="row" t-key="row_index">
                                <tr>
                                    <td t-esc="row.label"/>
                                    <t t-foreach="row.cells" t-as="cell" t-key="cell_index">
                                        <td class="o_dbc_num" t-esc="cell"/>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
                <div t-else="" class="o_dbc_body o_dbc_chart_body">
                    <t t-if="this.hasContent">
                        <!-- The box has the size; the canvas is sized by Chart.js to fit it. -->
                        <div class="o_dbc_chart_box">
                            <canvas t-custom-ref="canvas" class="o_dbc_canvas"/>
                        </div>
                    </t>
                    <t t-elif="!this.item.error">
                        <div class="o_dbc_empty">
                            <i class="fa fa-inbox me-2" role="img" aria-label="Empty"/>
                            <span t-esc="this.emptyLabel"/>
                        </div>
                    </t>
                </div>
                <div t-if="this.hasContent and this.dataInfo" class="o_dbc_foot o_dbc_datastrip" role="button"
                     t-on-click="this.onCardClick" title="Open the records behind this chart">
                    <t t-foreach="this.dataInfo" t-as="fact" t-key="fact_index">
                        <span class="o_dbc_fact">
                            <span class="o_dbc_fact_label" t-esc="fact[0]"/>
                            <span class="o_dbc_fact_value" t-esc="fact[1]"/>
                        </span>
                    </t>
                    <i class="fa fa-angle-right ms-auto" role="img" aria-label="Open"/>
                </div>
            </t>

            <!-- ============================ a treemap ========================= -->
            <t t-elif="this.item.kind === 'treemap'">
                <div class="o_dbc_body o_dbc_svg_body">
                    <t t-if="this.hasContent">
                        <svg class="o_dbc_treemap" viewBox="0 0 100 60" preserveAspectRatio="none" role="img"
                             t-att-aria-label="this.item.name">
                            <t t-foreach="this.treemapCells" t-as="cell" t-key="cell.index">
                                <g t-attf-class="o_dbc_tm_cell {{ this.isFocused(cell.point) ? 'o_dbc_tm_on' : '' }}"
                                   role="button" t-on-click="() => this.onPointClick(cell.point)">
                                    <title t-esc="cell.point.label + ': ' + this.formatFull(cell.point.value) + (cell.point.share !== undefined ? ' · ' + cell.point.share + '%' : '')"/>
                                    <rect t-att-x="cell.x" t-att-y="cell.y" t-att-width="cell.w" t-att-height="cell.h"
                                          t-att-fill="cell.color" rx="0.6"/>
                                    <text t-if="cell.w &gt; 14 and cell.h &gt; 9" t-att-x="cell.x + 1.6" t-att-y="cell.y + 4.2"
                                          class="o_dbc_tm_label" t-esc="cell.point.label"/>
                                    <text t-if="cell.w &gt; 14 and cell.h &gt; 14" t-att-x="cell.x + 1.6" t-att-y="cell.y + 8.6"
                                          class="o_dbc_tm_value" t-esc="this.formatValue(cell.point.value)"/>
                                </g>
                            </t>
                        </svg>
                    </t>
                    <t t-elif="!this.item.error">
                        <div class="o_dbc_empty"><i class="fa fa-inbox me-2" role="img" aria-label="Empty"/><span t-esc="this.emptyLabel"/></div>
                    </t>
                </div>
            </t>

            <!-- ============================ a calendar heat map ================ -->
            <t t-elif="this.item.kind === 'calendar'">
                <div class="o_dbc_body o_dbc_svg_body">
                    <t t-if="this.hasContent">
                        <t t-set="cal" t-value="this.calendarCells"/>
                        <svg class="o_dbc_calendar" t-attf-viewBox="0 0 {{ cal.weeks * 13 + 24 }} 104" role="img"
                             t-att-aria-label="this.item.name">
                            <t t-foreach="['Mon', '', 'Wed', '', 'Fri', '', 'Sun']" t-as="dayName" t-key="dayName_index">
                                <text t-if="dayName" x="0" t-att-y="14 + dayName_index * 13 + 9" class="o_dbc_cal_axis" t-esc="dayName"/>
                            </t>
                            <t t-foreach="cal.months" t-as="month" t-key="month.week">
                                <text t-att-x="24 + month.week * 13" y="8" class="o_dbc_cal_axis" t-esc="month.label"/>
                            </t>
                            <t t-foreach="cal.cells" t-as="cell" t-key="cell.point.key">
                                <rect t-attf-class="o_dbc_cal_cell {{ this.isFocused(cell.point) ? 'o_dbc_cal_on' : '' }}"
                                      t-att-x="24 + cell.week * 13" t-att-y="14 + cell.weekday * 13"
                                      width="11" height="11" rx="2"
                                      t-att-fill="this.calendarFill(cell)" role="button"
                                      t-on-click="() => this.onPointClick(cell.point, true)">
                                    <title t-esc="cell.point.label + ': ' + this.formatFull(cell.point.value)"/>
                                </rect>
                            </t>
                        </svg>
                    </t>
                    <t t-elif="!this.item.error">
                        <div class="o_dbc_empty"><i class="fa fa-inbox me-2" role="img" aria-label="Empty"/><span t-esc="this.emptyLabel"/></div>
                    </t>
                </div>
            </t>

            <!-- ============================ a heat map / a pivot =============== -->
            <t t-elif="this.isMatrix">
                <div class="o_dbc_body o_dbc_list_body o_dbc_matrix_body">
                    <t t-if="this.hasContent">
                        <t t-set="m" t-value="this.matrix"/>
                        <table t-attf-class="o_dbc_table o_dbc_matrix {{ this.item.kind === 'heatmap' ? 'o_dbc_heat' : '' }}">
                            <thead>
                                <tr>
                                    <th t-esc="this.item.group_label or 'Group'"/>
                                    <t t-foreach="m.columns" t-as="column" t-key="column_index">
                                        <th class="o_dbc_num" t-esc="column.label"/>
                                    </t>
                                    <th t-if="this.item.kind === 'pivot'" class="o_dbc_num">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="m.rows" t-as="row" t-key="row_index">
                                    <tr t-attf-class="{{ this.isFocused(row) ? 'o_dbc_row_focused' : '' }}"
                                        role="button" t-on-click="() => this.onPointClick(row)">
                                        <td t-esc="row.label"/>
                                        <t t-foreach="row.cells" t-as="cell" t-key="cell_index">
                                            <td class="o_dbc_num o_dbc_cell"
                                                t-att-style="this.item.kind === 'heatmap' ? this.heat(cell, m.max) : ''"
                                                t-esc="cell ? this.formatValue(cell) : (this.item.kind === 'heatmap' ? '' : '0')"/>
                                        </t>
                                        <td t-if="this.item.kind === 'pivot'" class="o_dbc_num o_dbc_total" t-esc="this.formatValue(row.total)"/>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot t-if="this.item.kind === 'pivot'">
                                <tr>
                                    <td>Total</td>
                                    <t t-foreach="m.columns" t-as="column" t-key="column_index">
                                        <td class="o_dbc_num" t-esc="this.formatValue(column.total)"/>
                                    </t>
                                    <td class="o_dbc_num" t-esc="this.formatValue(m.total)"/>
                                </tr>
                            </tfoot>
                        </table>
                    </t>
                    <t t-elif="!this.item.error">
                        <div class="o_dbc_empty">
                            <i class="fa fa-inbox me-2" role="img" aria-label="Empty"/>
                            <span t-esc="this.emptyLabel"/>
                        </div>
                    </t>
                </div>
            </t>

            <!-- ============================ progress bars ====================== -->
            <t t-elif="this.item.kind === 'progress'">
                <div class="o_dbc_body o_dbc_list_body">
                    <t t-if="this.hasContent">
                        <t t-foreach="this.item.points" t-as="point" t-key="point_index">
                            <div t-attf-class="o_dbc_progress {{ this.isFocused(point) ? 'o_dbc_row_focused' : '' }}"
                                 role="button" t-on-click="() => this.onPointClick(point)">
                                <div class="o_dbc_progress_head">
                                    <span class="o_dbc_row_label" t-esc="point.label"/>
                                    <span class="o_dbc_row_value">
                                        <t t-esc="this.formatValue(point.value)"/>
                                        <span class="o_dbc_share" t-esc="' · ' + point.share + '%'"/>
                                    </span>
                                </div>
                                <div class="o_dbc_progress_track">
                                    <div class="o_dbc_progress_fill"
                                         t-att-style="'width: ' + this.pointWidth(point) + '; background-color: ' + this.pointColor(point_index)"/>
                                </div>
                            </div>
                        </t>
                    </t>
                    <t t-elif="!this.item.error">
                        <div class="o_dbc_empty">
                            <i class="fa fa-inbox me-2" role="img" aria-label="Empty"/>
                            <span t-esc="this.emptyLabel"/>
                        </div>
                    </t>
                </div>
            </t>

            <!-- ============================ a table ============================= -->
            <t t-elif="this.item.kind === 'table'">
                <div class="o_dbc_body o_dbc_list_body o_dbc_table_body">
                    <t t-if="this.hasContent">
                        <table class="o_dbc_table">
                            <thead>
                                <tr>
                                    <th t-esc="this.item.group_label or 'Group'"/>
                                    <th class="o_dbc_num" t-esc="this.item.aggregate === 'count' ? 'Count' : (this.item.measure_label or 'Value')"/>
                                    <th t-if="this.item.aggregate !== 'count'" class="o_dbc_num">Count</th>
                                    <th class="o_dbc_num">Share</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="this.item.points" t-as="point" t-key="point_index">
                                    <tr t-attf-class="{{ this.isFocused(point) ? 'o_dbc_row_focused' : '' }}"
                                        role="button" t-on-click="() => this.onPointClick(point)">
                                        <td t-esc="point.label"/>
                                        <td class="o_dbc_num" t-esc="this.formatValue(point.value)"/>
                                        <td t-if="this.item.aggregate !== 'count'" class="o_dbc_num" t-esc="point.count"/>
                                        <td class="o_dbc_num"><t t-esc="point.share"/>%</td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td>Total</td>
                                    <td class="o_dbc_num" t-esc="this.formatValue(this.item.value)"/>
                                    <td t-if="this.item.aggregate !== 'count'" class="o_dbc_num" t-esc="this.item.count"/>
                                    <td class="o_dbc_num">100%</td>
                                </tr>
                            </tfoot>
                        </table>
                    </t>
                    <t t-elif="!this.item.error">
                        <div class="o_dbc_empty">
                            <i class="fa fa-inbox me-2" role="img" aria-label="Empty"/>
                            <span t-esc="this.emptyLabel"/>
                        </div>
                    </t>
                </div>
            </t>

            <!-- ============================ a top list ========================== -->
            <t t-elif="this.item.kind === 'list'">
                <div class="o_dbc_body o_dbc_list_body">
                    <t t-if="this.hasContent">
                        <t t-if="this.item.columns and this.item.columns.length">
                            <table class="o_dbc_table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Record</th>
                                        <th t-if="this.item.measure" class="o_dbc_num" t-esc="this.item.measure_label or this.item.measure"/>
                                        <t t-foreach="this.item.columns" t-as="column" t-key="column.name">
                                            <th t-att-class="['integer', 'float', 'monetary'].includes(column.type) ? 'o_dbc_num' : ''" t-esc="column.label"/>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="this.item.rows" t-as="row" t-key="row.id">
                                        <tr role="button" t-on-click="() => this.onRowClick(row)"
                                            t-att-class="row.flagged ? 'o_dbc_row_flagged' : ''"
                                            t-att-style="this.rowFlagStyle(row)">
                                            <td class="o_dbc_row_rank">
                                                <span t-if="this.medal(row_index)" t-attf-class="o_dbc_medal o_dbc_medal_{{ this.medal(row_index) }}"
                                                      t-att-title="this.medal(row_index)"/>
                                                <t t-else="" t-esc="row_index + 1"/>
                                            </td>
                                            <td t-esc="row.label"/>
                                            <td t-if="this.item.measure" class="o_dbc_num o_dbc_row_value">
                                                <span t-if="this.item.show_bars" class="o_dbc_cell_bar"
                                                      t-att-style="this.cellBarStyle(row)"/>
                                                <span t-esc="this.formatValue(row.value)"/>
                                            </td>
                                            <t t-foreach="row.cells" t-as="cell" t-key="cell_index">
                                                <td t-att-class="['integer', 'float', 'monetary'].includes(this.item.columns[cell_index].type) ? 'o_dbc_num' : ''" t-esc="cell"/>
                                            </t>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <t t-foreach="this.item.rows" t-as="row" t-key="row.id">
                                <div t-attf-class="o_dbc_row {{ row.flagged ? 'o_dbc_row_flagged' : '' }}"
                                     role="button" t-on-click="() => this.onRowClick(row)"
                                     t-att-style="this.rowFlagStyle(row)">
                                    <span t-if="this.item.measure and this.item.show_bars" class="o_dbc_row_bar"
                                          t-att-style="'width: ' + this.rowWidth(row)"/>
                                    <span class="o_dbc_row_rank">
                                        <span t-if="this.medal(row_index)" t-attf-class="o_dbc_medal o_dbc_medal_{{ this.medal(row_index) }}"
                                              t-att-title="this.medal(row_index)"/>
                                        <t t-else="" t-esc="row_index + 1"/>
                                    </span>
                                    <span class="o_dbc_row_label" t-esc="row.label"/>
                                    <span t-if="this.item.measure" class="o_dbc_row_value"
                                          t-esc="this.formatValue(row.value)"/>
                                </div>
                            </t>
                        </t>
                    </t>
                    <t t-elif="!this.item.error">
                        <div class="o_dbc_empty">
                            <i class="fa fa-inbox me-2" role="img" aria-label="Empty"/>
                            <span t-esc="this.emptyLabel"/>
                        </div>
                    </t>
                </div>
                <div class="o_dbc_foot" role="button" t-on-click="this.onCardClick">
                    <span t-esc="this.formatValue(this.item.count or 0)"/> records
                    <i class="fa fa-angle-right ms-1" role="img" aria-label="Open"/>
                </div>
            </t>

            <!-- ============================ a note ============================== -->
            <t t-elif="this.item.kind === 'text'">
                <div class="o_dbc_body o_dbc_note" t-out="this.note"/>
            </t>

            <t t-if="this.item.error">
                <div class="o_dbc_empty o_dbc_empty_error">
                    <i class="fa fa-exclamation-triangle me-2" role="img" aria-label="Error"/>
                    <span t-esc="this.emptyLabel"/>
                </div>
            </t>
        </div>
    </t>

</templates>
