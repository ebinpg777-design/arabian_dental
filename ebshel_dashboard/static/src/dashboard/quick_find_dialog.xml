<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="ebshel_dashboard.QuickFindDialog">
        <Dialog title="'Quick find'" size="'md'" footer="false" contentClass="'o_dbq_dialog'">
            <div class="o_dbq">
                <div class="o_dbq_search">
                    <i class="oi" data-icon="search" role="img" aria-label="Search"/>
                    <input type="text" t-ref="this.inputRef" class="o_dbq_input"
                           placeholder="Find a dashboard, a card or an action…"
                           t-att-value="this.state.query" t-on-input="this.onInput" t-on-keydown="this.onKeydown"/>
                    <i t-if="this.state.searching" class="oi oi-spin" data-icon="progress_activity" role="img" aria-label="Searching"/>
                    <kbd>Esc</kbd>
                </div>
                <div class="o_dbq_list">
                    <t t-if="!this.hits.length">
                        <div class="o_dbq_empty" t-out="this.emptyLabel"/>
                    </t>
                    <t t-foreach="this.hits" t-as="hit" t-key="hit.key">
                        <div t-attf-class="o_dbq_hit {{ hit_index === this.state.cursor ? 'o_dbq_hit_on' : '' }}"
                             role="option" t-att-aria-selected="hit_index === this.state.cursor"
                             t-on-mouseenter="() => this.state.cursor = hit_index"
                             t-on-click="() => this.pick(hit)">
                            <t t-if="hit.type === 'board'">
                                <i class="oi o_dbq_icon" t-att-data-icon="hit.board.icon" role="img" aria-label="Dashboard"/>
                                <span class="o_dbq_name" t-out="hit.board.name"/>
                                <span class="o_dbq_kind">Dashboard</span>
                            </t>
                            <t t-elif="hit.type === 'action'">
                                <i class="oi o_dbq_icon" t-att-data-icon="hit.action.icon" role="img" aria-label="Action"/>
                                <span class="o_dbq_name" t-out="hit.action.label"/>
                                <span class="o_dbq_kind">Action</span>
                            </t>
                            <t t-else="">
                                <i class="oi o_dbq_icon" t-att-data-icon="hit.card.icon" role="img" aria-label="Card"/>
                                <span class="o_dbq_name" t-out="hit.card.name"/>
                                <span class="o_dbq_kind"><t t-out="hit.card.board_name"/> · <t t-out="hit.card.kind"/></span>
                            </t>
                        </div>
                    </t>
                </div>
                <div class="o_dbq_foot">
                    <kbd>↑</kbd><kbd>↓</kbd> move · <kbd>Enter</kbd> open
                </div>
            </div>
        </Dialog>
    </t>

</templates>
