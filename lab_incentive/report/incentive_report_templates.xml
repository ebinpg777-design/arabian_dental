<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_incentive_sheet_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Incentive Statement — <span t-field="o.name"/></h2>
                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Executive:</strong> <span t-field="o.executive_id"/><br/>
                                <strong>Period:</strong> <span t-field="o.period"
                                    t-options="{'format': 'MMMM y'}"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Status:</strong> <span t-field="o.state"/><br/>
                                <span t-if="o.paid_reference">
                                    <strong>Reference:</strong> <span t-field="o.paid_reference"/>
                                </span>
                            </div>
                        </div>
                        <!-- what was billed, one row per invoice line; no incentive per
                             row - the slabs pay on the month's total (client, 2026-10-08) -->
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Date</th><th>Invoice</th><th>Order</th><th>Product</th>
                                    <th class="text-end">Billed</th>
                                    <th class="text-end">Incentive Base</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><span t-field="line.invoice_date"/></td>
                                    <td><span t-out="line.invoice_id.name"/></td>
                                    <td><span t-field="line.sale_order_id.name"/></td>
                                    <td><span t-field="line.product_id.name"/></td>
                                    <td class="text-end"><span t-field="line.sale_amount"/></td>
                                    <td class="text-end"><span t-field="line.incentive_base"/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold">
                                    <td colspan="4">Total</td>
                                    <td class="text-end"><span t-field="o.total_sales"/></td>
                                    <td class="text-end"><span t-field="o.total_base"/></td>
                                </tr>
                            </tfoot>
                        </table>
                        <t t-set="calc" t-value="o.slab_widget_data or {}"/>
                        <div t-if="calc.get('steps')" style="page-break-inside: avoid;">
                            <h5 class="mt-3">How this was calculated</h5>
                            <p class="text-muted small" t-out="calc.get('mode_note')"/>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Slab</th><th class="text-end">Rate</th>
                                        <th class="text-end">Paid on</th><th>Working</th>
                                        <th class="text-end">Incentive</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="calc['steps']" t-as="step"
                                        t-att-class="None if step['applied'] else 'text-muted'">
                                        <td t-out="step['band']"/>
                                        <td class="text-end" t-out="step['rate']"/>
                                        <td class="text-end" t-out="step['amount']"/>
                                        <td t-out="step['working']"/>
                                        <td class="text-end" t-out="step['result']"/>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="2">Base</td>
                                        <td class="text-end" t-out="calc.get('base_text')"/>
                                        <td>Slab incentive</td>
                                        <td class="text-end" t-out="calc.get('slab_text')"/>
                                    </tr>
                                    <tr t-if="calc.get('clinics')">
                                        <td colspan="3"/>
                                        <td>New clinics: <t t-out="calc['clinics']['count']"/> × <t t-out="calc['clinics']['each']"/></td>
                                        <td class="text-end" t-out="calc['clinics']['total']"/>
                                    </tr>
                                    <tr class="fw-bold">
                                        <td colspan="3"/>
                                        <td>Incentive</td>
                                        <td class="text-end"><span t-field="o.incentive_amount"/></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        <p t-else="" class="fw-bold">Incentive: <span t-field="o.incentive_amount"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
