<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_incentive_sheet_form" model="ir.ui.view">
        <field name="name">lab.incentive.sheet.form</field>
        <field name="model">lab.incentive.sheet</field>
        <field name="arch" type="xml">
            <form string="Incentive Sheet">
                <header>
                    <!-- accounting prepares the figure as well (it runs month-end
                         from its own menu); approving stays with field work -->
                    <button name="action_compute" type="object" string="Compute"
                            class="btn-primary" invisible="state != 'draft'"
                            groups="lab_fieldwork.group_fieldwork_manager,account.group_account_manager"/>
                    <!-- after marking a clinic as a new lead, or a late invoice: read the
                         month again. An approved sheet is Reset first. -->
                    <button name="action_compute" type="object" string="Recompute"
                            invisible="state != 'computed'"
                            groups="lab_fieldwork.group_fieldwork_manager,account.group_account_manager"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'computed'"
                            groups="lab_fieldwork.group_fieldwork_manager"/>
                    <button name="action_disburse" type="object" string="Disburse"
                            class="btn-primary" invisible="state != 'approved'"
                            groups="lab_fieldwork.group_fieldwork_manager"/>
                    <button name="action_reset_to_draft" type="object" string="Reset"
                            invisible="state not in ('computed','approved')"
                            groups="lab_fieldwork.group_fieldwork_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,computed,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_receipts" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="basis != 'collected'">
                            <field name="total_collected" widget="statinfo" string="Collected"/>
                        </button>
                        <button name="action_view_new_clinics" type="object"
                                class="oe_stat_button" icon="fa-user-plus"
                                invisible="state == 'draft'">
                            <field name="new_clinic_count" widget="statinfo" string="New Clinics"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="executive_id"
                                   readonly="state != 'draft'"/>
                            <field name="period"
                                   readonly="state != 'draft'"/>
                            <field name="rule_id" readonly="1"/>
                            <field name="basis" invisible="not basis"/>
                        </group>
                        <group>
                            <field name="total_sales" readonly="1" invisible="basis == 'collected'"/>
                            <field name="total_collected" readonly="1" invisible="basis != 'collected'"
                                   string="Collected (before tax)"/>
                            <field name="total_base" readonly="1"/>
                            <field name="slab_amount" readonly="1"/>
                            <field name="new_clinic_amount" readonly="1"
                                   string="New Clinic Bonus"/>
                            <field name="incentive_amount" readonly="1"
                                   class="fw-bold"/>
                        </group>
                    </group>

                    <!-- The month's money, and every cheque's way through it: what counted,
                         what waits for the bank, what bounced (client, 2026-11-23). -->
                    <group string="Money in this month" invisible="basis != 'collected'">
                        <field name="collection_widget_data" widget="lab_collection_widget"
                               nolabel="1" colspan="2"/>
                    </group>

                    <!-- The calculation widget: WHY the amount above is what it is. -->
                    <group string="How this was calculated"
                           invisible="state == 'draft'">
                        <field name="slab_widget_data" widget="lab_slab_widget"
                               nolabel="1" colspan="2"/>
                    </group>

                    <group string="Disbursement" invisible="state not in ('approved','paid')">
                        <field name="approved_by_id" readonly="1"/>
                        <field name="approved_date" readonly="1"/>
                        <field name="paid_reference" readonly="state == 'paid'"/>
                        <field name="paid_date" readonly="1"/>
                    </group>

                    <notebook>
                        <!-- What was counted: one row per invoice line (per receipt on the
                             Collected basis). No incentive per row - the slabs pay on the
                             month's total, and a share per order read as if each order
                             earned its own (client, 2026-10-08). -->
                        <page string="What was counted" name="lines">
                            <field name="line_ids" readonly="1">
                                <list decoration-danger="sale_amount &lt; 0">
                                    <field name="invoice_date" column_invisible="parent.basis == 'collected'"/>
                                    <field name="counted_date" column_invisible="parent.basis != 'collected'"/>
                                    <field name="receipt_ref" column_invisible="parent.basis != 'collected'"/>
                                    <field name="receipt_mode" column_invisible="parent.basis != 'collected'"
                                           optional="show"/>
                                    <field name="invoice_id"/>
                                    <field name="sale_order_id" optional="show"/>
                                    <field name="product_id"/>
                                    <field name="quantity" optional="show"/>
                                    <field name="sale_amount" sum="Total"
                                           column_invisible="parent.basis == 'collected'"/>
                                    <field name="collected_amount" sum="Total"
                                           column_invisible="parent.basis != 'collected'"/>
                                    <field name="incentive_basis" optional="show"/>
                                    <field name="incentive_base" sum="Total"/>
                                    <field name="used_incentive_price" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <!-- Every receipt that touched the executive's invoices and matters
                             to this month, with the reason it counts or does not. -->
                        <page string="Receipts &amp; cheques" name="receipts"
                              invisible="basis != 'collected'">
                            <field name="collection_ids" readonly="1">
                                <list decoration-success="status == 'counted'"
                                      decoration-warning="status in ('pending', 'later')"
                                      decoration-danger="status in ('bounced', 'taken_back')">
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'counted'"
                                           decoration-warning="status in ('pending', 'later')"
                                           decoration-danger="status in ('bounced', 'taken_back')"/>
                                    <field name="counted_date"/>
                                    <field name="mode"/>
                                    <field name="receipt_ref"/>
                                    <field name="receipt_date"/>
                                    <field name="cheque_number"/>
                                    <field name="cheque_date" optional="hide"/>
                                    <field name="deposit_date" optional="show"/>
                                    <field name="clear_date"/>
                                    <field name="bounce_date" optional="show"/>
                                    <field name="invoice_ref"/>
                                    <field name="partner_id" optional="show"/>
                                    <field name="amount" sum="Total" optional="show"/>
                                    <field name="executive_amount" optional="show"/>
                                    <field name="counted_amount" sum="Total"/>
                                    <field name="note"/>
                                    <field name="cheque_id" column_invisible="1"/>
                                    <button name="action_open_cheque" type="object" icon="fa-external-link"
                                            title="Open the cheque" invisible="not cheque_id"
                                            groups="lab_finance_ops.group_lab_cheque_user"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_incentive_sheet_list" model="ir.ui.view">
        <field name="name">lab.incentive.sheet.list</field>
        <field name="model">lab.incentive.sheet</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'draft'" decoration-success="state == 'paid'">
                <field name="name"/>
                <field name="executive_id"/>
                <field name="period"/>
                <field name="basis" optional="hide"/>
                <field name="total_sales" sum="Total"/>
                <field name="collected_cheques" sum="Total" optional="hide"/>
                <field name="cheques_waiting_amount" sum="Total" optional="hide"/>
                <field name="incentive_amount" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-warning="state == 'computed'"
                       decoration-info="state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="view_incentive_sheet_search" model="ir.ui.view">
        <field name="name">lab.incentive.sheet.search</field>
        <field name="model">lab.incentive.sheet</field>
        <field name="arch" type="xml">
            <search>
                <field name="executive_id"/>
                <field name="period"/>
                <filter name="to_approve" string="Awaiting Approval"
                        domain="[('state','=','computed')]"/>
                <filter name="to_pay" string="Approved — To Pay"
                        domain="[('state','=','approved')]"/>
                <group>
                    <filter name="by_executive" string="Executive"
                            context="{'group_by':'executive_id'}"/>
                    <filter name="by_period" string="Month"
                            context="{'group_by':'period:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- The receipts of a sheet, on their own: group by status, by cheque, by clinic. -->
    <record id="view_incentive_collection_list" model="ir.ui.view">
        <field name="name">lab.incentive.collection.list</field>
        <field name="model">lab.incentive.collection</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false"
                  decoration-success="status == 'counted'"
                  decoration-warning="status in ('pending', 'later')"
                  decoration-danger="status in ('bounced', 'taken_back')">
                <field name="sheet_id" optional="hide"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'counted'"
                       decoration-warning="status in ('pending', 'later')"
                       decoration-danger="status in ('bounced', 'taken_back')"/>
                <field name="counted_date"/>
                <field name="mode"/>
                <field name="receipt_ref"/>
                <field name="receipt_date"/>
                <field name="journal_name" optional="hide"/>
                <field name="cheque_number"/>
                <field name="cheque_bank" optional="hide"/>
                <field name="cheque_date" optional="hide"/>
                <field name="deposit_date" optional="show"/>
                <field name="clear_date"/>
                <field name="bounce_date" optional="show"/>
                <field name="invoice_ref"/>
                <field name="invoice_date" optional="hide"/>
                <field name="partner_id"/>
                <field name="amount" sum="Total"/>
                <field name="executive_amount" sum="Total" optional="show"/>
                <field name="counted_amount" sum="Total"/>
                <field name="from_earlier_month" optional="hide"/>
                <field name="note"/>
                <field name="cheque_id" column_invisible="1"/>
                <button name="action_open_cheque" type="object" icon="fa-external-link"
                        title="Open the cheque" invisible="not cheque_id"
                        groups="lab_finance_ops.group_lab_cheque_user"/>
            </list>
        </field>
    </record>

    <record id="view_incentive_collection_search" model="ir.ui.view">
        <field name="name">lab.incentive.collection.search</field>
        <field name="model">lab.incentive.collection</field>
        <field name="arch" type="xml">
            <search>
                <field name="receipt_ref"/>
                <field name="cheque_number"/>
                <field name="invoice_ref"/>
                <field name="partner_id"/>
                <filter name="counted" string="Counted"
                        domain="[('status', 'in', ('counted', 'taken_back'))]"/>
                <filter name="not_counted" string="Not counted"
                        domain="[('status', 'not in', ('counted', 'taken_back'))]"/>
                <separator/>
                <filter name="cheques" string="Cheques" domain="[('mode', '=', 'cheque')]"/>
                <filter name="earlier" string="Received in an earlier month"
                        domain="[('from_earlier_month', '=', True)]"/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_mode" string="Paid By" context="{'group_by': 'mode'}"/>
                    <filter name="group_clinic" string="Clinic" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_incentive_sheet" model="ir.actions.act_window">
        <field name="name">Incentive Sheets</field>
        <field name="res_model">lab.incentive.sheet</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>
    <record id="view_incentive_sheet_kanban" model="ir.ui.view">
        <field name="name">lab.incentive.sheet.kanban</field>
        <field name="model">lab.incentive.sheet</field>
        <field name="arch" type="xml">
            <!-- Cards, because this list is read on a phone. As a list it was 614px
                 wide on a 412px screen, so an executive had to drag the table
                 sideways to see their own figure. (client, 2026-08-24) -->
            <kanban quick_create="false" create="false" class="o_fw_kanban"
                    default_order="period desc, id desc">
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start">
                            <strong class="fs-6"><field name="period"/></strong>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'paid'"
                                   decoration-warning="state == 'confirmed'"/>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="text-muted">Billed</span>
                            <span><field name="total_sales" widget="monetary"/></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Incentive</span>
                            <strong><field name="incentive_amount" widget="monetary"/></strong>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_incentive_sheet_my" model="ir.actions.act_window">
        <field name="name">My Incentive</field>
        <field name="res_model">lab.incentive.sheet</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('executive_id','=',uid)]</field>
    </record>
    <record id="action_incentive_analysis" model="ir.actions.act_window">
        <field name="name">Incentive Analysis</field>
        <field name="res_model">lab.incentive.sheet</field>
        <field name="view_mode">pivot,graph</field>
        <field name="context">{'search_default_by_executive': 1, 'search_default_by_period': 1}</field>
    </record>
</odoo>
