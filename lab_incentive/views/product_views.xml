<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_incentive" model="ir.ui.view">
        <field name="name">product.template.form.lab.incentive</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="list_price" position="after">
                <field name="incentive_price"
                       groups="lab_fieldwork.group_fieldwork_manager"
                       help="Executives earn incentive on this figure for this product, not on what the doctor is actually charged. Leave blank to use the sale price."/>
            </field>
        </field>
    </record>
</odoo>
