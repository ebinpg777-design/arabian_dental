<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_incentive" model="ir.ui.view">
        <field name="name">product.template.form.lab.incentive</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- What an executive earns incentive on for this product: the sale
                 value, a fixed incentive price, or the lab's margin on an item it
                 does not manufacture. (Ortho, 2026-10-08) -->
            <field name="list_price" position="after">
                <field name="incentive_basis"
                       groups="lab_fieldwork.group_fieldwork_manager"/>
                <field name="incentive_price"
                       invisible="incentive_basis != 'price'"
                       required="incentive_basis == 'price'"
                       groups="lab_fieldwork.group_fieldwork_manager"/>
                <field name="incentive_margin_pct"
                       invisible="incentive_basis != 'margin_pct'"
                       groups="lab_fieldwork.group_fieldwork_manager"/>
                <field name="incentive_margin_amount"
                       invisible="incentive_basis != 'margin_amount'"
                       required="incentive_basis == 'margin_amount'"
                       groups="lab_fieldwork.group_fieldwork_manager"/>
            </field>
        </field>
    </record>

    <!-- Setting the basis on many products one form at a time is not a plan. -->
    <record id="view_product_template_incentive_list" model="ir.ui.view">
        <field name="name">product.template.list.lab.incentive</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="list_price" position="after">
                <field name="incentive_basis" optional="hide"
                       groups="lab_fieldwork.group_fieldwork_manager"/>
                <field name="incentive_margin_pct" optional="hide"
                       groups="lab_fieldwork.group_fieldwork_manager"/>
                <field name="incentive_margin_amount" optional="hide"
                       groups="lab_fieldwork.group_fieldwork_manager"/>
            </field>
        </field>
    </record>

    <record id="view_product_template_incentive_search" model="ir.ui.view">
        <field name="name">product.template.search.lab.incentive</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <filter name="filter_to_sell" position="after">
                <separator/>
                <filter name="incentive_on_margin" string="Incentive on margin"
                        domain="[('incentive_basis', 'in', ['margin_pct', 'margin_amount'])]"/>
                <filter name="incentive_on_sale" string="Incentive on sale value"
                        domain="[('incentive_basis', '=', 'sale')]"/>
            </filter>
        </field>
    </record>
</odoo>
