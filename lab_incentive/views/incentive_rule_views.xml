<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_incentive_rule_form" model="ir.ui.view">
        <field name="name">lab.incentive.rule.form</field>
        <field name="model">lab.incentive.rule</field>
        <field name="arch" type="xml">
            <form string="Incentive Rule">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="slab_mode"/>
                            <!-- the fallback for products counted on a margin %
                                 that carry none of their own (Ortho, 2026-10-08) -->
                            <field name="default_margin_pct"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <!-- Opening a door is the other half of the job; the slabs only
                         reward what was sold. Zero by default. (client, 2026-08-27) -->
                    <group>
                        <field name="new_clinic_bonus"
                               help="Paid for each clinic the executive opened on their own route that month, on top of the slabs."/>
                    </group>
                    <!-- Reaching for Flat gives 5% of the whole base instead. -->
                    <div class="alert alert-info" role="alert"
                         invisible="slab_mode != 'telescopic'">
                        A threshold is just a 0% first slab: to pay 5% on everything
                        above 100,000, add a slab 0 → 100,000 at 0% and a slab
                        100,000 → blank at 5%.
                    </div>
                    <field name="slab_ids">
                        <list editable="bottom">
                            <field name="amount_from"/>
                            <field name="amount_to"/>
                            <field name="incentive_type"/>
                            <field name="value"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_incentive_rule_list" model="ir.ui.view">
        <field name="name">lab.incentive.rule.list</field>
        <field name="model">lab.incentive.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="slab_mode"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_incentive_rule" model="ir.actions.act_window">
        <field name="name">Incentive Rules</field>
        <field name="res_model">lab.incentive.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
