<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_dental_registration_ack_document">
        <t t-call="sale_custom.external_layout_lab">
            <div class="page">
                <h3>Case Registration Acknowledgement</h3>
                <div class="row mt-3">
                    <div class="col-6">
                        <strong>Doctor / Clinic:</strong>
                        <address t-field="o.partner_id"
                                 t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'/>
                    </div>
                    <div class="col-6">
                        <table class="table table-sm" style="font-size:12px">
                            <tr><td><strong>Case No.</strong></td><td><span t-field="o.name"/></td></tr>
                            <tr><td><strong>Registered On</strong></td>
                                <td><span t-field="o.date_order" t-options="{'widget': 'date'}"/></td></tr>
                            <tr t-if="o.patient"><td><strong>Patient</strong></td><td><span t-field="o.patient"/></td></tr>
                            <tr t-if="o.age"><td><strong>Age</strong></td><td><span t-field="o.age"/></td></tr>
                            <tr t-if="o.gender"><td><strong>Gender</strong></td><td><span t-field="o.gender"/></td></tr>
                        </table>
                    </div>
                </div>

                <h4 class="mt-3">Appliance Details</h4>
                <table class="table table-sm" style="font-size:12px">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Colour</th>
                            <th>U/L</th>
                            <th>Teeth</th>
                            <th class="text-end">Qty</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.order_line.filtered(lambda l: not l.display_type)" t-as="line">
                            <td><span t-field="line.product_id.display_name"/></td>
                            <td><span t-field="line.color_scheme.name"/></td>
                            <td><span t-field="line.ul"/></td>
                            <td><span t-field="line.teeth"/></td>
                            <td class="text-end"><span t-field="line.product_uom_qty"/></td>
                        </tr>
                    </tbody>
                </table>

                <div class="row mt-2">
                    <div class="col-3" t-if="o.is_screw"><span class="badge text-bg-secondary">Screw</span></div>
                    <div class="col-3" t-if="o.is_bite"><span class="badge text-bg-secondary">Bite</span></div>
                    <div class="col-3" t-if="o.is_bands"><span class="badge text-bg-secondary">Bands</span></div>
                    <div class="col-3" t-if="o.is_wires"><span class="badge text-bg-secondary">Wires</span></div>
                    <div class="col-3" t-if="o.is_teeth"><span class="badge text-bg-secondary">Teeth</span></div>
                    <div class="col-3" t-if="o.is_facebow"><span class="badge text-bg-secondary">Face Bow</span></div>
                    <div class="col-3" t-if="o.is_dd_cheque"><span class="badge text-bg-secondary">DD/Cheque</span></div>
                    <div class="col-3" t-if="o.is_others"><span class="badge text-bg-secondary">Others</span></div>
                </div>

                <div t-if="o.modification" class="mt-2">
                    <strong>Modifications:</strong> <span t-field="o.modification"/>
                </div>
                <div t-if="o.instruction" class="mt-2">
                    <strong>Special Instructions:</strong> <span t-field="o.instruction"/>
                </div>

                <p class="mt-4 text-muted">
                    This acknowledges receipt of the above case at Arabian Dental Lab. The case will be
                    processed and dispatched per the due date above; status updates will be sent on
                    WhatsApp where opted in.
                </p>
            </div>
        </t>
    </template>

    <template id="report_dental_registration_ack">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="sale_custom.report_dental_registration_ack_document"
                   t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
