<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Tax Invoice. Laid out to the approved design: navy headings on light cards, the
        line table as the centrepiece, one bold total, then how to pay and who signed.
        Tables everywhere (wkhtmltopdf's WebKit has no flexbox), sizes in the report
        stylesheet (static/src/scss/invoice_report.scss).
    -->
    <template id="report_dental_invoice_document">
        <t t-call="sale_custom.external_layout_lab"
            mo="{'widget': 'monetary', 'display_currency': cur}"
            footer_note.translate="Thank you for your business."
            footer_class="'lab-brand'"
            footer_minimal="True"
            hide_letterhead="True">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
            <t t-set="cur" t-value="o.currency_id"/>
            <t t-set="stamp" t-value="o._dental_payment_state_label()"/>
            <t t-set="stamp" t-value="stamp if stamp[1] in ('draft', 'cancel') else ('', '')"/>
            <t t-set="lines" t-value="o.invoice_line_ids.filtered(lambda l: l.display_type == 'product')"/>
            <t t-set="show_disc" t-value="any(l.discount for l in lines)"/>
            <t t-set="show_hsn" t-value="any((l.product_id.hsn_number or '') for l in lines)"/>
            <!-- The patient on every line (client, 2026-10-19: "add patient's name in the
                 item list"); a single patient is also named in the chip under Bill To.
                 Jaw and Teeth columns appear when any line carries one. -->
            <t t-set="patients" t-value="o._dental_patients()"/>
            <t t-set="show_patient" t-value="any(l.patient for l in lines)"/>
            <t t-set="show_ul" t-value="any(l.ul for l in lines)"/>
            <t t-set="show_teeth" t-value="any(l.teeth for l in lines)"/>
            <t t-set="show_tax" t-value="bool(o.amount_tax) or any(l.tax_ids for l in lines)"/>
            <t t-set="paid" t-value="o.amount_total - o.amount_residual"/>
            <!-- The report wrappers (body, #wrapwrap, main, .article) carry margins and
                 padding of their own that kept the sheet's foot a clear 7 mm above the
                 footer bar ("remove this unwanted space", client, 2026-10-19). -->
            <style>
                html, body, #wrapwrap, main, .article { margin: 0 !important; padding: 0 !important; }
            </style>
            <div class="page lab-invoice">
                <!-- The sheet: one table as tall as the page's body, the invoice proper in
                     its top row and the closing block - words, totals, bank, pay, sign,
                     terms - in a bottom row that sits at the foot of the page however
                     short the invoice is (client, 2026-10-19: "move this part to the
                     bottom of the sheet"). wkhtmltopdf gives a row's surplus height to
                     the auto row above it, which is what pushes the foot down. An invoice
                     longer than a page simply flows on, the foot after its last line.
                     353mm, not the page's 283: Odoo lets wkhtmltopdf "smart-shrink" the
                     body, so a millimetre here is about 0.77 on paper. Found by probing
                     (2026-10-19, margins 6/8, no header spacing): 354 still fits, 356 spills.
                     Re-probe if the paper format's margins or the shrinking ever change.
                     The closing bar (note, website) is the sheet's last row, so the few
                     millimetres wkhtmltopdf keeps clear above its footer fall below the
                     bar, where only the page number sits. -->
                <!-- the height can be overridden from a shell for probing: context lab_sheet_h -->
                <table class="oi-sheet" t-attf-style="height:{{o.env.context.get('lab_sheet_h', 353)}}mm;">
                    <tr><td class="oi-sheet-top">

                <!-- letterhead, in the body: the design puts it in a card at the top of
                     the page, and a body block cannot be clipped by the header band -->
                <!-- one row: the logo on the left, who and where on the right (2026-10-19 -
                     a logo row above the address pushed the pay card onto a second page) -->
                <!-- Two balanced columns (client, 2026-10-19: "remove unwanted spaces,
                     align properly"): who the lab is on the left - logo, certification
                     marks, tax ids - and how to reach it on the right, address, phones and
                     e-mails each behind its icon as on the lab's own stationery. The lines
                     come from the company's Letterhead fields, written as they should
                     print. The marks once sat above the contact lines and made the card
                     tall enough to push a five-line invoice onto a second page. -->
                <div class="oi-letterhead">
                    <table>
                        <tr>
                            <td class="oi-lhlogo">
                                <!-- the invoice logo, else the company's own: an invoice
                                     with no logo at all printed no lab name anywhere -->
                                <t t-set="head_logo" t-value="o.company_id.logo1 or o.company_id.logo"/>
                                <img t-if="head_logo" class="oi-logo" t-att-src="image_data_uri(head_logo)"/>
                                <div t-else="" class="oi-companyname" t-out="o.company_id.name"/>
                                <!-- the GSTIN large and bold, the e-mails under it (client,
                                     2026-10-19: "move email to the left block below the GST
                                     number, increase the GST number font size and make bold") -->
                                <t t-set="lh" t-value="o.company_id._lab_letterhead()"/>
                                <div t-if="o.company_id.gst_number or o.company_id.pan_number" class="oi-ids">
                                    <span t-if="o.company_id.gst_number">GSTIN <b t-field="o.company_id.gst_number"/></span>
                                    <span t-if="o.company_id.gst_number and o.company_id.pan_number"> · </span>
                                    <span t-if="o.company_id.pan_number">PAN <b t-field="o.company_id.pan_number"/></span>
                                </div>
                                <table class="oi-lhblock oi-lhleft">
                                    <tr t-foreach="[r for r in lh if r[0] == 'emails']" t-as="row">
                                        <td class="oi-lhicon"><img t-att-src="row[1]"/></td>
                                        <td class="oi-lhtext"><div t-foreach="row[2]" t-as="line" t-out="line"/></td>
                                    </tr>
                                </table>
                            </td>
                            <td class="oi-lhinfo">
                                <!-- the certification marks in the top-right corner, above the
                                     contact lines, as on the lab's stationery (client, 2026-10-19:
                                     "move the marked logo to right top") -->
                                <div t-if="o.company_id.logo2" class="oi-lhcerts">
                                    <img class="oi-cert" t-att-src="image_data_uri(o.company_id.logo2)"/>
                                </div>
                                <table class="oi-lhblock">
                                    <tr t-foreach="[r for r in lh if r[0] != 'emails']" t-as="row">
                                        <td class="oi-lhicon"><img t-att-src="row[1]"/></td>
                                        <td class="oi-lhtext"><div t-foreach="row[2]" t-as="line" t-out="line"/></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="oi-rule"/>

                <!-- ── title ─────────────────────────────────────────────── -->
                <table style="width:100%;border-collapse:collapse;margin-bottom:6px;">
                    <tr>
                        <td style="border:none;padding:0;vertical-align:bottom;">
                            <div class="oi-title">
                                <t t-if="o.move_type == 'out_invoice'">INVOICE</t>
                                <t t-elif="o.move_type == 'out_refund'">CREDIT NOTE</t>
                                <t t-elif="o.move_type == 'in_invoice'">VENDOR BILL</t>
                                <t t-elif="o.move_type == 'in_refund'">DEBIT NOTE</t>
                                <t t-else="">INVOICE</t>
                            </div>
                        </td>
                        <td style="border:none;padding:0;text-align:right;vertical-align:bottom;">
                            <div class="oi-numlabel">Invoice No.</div>
                            <div class="oi-number"><span t-field="o.name"/></div>
                            <div t-if="stamp[0]" t-attf-class="oi-stamp {{stamp[1]}}"><t t-out="stamp[0]"/></div>
                        </td>
                    </tr>
                </table>

                <!-- ── address and barcode, then the invoice meta ──────────
                     Client layout (2026-08-18): the sales code sits under the Bill To
                     address and the dates/source card runs below the block.
                     Side by side since 2026-10-19 ("remove unwanted spaces, so more
                     items can be added"): the gap that stood above the card and the
                     barcode's own row went; the barcode sits beside the card. -->
                <table class="oi-headrow">
                    <tr>
                        <td class="oi-billcell">
                            <div class="oi-billcard">
                                <div class="oi-label">Bill to</div>
                                <div class="oi-partyname" t-field="o.partner_id.name"/>
                                <div class="oi-partyline"
                                     t-field="o.partner_id"
                                     t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                                <div class="oi-partysub">
                                    <t t-set="gstin" t-value="o.partner_id.gst_number or (o.partner_id.parent_id and o.partner_id.parent_id.gst_number)"/>
                                    <span t-if="gstin">GSTIN: <t t-out="gstin"/></span>
                                    <span t-if="gstin and o.partner_id.pan_number">  ·  </span>
                                    <span t-if="o.partner_id.pan_number">PAN: <span t-field="o.partner_id.pan_number"/></span>
                                    <span t-if="(gstin or o.partner_id.pan_number) and o.partner_id.dci_number">  ·  </span>
                                    <span t-if="o.partner_id.dci_number">DCI No: <span t-field="o.partner_id.dci_number"/></span>
                                </div>

                                <!-- No sales-code / patient chip under the address any more
                                     (client, 2026-10-19): the patient is on every line of the
                                     table, and the route is nothing the clinic needs to read. -->
                            </div>
                        </td>
                        <!-- Just the barcode: no caption, no frame, no number under the
                             bars - the invoice number is printed twice on this sheet and a
                             scanner needs none of it. (client, 2026-08-28)
                             96 x 17 mm, rendered at 1800 px: a field printer with a tired
                             drum DROPS the thin bars outright - a captured failure photo
                             showed 27-47 of the 68 elements surviving on paper, which no
                             scanner can ever read back. At this width a thin element is
                             ~1.07 mm instead of 0.80, wide enough to outlive toner
                             starvation and a fit-to-page shrink. (client, 2026-08-28)
                             Keep the size; only its place changed. -->
                        <td class="oi-scancell">
                            <span t-field="o.name"
                                  t-options="{'widget': 'barcode',
                                              'symbology': 'Code128',
                                              'humanreadable': 0,
                                              'quiet': 1,
                                              'width': 1800,
                                              'height': 240,
                                              'img_style': 'width:96mm; height:17mm; display:inline-block;'}"/>
                            <!-- under the barcode: the sales route and the salesperson
                                 (client, 2026-10-19) -->
                            <t t-set="route" t-value="o.team_id if 'team_id' in o._fields else False"/>
                            <table class="oi-whosold" t-if="route or o.invoice_user_id">
                                <tr>
                                    <td t-if="route">
                                        <div class="oi-label">Sales route</div>
                                        <div class="oi-whoval" t-field="route.name"/>
                                    </td>
                                    <td t-if="o.invoice_user_id">
                                        <div class="oi-label">Salesperson</div>
                                        <div class="oi-whoval" t-field="o.invoice_user_id.name"/>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- the full width, in equal columns (2026-10-19: "fit to full page and
                     divide to 4"); a missing source or due date shares its room out -->
                <t t-set="meta_w" t-value="round(100.0 / (2 + bool(o.invoice_origin) + bool(o.invoice_date_due)), 2)"/>
                <div class="oi-metacard">
                    <table style="table-layout:fixed;">
                        <tr>
                            <td t-attf-style="width:{{meta_w}}%;">
                                <div class="oi-label">Invoice No.</div>
                                <div class="oi-metaval"><span t-field="o.name"/></div>
                            </td>
                            <td t-attf-style="width:{{meta_w}}%;" t-if="o.invoice_origin">
                                <div class="oi-label">Source</div>
                                <div class="oi-metaval oi-wrap"><span t-field="o.invoice_origin"/></div>
                            </td>
                            <td t-attf-style="width:{{meta_w}}%;">
                                <div class="oi-label">Invoice date</div>
                                <div class="oi-metaval"><span t-field="o.invoice_date"/></div>
                            </td>
                            <td t-attf-style="width:{{meta_w}}%;" t-if="o.invoice_date_due">
                                <div class="oi-label">Due date</div>
                                <div class="oi-metaval"><span t-field="o.invoice_date_due"/></div>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- ── lines ───────────────────────────────────────────────
                     The lab's own invoice, redrawn (client, 2026-10-19): each line's
                     GST in its own columns - SGST and CGST, or IGST across states -
                     and the line total with GST; the teeth as the Palmer cross the
                     lab always printed. -->
                <t t-set="gst" t-value="o._dental_gst_table() if show_tax else ([], {})"/>
                <t t-set="gst_names" t-value="gst[0]"/>
                <!-- Widths: every column but Description is held to what its figures
                     need, so the description takes the rest; at the old widths it wrapped
                     onto three lines and a five-line invoice ran onto a second page. -->
                <table class="oi-lines oi-gst">
                    <thead>
                        <tr>
                            <th class="mid" style="width:3%">#</th>
                            <th>Description</th>
                            <th t-if="show_hsn" class="mid" style="width:8%">HSN</th>
                            <th t-if="show_patient" style="width:10%">Patient</th>
                            <th t-if="show_ul" class="mid" style="width:4%">Jaw</th>
                            <th t-if="show_teeth" class="mid" style="width:8%">Teeth</th>
                            <th class="num" style="width:5%">Qty</th>
                            <th class="num" style="width:8%">Rate</th>
                            <th t-if="show_disc" class="num" style="width:6%">Disc %</th>
                            <th class="num" style="width:9%"><t t-if="gst_names">Taxable</t><t t-else="">Amount</t></th>
                            <th t-foreach="gst_names" t-as="g" class="num" style="width:7%"><t t-out="g"/></th>
                            <th t-if="gst_names" class="num" style="width:10%">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="lines" t-as="l">
                            <t t-set="cells" t-value="gst[1].get(l.id, {})"/>
                            <td class="mid oi-slno"><t t-out="l_index + 1"/></td>
                            <td><span t-field="l.name"/></td>
                            <td t-if="show_hsn" class="mid oi-hsn"><span t-field="l.product_id.hsn_number"/></td>
                            <td t-if="show_patient"><span t-field="l.patient"/></td>
                            <td t-if="show_ul" class="mid"><span t-field="l.ul"/></td>
                            <td t-if="show_teeth" class="mid oi-teethcell">
                                <t t-set="cross" t-value="l._dental_palmer() if l.teeth else None"/>
                                <table t-if="cross" class="oi-palmer">
                                    <tr>
                                        <td class="q ur"><t t-out="cross['ur']"/></td>
                                        <td class="q ul"><t t-out="cross['ul']"/></td>
                                    </tr>
                                    <tr>
                                        <td class="q lr"><t t-out="cross['lr']"/></td>
                                        <td class="q ll"><t t-out="cross['ll']"/></td>
                                    </tr>
                                </table>
                                <div t-if="cross and cross['rest']" class="oi-teethrest" t-out="cross['rest']"/>
                                <span t-if="l.teeth and not cross" t-field="l.teeth"/>
                            </td>
                            <td class="num">
                                <span t-field="l.quantity"/>
                                <span t-field="l.product_uom_id" groups="uom.group_uom"/>
                            </td>
                            <td class="num"><span t-out="o._dental_money(l.price_unit)"/></td>
                            <td t-if="show_disc" class="num"><span t-if="l.discount" t-out="l.discount"/></td>
                            <td class="num"><span t-out="o._dental_money(l.price_subtotal)"/></td>
                            <td t-foreach="gst_names" t-as="g" class="num">
                                <t t-if="g in cells">
                                    <span t-out="o._dental_money(cells[g][1])"/>
                                    <div class="oi-rate"><t t-out="('%.2f' % cells[g][0]).rstrip('0').rstrip('.')"/>%</div>
                                </t>
                            </td>
                            <td t-if="gst_names" class="num oi-linetotal"><span t-out="o._dental_money(l.price_total)"/></td>
                        </tr>
                    </tbody>
                    <!-- every column summed (client, 2026-10-19: "add total in each
                         column of item") -->
                    <t t-set="tot" t-value="o._dental_column_totals()"/>
                    <tfoot>
                        <tr class="oi-sum">
                            <td/>
                            <td>Total</td>
                            <td t-if="show_hsn"/>
                            <td t-if="show_patient"/>
                            <td t-if="show_ul"/>
                            <td t-if="show_teeth"/>
                            <td class="num"><t t-out="tot['qty_text']"/></td>
                            <td/>
                            <td t-if="show_disc"/>
                            <td class="num"><span t-out="o._dental_money(tot['taxable'])"/></td>
                            <td t-foreach="gst_names" t-as="g" class="num"><span t-out="o._dental_money(tot['gst'].get(g, 0.0))"/></td>
                            <td t-if="gst_names" class="num oi-linetotal"><span t-out="o._dental_money(tot['total'])"/></td>
                        </tr>
                    </tfoot>
                </table>

                    </td></tr>
                    <tr><td class="oi-sheet-foot">

                <!-- ── words + totals ──────────────────────────────────────
                     The sums the lab's invoice always ended with: the taxable value,
                     each GST, the round-off, the bill amount; then the clinic's old
                     balance and the total balance with this bill. -->
                <t t-set="balances" t-value="o._dental_balances()"/>
                <table style="width:100%;border-collapse:collapse;margin-top:6px;page-break-inside:avoid;">
                    <tr>
                        <td style="width:52%;border:none;padding:0 22px 0 0;vertical-align:top;">
                            <div class="oi-label">Amount in words</div>
                            <!-- every word capitalised, as the lab's own invoices wrote it
                                 ("One Thousand, Three Hundred Rupees") - client, 2026-10-19 -->
                            <div class="oi-words"><t t-out="o._dental_words(o.amount_total)"/></div>
                            <div class="oi-declare" t-if="o.comment and o.move_type in ('out_invoice', 'out_refund')">
                                <div class="oi-label">GST declaration</div>
                                <div t-out="' '.join(o.comment.split())"/>
                            </div>
                        </td>
                        <td style="border:none;padding:0;vertical-align:top;">
                            <!-- no taxable value or GST rows here: the line table carries
                                 them in its columns ("no need this, total bill amount is
                                 enough" - client, 2026-10-19) -->
                            <table class="oi-totals">
                                <tr class="tax">
                                    <td class="k">Round off</td>
                                    <td class="v"><span t-out="o._dental_money(o._dental_round_off())"/></td>
                                </tr>
                                <tr class="total">
                                    <td>Bill amount</td>
                                    <td class="v"><span t-out="o._dental_money(o.amount_total)"/></td>
                                </tr>
                                <t t-if="balances">
                                    <tr class="old">
                                        <td class="k">Old balance</td>
                                        <td class="v"><span t-out="o._dental_money(balances[0])"/></td>
                                    </tr>
                                    <tr class="balance">
                                        <td>Total balance</td>
                                        <td class="v"><span t-out="o._dental_money(balances[1])"/></td>
                                    </tr>
                                </t>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- ── bank details ──────────────────────────────────────── -->
                <!-- Odoo 20 removed res.bank: the bank's name, branch city and IFSC
                     (bank_bic) now live on the account itself; acc_number is account_number. -->
                <!-- heading and table on the same page: a long invoice left the heading
                     alone at the foot of page one and the accounts on page two -->
                <div t-if="o.company_id.partner_id.bank_ids" style="page-break-inside:avoid;">
                    <div class="oi-section">Bank Details</div>
                    <table class="oi-bank">
                        <tr t-foreach="o.company_id.partner_id.bank_ids" t-as="b">
                            <td style="width:25%;">
                                <div class="oi-label">Bank name</div>
                                <div class="oi-bankval"><span t-field="b.bank_name"/></div>
                            </td>
                            <td style="width:28%;">
                                <div class="oi-label">Account number</div>
                                <div class="oi-bankval"><span t-field="b.account_number"/></div>
                            </td>
                            <td style="width:24%;">
                                <div class="oi-label">Branch</div>
                                <div class="oi-bankval"><span t-field="b.city"/></div>
                            </td>
                            <td>
                                <div class="oi-label">IFSC code</div>
                                <div class="oi-bankval"><span t-field="b.bank_bic"/></div>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- ── pay / sign ────────────────────────────────────────── -->
                <table style="width:100%;border-collapse:collapse;margin-top:6px;page-break-inside:avoid;">
                    <tr>
                        <td style="width:44%;border:none;padding:0;vertical-align:top;">
                            <div class="oi-paycard" t-if="o.company_id.payment_qr">
                                <table style="width:100%;border-collapse:collapse;">
                                    <tr>
                                        <td class="oi-qr" style="border:none;padding:0;width:40mm;">
                                            <img t-att-src="image_data_uri(o.company_id.payment_qr)"/>
                                        </td>
                                        <td style="border:none;padding:0 0 0 10px;vertical-align:middle;">
                                            <div class="oi-qrtitle">SCAN TO PAY</div>
                                            <div class="oi-qrnote">Quick payment<br/>using the QR code.</div>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </td>
                        <td style="border:none;padding:0 0 0 10px;vertical-align:bottom;">
                            <div class="oi-sign">
                                <div class="oi-label">Authorised signatory</div>
                                <img t-if="o.invoice_signature" t-att-src="image_data_uri(o.invoice_signature)"/>
                                <img t-if="not o.invoice_signature and o.company_id.invoice_signature"
                                     t-att-src="image_data_uri(o.company_id.invoice_signature)"/>
                                <div class="oi-signfor">For <span t-field="o.company_id.name"/></div>
                            </div>
                        </td>
                    </tr>
                </table>

                <div class="oi-terms" t-if="o.invoice_payment_term_id.note or o.fiscal_position_id.note or o.narration">
                    <span t-if="o.invoice_payment_term_id.note" t-field="o.invoice_payment_term_id.note"/>
                    <span t-if="o.fiscal_position_id.note" t-field="o.fiscal_position_id.note"/>
                    <span t-if="o.narration" t-field="o.narration"/>
                </div>

                <!-- the closing bar: a red rule, the note and the website (client,
                     2026-10-19: no phone or e-mail at the bottom, the website instead) -->
                <div class="oi-foot">
                    <table>
                        <tr>
                            <td class="oi-footnote">Thank you for your business.</td>
                            <td class="oi-footsite"><t t-out="(o.company_id.website or '').replace('https://', '').replace('http://', '').rstrip('/')"/></td>
                        </tr>
                    </table>
                </div>

                    </td></tr>
                </table>
            </div>
        </t>
    </template>

    <template id="report_dental_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="sale_custom.report_dental_invoice_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <!-- Standard invoice print (Invoice PDF / Send &amp; Print / portal) uses this layout. -->
    <template id="report_invoice_dental_dispatch" inherit_id="account.report_invoice">
        <xpath expr="//t[@t-call='account.report_invoice_document']" position="after">
            <t t-elif="o._get_name_invoice_report() == 'sale_custom.report_dental_invoice_document'"
               t-call="sale_custom.report_dental_invoice_document" t-lang="lang"/>
        </xpath>
    </template>
</odoo>
