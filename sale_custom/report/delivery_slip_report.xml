<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_dental_delivery_slip_document">
        <t t-call="sale_custom.external_layout_lab">
            <div class="page">
                <h3>Delivery Slip <span t-field="o.name"/></h3>
                <div class="row mt-3">
                    <div class="col-6">
                        <strong>Deliver To:</strong>
                        <address t-field="o.partner_id"
                                 t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'/>
                    </div>
                    <div class="col-6">
                        <table class="table table-sm" style="font-size:12px">
                            <tr>
                                <td><strong>Date</strong></td>
                                <td><span t-field="o.date_done"
                                          t-options="{'widget': 'date'}"
                                          t-if="o.date_done"/>
                                    <span t-else="" t-field="o.scheduled_date" t-options="{'widget': 'date'}"/>
                                </td>
                            </tr>
                            <tr t-if="o.origin">
                                <td><strong>Reference</strong></td>
                                <td><span t-field="o.origin"/></td>
                            </tr>
                            <tr t-if="o.courier_company">
                                <td><strong>Courier</strong></td>
                                <td><span t-field="o.courier_company"/></td>
                            </tr>
                            <tr t-if="o.courier_option">
                                <td><strong>Service</strong></td>
                                <td><span t-field="o.courier_option"/></td>
                            </tr>
                            <tr t-if="o.consignment_number">
                                <td><strong>Consignment No.</strong></td>
                                <td><span t-field="o.consignment_number"/></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <table class="table table-sm mt-3" style="font-size:12px">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Quantity</th>
                            <th>Unit</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.move_ids.filtered(lambda m: m.state != 'cancel')" t-as="move">
                            <td><span t-field="move.product_id.display_name"/></td>
                            <td class="text-end"><span t-field="move.quantity"/></td>
                            <td><span t-field="move.product_uom.name"/></td>
                        </tr>
                    </tbody>
                </table>

                <div class="row mt-5">
                    <div class="col-6">
                        <strong>Dispatched By:</strong>
                        <div style="margin-top:40px; border-top:1px solid #000; width:200px;"/>
                    </div>
                    <div class="col-6">
                        <strong>Received By (Signature):</strong>
                        <div style="margin-top:40px; border-top:1px solid #000; width:200px;"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_dental_delivery_slip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="sale_custom.report_dental_delivery_slip_document"
                   t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
