<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- (Ortho client, 2026-10-15: "a button to change partner in confirmed sale orders
         without changing the SO status") -->
    <record id="view_sale_order_change_customer_form" model="ir.ui.view">
        <field name="name">sale.order.change.customer.form</field>
        <field name="model">sale.order.change.customer</field>
        <field name="arch" type="xml">
            <form string="Change Customer">
                <field name="order_id" invisible="1"/>
                <div class="alert alert-info mb-3" role="status">
                    The order stays confirmed: its manufacturing and deliveries carry on. Its lines and prices
                    are not changed.
                </div>
                <group>
                    <group>
                        <field name="current_partner_id"/>
                        <field name="partner_id" options="{'no_create': True}"/>
                        <field name="partner_invoice_id" options="{'no_create': True}"
                               domain="['|', ('id', '=', partner_id), ('commercial_partner_id', '=', partner_id)]"/>
                        <field name="partner_shipping_id" options="{'no_create': True}"
                               domain="['|', ('id', '=', partner_id), ('commercial_partner_id', '=', partner_id)]"/>
                    </group>
                    <group>
                        <field name="new_route_id" invisible="not partner_id"/>
                        <field name="move_route" invisible="not new_route_id"/>
                        <field name="reason" placeholder="e.g. booked against the wrong clinic"/>
                    </group>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Change Customer" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_order_form_change_customer" model="ir.ui.view">
        <field name="name">sale.order.form.change.customer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_change_customer" type="object" string="Change Customer"
                        icon="fa-exchange" invisible="state != 'sale'"
                        groups="sales_team.group_sale_salesman"/>
            </xpath>
        </field>
    </record>
</odoo>
