<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dispatch_register_form" model="ir.ui.view">
        <field name="name">dental.dispatch.register.form</field>
        <field name="model">dental.dispatch.register</field>
        <field name="arch" type="xml">
            <form string="Dispatch Register">
                <group>
                    <group>
                        <field name="team_ids" widget="many2many_tags"
                               placeholder="Every route, one page each"
                               options="{'no_create': True}"/>
                        <label for="date"/>
                        <div class="o_row">
                            <field name="date"/>
                            <span class="text-muted">to</span>
                            <field name="date_to" placeholder="same day"/>
                        </div>
                    </group>
                    <group>
                        <field name="include_draft"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <div class="alert alert-info mb-0" role="status" invisible="not summary">
                    <i class="fa fa-truck me-2" title="Dispatch"/><field name="summary" nolabel="1" class="d-inline"/>
                </div>
                <footer>
                    <button name="action_print" string="Print Register" type="object"
                            class="btn-primary" data-hotkey="q" icon="fa-print"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dispatch_register" model="ir.actions.act_window">
        <field name="name">Dispatch Register</field>
        <field name="res_model">dental.dispatch.register</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- where the two teams that print it live: Sales, and Accounting > Customers -->
    <menuitem id="menu_dispatch_register_sale"
              name="Dispatch Register"
              parent="sale.sale_menu_root"
              action="action_dispatch_register"
              sequence="18"
              groups="sales_team.group_sale_salesman"/>
    <menuitem id="menu_dispatch_register_account"
              name="Dispatch Register"
              parent="account.menu_finance_receivables"
              action="action_dispatch_register"
              sequence="60"/>
</odoo>
