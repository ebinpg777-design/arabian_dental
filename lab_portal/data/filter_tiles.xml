<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Digital Rx (portal case request) tiles (dynamic_filter_tiles; replaces the former list_view_dashboard block). -->
    <data noupdate="1">
        <record id="tile_case_request_new" model="filter.tile">
            <field name="name">New — to review</field>
            <field name="sequence">10</field>
            <field name="row">1</field>
            <field name="model_id" ref="lab_portal.model_lab_case_request"/>
            <field name="domain">[('state','=','new')]</field>
            <field name="color">amber</field>
            <field name="icon">fa-inbox</field>
        </record>

        <record id="tile_case_request_reviewed" model="filter.tile">
            <field name="name">Reviewed</field>
            <field name="sequence">20</field>
            <field name="row">1</field>
            <field name="model_id" ref="lab_portal.model_lab_case_request"/>
            <field name="domain">[('state','=','reviewed')]</field>
            <field name="color">teal</field>
            <field name="icon">fa-eye</field>
        </record>

        <record id="tile_case_request_converted" model="filter.tile">
            <field name="name">Converted</field>
            <field name="sequence">30</field>
            <field name="row">1</field>
            <field name="model_id" ref="lab_portal.model_lab_case_request"/>
            <field name="domain">[('state','=','converted')]</field>
            <field name="color">emerald</field>
            <field name="icon">fa-check-circle</field>
        </record>
        <record id="row_case_request_1" model="filter.tile.row">
            <field name="model_id" ref="lab_portal.model_lab_case_request"/><field name="number">1</field><field name="name">Digital Rx</field>
        </record>
    </data>
</odoo>
