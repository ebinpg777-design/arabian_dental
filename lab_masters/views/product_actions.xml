<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        For a product added later: select it in the product list, Actions, "Make in
        production (BoM by category)". The same rule the upgrade applied to every
        product (models/category_boms.py). A product that has a bill of materials
        already, or whose category is not a production one, is left as it is.
    -->
    <record id="action_make_category_boms" model="ir.actions.server">
        <field name="name">Make in production (BoM by category)</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('mrp.group_mrp_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = env['lab.masters.loader'].action_make_category_boms(records.ids)</field>
    </record>
</odoo>
