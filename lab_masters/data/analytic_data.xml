            <value eval="{'cost_centre_id': ref('lab_masters.cc_store')}"/>
        </function>
        <function model="hr.department" name="write">
            <value eval="[ref('lab_masters.dept_purchase')]"/>
            <value eval="{'cost_centre_id': ref('lab_masters.cc_purchase')}"/>
        </function>
        <function model="hr.department" name="write">
            <value eval="[ref('lab_masters.dept_packing')]"/>
            <value eval="{'cost_centre_id': ref('lab_masters.cc_packing')}"/>
        </function>
        <function model="hr.department" name="write">
            <value eval="[ref('lab_masters.dept_logistics')]"/>
            <value eval="{'cost_centre_id': ref('lab_masters.cc_logistics')}"/>
        </function>
        <function model="hr.department" name="write">
            <value eval="[ref('lab_masters.dept_admin')]"/>
            <value eval="{'cost_centre_id': ref('lab_masters.cc_admin')}"/>
        </function>
        <function model="hr.department" name="write">
            <value eval="[ref('lab_masters.dept_accounts')]"/>
            <value eval="{'cost_centre_id': ref('lab_masters.cc_accounts')}"/>
        </function>
        <function model="hr.department" name="write">
            <value eval="[ref('lab_masters.dept_hr')]"/>
            <value eval="{'cost_centre_id': ref('lab_masters.cc_hr')}"/>
        </function>
        <function model="hr.department" name="write">
            <value eval="[ref('lab_masters.dept_it')]"/>
            <value eval="{'cost_centre_id': ref('lab_masters.cc_it')}"/>
        </function>

    </data>
</odoo>
