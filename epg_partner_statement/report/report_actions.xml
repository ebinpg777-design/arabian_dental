<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The letterhead is drawn in the body, once, on page 1: the page itself needs no
         header band, only room for the footer bar. -->
    <record id="paperformat_statement" model="report.paperformat">
        <field name="name">Statement A4 (letterhead in body)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">14</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">3</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_partner_statement" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_statement"/>
        <field name="name">Statement of Account</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">epg_partner_statement.report_statement</field>
        <field name="print_report_name">'Statement - %s' % (object.name or '')</field>
        <!-- No binding: the wizard (Action menu / smart button) is the entry point, so the
             period and options are always chosen explicitly. -->
    </record>

    <!-- Item-wise: the same statement with each invoice's items under it - the lab's
         Odoo 17 "Itemwise Account Statement Report" (client, 2026-10-21). Its three
         extra columns need the width of a landscape page, as the old report had. -->
    <record id="paperformat_statement_landscape" model="report.paperformat">
        <field name="name">Statement A4 landscape (item-wise)</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">14</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">3</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_partner_statement_itemwise" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_statement_landscape"/>
        <field name="name">Item-wise Statement of Account</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">epg_partner_statement.report_statement_itemwise</field>
        <field name="print_report_name">'Item-wise Statement - %s' % (object.name or '')</field>
    </record>
</odoo>
