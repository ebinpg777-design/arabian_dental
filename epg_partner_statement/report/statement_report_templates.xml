<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="st" t-value="statements.get(o.id)"/>
                <t t-set="blocks" t-value="st and st['blocks'] or []"/>
                <t t-set="open_mode" t-value="options['open_items_only']"/>
                <!-- item-wise: each invoice's items under its row (client, 2026-10-21) -->
                <t t-set="itemwise" t-value="options.get('itemwise')"/>
                <!-- patient-wise: the works under each patient (client, 2026-10-21) -->
                <t t-set="patientwise" t-value="options.get('patientwise')"/>
                <t t-set="one_patient" t-value="options.get('patient')"/>
                <t t-call="{{layout}}" hide_letterhead="True">
                    <!-- The letterhead is drawn here, not in the page header band: it is
                         too tall for the band and used to overlap the first lines of the
                         statement (2026-08-18). -->
                    <div class="page epg-statement">
                        <!-- ONE compact band for the letterhead, drawn in the body. The page
                             used to carry Odoo's standard header (with the country) AND the
                             lab letterhead under it, whose GSTIN line printed over the
                             address; the two with a 52 mm top margin put the first line of
                             the ledger 42% of the way down page 1. (client, 2026-09-30) -->
                        <t t-set="lh_logo" t-value="company.logo1 if 'logo1' in company._fields and company.logo1 else company.logo"/>
                        <t t-set="lh_cert" t-value="company.logo2 if 'logo2' in company._fields else False"/>
                        <table class="epg-lh">
                            <tr>
                                <td class="epg-lh-logo"><img t-if="lh_logo" t-att-src="image_data_uri(lh_logo)"/></td>
                                <td class="epg-lh-addr">
                                    <div t-out="', '.join(x.strip(' ,') for x in [company.street or '', company.street2 or ''] if x.strip(' ,'))"/>
                                    <div>
                                        <t t-out="', '.join(x for x in [company.city or '', company.state_id.name or ''] if x)"/><t t-if="company.zip"> - <t t-out="company.zip"/></t>
                                    </div>
                                    <div class="epg-lh-ids">
                                        <t t-if="'pan_number' in company._fields and company.pan_number">PAN <b t-out="company.pan_number"/></t>
                                        <t t-if="'gst_number' in company._fields and company.gst_number">  GSTIN <b t-out="company.gst_number"/></t>
                                        <t t-if="not ('gst_number' in company._fields and company.gst_number) and company.vat">  GSTIN <b t-out="company.vat"/></t>
                                    </div>
                                </td>
                                <td class="epg-lh-cert"><img t-if="lh_cert" t-att-src="image_data_uri(lh_cert)"/></td>
                            </tr>
                        </table>
                        <!-- what this is on the left, who it is for on the right, both condensed -->
                        <table class="epg-head">
                            <tr>
                                <td class="epg-head-l">
                                    <h2 class="epg-title">
                                        <t t-if="patientwise">Patient-wise </t>
                                        <t t-if="itemwise">Item-wise </t>
                                        <t t-if="open_mode">Open Items Statement</t>
                                        <t t-else="">Statement of Account</t>
                                    </h2>
                                    <div class="epg-headmeta">
                                        <b t-out="statement_type_label"/>
                                        <div><span t-out="date_from" t-options="{'widget': 'date'}"/> → <span t-out="date_to" t-options="{'widget': 'date'}"/></div>
                                        <div t-if="one_patient">Patient <b t-out="one_patient"/></div>
                                        <div class="epg-printed">Printed <span t-out="printed_on" t-options="{'widget': 'date'}"/><t t-if="o.ref"> · Ref <span t-field="o.ref"/></t></div>
                                    </div>
                                </td>
                                <td class="epg-head-r">
                                    <div class="epg-partner">
                                        <div class="epg-to">Statement for</div>
                                        <div class="epg-partner-name" t-field="o.name"/>
                                        <div t-if="st and st['address']" t-out="', '.join(st['address'])"/>
                                        <div t-if="o.phone or o.email">
                                            <t t-if="o.phone">Ph: <span t-field="o.phone"/></t><t t-if="o.phone and o.email"> · </t><t t-if="o.email" t-out="o.email"/>
                                        </div>
                                        <div class="epg-ident" t-if="st and st['identifiers']" t-out="' · '.join('%s: %s' % (i[0], i[1]) for i in st['identifiers'])"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <t t-if="not blocks or not st['has_data']">
                            <p class="epg-empty">No entries for this period.</p>
                        </t>

                        <t t-foreach="blocks if (st and st['has_data']) else []" t-as="block">
                            <t t-set="cur" t-value="block['currency']"/>
                            <t t-set="mo" t-value="{'widget': 'monetary', 'display_currency': cur}"/>
                            <h5 t-if="len(blocks) > 1" class="mt-2">Currency: <span t-out="cur.name"/></h5>

                            <!-- summary strip - not on one patient's statement: the clinic's
                                 balance and payments are not that patient's -->
                            <table class="epg-summary" t-if="not one_patient">
                                <tr>
                                <t t-if="not open_mode">
                                    <td class="epg-card"><div class="epg-card-label">Opening balance</div><div class="epg-card-value" t-out="block['opening']" t-options="mo"/></td>
                                    <td class="epg-card"><div class="epg-card-label" t-out="labels['debit_total']"/><div class="epg-card-value" t-out="block['total_debit']" t-options="mo"/></td>
                                    <td class="epg-card"><div class="epg-card-label" t-out="labels['credit_total']"/><div class="epg-card-value" t-out="block['total_credit']" t-options="mo"/></td>
                                    <td class="epg-card epg-card-due"><div class="epg-card-label"><span t-out="labels['due']"/> on <span t-out="date_to" t-options="{'widget': 'date'}"/></div><div class="epg-card-value" t-out="block['closing']" t-options="mo"/></td>
                                </t>
                                <t t-else="">
                                    <td class="epg-card"><div class="epg-card-label">Open documents</div><div class="epg-card-value" t-out="block['open_count']"/></td>
                                    <td t-attf-class="epg-card #{'epg-card-danger' if block['overdue_amount'] else ''}"><div class="epg-card-label">Overdue</div><div class="epg-card-value" t-out="block['overdue_amount']" t-options="mo"/></td>
                                    <td class="epg-card" t-if="block['credits_open']"><div class="epg-card-label">Unallocated credits</div><div class="epg-card-value" t-out="block['credits_open']" t-options="mo"/></td>
                                    <td class="epg-card epg-card-due"><div class="epg-card-label">Total <span t-out="labels['due']"/></div><div class="epg-card-value" t-out="block['ageing_total']" t-options="mo"/></td>
                                </t>
                                </tr>
                            </table>

                            <t t-if="patientwise">
                                <t t-call="epg_partner_statement.statement_patients"/>
                            </t>
                            <t t-else="">
                            <!-- ledger -->
                            <!-- item-wise adds Patient (when the items name one), Qty, Rate and
                                 Amount; pcol / icols say how many cells that is, for the spans -->
                            <t t-set="pcol" t-value="itemwise and block.get('item_patients')"/>
                            <t t-set="icols" t-value="(4 if pcol else 3) if itemwise else 0"/>
                            <table t-attf-class="epg-ledger #{'epg-itemwise' if itemwise else ''}">
                                <thead t-if="itemwise">
                                    <tr>
                                        <th style="width:7%">Date</th>
                                        <th style="width:11.5%">Document</th>
                                        <th t-attf-style="width:#{18 if pcol else 28}%">Description</th>
                                        <th t-if="pcol" style="width:10%">Patient</th>
                                        <th style="width:8.5%">Due</th>
                                        <th class="num" style="width:4.5%">Qty</th>
                                        <th class="num" style="width:7.5%">Rate</th>
                                        <th class="num" style="width:8%">Amount</th>
                                        <th class="num" style="width:8.5%" t-out="labels['debit']"/>
                                        <th class="num" style="width:8.5%" t-out="labels['credit']"/>
                                        <th class="num" style="width:8%"><t t-if="open_mode"><span t-out="labels['open']"/></t><t t-else="">Balance</t></th>
                                    </tr>
                                </thead>
                                <thead t-else="">
                                    <tr>
                                        <!--
                                            Widths rebalanced for what the columns
                                            actually hold. Document was 16% for an
                                            eight-character invoice number while
                                            Description — now carrying the item names
                                            and the patients — had 22% and wrapped every
                                            other row. The five percent comes off
                                            Document and Type, which had it spare; the
                                            money columns are untouched because they are
                                            nowrap and already fit their longest figure.
                                            (client, 2026-08-27)
                                        -->
                                        <!-- Type now rides under the document number: a column of
                                             its own for one word was what squeezed "B2C/2026-27/15140"
                                             into the Type column and broke every date over two lines.
                                             (client, 2026-09-30) -->
                                        <th style="width:11%">Date</th>
                                        <th style="width:18%">Document</th>
                                        <th style="width:25%">Description</th>
                                        <th style="width:12%">Due</th>
                                        <th class="num" style="width:11%" t-out="labels['debit']"/>
                                        <th class="num" style="width:12%" t-out="labels['credit']"/>
                                        <th class="num" style="width:11%"><t t-if="open_mode"><span t-out="labels['open']"/></t><t t-else="">Balance</t></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-if="not open_mode" class="epg-row-open">
                                        <td><span t-out="date_from" t-options="{'widget': 'date'}"/></td>
                                        <td t-att-colspan="3 + icols">Opening balance</td>
                                        <td class="num"/><td class="num"/>
                                        <td class="num"><span t-out="block['opening']" t-options="mo"/></td>
                                    </tr>
                                    <tr t-if="not block['lines'] and not open_mode">
                                        <td t-att-colspan="7 + icols" class="epg-sub text-center">No transactions in this period.</td>
                                    </tr>
                                    <t t-foreach="block['lines']" t-as="l">
                                    <tr t-att-class="'epg-row-doc' if itemwise else None">
                                        <td><span t-out="l['doc_date']" t-options="{'widget': 'date'}"/></td>
                                        <td class="epg-doc">
                                            <span t-out="l['move']"/>
                                            <!-- The clinic's own number is what the cell
                                                 shows; the journal entry it was booked on
                                                 is only of interest to the lab. -->
                                            <div t-if="l.get('old_number')" class="epg-sub" t-out="l['entry']"/>
                                            <div><span t-attf-class="epg-kind #{'epg-kind-inv' if l['kind'] == 'Invoice' else 'epg-kind-pay' if l['kind'] in ('Payment', 'Bank') else 'epg-kind-cn' if l['kind'] == 'Credit Note' else ''}" t-out="l['kind']"/></div>
                                        </td>
                                        <td>
                                            <span t-out="l['name']"/>
                                            <div t-if="l['patient']" class="epg-sub">Patients: <span t-out="l['patient']"/></div>
                                        </td>
                                        <td t-if="pcol"/>
                                        <td class="epg-due">
                                            <span t-out="l['due']" t-options="{'widget': 'date'}"/>
                                            <span t-if="l['days_overdue']" class="epg-overdue"><span t-out="l['days_overdue']"/>d</span>
                                        </td>
                                        <t t-if="itemwise"><td class="num"/><td class="num"/><td class="num"/></t>
                                        <td class="num"><span t-if="l['debit']" t-out="l['debit']" t-options="mo"/></td>
                                        <td class="num"><span t-if="l['credit']" t-out="l['credit']" t-options="mo"/></td>
                                        <td class="num"><span t-out="l['residual'] if open_mode else l['balance']" t-options="mo"/></td>
                                    </tr>
                                    <!-- what the invoice billed: rate as invoiced, amount with tax,
                                         so the items add up to the row above -->
                                    <t t-if="itemwise">
                                        <tr t-foreach="l.get('items') or []" t-as="it" class="epg-row-item">
                                            <td/><td/>
                                            <td class="epg-item" t-out="it['name']"/>
                                            <td t-if="pcol" t-out="it['patient']"/>
                                            <td/>
                                            <td class="num" t-out="int(it['quantity']) if it['quantity'] == int(it['quantity']) else it['quantity']"/>
                                            <td class="num"><span t-out="it['price_unit']" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                            <td class="num"><span t-out="it['amount']" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                            <td/><td/><td/>
                                        </tr>
                                    </t>
                                    </t>
                                    <tr class="epg-row-total">
                                        <td><span t-out="date_to" t-options="{'widget': 'date'}"/></td>
                                        <td t-att-colspan="3 + (1 if pcol else 0)"><t t-if="open_mode">Total <span t-out="labels['due']"/></t><t t-else="">Closing balance — <span t-out="labels['due']"/></t></td>
                                        <t t-if="itemwise">
                                            <t t-set="tq" t-value="block.get('total_qty', 0.0)"/>
                                            <td class="num" t-out="int(tq) if tq == int(tq) else tq"/><td class="num"/><td class="num"/>
                                        </t>
                                        <td class="num"><span t-out="block['total_debit']" t-options="mo"/></td>
                                        <td class="num"><span t-out="block['total_credit']" t-options="mo"/></td>
                                        <td class="num"><span t-out="block['ageing_total'] if open_mode else block['closing']" t-options="mo"/></td>
                                    </tr>
                                </tbody>
                            </table>
                            </t>

                            <!-- ageing -->
                            <t t-if="options.get('show_ageing') and (block['ageing_gross'] or block['credits_open'])">
                                <div class="epg-ageing-title">Ageing of open items by due date — as of <span t-out="date_to" t-options="{'widget': 'date'}"/></div>
                                <div class="epg-ageing">
                                    <t t-foreach="block['ageing_rows']" t-as="a">
                                        <div t-attf-class="epg-bucket #{'epg-bucket-hot' if a[2] and a[1] else ''}">
                                            <div class="epg-bucket-label" t-out="a[0]"/>
                                            <div class="epg-bucket-value" t-out="a[1]" t-options="mo"/>
                                        </div>
                                    </t>
                                    <div class="epg-bucket epg-bucket-total">
                                        <div class="epg-bucket-label">Total open</div>
                                        <div class="epg-bucket-value" t-out="block['ageing_total']" t-options="mo"/>
                                    </div>
                                </div>
                                <div t-if="block['credits_open']" class="epg-credits">
                                    Buckets show what is owed (<span t-out="block['ageing_gross']" t-options="mo"/>); unallocated payments / credits of
                                    <span t-out="block['credits_open']" t-options="mo"/> are deducted in the total.
                                </div>
                            </t>
                        </t>

                        <!-- footer: bank, QR, signature -->
                        <t t-if="st and st['has_data']">
                            <!-- table, not flex: wkhtmltopdf's WebKit ignores flexbox and
                                 silently dropped the QR image inside it. -->
                            <table class="epg-footer" style="width:100%; page-break-inside:avoid;">
                                <tr>
                                    <td style="width:44%; vertical-align:top;">
                                        <t t-if="company.partner_id.bank_ids">
                                            <div class="epg-bank-title">Pay to</div>
                                            <table class="epg-bank-table">
                                                <thead><tr><th>Bank</th><th>A/c No.</th><th>Branch</th><th>IFSC / BIC</th></tr></thead>
                                                <tbody>
                                                    <tr t-foreach="company.partner_id.bank_ids" t-as="b">
                                                        <td><span t-field="b.bank_name"/></td>
                                                        <td><span t-field="b.account_number"/></td>
                                                        <td><span t-field="b.city"/></td>
                                                        <td><span t-field="b.bank_bic"/></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </t>
                                    </td>
                                    <td class="epg-qr" style="width:28%; text-align:center; vertical-align:top;">
                                        <t t-if="payment_qr">
                                            <img t-att-src="image_data_uri(payment_qr)" width="170" height="170"/>
                                            <div>Scan to pay</div>
                                        </t>
                                    </td>
                                    <td class="epg-sign" style="width:28%; text-align:right; vertical-align:top;">
                                        <div class="epg-sign-for">For <span t-field="company.name"/></div>
                                        <img t-if="signature" t-att-src="image_data_uri(signature)"/>
                                        <div><span class="epg-sign-line">Authorised Signatory</span></div>
                                    </td>
                                </tr>
                            </table>
                            <div class="epg-note">Please quote the document numbers when paying. Figures come from posted entries as of the statement date — tell us if anything does not match your records.</div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Patient-wise (client, 2026-10-21; designed new - the Odoo 17 server had no
         patient-wise statement): the period's works under each patient, then what was
         paid, which belongs to the invoices and not to any one patient. -->
    <template id="statement_patients">
        <div class="epg-pw-title">Works by patient
            <span class="epg-pw-count"><t t-out="len(block['patients'])"/> patient(s)</span></div>
        <table class="epg-ledger epg-patients">
            <thead>
                <tr>
                    <th style="width:12%">Date</th>
                    <th style="width:19%">Document</th>
                    <th style="width:37%">Item</th>
                    <th class="num" style="width:7%">Qty</th>
                    <th class="num" style="width:12%">Rate</th>
                    <th class="num" style="width:13%">Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr t-if="not block['patients']">
                    <td colspan="6" class="epg-sub text-center">No works in this period<t t-if="one_patient"> for a patient named "<t t-out="one_patient"/>"</t>.</td>
                </tr>
                <t t-foreach="block['patients']" t-as="pt">
                    <tr class="epg-row-patient">
                        <td colspan="3"><span class="epg-pt-name" t-out="pt['name']"/>
                            <span class="epg-sub"> · <t t-out="pt['documents']"/> document(s)</span></td>
                        <td class="num" t-out="int(pt['qty']) if pt['qty'] == int(pt['qty']) else pt['qty']"/>
                        <td/>
                        <td class="num"><span t-out="pt['total']" t-options="mo"/></td>
                    </tr>
                    <tr t-foreach="pt['lines']" t-as="pl">
                        <td><span t-out="pl['date']" t-options="{'widget': 'date'}"/></td>
                        <td class="epg-doc"><span t-out="pl['move']"/>
                            <span t-if="pl['amount'] &lt; 0" class="epg-kind epg-kind-cn" t-out="pl['kind']"/></td>
                        <td t-out="pl['name']"/>
                        <td class="num" t-out="int(pl['quantity']) if pl['quantity'] == int(pl['quantity']) else pl['quantity']"/>
                        <td class="num"><span t-out="pl['price_unit']" t-options="{'widget': 'float', 'precision': 2}"/></td>
                        <td class="num"><span t-out="pl['amount']" t-options="{'widget': 'float', 'precision': 2}"/></td>
                    </tr>
                </t>
                <tr class="epg-row-total" t-if="block['patients']">
                    <td colspan="3"><t t-if="one_patient">Total</t><t t-else="">All patients</t></td>
                    <td class="num" t-out="int(block['patients_qty']) if block['patients_qty'] == int(block['patients_qty']) else block['patients_qty']"/>
                    <td/>
                    <td class="num"><span t-out="block['patients_total']" t-options="mo"/></td>
                </tr>
            </tbody>
        </table>
        <t t-if="not one_patient and block['other_rows']">
            <div class="epg-pw-title">Payments, credits and other entries</div>
            <table class="epg-ledger">
                <thead>
                    <tr>
                        <th style="width:12%">Date</th>
                        <th style="width:19%">Document</th>
                        <th style="width:39%">Description</th>
                        <th class="num" style="width:15%" t-out="labels['debit']"/>
                        <th class="num" style="width:15%" t-out="labels['credit']"/>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="block['other_rows']" t-as="l">
                        <td><span t-out="l['doc_date']" t-options="{'widget': 'date'}"/></td>
                        <td class="epg-doc"><span t-out="l['move']"/>
                            <div><span t-attf-class="epg-kind #{'epg-kind-pay' if l['kind'] in ('Payment', 'Bank') else 'epg-kind-cn' if l['kind'] == 'Credit Note' else 'epg-kind-inv' if l['kind'] == 'Invoice' else ''}" t-out="l['kind']"/></div></td>
                        <td t-out="l['name'] or l['ref']"/>
                        <td class="num"><span t-if="l['debit']" t-out="l['debit']" t-options="mo"/></td>
                        <td class="num"><span t-if="l['credit']" t-out="l['credit']" t-options="mo"/></td>
                    </tr>
                </tbody>
            </table>
        </t>
        <div class="epg-pw-note">
            Patient totals are the items invoiced, with tax<t t-if="not one_patient">; payments are made against the
            invoices rather than a patient, so they are listed apart, and the amount due is in the summary above</t>.
        </div>
    </template>

    <!-- The item-wise print: the statement above, on its own (landscape) report. -->
    <template id="report_statement_itemwise">
        <t t-call="epg_partner_statement.report_statement"/>
    </template>
</odoo>
