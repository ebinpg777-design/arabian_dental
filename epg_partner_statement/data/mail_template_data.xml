<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_statement" model="mail.template">
            <field name="name">Statement of Account</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">{{ object.company_id.name or user.company_id.name }} - Statement of Account {{ ctx.get('statement_from', '') }} to {{ ctx.get('statement_to', '') }}</field>
            <field name="email_from">{{ (user.email_formatted or user.company_id.email_formatted) }}</field>
            <field name="email_to">{{ object.email_formatted }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <p>Dear <t t-out="object.name or ''"/>,</p>
    <p>Please find attached your <t t-out="ctx.get('statement_type', 'statement').lower()"/> statement of account
       for the period <strong><t t-out="ctx.get('statement_from', '')"/></strong> to
       <strong><t t-out="ctx.get('statement_to', '')"/></strong>.</p>
    <p>If anything in it does not match your records, reply to this e-mail and we will sort it out.</p>
    <p>Thank you,<br/><t t-out="user.company_id.name or ''"/></p>
</div>
            </field>
        </record>
    </data>
</odoo>
