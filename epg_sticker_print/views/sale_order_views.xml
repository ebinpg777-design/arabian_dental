<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_sticker" model="ir.ui.view">
        <field name="name">sale.order.form.epg.sticker</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_sticker" type="object" string="Sticker" icon="fa-tag"
                        class="oe_highlight" invisible="state == 'cancel'"/>
            </xpath>
        </field>
    </record>
</odoo>
