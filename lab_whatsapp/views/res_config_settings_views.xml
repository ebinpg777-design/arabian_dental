<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_whatsapp" model="ir.ui.view">
        <field name="name">res.config.settings.form.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="WhatsApp" string="WhatsApp" name="lab_whatsapp"
                     logo="/base/static/description/settings.png">
                    <block title="Sender" name="wa_sender">
                        <setting string="Default WhatsApp Sender" help="Account used to send notifications.">
                            <field name="wa_account_id"/>
                            <button name="action_open_whatsapp_accounts" type="object"
                                    string="Configure senders" class="btn-link"/>
                        </setting>
                    </block>
                    <block title="Automatic Notifications to Doctors" name="wa_events">
                        <setting string="Templates" help="Each event below sends the template tagged with it. Edit the wording, preview it on a real record and send yourself a test there.">
                            <field name="wa_missing_templates" invisible="1"/>
                            <button name="action_open_whatsapp_templates" type="object"
                                    string="Edit templates" class="btn-link" icon="fa-arrow-right"/>
                            <div class="alert alert-warning py-1 mt-1 mb-0" role="alert"
                                 invisible="not wa_missing_templates">
                                Switched on but with no template to send:
                                <field name="wa_missing_templates" readonly="1" class="oe_inline"/>
                            </div>
                        </setting>
                        <setting string="Case Registered" help="Confirm to the doctor when a case is registered/confirmed.">
                            <field name="wa_notify_order_confirm"/>
                        </setting>
                        <setting string="Dispatched" help="Notify with courier &amp; consignment number when work is dispatched.">
                            <field name="wa_notify_dispatch"/>
                        </setting>
                        <setting string="Invoice Ready" help="Notify the doctor when an invoice is posted.">
                            <field name="wa_notify_invoice"/>
                        </setting>
                        <setting string="Payment Received" help="Send a thank-you receipt when a payment is registered.">
                            <field name="wa_notify_payment"/>
                        </setting>
                    </block>
                    <block title="Payment Reminders" name="wa_reminders">
                        <setting string="Send Overdue Reminders" help="A daily job messages doctors with overdue invoices.">
                            <field name="wa_notify_reminder"/>
                            <div class="content-group" invisible="not wa_notify_reminder">
                                <div class="row">
                                    <label for="wa_reminder_days" class="col-lg-6"/>
                                    <field name="wa_reminder_days"/>
                                </div>
                                <div class="row">
                                    <label for="wa_reminder_throttle_days" class="col-lg-6"/>
                                    <field name="wa_reminder_throttle_days"/>
                                </div>
                                <div class="row">
                                    <label for="wa_reminder_batch_size" class="col-lg-6"/>
                                    <field name="wa_reminder_batch_size"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
