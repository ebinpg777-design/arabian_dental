<odoo>
    <data noupdate="0">

        <record id="privilege_lab_finance_ops" model="res.groups.privilege">
            <field name="name">Finance Operations</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="sequence">40</field>
        </record>

        <record id="group_lab_cheque_user" model="res.groups">
            <field name="name">Cheque Register User</field>
            <field name="privilege_id" ref="privilege_lab_finance_ops"/>
            <field name="comment">Records cheques received and allocates them to invoices.</field>
        </record>

        <record id="group_lab_payment_approver" model="res.groups">
            <field name="name">Payment Approver</field>
            <field name="privilege_id" ref="privilege_lab_finance_ops"/>
            <field name="implied_ids" eval="[(4, ref('group_lab_cheque_user'))]"/>
            <field name="comment">Approves payments held by the approval threshold and
                clears or bounces cheques.</field>
        </record>

        <record id="account.group_account_invoice" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_lab_cheque_user'))]"/>
        </record>
        <record id="account.group_account_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_lab_payment_approver'))]"/>
        </record>

        </data>
</odoo>
