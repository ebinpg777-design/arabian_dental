<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_approval" model="ir.ui.view">
        <field name="name">account.payment.form.approval</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_submit_for_approval" type="object"
                        string="Submit for Approval" class="btn-secondary"
                        invisible="state != 'draft' or approval_state in ('to_approve', 'approved')"/>
                <button name="action_approve_payment" type="object" string="Approve"
                        class="btn-primary" invisible="approval_state != 'to_approve'"
                        groups="lab_finance_ops.group_lab_payment_approver"/>
                <button name="action_refuse_payment" type="object" string="Refuse"
                        invisible="approval_state != 'to_approve'"
                        groups="lab_finance_ops.group_lab_payment_approver"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning m-0 rounded-0" role="alert"
                     invisible="approval_state != 'to_approve'">
                    <i class="fa fa-lock me-1" title="Awaiting approval"/>
                    This payment is waiting for approval and cannot be posted yet.
                </div>
                <div class="alert alert-danger m-0 rounded-0" role="alert"
                     invisible="approval_state != 'refused'">
                    <i class="fa fa-times me-1" title="Refused"/>
                    <strong>Refused:</strong>
                    <field name="approval_note" nolabel="1" readonly="1" class="d-inline"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='memo']" position="after">
                <field name="approval_state" widget="badge"
                       decoration-success="approval_state == 'approved'"
                       decoration-warning="approval_state == 'to_approve'"
                       decoration-danger="approval_state == 'refused'"/>
                <field name="approved_by_id" invisible="approval_state != 'approved'"/>
                <field name="approval_date" invisible="approval_state != 'approved'"/>
                <field name="approval_note"
                       groups="lab_finance_ops.group_lab_payment_approver"/>
                <field name="cheque_id" invisible="not cheque_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_list_approval" model="ir.ui.view">
        <field name="name">account.payment.list.approval</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="approval_state" widget="badge" optional="show"
                       decoration-success="approval_state == 'approved'"
                       decoration-warning="approval_state == 'to_approve'"
                       decoration-danger="approval_state == 'refused'"/>
                <field name="cheque_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="action_lab_payments_to_approve" model="ir.actions.act_window">
        <field name="name">Payments to Approve</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('approval_state', '=', 'to_approve')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting for approval</p>
        </field>
    </record>
</odoo>
