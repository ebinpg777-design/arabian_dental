<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Each bank's Cheques in Hand (PDC) account, as Odoo 17 kept them (2026-11-23) -->
    <record id="view_account_journal_form_pdc" model="ir.ui.view">
        <field name="name">account.journal.form.lab.pdc</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='suspense_account_id']" position="after">
                <field name="lab_pdc_account_id" invisible="type != 'bank'"
                       options="{'no_quick_create': True}" groups="account.group_account_readonly"/>
            </xpath>
        </field>
    </record>
</odoo>
