<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="im_livechat_channel_view_form_cai" model="ir.ui.view">
        <field name="name">im_livechat.channel.form.ebshel_ai_suite</field>
        <field name="model">im_livechat.channel</field>
        <field name="inherit_id" ref="im_livechat.im_livechat_channel_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='options']" position="before">
                <page string="AI Assistant" name="cai_assistant" groups="im_livechat.im_livechat_group_manager">
                    <group>
                        <group>
                            <field name="cai_assistant_id" options="{'no_create': True}"/>
                            <field name="cai_max_replies" invisible="not cai_assistant_id"/>
                        </group>
                    </group>
                    <div class="text-muted small">
                        The assistant answers visitors first, only from its knowledge sources and with the rights of
                        the visitor. It hands the conversation to an available operator when it cannot help, when
                        the visitor asks for a person, or after the maximum number of answers.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
