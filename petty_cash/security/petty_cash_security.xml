<odoo>
    <record id="module_category_petty_cash" model="ir.module.category">
        <field name="name">Petty Cash</field>
        <field name="sequence">35</field>
    </record>

    <!-- Odoo 19 replaced res.groups.category_id with res.groups.privilege_id, pointing
         at the new res.groups.privilege model; the privilege is what now carries the
         ir.module.category. Without this the module refuses to load outright:
         "Invalid field 'category_id' in 'res.groups'". -->
    <record id="privilege_petty_cash" model="res.groups.privilege">
        <field name="name">Petty Cash</field>
        <field name="category_id" ref="module_category_petty_cash"/>
        <field name="sequence">35</field>
    </record>

    <record id="group_petty_cash_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_petty_cash"/>
    </record>

    <record id="group_petty_cash_officer" model="res.groups">
        <field name="name">Officer</field>
        <field name="privilege_id" ref="privilege_petty_cash"/>
        <field name="implied_ids" eval="[(4, ref('group_petty_cash_user'))]"/>
    </record>

    <record id="group_petty_cash_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_petty_cash"/>
        <field name="implied_ids" eval="[(4, ref('group_petty_cash_officer'))]"/>
    </record>

    </odoo>
