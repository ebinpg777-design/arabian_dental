<odoo>
    <record id="module_category_petty_cash" model="ir.module.category">
        <field name="name">Petty Cash</field>
        <field name="sequence">35</field>
    </record>

    <!-- Odoo 19 replaced res.groups.category_id with res.groups.privilege_id, pointing
         at the new res.groups.privilege model; the privilege is what now carries the
         ir.module.category. Without this the module refuses to load outright:
         "Invalid field 'category_id' in 'res.groups'". -->
    <record id="privilege_petty_cash" model="res.groups.privilege">
        <field name="name">Petty Cash</field>
        <field name="category_id" ref="module_category_petty_cash"/>
        <field name="sequence">35</field>
    </record>

    <record id="group_petty_cash_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_petty_cash"/>
    </record>

    <record id="group_petty_cash_officer" model="res.groups">
        <field name="name">Officer</field>
        <field name="privilege_id" ref="privilege_petty_cash"/>
        <field name="implied_ids" eval="[(4, ref('group_petty_cash_user'))]"/>
    </record>

    <record id="group_petty_cash_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_petty_cash"/>
        <field name="implied_ids" eval="[(4, ref('group_petty_cash_officer'))]"/>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         ALLOCATION rules
         User  → own records AND own company(ies)
         Officer/Manager → all records in own company(ies)
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="petty_cash_allocation_user_rule" model="ir.rule">
        <field name="name">Petty Cash Allocation: own records + own company</field>
        <field name="model_id" ref="model_petty_cash_allocation"/>
        <field name="domain_force">[
            ('partner_id', '=', user.partner_id.id),
            ('company_id', 'in', user.company_ids.ids)
        ]</field>
        <field name="groups" eval="[(4, ref('group_petty_cash_user'))]"/>
    </record>

    <record id="petty_cash_allocation_officer_rule" model="ir.rule">
        <field name="name">Petty Cash Allocation: officers all records in own company</field>
        <field name="model_id" ref="model_petty_cash_allocation"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_petty_cash_officer'))]"/>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         TRANSACTION rules
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="petty_cash_transaction_user_rule" model="ir.rule">
        <field name="name">Petty Cash Transaction: own records + own company</field>
        <field name="model_id" ref="model_petty_cash_transaction"/>
        <field name="domain_force">[
            ('petty_cash_partner_id', '=', user.partner_id.id),
            ('company_id', 'in', user.company_ids.ids)
        ]</field>
        <field name="groups" eval="[(4, ref('group_petty_cash_user'))]"/>
    </record>

    <record id="petty_cash_transaction_officer_rule" model="ir.rule">
        <field name="name">Petty Cash Transaction: officers all records in own company</field>
        <field name="model_id" ref="model_petty_cash_transaction"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_petty_cash_officer'))]"/>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         EXPENSE rules
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="petty_cash_expense_user_rule" model="ir.rule">
        <field name="name">Petty Cash Expense: own records + own company</field>
        <field name="model_id" ref="model_petty_cash_expense"/>
        <field name="domain_force">[
            ('petty_cash_partner_id', '=', user.partner_id.id),
            ('company_id', 'in', user.company_ids.ids)
        ]</field>
        <field name="groups" eval="[(4, ref('group_petty_cash_user'))]"/>
    </record>

    <record id="petty_cash_expense_officer_rule" model="ir.rule">
        <field name="name">Petty Cash Expense: officers all records in own company</field>
        <field name="model_id" ref="model_petty_cash_expense"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_petty_cash_officer'))]"/>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         EXPENSE LINE rules
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="petty_cash_expense_line_user_rule" model="ir.rule">
        <field name="name">Petty Cash Expense Line: own records + own company</field>
        <field name="model_id" ref="model_petty_cash_expense_line"/>
        <field name="domain_force">[
            ('expense_id.petty_cash_partner_id', '=', user.partner_id.id),
            ('company_id', 'in', user.company_ids.ids)
        ]</field>
        <field name="groups" eval="[(4, ref('group_petty_cash_user'))]"/>
    </record>

    <record id="petty_cash_expense_line_officer_rule" model="ir.rule">
        <field name="name">Petty Cash Expense Line: officers all records in own company</field>
        <field name="model_id" ref="model_petty_cash_expense_line"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_petty_cash_officer'))]"/>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         CATEGORY BUDGET rules  (company scoped through allocation)
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="petty_cash_category_budget_user_rule" model="ir.rule">
        <field name="name">Petty Cash Category Budget: own records + own company</field>
        <field name="model_id" ref="model_petty_cash_category_budget"/>
        <field name="domain_force">[
            ('allocation_id.partner_id', '=', user.partner_id.id),
            ('company_id', 'in', user.company_ids.ids)
        ]</field>
        <field name="groups" eval="[(4, ref('group_petty_cash_user'))]"/>
    </record>

    <record id="petty_cash_category_budget_officer_rule" model="ir.rule">
        <field name="name">Petty Cash Category Budget: officers all records in own company</field>
        <field name="model_id" ref="model_petty_cash_category_budget"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_petty_cash_officer'))]"/>
    </record>
</odoo>
