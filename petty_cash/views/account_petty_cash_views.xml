<odoo>
    <record id="view_account_journal_form_petty_cash" model="ir.ui.view">
        <field name="name">account.journal.form.petty.cash</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="is_petty_cash"/>
                </xpath>
            </field>
    </record>

    <record id="view_account_form_petty_cash" model="ir.ui.view">
        <field name="name">account.account.form.petty.cash</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_type']" position="after">
                <field name="is_petty_cash"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_petty_cash" model="ir.ui.view">
        <field name="name">account.move.form.inherit.petty.cash</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_petty_cash_expense" type="object" class="oe_stat_button" icon="fa-money" invisible="not petty_cash_expense_id">
                    <field name="petty_cash_expense_id" widget="statinfo" string="Petty Cash"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='misc_group']" position="inside">
                <field name="is_petty_cash" invisible="1"/>
                <field name="petty_cash_expense_id" invisible="1"/>
                <field name="petty_cash_partner_id" domain="[('is_petty_cash_holder', '=', True)]" string="Petty Cash Holder" invisible="move_type not in ('in_invoice', 'entry') and not is_petty_cash"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_form_inherit_petty_cash" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.petty.cash</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="is_petty_cash" invisible="1"/>
                <field name="petty_cash_partner_id" domain="[('is_petty_cash_holder', '=', True)]" string="Petty Cash Holder" invisible="not is_petty_cash" required="is_petty_cash"/>
            </xpath>
        </field>
    </record>
</odoo>
