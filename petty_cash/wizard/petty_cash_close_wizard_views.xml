<odoo>
    <record id="view_petty_cash_close_wizard_form" model="ir.ui.view">
        <field name="name">petty.cash.close.wizard.form</field>
        <field name="model">petty.cash.close.wizard</field>
        <field name="arch" type="xml">
            <form string="Close / Return">
                <sheet>
                    <!-- ── Mode toggle ─────────────────────────────────── -->
                    <div class="alert alert-info d-flex align-items-center gap-2 py-2 mb-3">
                        <i class="fa fa-info-circle fa-lg"/>
                        <span invisible="is_closing">
                            <b>Partial Return</b> — The allocation stays active after this return.
                            You can do more partial returns or close it later.
                        </span>
                        <span invisible="not is_closing">
                            <b>Close Allocation</b> — The allocation will be permanently closed
                            once this return is posted.
                        </span>
                    </div>

                    <!-- ── Balance summary strip ───────────────────────── -->
                    <div class="o_horizontal_separator mb-2">Current Balance</div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="amount_allocated" readonly="1"/>
                            <field name="amount_utilized" readonly="1"/>
                        </group>
                        <group>
                            <field name="amount_returned" readonly="1" string="Already Returned"/>
                            <field name="partial_return_count" readonly="1" string="Partial Returns Made"/>
                            <field name="current_balance" readonly="1"
                                   decoration-danger="current_balance &lt; 0"
                                   decoration-warning="current_balance == 0"/>
                        </group>
                    </group>

                    <div class="o_horizontal_separator mb-2">Return Details</div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="amount" string="Amount to Return"
                                   decoration-danger="amount &gt; current_balance"/>
                            <field name="counter_account_id" required="1"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="is_closing" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="remaining_after" readonly="1"
                                   string="Balance After Return"
                                   decoration-success="remaining_after == 0"
                                   decoration-warning="remaining_after &gt; 0"/>
                            <!-- Write-off option -->
                            <field name="can_write_off" invisible="1"/>
                            <field name="use_write_off" invisible="not can_write_off"
                                   widget="boolean_toggle" string="Write Off Remainder"/>
                            <field name="write_off_account_id"
                                   invisible="not use_write_off"
                                   required="use_write_off"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="write_off_amount" readonly="1"
                                   invisible="not use_write_off"
                                   string="Write-off Amount"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Optional notes for this return…"/>
                    </group>

                    <!-- ── After-return balance indicator ─────────────── -->
                    <div class="alert alert-success py-2 mt-2"
                         invisible="remaining_after != 0 or not is_closing">
                        <i class="fa fa-check-circle me-2" title="Fully recovered"/>
                        Full balance will be recovered. Allocation will be <b>closed</b> on confirm.
                    </div>
                    <div class="alert alert-warning py-2 mt-2"
                         invisible="remaining_after == 0 or not is_closing or use_write_off">
                        <i class="fa fa-exclamation-triangle me-2" title="Remainder"/>
                        <b><field name="remaining_after" readonly="1" nolabel="1" class="oe_inline"/></b>
                        will remain unrecovered. Enable <b>Write Off Remainder</b> to absorb it,
                        or reduce the return amount.
                    </div>
                    <div class="alert alert-info py-2 mt-2"
                         invisible="is_closing">
                        <i class="fa fa-info-circle me-2"/>
                        Remaining balance after this return:
                        <b><field name="remaining_after" readonly="1" nolabel="1" class="oe_inline"/></b>.
                        The allocation stays active.
                    </div>

                    <!-- Hidden relation fields -->
                    <field name="allocation_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button special="cancel" string="Discard" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
