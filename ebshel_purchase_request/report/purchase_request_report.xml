<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── IR Actions Report ─────────────────────────────────────────────── -->
    <record id="action_report_purchase_request" model="ir.actions.report">
        <field name="name">Purchase Request</field>
        <field name="model">ebshel.purchase.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ebshel_purchase_request.report_purchase_request_document</field>
        <field name="report_file">ebshel_purchase_request.report_purchase_request_document</field>
        <field name="binding_model_id" ref="model_ebshel_purchase_request"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- ── QWeb Template ─────────────────────────────────────────────────── -->
    <template id="report_purchase_request_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <t t-set="track" t-value="doc.line_ids.filtered(lambda l: l.purchased_qty > 0)"/>
                    <div class="page">
                        <style>
                            .pr-title { font-weight:700; margin:0; }
                            .pr-ref { color:#555; font-size:14px; font-weight:600; }
                            .pr-badge { display:inline-block; border:1px solid #999; border-radius:3px;
                                        padding:2px 10px; font-size:12px; font-weight:700; }
                            .pr-box { border:1px solid #ccc; border-radius:3px; padding:6px 10px; height:100%; }
                            .pr-box .lbl { font-size:9.5px; text-transform:uppercase; letter-spacing:.5px;
                                           color:#777; font-weight:700; }
                            .pr-box .val { font-size:13px; font-weight:600; }
                            table.pr-items { width:100%; border-collapse:collapse; font-size:11.5px; }
                            table.pr-items th { background:#f0f0f0; padding:6px 7px; text-align:left;
                                                border:1px solid #ccc; }
                            table.pr-items td { padding:5px 7px; border:1px solid #ddd; }
                            table.pr-items tfoot td { border-top:2px solid #333; font-weight:700; }
                            .pr-mini { font-size:10px; }
                            .pr-st-full { font-weight:700; }
                            .pr-st-none { color:#888; }
                            .pr-section { font-weight:700; border-bottom:1px solid #333;
                                          padding-bottom:3px; margin:18px 0 8px; font-size:14px; }
                        </style>

                        <!-- Header -->
                        <div class="row mb-2">
                            <div class="col-7">
                                <h2 class="pr-title">Purchase Request</h2>
                                <div class="pr-ref"><t t-esc="doc.name"/></div>
                            </div>
                            <div class="col-5 text-end">
                                <span class="pr-badge">
                                    <t t-esc="dict(doc._fields['state'].selection).get(doc.state, doc.state)"/>
                                </span>
                            </div>
                        </div>

                        <!-- Meta cards -->
                        <div class="row mb-2">
                            <div class="col-3"><div class="pr-box"><div class="lbl">Requested By</div><div class="val"><t t-esc="doc.requester_id.name"/></div></div></div>
                            <div class="col-3"><div class="pr-box"><div class="lbl">Department</div><div class="val"><t t-esc="doc.analytic_account_id.name or '—'"/></div></div></div>
                            <div class="col-3"><div class="pr-box"><div class="lbl">Request Date</div><div class="val"><span t-field="doc.date_request"/></div></div></div>
                            <div class="col-3"><div class="pr-box"><div class="lbl">Required By</div><div class="val"><t t-if="doc.date_required"><span t-field="doc.date_required"/></t><t t-else="">—</t></div></div></div>
                        </div>
                        <t t-if="doc.description">
                            <div class="pr-box mb-2"><div class="lbl">Purpose / Title</div><div class="val" t-esc="doc.description"/></div>
                        </t>

                        <!-- Lines -->
                        <div class="pr-section">Requested Items</div>
                        <table class="pr-items">
                            <thead>
                                <tr>
                                    <th style="width:3%">#</th>
                                    <th style="width:33%">Product / Description</th>
                                    <th class="text-end" style="width:8%">Qty</th>
                                    <th style="width:8%">UoM</th>
                                    <th class="text-end" style="width:14%">Est. Unit</th>
                                    <th class="text-end" style="width:16%">Est. Total</th>
                                    <th style="width:18%">Required By</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr t-att-style="'text-decoration:line-through;color:#94a3b8;' if line.cancelled else ''">
                                        <td><t t-esc="line_index + 1"/></td>
                                        <td>
                                            <strong t-esc="line.product_id.name"/>
                                            <t t-if="line.name and line.name != line.product_id.name"><br/><span class="pr-mini" t-esc="line.name"/></t>
                                            <t t-if="line.remarks"><br/><span class="pr-mini text-muted">↳ <t t-esc="line.remarks"/></span></t>
                                        </td>
                                        <td class="text-end"><t t-esc="line.qty"/></td>
                                        <td><t t-esc="line.uom_id.name"/></td>
                                        <td class="text-end"><span t-esc="line.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                        <td class="text-end"><span t-esc="line.estimated_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                        <td><span t-field="line.date_required"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5" class="text-end">Estimated Total</td>
                                    <td class="text-end"><span t-esc="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Procurement tracking: ordered → received → billed -->
                        <t t-if="track">
                            <div class="pr-section">Procurement Tracking</div>
                            <table class="pr-items">
                                <thead>
                                    <tr>
                                        <th style="width:34%">Product</th>
                                        <th class="text-end">Requested</th>
                                        <th class="text-end">Ordered</th>
                                        <th class="text-end">Received</th>
                                        <th class="text-end">Billed</th>
                                        <th class="text-center">Reception</th>
                                        <th class="text-center">Billing</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="track" t-as="line">
                                        <tr>
                                            <td><t t-esc="line.product_id.name"/></td>
                                            <td class="text-end"><t t-esc="line.qty"/></td>
                                            <td class="text-end"><t t-esc="line.purchased_qty"/></td>
                                            <td class="text-end"><t t-esc="line.qty_done"/></td>
                                            <td class="text-end"><t t-esc="line.qty_invoiced"/></td>
                                            <td class="text-center">
                                                <span t-att-class="'pr-st-full' if line.reception_status=='full' else ('pr-st-partial' if line.reception_status=='partial' else 'pr-st-none')"
                                                      t-esc="dict(line._fields['reception_status'].selection).get(line.reception_status)"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-att-class="'pr-st-full' if line.billing_status=='full' else ('pr-st-partial' if line.billing_status=='partial' else 'pr-st-none')"
                                                      t-esc="dict(line._fields['billing_status'].selection).get(line.billing_status)"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- Approval History -->
                        <t t-if="doc.approval_log_ids">
                            <div class="pr-section">Approval History</div>
                            <table class="pr-items">
                                <thead>
                                    <tr>
                                        <th>Date</th><th>Approver</th><th>Level</th><th>Action</th><th>Comments</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.approval_log_ids" t-as="log">
                                        <tr>
                                            <td><span t-field="log.date"/></td>
                                            <td><t t-esc="log.approver_id.name"/></td>
                                            <td><t t-esc="log.level_name or ''"/></td>
                                            <td><t t-esc="dict(log._fields['action'].selection).get(log.action, '')"/></td>
                                            <td><t t-esc="log.comments or ''"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- Notes -->
                        <t t-if="doc.notes">
                            <div class="pr-section">Notes</div>
                            <div t-out="doc.notes"/>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
