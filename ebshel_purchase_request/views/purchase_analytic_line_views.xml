<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_analytic_line_list" model="ir.ui.view">
        <field name="name">purchase.analytic.line.list</field>
        <field name="model">purchase.analytic.line</field>
        <field name="arch" type="xml">
            <list string="Purchase Analytic Lines" create="0" edit="0">
                <field name="date"/>
                <field name="name"/>
                <field name="analytic_account_id"/>
                <field name="commitment_type"/>
                <field name="request_id" optional="show"/>
                <field name="order_id" optional="show"/>
                <field name="note" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Net Committed"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_analytic_line_form" model="ir.ui.view">
        <field name="name">purchase.analytic.line.form</field>
        <field name="model">purchase.analytic.line</field>
        <field name="arch" type="xml">
            <form string="Purchase Analytic Line" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="commitment_type"/>
                            <field name="analytic_account_id"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                            <field name="request_id"/>
                            <field name="request_line_id"/>
                            <field name="order_id"/>
                            <field name="order_line_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_purchase_analytic_line_search" model="ir.ui.view">
        <field name="name">purchase.analytic.line.search</field>
        <field name="model">purchase.analytic.line</field>
        <field name="arch" type="xml">
            <search string="Purchase Analytic Lines">
                <field name="analytic_account_id"/>
                <field name="request_id"/>
                <field name="order_id"/>
                <filter name="type_request" string="Requests"
                        domain="[('commitment_type', '=', 'request')]"/>
                <filter name="type_order" string="Purchase Orders"
                        domain="[('commitment_type', '=', 'order')]"/>
                <separator/>
                <filter name="filter_date" string="Date" date="date"/>
                <group>
                    <filter name="group_account" string="Department / Cost Center"
                            domain="[]" context="{'group_by': 'analytic_account_id'}"/>
                    <filter name="group_type" string="Source"
                            domain="[]" context="{'group_by': 'commitment_type'}"/>
                    <filter name="group_date" string="Date"
                            domain="[]" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_purchase_analytic_line" model="ir.actions.act_window">
        <field name="name">Purchase Analytic Lines</field>
        <field name="res_model">purchase.analytic.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_account': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No purchase analytic lines yet</p>
            <p>This ledger tracks budget encumbered by purchase requests and orders
               before it is realized as a bill. Entries are created automatically.</p>
        </field>
    </record>

</odoo>
