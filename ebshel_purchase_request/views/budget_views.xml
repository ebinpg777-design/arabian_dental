<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Budget lines embedded in the Budget form: show Purchased / Invoiced /
         Committed alongside the standard Achieved column. -->
    <record id="view_budget_analytic_form_ebshel_commitment" model="ir.ui.view">
        <field name="name">budget.analytic.form.ebshel.commitment</field>
        <field name="model">budget.analytic</field>
        <field name="inherit_id" ref="account_budget.view_budget_analytic_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='budget_line_ids']/list/field[@name='achieved_amount']" position="after">
                <field name="purchased_amount" sum="Purchased"
                       column_invisible="parent.state in ('draft','canceled')"/>
                <field name="invoiced_amount" sum="Invoiced"
                       column_invisible="parent.state in ('draft','canceled')"/>
                <field name="total_amount" sum="Committed"
                       decoration-danger="total_amount > budget_amount"
                       column_invisible="parent.state in ('draft','canceled')"/>
            </xpath>
        </field>
    </record>

    <!-- Budget lines shown on the Analytic Account form (Budgets tab). -->
    <record id="view_analytic_account_budget_tab_ebshel_commitment" model="ir.ui.view">
        <field name="name">account.analytic.account.budget.tab.ebshel.commitment</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="account_budget.view_account_analytic_account_form_inherit_budget"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='budget_line_ids']/list/field[@name='achieved_amount']" position="after">
                <field name="purchased_amount" string="Purchased" sum="Purchased"/>
                <field name="invoiced_amount" string="Invoiced" sum="Invoiced"/>
                <field name="total_amount" string="Total" sum="Committed"/>
            </xpath>
        </field>
    </record>

    <!-- Standalone Budgets Analysis list. -->
    <record id="view_budget_line_tree_ebshel_commitment" model="ir.ui.view">
        <field name="name">budget.line.list.ebshel.commitment</field>
        <field name="model">budget.line</field>
        <field name="inherit_id" ref="account_budget.view_budget_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='achieved_amount']" position="after">
                <field name="purchased_amount" sum="Purchased" optional="show"/>
                <field name="invoiced_amount" sum="Invoiced" optional="show"/>
                <field name="total_amount" sum="Committed" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
