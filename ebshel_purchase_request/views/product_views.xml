<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add the 'Procure via Purchase Request' flag to the product Purchase tab -->
    <record id="view_product_template_pr_flag" model="ir.ui.view">
        <field name="name">product.template.purchase.request.flag</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="purchase.view_product_supplier_inherit"/>
        <field name="arch" type="xml">
            <field name="purchase_method" position="after">
                <field name="purchase_request"/>
            </field>
        </field>
    </record>

</odoo>
