<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ebshel_purchase_request.RfqVendorComparisonField">
    <div class="rvc-widget">

        <!-- ══ Empty state ════════════════════════════════════════════════ -->
        <t t-if="!this.hasVendors">
            <div class="rvc-empty">
                <div class="rvc-empty-icon">⚖️</div>
                <div class="rvc-empty-title">No vendor quotations yet</div>
                <div class="rvc-empty-sub">
                    Add vendor quotations to compare prices and crown a winner.
                </div>
            </div>
        </t>

        <!-- ══ Comparison ═════════════════════════════════════════════════ -->
        <t t-else="">

            <!-- Savings strip -->
            <div class="rvc-savings" t-if="this.potentialSavings > 0">
                <span class="rvc-savings-icon">💡</span>
                <span>
                    Picking the lowest quote instead of the highest saves
                    <strong class="rvc-savings-amount"
                             t-out="this.fmt(this.potentialSavings, this.rankedVendors[0].currencyId)"/>
                </span>
                <span class="rvc-savings-count">
                    <t t-out="this.rankedVendors.length"/> vendors compared
                </span>
            </div>

            <!-- Award / Order status toolbar -->
            <div class="rvc-toolbar" t-if="this.hasWinner or this.hasPO">
                <t t-if="this.hasPO">
                    <span class="rvc-status rvc-status--po">
                        ✓ Ordered — purchase order(s) created
                    </span>
                    <button class="rvc-btn rvc-btn--po" t-on-click="() => this.viewPO()">
                        📋 View Purchase Order(s)
                    </button>
                </t>
                <t t-elif="this.hasWinner">
                    <span class="rvc-status rvc-status--won">
                        🏆 <strong t-out="this.winner.name"/> awarded
                    </span>
                    <button class="rvc-btn rvc-btn--po"
                            t-if="this.canAward"
                            t-att-disabled="this.state.busy"
                            t-on-click="() => this.createPO()">
                        🛒 Create Purchase Order
                    </button>
                </t>
            </div>

            <!-- Podium cards -->
            <div class="rvc-grid">
                <t t-foreach="this.rankedVendors" t-as="v" t-key="v.id">
                    <div t-att-class="this.cardClass(v)"
                         t-on-mouseenter="() => this.onHover(v.id)"
                         t-on-mouseleave="() => this.onLeave()">

                        <!-- Winner crown banner -->
                        <div class="rvc-crown" t-if="v.isWinner">
                            👑 WINNER
                        </div>

                        <!-- Rank medal -->
                        <div class="rvc-rank" t-if="!v.isWinner">
                            <span t-out="this.medal(v.rank or (v_index + 1))"/>
                        </div>

                        <!-- New-vendor flag -->
                        <div class="rvc-new-flag" t-if="v.isNewVendor">NEW</div>

                        <!-- Vendor name -->
                        <div class="rvc-vendor">
                            <span class="rvc-vendor-icon">🏢</span>
                            <span class="rvc-vendor-name" t-out="v.name"/>
                        </div>

                        <!-- Total price -->
                        <div class="rvc-total">
                            <t t-out="this.fmt(v.total, v.currencyId)"/>
                        </div>
                        <div class="rvc-untaxed">
                            untaxed <t t-out="this.fmt(v.untaxed, v.currencyId)"/>
                        </div>

                        <!-- Comparative price bar -->
                        <div class="rvc-pricebar-track">
                            <div class="rvc-pricebar-fill"
                                 t-att-class="this.isBestPrice(v) ? 'rvc-pricebar-fill--best' : ''"
                                 t-attf-style="width: #{this.priceBarWidth(v)}"/>
                        </div>

                        <!-- Quick badges -->
                        <div class="rvc-badges">
                            <span class="rvc-badge rvc-badge--price" t-if="this.isBestPrice(v)">
                                💰 Lowest price
                            </span>
                            <span class="rvc-badge rvc-badge--delta" t-if="this.priceDelta(v)">
                                <t t-out="this.priceDelta(v)"/> vs best
                            </span>
                            <span class="rvc-badge rvc-badge--fast" t-if="this.isFastest(v)">
                                ⚡ Fastest
                            </span>
                            <span class="rvc-badge rvc-badge--score" t-if="this.isBestScore(v)">
                                ⭐ Top score
                            </span>
                        </div>

                        <!-- Metrics -->
                        <div class="rvc-metrics">
                            <div class="rvc-metric">
                                <span class="rvc-metric-label">Delivery</span>
                                <span class="rvc-metric-value">
                                    <t t-if="v.deliveryDays"><t t-out="v.deliveryDays"/> days</t>
                                    <t t-else="">—</t>
                                </span>
                            </div>
                            <div class="rvc-metric">
                                <span class="rvc-metric-label">Terms</span>
                                <span class="rvc-metric-value" t-out="v.paymentTerm or '—'"/>
                            </div>
                        </div>

                        <!-- Score gauge -->
                        <div class="rvc-score-row">
                            <span class="rvc-score-label">Score</span>
                            <div class="rvc-score-track">
                                <div class="rvc-score-fill"
                                     t-attf-style="width: #{this.scoreBarWidth(v)}"/>
                            </div>
                            <span class="rvc-score-num" t-out="v.score.toFixed(0)"/>
                        </div>

                        <!-- Existing justification -->
                        <div class="rvc-justify-shown" t-if="v.isWinner and v.justification">
                            <span class="rvc-justify-icon">📝</span>
                            <em t-out="v.justification"/>
                        </div>

                        <!-- Footer actions -->
                        <div class="rvc-actions" t-if="!this.readonly">

                            <!-- Inline justification box -->
                            <t t-if="this.state.justifyId === v.id">
                                <textarea class="rvc-justify-input"
                                          placeholder="Why is this vendor the winner? (optional)"
                                          rows="2"
                                          t-att-value="this.state.justifyText" t-on-input="(ev) => this.state.justifyText = ev.target.value"/>
                                <div class="rvc-justify-btns">
                                    <button class="rvc-btn rvc-btn--crown"
                                            t-att-disabled="this.state.busy"
                                            t-on-click="() => this.confirmWinner(v)">
                                        <t t-if="this.state.justifyMode === 'order'">🛒 Award &amp; Create PO</t>
                                        <t t-else="">👑 Confirm Winner</t>
                                    </button>
                                    <button class="rvc-btn rvc-btn--ghost"
                                            t-on-click="() => this.cancelJustify()">
                                        Cancel
                                    </button>
                                </div>
                            </t>

                            <!-- Winner, PO not yet created → offer to order from this card -->
                            <t t-elif="v.isWinner and !this.hasPO">
                                <span class="rvc-winner-tag">✓ Awarded</span>
                                <button class="rvc-btn rvc-btn--po"
                                        t-if="this.canAward"
                                        t-att-disabled="this.state.busy"
                                        t-on-click="() => this.createPO()">
                                    🛒 Create Purchase Order
                                </button>
                            </t>

                            <!-- Winner with PO already created -->
                            <t t-elif="v.isWinner and this.hasPO">
                                <span class="rvc-winner-tag">✓ Ordered</span>
                            </t>

                            <!-- Challenger cards: crown, or award + order in one click -->
                            <t t-else="">
                                <div class="rvc-award-btns" t-if="this.canAward">
                                    <button class="rvc-btn rvc-btn--crown"
                                            t-att-disabled="this.state.busy"
                                            t-on-click="() => this.openJustify(v, 'award')">
                                        👑 Crown Winner
                                    </button>
                                    <button class="rvc-btn rvc-btn--order"
                                            t-att-disabled="this.state.busy"
                                            t-on-click="() => this.openJustify(v, 'order')"
                                            title="Award this vendor and create the purchase order in one step">
                                        🛒 Award &amp; Order
                                    </button>
                                </div>
                                <button class="rvc-btn rvc-btn--ghost"
                                        t-on-click="() => this.openQuotation(v)">
                                    ✎ Edit Quote
                                </button>
                            </t>
                        </div>

                        <!-- Read-only winner tag -->
                        <div class="rvc-actions" t-if="this.readonly and v.isWinner">
                            <span class="rvc-winner-tag">
                                <t t-if="this.hasPO">✓ Ordered</t>
                                <t t-else="">✓ Awarded</t>
                            </span>
                        </div>

                    </div>
                </t>
            </div>

        </t>
    </div>
</t>

</templates>
