<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ebshel_pr_qty_edit_wizard_form" model="ir.ui.view">
        <field name="name">ebshel.pr.qty.edit.wizard.form</field>
        <field name="model">ebshel.pr.qty.edit.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Quantities">
                <field name="reapproval" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="not reapproval">
                    Reducing a quantity will send this request back through the
                    approval workflow.
                </div>
                <!-- <div class="alert alert-secondary" role="alert" invisible="reapproval">
                    Quantities can only be reduced, and not below what is already
                    placed on an RFQ. The request stays approved.
                </div> -->
                <field name="line_ids">
                    <list editable="bottom" create="false" delete="false">
                        <field name="product_id" readonly="1"/>
                        <field name="uom_id" readonly="1" optional="show"/>
                        <field name="current_qty" readonly="1" string="Current PR Quantity"/>
                        <field name="qty_in_rfq" readonly="1"/>
                        <field name="new_qty" string="New PR Quantity"/>
                        <field name="request_line_id" force_save="1" column_invisible="True"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" string="Apply" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
