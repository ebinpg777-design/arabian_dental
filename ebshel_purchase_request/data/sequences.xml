<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <record id="seq_ebshel_purchase_request" model="ir.sequence">
        <field name="name">Purchase Request</field>
        <field name="code">ebshel.purchase.request</field>
        <field name="prefix">PR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_ebshel_purchase_rfq" model="ir.sequence">
        <field name="name">Purchase RFQ (Custom)</field>
        <field name="code">ebshel.purchase.rfq</field>
        <field name="prefix">RFQC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_purchase_analytic_line" model="ir.sequence">
        <field name="name">Purchase Analytic Line</field>
        <field name="code">purchase.analytic.line</field>
        <field name="prefix">PAL/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

</data>
</odoo>
