<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_followups" model="ir.cron">
            <field name="name">Advanced Accounting: automatic payment reminders</field>
            <field name="model_id" ref="model_ebshel_followup_desk"/>
            <field name="state">code</field>
            <field name="code">model._cron_followups()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_deferrals" model="ir.cron">
            <field name="name">Advanced Accounting: recognise deferrals</field>
            <field name="model_id" ref="model_ebshel_deferral"/>
            <field name="state">code</field>
            <field name="code">model._cron_post_due()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_ledger_scan" model="ir.cron">
            <field name="name">Advanced Accounting: ledger health scan</field>
            <field name="model_id" ref="model_ebshel_ledger_scanner"/>
            <field name="state">code</field>
            <field name="code">model._cron_scan()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
        </record>
        <!-- Ortho's e1869906. Receipts on the lab's book are plain journal entries too, so
             nothing marks an invoice paid until somebody reconciles it; this settles every
             partner's open items nightly (a quoted or same-amount invoice first, then oldest
             first). Shipped SWITCHED OFF in the lab: its first run reconciles the whole book
             in one night, and that is for the accountant to switch on (Settings > Technical >
             Scheduled Actions), not for a module upgrade to do. -->
        <record id="cron_settle" model="ir.cron">
            <field name="name">Advanced Accounting: settle open items with payments</field>
            <field name="model_id" ref="model_ebshel_match_desk"/>
            <field name="state">code</field>
            <field name="code">model._cron_settle()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=20, minute=30, second=0, microsecond=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
