<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_followups" model="ir.cron">
            <field name="name">Advanced Accounting: automatic payment reminders</field>
            <field name="model_id" ref="model_ebshel_followup_desk"/>
            <field name="state">code</field>
            <field name="code">model._cron_followups()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_deferrals" model="ir.cron">
            <field name="name">Advanced Accounting: recognise deferrals</field>
            <field name="model_id" ref="model_ebshel_deferral"/>
            <field name="state">code</field>
            <field name="code">model._cron_post_due()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_ledger_scan" model="ir.cron">
            <field name="name">Advanced Accounting: ledger health scan</field>
            <field name="model_id" ref="model_ebshel_ledger_scanner"/>
            <field name="state">code</field>
            <field name="code">model._cron_scan()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
