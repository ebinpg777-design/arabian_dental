<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_deferral" model="ir.sequence">
            <field name="name">Deferral</field>
            <field name="code">ebshel.deferral</field>
            <field name="prefix">DEF/</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_budget" model="ir.sequence">
            <field name="name">Budget</field>
            <field name="code">ebshel.budget</field>
            <field name="prefix">BUD/</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_close" model="ir.sequence">
            <field name="name">Close period</field>
            <field name="code">ebshel.close.period</field>
            <field name="prefix">CLOSE/</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
