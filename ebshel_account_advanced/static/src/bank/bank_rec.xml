<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ebshel_account_advanced.BankRec">
        <div class="o_eaa o_action o_eaa_bank">
            <div class="o_eaa_head">
                <h2><i class="fa fa-university me-2"/>Bank reconciliation</h2>
                <div class="btn-group btn-group-sm ms-2" t-if="this.state.overview">
                    <button t-att-class="'btn ' + (this.state.tab === 'match' ? 'btn-primary' : 'btn-outline-primary')" t-on-click="() => this.setTab('match')"><i class="fa fa-link me-1"/>Match bank lines</button>
                    <button t-att-class="'btn ' + (this.state.tab === 'tick' ? 'btn-primary' : 'btn-outline-primary')" t-on-click="() => this.setTab('tick')"><i class="fa fa-check-square-o me-1"/>Tick the books</button>
                    <button t-att-class="'btn ' + (this.state.tab === 'paste' ? 'btn-primary' : 'btn-outline-primary')" t-on-click="() => this.setTab('paste')"><i class="fa fa-clipboard me-1"/>Paste a statement</button>
                </div>
                <div class="ms-auto d-flex gap-1">
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.refreshAll()" title="Refresh"><i class="fa fa-refresh"/></button>
                </div>
            </div>
            <div t-if="!this.state.overview" class="p-4 text-muted"><i class="fa fa-circle-o-notch fa-spin me-2"/>Reading the banks…</div>
            <div t-elif="!this.state.overview.journals.length" class="p-4 text-muted">No bank or cash journal with an account yet.</div>
            <div t-else="" class="o_eaa_bank_body">
                <!-- the banks, each with the numbers that matter -->
                <div class="o_eaa_banks">
                    <div t-foreach="this.state.overview.journals" t-as="j" t-key="j.id" t-att-class="'o_eaa_bankcard' + (j.id === this.state.journalId ? ' on' : '')" t-on-click="() => this.pickJournal(j.id)">
                        <div class="o_eaa_bankname"><i t-att-class="'fa me-1 ' + (j.type === 'bank' ? 'fa-university' : 'fa-money')"/><t t-out="j.name"/></div>
                        <div class="o_eaa_bankbal" t-out="this.money(j.book)"/>
                        <div class="o_eaa_bankmeta">
                            <span t-if="j.to_match" class="o_eaa_badge warn"><t t-out="j.to_match"/> to match</span>
                            <span t-if="j.uncleared" class="o_eaa_badge muted" t-att-title="this.money(j.deposits) + ' in, ' + this.money(j.payments) + ' out not yet at the bank'"><t t-out="j.uncleared"/> not at the bank</span>
                            <span t-if="j.checkpoint" t-att-class="'o_eaa_badge ' + (Math.abs(j.checkpoint.difference) &lt; 0.01 ? 'good' : 'bad')"
                                  t-att-title="'Bank balance ' + this.money(j.checkpoint.balance) + ' on ' + j.checkpoint.date">
                                <t t-if="Math.abs(j.checkpoint.difference) &lt; 0.01">agrees <t t-out="j.checkpoint.date"/></t><t t-else="">off by <t t-out="this.money(j.checkpoint.difference)"/></t>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- ============================================ MATCH -->
                <div t-if="this.state.tab === 'match'" class="o_eaa_match2">
                    <div class="o_eaa_panel o_eaa_lines">
                        <div class="o_eaa_toolbar">
                            <span t-foreach="[['open', 'To match'], ['done', 'Matched'], ['all', 'All']]" t-as="f" t-key="f[0]"
                                  t-att-class="'o_eaa_chip' + (this.state.lineState === f[0] ? ' on' : '')" t-on-click="() => { this.state.lineState = f[0]; this.loadLines(); }" t-out="f[1]"/>
                            <input class="form-control" placeholder="Label, partner or amount" t-att-value="this.state.search" t-on-change="(ev) => { this.state.search = ev.target.value; this.loadLines(); }"/>
                            <button class="btn btn-sm btn-primary ms-auto" t-if="this.state.overview.can_write and this.state.lineState !== 'done'" t-on-click="this.autoReconcile" t-att-disabled="this.state.busy"
                                    title="Rules, book twins and sure invoice matches, all at once"><i class="fa fa-magic me-1"/>Auto</button>
                        </div>
                        <div t-if="this.state.lines and !this.state.lines.rows.length" class="o_eaa_empty">
                            <t t-if="this.state.lineState === 'open'">Nothing to match. Paste the next statement from the third tab.</t><t t-else="">No bank lines.</t>
                        </div>
                        <div t-if="this.state.lines" class="o_eaa_linelist">
                            <div t-foreach="this.state.lines.rows" t-as="r" t-key="r.id" t-att-class="'o_eaa_stline' + (r.id === this.state.selectedId ? ' sel' : '') + (r.reconciled ? ' done' : '')" t-on-click="() => this.select(r.id)">
                                <div class="o_eaa_stl_top">
                                    <span class="o_eaa_stl_date" t-out="r.date"/>
                                    <span t-att-class="'o_eaa_stl_amt ' + (r.amount &gt;= 0 ? 'in' : 'out')" t-out="this.money(r.amount)"/>
                                </div>
                                <div class="o_eaa_stl_label" t-out="r.label"/>
                                <div class="o_eaa_stl_best">
                                    <t t-if="r.reconciled"><i class="fa fa-check text-success me-1"/><t t-out="r.matched.map((m) => m.with || m.account).join(', ')"/></t>
                                    <t t-elif="r.best">
                                        <span t-att-class="'o_eaa_badge ' + this.confClass(r.best.confidence)"><t t-out="r.best.confidence"/>%</span>
                                        <span class="text-muted" t-out="r.best.kind === 'rule' ? r.best.reason : (r.best.name + ' · ' + r.best.reason)"/>
                                    </t>
                                    <span t-else="" class="text-muted">no suggestion</span>
                                </div>
                            </div>
                        </div>
                        <div class="o_eaa_hint">↑ ↓ to move · Enter to accept the suggestion</div>
                    </div>

                    <div class="o_eaa_panel o_eaa_detail" t-if="this.state.detail">
                        <t t-set="d" t-value="this.state.detail"/>
                        <div class="o_eaa_det_head">
                            <div>
                                <div class="text-muted small"><t t-out="d.date"/><t t-if="d.rule"> · rule <t t-out="d.rule"/></t></div>
                                <div class="o_eaa_det_label" t-out="d.label"/>
                            </div>
                            <div t-att-class="'o_eaa_det_amt ' + (d.amount &gt;= 0 ? 'in' : 'out')" t-out="this.money(d.amount)"/>
                        </div>

                        <t t-if="d.reconciled">
                            <div class="o_eaa_ph mt-2">Reconciled with</div>
                            <table class="o_eaa_table">
                                <tbody><tr t-foreach="d.matched" t-as="m" t-key="m_index"><td t-out="m.account"/><td t-out="m.with || m.label"/><td t-out="m.partner"/><td class="num" t-out="this.money(m.amount)"/></tr></tbody>
                            </table>
                            <div class="mt-2" t-if="this.state.ruleOffer">
                                <div class="o_eaa_offer">
                                    <i class="fa fa-lightbulb-o me-1"/>Do this every time? Lines with
                                    <input class="form-control form-control-sm d-inline-block" style="width: 200px" t-custom-model="this.state.ruleOffer.keywords"/>
                                    go to <b t-out="this.state.ruleOffer.account"/>.
                                    <button class="btn btn-sm btn-primary ms-1" t-on-click="this.makeRule">Save the rule</button>
                                    <button class="btn btn-sm btn-link" t-on-click="() => this.state.ruleOffer = null">No</button>
                                </div>
                            </div>
                            <button class="btn btn-sm btn-outline-danger mt-2" t-if="this.state.overview.can_write" t-on-click="this.undo"><i class="fa fa-undo me-1"/>Undo</button>
                        </t>
                        <t t-else="">
                            <div class="o_eaa_ph mt-2">Best guesses</div>
                            <div t-if="!d.candidates.length" class="o_eaa_empty">No guess: search below, or write it off to an account.</div>
                            <div t-foreach="d.candidates" t-as="c" t-key="c.kind + c.id" class="o_eaa_cand">
                                <span t-att-class="'o_eaa_badge ' + this.confClass(c.confidence)"><t t-out="c.confidence"/>%</span>
                                <span t-att-class="'o_eaa_kind ' + c.kind" t-out="c.kind === 'book' ? 'in the books' : c.kind === 'open' ? 'open item' : 'rule'"/>
                                <div class="o_eaa_cand_main">
                                    <div><b t-out="c.name"/><span class="text-muted" t-if="c.partner"> · <t t-out="c.partner"/></span><span class="text-muted" t-if="c.account"> → <t t-out="c.account"/></span></div>
                                    <div class="small text-muted" t-out="c.reason"/>
                                </div>
                                <span class="num" t-if="c.amount !== undefined" t-out="this.money(c.amount)"/>
                                <button class="btn btn-sm btn-outline-primary o_eaa_btn" t-if="this.state.overview.can_write" t-on-click="() => this.useCandidate(c)" t-att-disabled="this.state.busy">
                                    <t t-out="c.kind === 'book' ? 'Tick' : c.kind === 'open' ? 'Add' : 'Apply'"/>
                                </button>
                            </div>

                            <div class="o_eaa_ph mt-3 d-flex align-items-center gap-2">Find
                                <span t-att-class="'o_eaa_chip' + (this.state.itemKind === 'open' ? ' on' : '')" t-on-click="() => this.setItemKind('open')">open invoices and bills</span>
                                <span t-att-class="'o_eaa_chip' + (this.state.itemKind === 'book' ? ' on' : '')" t-on-click="() => this.setItemKind('book')">items already in the books</span>
                            </div>
                            <input class="form-control form-control-sm mb-1" placeholder="Number, reference, partner or amount" t-custom-model="this.state.itemSearch" t-on-change="this.searchItems"/>
                            <div class="o_eaa_results">
                                <div t-foreach="this.state.itemResults" t-as="i" t-key="i.id" class="o_eaa_result">
                                    <div class="o_eaa_cand_main"><b t-out="i.name"/> <span class="text-muted" t-out="i.partner"/><div class="small text-muted"><t t-out="i.date"/><t t-if="i.ref"> · <t t-out="i.ref"/></t><t t-if="i.label and i.label !== i.name"> · <t t-out="i.label"/></t></div></div>
                                    <span class="num" t-out="this.money(i.amount)"/>
                                    <button class="btn btn-sm btn-outline-primary o_eaa_btn" t-if="this.state.overview.can_write" t-on-click="() => i.kind === 'book' ? this.booked(i.id) : this.addOpen(i)">
                                        <t t-out="i.kind === 'book' ? 'Tick' : 'Add'"/>
                                    </button>
                                </div>
                                <div t-if="!this.state.itemResults.length" class="o_eaa_empty">Nothing found.</div>
                            </div>

                            <div class="o_eaa_ph mt-3">This bank line is</div>
                            <div class="o_eaa_parts">
                                <div t-foreach="this.state.parts" t-as="p" t-key="p_index" class="o_eaa_part">
                                    <t t-if="p.kind === 'open'">
                                        <i class="fa fa-file-text-o text-muted"/><div class="o_eaa_cand_main"><b t-out="p.name"/> <span class="text-muted" t-out="p.partner"/></div>
                                        <span class="num" t-out="this.money(p.amount)"/>
                                    </t>
                                    <t t-else="">
                                        <select class="form-select form-select-sm" t-on-change="(ev) => this.accountFor(p, ev.target.value)">
                                            <option value="">Account…</option>
                                            <option t-foreach="d.accounts" t-as="a" t-key="a.id" t-att-value="a.id" t-att-selected="p.account_id === a.id" t-out="a.name"/>
                                        </select>
                                        <input class="form-control form-control-sm" t-custom-model="p.label" placeholder="Label"/>
                                        <input class="form-control form-control-sm num" style="max-width: 110px" type="number" step="0.01" t-custom-model="p.amount"/>
                                    </t>
                                    <button class="btn btn-sm btn-link text-danger o_eaa_btn" t-on-click="() => this.removePart(p_index)"><i class="fa fa-times"/></button>
                                </div>
                                <div class="o_eaa_partbar">
                                    <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.addAccount(null)" t-att-disabled="this.remaining &lt;= 0.005"><i class="fa fa-plus me-1"/>Write off to an account</button>
                                    <span class="ms-auto small">allocated <b t-out="this.money(this.allocated)"/> · left <b t-att-class="this.remaining > 0.005 ? 'text-warning' : 'text-success'" t-out="this.money(this.remaining)"/></span>
                                </div>
                                <div class="small text-muted" t-if="this.remaining > 0.005 and this.state.parts.length">Whatever is left stays on the suspense account, to match later.</div>
                            </div>
                            <button class="btn btn-primary mt-2" t-if="this.state.overview.can_write" t-on-click="this.reconcile" t-att-disabled="this.state.busy or !this.state.parts.length">
                                <i class="fa fa-check me-1"/>Reconcile
                            </button>
                        </t>
                    </div>
                </div>

                <!-- ============================================ TICK -->
                <div t-if="this.state.tab === 'tick' and this.state.brs" class="o_eaa_tick">
                    <t t-set="b" t-value="this.state.brs"/>
                    <div class="o_eaa_grid" style="grid-template-columns: minmax(300px, 1fr) minmax(0, 2fr)">
                        <div class="o_eaa_panel">
                            <div class="o_eaa_ph d-flex align-items-center">Reconciliation statement
                                <button class="btn btn-sm btn-link ms-auto" t-on-click="this.printBrs"><i class="fa fa-print me-1"/>PDF</button></div>
                            <label class="small text-muted">As at</label>
                            <input type="date" class="form-control form-control-sm mb-2" t-att-value="this.state.brsDate" t-on-change="(ev) => { this.state.brsDate = ev.target.value; this.loadBrs(); }"/>
                            <table class="o_eaa_brs">
                                <tr><td>Balance per books</td><td class="num" t-out="this.money(b.numbers.book)"/></tr>
                                <tr><td>Less deposits not yet at the bank</td><td class="num" t-out="this.money(-b.numbers.deposits)"/></tr>
                                <tr><td>Add payments not yet presented</td><td class="num" t-out="this.money(b.numbers.payments)"/></tr>
                                <tr class="tot"><td>The bank should show</td><td class="num" t-out="this.money(b.numbers.bank_expected)"/></tr>
                                <tr><td>The bank shows</td><td class="num"><input class="form-control form-control-sm num" type="number" step="0.01" t-custom-model="this.state.bankBalance" t-on-change="this.saveBalance" placeholder="from the statement"/></td></tr>
                                <tr t-if="this.difference !== null" t-att-class="'tot ' + (Math.abs(this.difference) &lt; 0.01 ? 'ok' : 'off')">
                                    <td><t t-if="Math.abs(this.difference) &lt; 0.01"><i class="fa fa-check-circle me-1"/>Reconciled</t><t t-else="">Still to explain</t></td>
                                    <td class="num" t-out="this.money(this.difference)"/>
                                </tr>
                            </table>
                            <div class="small text-muted mt-2"><t t-out="b.numbers.uncleared"/> item(s) not yet seen by the bank<t t-if="b.oldest_open">, the oldest from <t t-out="b.oldest_open"/></t>.</div>
                            <div class="o_eaa_baseline mt-3" t-if="b.can_write">
                                <div class="o_eaa_ph">First time here?</div>
                                <div class="small text-muted mb-1">Mark everything booked up to the day the bank last agreed with you as already seen.</div>
                                <div class="d-flex gap-1"><input type="date" class="form-control form-control-sm" t-custom-model="this.state.baselineDate"/>
                                    <button class="btn btn-sm btn-outline-secondary" t-on-click="this.baseline">Set the baseline</button></div>
                            </div>
                        </div>
                        <div class="o_eaa_panel">
                            <div class="o_eaa_toolbar">
                                <span t-foreach="[['uncleared', 'Not at the bank yet'], ['cleared', 'Seen by the bank'], ['all', 'All']]" t-as="f" t-key="f[0]"
                                      t-att-class="'o_eaa_chip' + (this.state.brsShow === f[0] ? ' on' : '')" t-on-click="() => { this.state.brsShow = f[0]; this.loadBrs(); }" t-out="f[1]"/>
                                <input class="form-control" placeholder="Number, partner or amount" t-att-value="this.state.brsSearch" t-on-change="(ev) => { this.state.brsSearch = ev.target.value; this.loadBrs(); }"/>
                                <span class="small text-muted ms-auto"><t t-out="b.items.length"/> of <t t-out="b.total"/></span>
                            </div>
                            <div class="o_eaa_toolbar" t-if="b.can_write">
                                <span class="small">Selected <b t-out="this.tickedIds.length"/>:</span>
                                <span class="small">cleared on</span><input type="date" class="form-control" t-custom-model="this.state.clearDate"/>
                                <button class="btn btn-sm btn-primary" t-on-click="() => this.clearSelected()"><i class="fa fa-check me-1"/>Tick</button>
                                <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.clearSelected(false)">Untick</button>
                            </div>
                            <div style="overflow-x:auto">
                                <table class="o_eaa_table">
                                    <thead><tr><th><input type="checkbox" t-on-change="this.tickAll"/></th><th>Date</th><th>Entry</th><th>Label</th><th>Partner</th><th class="num">In</th><th class="num">Out</th><th class="num">Days</th><th>Bank</th><th/></tr></thead>
                                    <tbody>
                                        <tr t-foreach="b.items" t-as="i" t-key="i.id" t-att-class="(this.state.ticked[i.id] ? 'sel ' : '') + (i.stale ? 'stale' : '')">
                                            <td><input type="checkbox" t-att-checked="this.state.ticked[i.id]" t-on-change="(ev) => this.state.ticked[i.id] = ev.target.checked"/></td>
                                            <td t-out="i.date"/>
                                            <td><a href="#" t-on-click.prevent="() => this.openMove(i.move_id)" t-out="i.name"/></td>
                                            <td class="o_eaa_trunc" t-out="i.label"/>
                                            <td class="o_eaa_trunc" t-out="i.partner"/>
                                            <td class="num text-success" t-out="i.amount > 0 ? this.money(i.amount) : ''"/>
                                            <td class="num text-danger" t-out="i.amount &lt; 0 ? this.money(-i.amount) : ''"/>
                                            <td t-att-class="'num ' + (i.stale ? 'text-danger fw-bold' : '')" t-out="i.age"/>
                                            <td class="small"><t t-if="i.cleared"><i class="fa fa-check text-success"/> <t t-out="i.cleared"/></t></td>
                                            <td><button class="btn btn-sm btn-link o_eaa_btn" t-if="b.can_write" t-on-click="() => this.clearOne(i)" t-att-title="i.cleared ? 'Untick' : 'Tick as cleared'"><i t-att-class="'fa ' + (i.cleared ? 'fa-undo' : 'fa-check')"/></button></td>
                                        </tr>
                                        <tr t-if="!b.items.length"><td colspan="10" class="o_eaa_empty">Nothing here.</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ============================================ PASTE -->
                <div t-if="this.state.tab === 'paste'" class="o_eaa_paste o_eaa_panel">
                    <div class="o_eaa_ph">Paste the statement from Excel, a PDF or the bank's website - or open its CSV</div>
                    <textarea class="form-control o_eaa_pastebox" rows="8" t-custom-model="this.state.pasteText" t-on-input="this.parse"
                              placeholder="01/09/2026&#9;NEFT-CLINIC PAYMENT INV/2026/0012&#9;&#9;15,000.00&#9;2,45,000.00"/>
                    <div class="d-flex gap-2 align-items-center mt-1">
                        <input type="file" accept=".csv,.txt,.tsv" class="form-control form-control-sm" style="max-width: 280px" t-on-change="this.onFile"/>
                        <label class="small ms-auto"><input type="checkbox" t-custom-model="this.state.tickOnImport"/> tick rows the books already hold instead of adding them</label>
                    </div>
                    <t t-if="this.state.parsed and this.state.map">
                        <div class="o_eaa_toolbar mt-2">
                            <t t-foreach="[['date', 'Date'], ['label', 'Label'], ['amount', 'Amount (signed)'], ['debit', 'Money out'], ['credit', 'Money in']]" t-as="k" t-key="k[0]">
                                <span class="small" t-out="k[1]"/>
                                <select class="form-select" t-on-change="(ev) => this.setMap(k[0], ev)">
                                    <option value="-1">–</option>
                                    <option t-foreach="this.columns" t-as="c" t-key="c" t-att-value="c" t-att-selected="this.state.map[k[0]] === c" t-out="this.colLabel(c)"/>
                                </select>
                            </t>
                            <label class="small"><input type="checkbox" t-custom-model="this.state.map.hasHeader"/> first row is a header</label>
                        </div>
                        <table class="o_eaa_table mt-1">
                            <thead><tr><th>Date</th><th>Label</th><th class="num">Amount</th><th/></tr></thead>
                            <tbody>
                                <tr t-foreach="this.preview.slice(0, 50)" t-as="r" t-key="r_index" t-att-class="r.ok ? '' : 'text-muted'">
                                    <td t-out="r.date || '?'"/><td class="o_eaa_trunc" t-out="r.label"/>
                                    <td t-att-class="'num ' + (r.amount &gt; 0 ? 'text-success' : 'text-danger')" t-out="r.amount === null ? '?' : this.money(r.amount)"/>
                                    <td><i t-if="!r.ok" class="fa fa-exclamation-triangle text-warning" title="No date or no amount: skipped"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="d-flex align-items-center gap-2 mt-2">
                            <span class="small"><b t-out="this.preview.filter((r) => r.ok).length"/> row(s) ready<t t-if="this.preview.length > 50">, first 50 shown</t></span>
                            <button class="btn btn-primary ms-auto" t-if="this.state.overview.can_write" t-on-click="this.doImport" t-att-disabled="this.state.busy"><i class="fa fa-upload me-1"/>Import into <t t-out="this.journal ? this.journal.name : ''"/></button>
                        </div>
                    </t>
                    <div class="o_eaa_offer mt-2" t-if="this.state.importResult">
                        <i class="fa fa-check-circle me-1 text-success"/>
                        <b t-out="this.state.importResult.ticked"/> ticked in the books, <b t-out="this.state.importResult.created"/> new bank line(s)
                        (<t t-out="this.state.importResult.ruled"/> reconciled by rules), <t t-out="this.state.importResult.duplicates"/> duplicate(s) skipped.
                        <t t-if="this.state.importResult.errors.length"><div class="small text-danger" t-out="this.state.importResult.errors.slice(0, 5).join('; ')"/></t>
                        <button class="btn btn-sm btn-link" t-on-click="() => this.setTab('match')">Match the new lines →</button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
