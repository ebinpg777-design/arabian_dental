<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ebshel_account_advanced.FollowupDesk">
        <div class="o_eaa o_action o_eaa_followup">
            <div class="o_eaa_head">
                <h2><i class="oi me-2" data-icon="notifications"/>Collections desk</h2>
                <span class="o_eaa_sub" t-if="this.state.data">as of <t t-out="this.state.data.today"/><t t-if="!this.state.data.auto"> · automatic reminders are off in the settings</t></span>
                <div class="ms-auto d-flex gap-1">
                    <button class="btn btn-sm btn-primary" t-if="this.state.data and this.state.data.can_write" t-on-click="this.sendAllDue"><i class="oi me-1" data-icon="send"/>Send every reminder due</button>
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.open('send')" t-if="this.state.data and this.state.data.can_write" title="Send the selected customers a reminder"><i class="oi" data-icon="mail"/></button>
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.printLetters()" t-if="this.state.data and this.state.data.can_write" title="Print letters for the selected customers"><i class="oi" data-icon="print"/></button>
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.load()"><i class="oi" data-icon="refresh"/></button>
                </div>
            </div>
            <div t-if="this.state.loading and !this.state.data" class="p-4 text-muted"><i class="oi oi-spin me-2" data-icon="autorenew"/>Reading the ledger…</div>
            <div t-elif="this.state.data" class="o_eaa_body">
                <div class="o_eaa_kpis">
                    <div class="o_eaa_kpi"><div class="o_eaa_kl">Receivable</div><div class="o_eaa_kv" t-out="this.money(this.state.data.kpis.receivable)"/><div class="o_eaa_ks"><t t-out="this.state.data.total_rows"/> customers</div></div>
                    <div class="o_eaa_kpi bad"><div class="o_eaa_kl">Overdue</div><div class="o_eaa_kv" t-out="this.money(this.state.data.kpis.overdue)"/><div class="o_eaa_ks"><t t-out="this.state.data.kpis.receivable ? Math.round(this.state.data.kpis.overdue / this.state.data.kpis.receivable * 100) : 0"/>% of receivable</div></div>
                    <div class="o_eaa_kpi warn clickable" t-on-click="() => this.setFilter('state', ['action'])"><div class="o_eaa_kl">Reminders due</div><div class="o_eaa_kv" t-out="this.state.data.kpis.action"/><div class="o_eaa_ks">customers to remind</div></div>
                    <div class="o_eaa_kpi info clickable" t-on-click="() => this.setFilter('state', ['promised'])"><div class="o_eaa_kl">Promised</div><div class="o_eaa_kv" t-out="this.money(this.state.data.kpis.promised)"/><div class="o_eaa_ks">payment promised</div></div>
                    <div class="o_eaa_kpi"><div class="o_eaa_kl">DSO</div><div class="o_eaa_kv"><t t-out="this.state.data.kpis.dso !== null ? this.state.data.kpis.dso : '–'"/></div><div class="o_eaa_ks">days sales outstanding</div></div>
                    <div class="o_eaa_kpi"><div class="o_eaa_kl">Unallocated</div><div class="o_eaa_kv" t-out="this.money(this.state.data.kpis.unallocated)"/><div class="o_eaa_ks">credits not applied</div></div>
                    <div class="o_eaa_kpi muted"><div class="o_eaa_kl">On hold</div><div class="o_eaa_kv" t-out="this.state.data.kpis.on_hold"/><div class="o_eaa_ks">customers</div></div>
                </div>
                <div class="o_eaa_panel mb-2">
                    <div class="o_eaa_ph">Overdue by age</div>
                    <div class="o_eaa_stack">
                        <t t-foreach="this.state.data.buckets" t-as="b" t-key="b.label">
                            <div class="seg" t-attf-style="width: {{ b.value / this.bucketTotal * 100 }}%; background: {{ ['#8fb3d9', '#5f8fc4', '#b45309', '#b42318', '#7a1a12'][b_index] }}" t-att-title="b.label + ': ' + this.money(b.value)"/>
                        </t>
                    </div>
                    <div class="d-flex flex-wrap gap-3 mt-1 small text-muted">
                        <span t-foreach="this.state.data.buckets" t-as="b" t-key="b.label"><b t-out="b.label"/> days: <t t-out="this.compact(b.value)"/></span>
                    </div>
                </div>
                <div class="o_eaa_toolbar">
                    <span t-foreach="this.state.data.states" t-as="s" t-key="s.key" t-att-class="'o_eaa_chip' + (this.state.filters.state.includes(s.key) ? ' on' : '')" t-on-click="() => this.toggleState(s.key)" t-out="s.label"/>
                    <select class="form-select" t-on-change="(ev) => this.setFilter('responsible_id', +ev.target.value || false)">
                        <option value="">Any responsible</option>
                        <option t-foreach="this.state.data.users" t-as="u" t-key="u.id" t-att-value="u.id" t-att-selected="this.state.filters.responsible_id === u.id" t-out="u.name"/>
                    </select>
                    <select class="form-select" t-on-change="(ev) => this.setFilter('sort', ev.target.value)">
                        <option value="overdue">Most overdue first</option><option value="days">Oldest first</option><option value="due">Largest balance</option><option value="name">By name</option>
                    </select>
                    <input class="form-control" placeholder="Search customers…" t-att-value="this.state.filters.search" t-on-change="(ev) => this.setFilter('search', ev.target.value)"/>
                    <span class="small text-muted ms-auto"><t t-out="this.rows.length"/> of <t t-out="this.state.data.total_rows"/></span>
                </div>
                <div class="o_eaa_panel" style="overflow-x:auto">
                    <table class="o_eaa_table">
                        <thead><tr>
                            <th><input type="checkbox" t-on-change="this.toggleAll"/></th><th>Customer</th><th class="num">Overdue</th><th style="min-width:90px"/><th class="num">Balance</th><th class="num">Days</th>
                            <th>Status</th><th>Level</th><th>Next</th><th>Responsible</th><th>Last action</th><th/>
                        </tr></thead>
                        <tbody>
                            <tr t-if="!this.rows.length"><td colspan="12" class="o_eaa_empty">Nobody matches these filters.</td></tr>
                            <tr t-foreach="this.rows" t-as="r" t-key="r.id" t-att-class="this.state.selected[r.id] ? 'sel' : ''">
                                <td><input type="checkbox" t-att-checked="this.state.selected[r.id]" t-on-change="(ev) => this.state.selected[r.id] = ev.target.checked"/></td>
                                <td><a href="#" t-on-click.prevent="() => this.openDetail(r.id)"><b t-out="r.name"/></a>
                                    <span t-if="r.on_hold" class="o_eaa_badge bad ms-1">on hold</span>
                                    <span t-if="!r.email" class="o_eaa_badge warn ms-1" title="No email address">no email</span></td>
                                <td class="num"><b t-out="this.money(r.overdue)"/></td>
                                <td><div class="o_eaa_bar"><div t-att-class="'fill ' + (r.days > 60 ? 'bad' : r.days > 30 ? 'warn' : '')" t-attf-style="width: {{ r.overdue / this.maxOverdue * 100 }}%"/></div></td>
                                <td class="num" t-out="this.money(r.due)"/>
                                <td class="num" t-out="r.days || ''"/>
                                <td><span t-att-class="'o_eaa_badge ' + this.stateClass(r.state)" t-out="r.state_label"/></td>
                                <td class="small"><t t-out="r.level || '–'"/><t t-if="r.suggested and r.suggested.name !== r.level"> → <b t-out="r.suggested.name"/></t></td>
                                <td class="small"><t t-if="r.promise_date"><i class="oi text-info" data-icon="handshake"/> <t t-out="this.fmtDate(r.promise_date)"/></t><t t-elif="r.next_date" t-out="this.fmtDate(r.next_date)"/></td>
                                <td><select class="form-select form-select-sm" style="font-size:.72rem;padding:.05rem 1.2rem .05rem .3rem" t-on-change="(ev) => this.setResponsible(r, ev)" t-att-disabled="!this.state.data.can_write">
                                    <option value="">–</option>
                                    <option t-foreach="this.state.data.users" t-as="u" t-key="u.id" t-att-value="u.id" t-att-selected="r.responsible_id === u.id" t-out="u.name"/>
                                </select></td>
                                <td class="small text-muted"><t t-if="r.last_action"><t t-out="r.last_action.label"/> · <t t-out="this.fmtDate(r.last_action.date)"/></t></td>
                                <td class="text-nowrap" t-if="this.state.data.can_write">
                                    <button class="btn btn-sm btn-outline-primary o_eaa_btn" t-on-click="() => this.open('send', r)" title="Send the reminder"><i class="oi" data-icon="mail"/></button>
                                    <button class="btn btn-sm btn-outline-secondary o_eaa_btn" t-on-click="() => this.open('call', r)" title="Log a call"><i class="oi" data-icon="phone"/></button>
                                    <button class="btn btn-sm btn-outline-secondary o_eaa_btn" t-on-click="() => this.open('promise', r)" title="Promise to pay"><i class="oi" data-icon="handshake"/></button>
                                    <button class="btn btn-sm btn-outline-secondary o_eaa_btn" t-on-click="() => this.open('snooze', r)" title="Snooze"><i class="oi" data-icon="schedule"/></button>
                                    <button class="btn btn-sm btn-outline-secondary o_eaa_btn" t-on-click="() => this.flag(r, 'on_hold', !r.on_hold)" t-att-title="r.on_hold ? 'Release' : 'Put on hold'"><i class="oi" t-att-data-icon="r.on_hold ? 'lock_open' : 'lock'"/></button>
                                    <button class="btn btn-sm btn-outline-secondary o_eaa_btn" t-on-click="() => this.flag(r, 'excluded', !r.excluded)" t-att-title="r.excluded ? 'Remind again' : 'Never remind'"><i class="oi" t-att-data-icon="r.excluded ? 'notifications' : 'notifications_off'"/></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="o_eaa_side" t-if="this.state.detail">
                <div class="o_eaa_side_h">
                    <h4 t-out="this.state.detail.name"/>
                    <button class="btn btn-sm btn-link" t-on-click="() => this.openPartner(this.state.detail.id)" title="Open the customer"><i class="oi" data-icon="open_in_new"/></button>
                    <button class="btn btn-sm btn-link" t-on-click="() => this.openStatement(this.state.detail.id)" title="Statement of account"><i class="oi" data-icon="description"/></button>
                    <button class="btn btn-sm btn-link ms-auto" t-on-click="this.closeDetail"><i class="oi" data-icon="close"/></button>
                </div>
                <div class="o_eaa_side_b">
                    <div class="small text-muted mb-2">
                        <span t-if="this.state.detail.emails.length"><i class="oi" data-icon="mail"/> <t t-out="this.state.detail.emails.join(', ')"/></span>
                        <span t-if="this.state.detail.phone" class="ms-2"><i class="oi" data-icon="phone"/> <t t-out="this.state.detail.phone"/></span>
                        <span t-if="this.state.detail.habit.to_pay !== null and this.state.detail.habit.to_pay !== undefined" class="ms-2">pays in <b t-out="this.state.detail.habit.to_pay"/> days (<t t-out="this.state.detail.habit.late"/> late)</span>
                    </div>
                    <div class="o_eaa_ph">Open items</div>
                    <table class="o_eaa_table mb-3">
                        <thead><tr><th>Document</th><th>Due</th><th class="num">Days</th><th class="num">Open</th></tr></thead>
                        <tbody>
                            <tr t-foreach="this.state.detail.items" t-as="it" t-key="it.id" class="clickable" t-on-click="() => this.openMove(it.move_id)">
                                <td><t t-out="it.name"/><span t-if="it.kind === 'credit'" class="o_eaa_badge info ms-1">credit</span></td>
                                <td t-out="this.fmtDate(it.due)"/>
                                <td t-att-class="'num ' + (it.days > 0 and it.kind === 'invoice' ? 'text-danger' : '')" t-out="it.kind === 'invoice' ? it.days : ''"/>
                                <td class="num" t-out="this.money(it.residual)"/>
                            </tr>
                        </tbody>
                    </table>
                    <div class="o_eaa_ph">Notes for the next call</div>
                    <textarea class="form-control form-control-sm mb-1" rows="3" t-model.proxy="this.state.detail.note"/>
                    <button class="btn btn-sm btn-outline-secondary mb-3" t-on-click="this.saveNote" t-if="this.state.data.can_write">Save note</button>
                    <div class="o_eaa_ph">History</div>
                    <div class="o_eaa_timeline">
                        <div t-if="!this.state.detail.actions.length" class="o_eaa_empty">Nothing yet.</div>
                        <div t-foreach="this.state.detail.actions" t-as="a" t-key="a.id" class="ev">
                            <b t-out="a.label"/><t t-if="a.level"> · <t t-out="a.level"/></t> <span class="text-muted" t-out="this.fmtDate(a.date)"/><span class="text-muted" t-if="a.user"> · <t t-out="a.user"/></span>
                            <div t-if="a.note" class="text-muted" t-out="a.note"/>
                            <div t-if="a.promise_date" class="text-info">for <t t-out="this.fmtDate(a.promise_date)"/>, <t t-out="this.money(a.amount)"/></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="o_eaa_modal" t-if="this.state.modal" t-on-click.self="this.close">
                <div class="o_eaa_modal_c">
                    <t t-if="this.state.modal.kind === 'send'">
                        <h5>Send a reminder to <t t-out="this.state.modal.ids.length"/> customer(s)</h5>
                        <label>Level</label>
                        <select class="form-select form-select-sm" t-model.proxy="this.state.form.level_id">
                            <option value="">the level each customer has reached</option>
                            <option t-foreach="this.state.data.levels" t-as="l" t-key="l.id" t-att-value="l.id"><t t-out="l.name"/> (<t t-out="l.days"/> days, <t t-out="l.action"/>)</option>
                        </select>
                        <label>Add a line</label>
                        <textarea class="form-control form-control-sm" rows="2" t-model.proxy="this.state.form.note"/>
                    </t>
                    <t t-if="this.state.modal.kind === 'call'">
                        <h5>Log a call with <t t-out="this.state.modal.row.name"/></h5>
                        <label>What was said</label>
                        <textarea class="form-control form-control-sm" rows="3" t-model.proxy="this.state.form.note"/>
                        <label>Follow up again on</label>
                        <input type="date" class="form-control form-control-sm" t-model.proxy="this.state.form.next_date"/>
                    </t>
                    <t t-if="this.state.modal.kind === 'promise'">
                        <h5><t t-out="this.state.modal.row.name"/> promises to pay</h5>
                        <label>On</label><input type="date" class="form-control form-control-sm" t-model.proxy="this.state.form.date"/>
                        <label>Amount</label><input type="number" step="0.01" class="form-control form-control-sm" t-model.proxy="this.state.form.amount"/>
                        <label>Note</label><input class="form-control form-control-sm" t-model.proxy="this.state.form.note"/>
                    </t>
                    <t t-if="this.state.modal.kind === 'snooze'">
                        <h5>Snooze <t t-out="this.state.modal.row.name"/></h5>
                        <label>Days</label><input type="number" class="form-control form-control-sm" t-model.proxy="this.state.form.days"/>
                        <label>Why</label><input class="form-control form-control-sm" t-model.proxy="this.state.form.note"/>
                    </t>
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button class="btn btn-sm btn-secondary" t-on-click="this.close">Cancel</button>
                        <button class="btn btn-sm btn-primary" t-on-click="this.submit" t-att-disabled="this.state.busy"><i t-if="this.state.busy" class="oi oi-spin me-1" data-icon="autorenew"/>Confirm</button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
