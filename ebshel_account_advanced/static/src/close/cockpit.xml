<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ebshel_account_advanced.CloseCockpit">
        <div class="o_eaa o_action o_eaa_close">
            <div class="o_eaa_head">
                <h2><i class="oi me-2" data-icon="speed"/>Close cockpit</h2>
                <select class="form-select form-select-sm" style="width:auto" t-if="this.state.data and this.state.data.periods.length" t-on-change="this.pick">
                    <option t-foreach="this.state.data.periods" t-as="p" t-key="p.id" t-att-value="p.id" t-att-selected="this.state.data.period and p.id === this.state.data.period.id"><t t-out="p.name"/> · <t t-out="p.state"/> · <t t-out="p.progress"/>%</option>
                </select>
                <div class="ms-auto d-flex gap-1">
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="this.startCreate" t-if="this.state.data and this.state.data.can_write"><i class="oi me-1" data-icon="add"/>New period</button>
                    <button class="btn btn-sm btn-outline-secondary" t-if="this.state.data and this.state.data.period" t-on-click="this.openPeriod"><i class="oi" data-icon="edit"/></button>
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.load()"><i class="oi" data-icon="refresh"/></button>
                </div>
            </div>
            <div t-if="this.state.creating" class="o_eaa_body pb-0">
                <div class="o_eaa_panel d-flex flex-wrap gap-2 align-items-end">
                    <div><label class="small text-muted">Name</label><input class="form-control form-control-sm" t-model.proxy="this.state.form.name"/></div>
                    <div><label class="small text-muted">From</label><input type="date" class="form-control form-control-sm" t-model.proxy="this.state.form.from"/></div>
                    <div><label class="small text-muted">To</label><input type="date" class="form-control form-control-sm" t-model.proxy="this.state.form.to"/></div>
                    <button class="btn btn-sm btn-primary" t-on-click="this.create">Create with the checklist</button>
                    <button class="btn btn-sm btn-secondary" t-on-click="() => this.state.creating = false">Cancel</button>
                </div>
            </div>
            <div t-if="this.state.loading and !this.state.data" class="p-4 text-muted"><i class="oi oi-spin me-2" data-icon="autorenew"/>Running the checks…</div>
            <div t-elif="this.state.data and !this.state.data.period" class="p-4 text-muted">No close period yet. Create one for last month: the checklist comes from the templates and every check counts what is still to fix.</div>
            <div t-elif="this.state.data" class="o_eaa_body">
                <div class="o_eaa_grid" style="grid-template-columns: 300px minmax(0, 1fr)">
                    <div class="o_eaa_panel text-center">
                        <svg viewBox="0 0 110 110" class="o_eaa_ring">
                            <circle cx="55" cy="55" t-att-r="this.ring.r" fill="none" stroke="#e6eaf0" stroke-width="10"/>
                            <circle cx="55" cy="55" t-att-r="this.ring.r" fill="none" t-att-stroke="this.state.data.period.state === 'closed' ? '#067647' : this.state.data.period.blocking ? '#b45309' : '#1f3a5f'" stroke-width="10" stroke-linecap="round"
                                    t-att-stroke-dasharray="this.ring.c" t-att-stroke-dashoffset="this.ring.off" transform="rotate(-90 55 55)"/>
                            <text x="55" y="60" text-anchor="middle" font-size="20" font-weight="700" fill="#1f3a5f"><t t-out="this.ring.p"/>%</text>
                        </svg>
                        <div><b t-out="this.state.data.period.name"/> <span t-att-class="'o_eaa_badge ' + (this.state.data.period.state === 'closed' ? 'good' : this.state.data.period.state === 'review' ? 'warn' : 'info')" t-out="this.state.data.period.state"/></div>
                        <div class="small text-muted"><t t-out="this.state.data.period.from"/> → <t t-out="this.state.data.period.to"/> · <t t-out="this.state.data.period.done"/>/<t t-out="this.state.data.period.total"/> done</div>
                        <div class="small text-danger mt-1" t-if="this.state.data.period.blocking"><i class="oi" data-icon="error"/> <t t-out="this.state.data.period.blocking"/> check(s) still find something</div>
                        <div class="small text-muted mt-1" t-if="this.state.data.period.closed_on">closed <t t-out="this.state.data.period.closed_on"/> by <t t-out="this.state.data.period.closed_by"/></div>
                        <div class="mt-2 d-flex flex-column gap-1" t-if="this.state.data.can_write">
                            <button class="btn btn-sm btn-primary" t-if="this.state.data.period.state !== 'closed'" t-on-click="this.closePeriod" t-att-disabled="this.state.busy or this.state.data.period.done &lt; this.state.data.period.total"><i class="oi me-1" data-icon="lock"/>Close the period<t t-if="this.state.data.period.lock_books and !this.state.data.can_lock"> (manager)</t></button>
                            <button class="btn btn-sm btn-outline-secondary" t-else="" t-on-click="this.reopen"><i class="oi me-1" data-icon="lock_open"/>Reopen</button>
                        </div>
                        <div class="mt-3 text-start small">
                            <div class="o_eaa_ph">Lock dates</div>
                            <div>Books: <b t-out="this.state.data.locks.fiscal || 'none'"/></div>
                            <div>Tax: <b t-out="this.state.data.locks.tax || 'none'"/></div>
                            <div>Sales: <b t-out="this.state.data.locks.sale || 'none'"/> · Purchases: <b t-out="this.state.data.locks.purchase || 'none'"/></div>
                        </div>
                    </div>
                    <div>
                        <div class="o_eaa_panel mb-2">
                            <div class="o_eaa_ph">Automatic checks <span class="text-muted">— live counts; a check ticks itself when it finds nothing</span></div>
                            <div t-foreach="this.checks" t-as="t" t-key="t.id" t-att-class="'o_eaa_check ' + t.state + (t.blocking ? ' blocking' : '')">
                                <div class="ic"><i class="oi" t-att-data-icon="t.state === 'done' ? 'check' : t.state === 'skipped' ? 'skip_next' : t.blocking ? 'priority_high' : 'radio_button_unchecked'"/></div>
                                <div class="nm"><t t-out="t.name"/>
                                    <span t-if="t.count" t-att-class="'o_eaa_badge ms-1 ' + (t.state === 'todo' ? 'bad' : 'muted')"><t t-out="t.count"/><t t-if="t.amount"> · <t t-out="this.money(t.amount)"/></t></span>
                                    <div t-if="this.state.noteFor === t.id" class="mt-1"><input class="form-control form-control-sm" placeholder="Why it is skipped / a note" t-model.proxy="this.state.note"/></div>
                                    <div t-elif="t.note" class="small text-muted" t-out="t.note"/>
                                </div>
                                <div class="acts">
                                    <button class="btn btn-sm btn-outline-secondary o_eaa_btn" t-if="t.count" t-on-click="() => this.openTask(t)" title="Open the records"><i class="oi" data-icon="search"/></button>
                                    <t t-if="this.state.data.can_write and this.state.data.period.state !== 'closed'">
                                        <button class="btn btn-sm btn-outline-secondary o_eaa_btn" t-if="t.state === 'todo'" t-on-click="() => this.skipTask(t)" title="Skip with a note"><i class="oi" data-icon="skip_next"/></button>
                                        <button class="btn btn-sm btn-outline-secondary o_eaa_btn" t-if="t.state !== 'todo'" t-on-click="() => this.setTask(t, 'todo')" title="Back to do"><i class="oi" data-icon="undo"/></button>
                                    </t>
                                </div>
                            </div>
                        </div>
                        <div class="o_eaa_panel">
                            <div class="o_eaa_ph">Tasks</div>
                            <div t-foreach="this.manual" t-as="t" t-key="t.id" t-att-class="'o_eaa_check ' + t.state">
                                <div class="ic"><i class="oi" t-att-data-icon="t.state === 'done' ? 'check' : t.state === 'skipped' ? 'skip_next' : 'radio_button_unchecked'"/></div>
                                <div class="nm"><t t-out="t.name"/>
                                    <div t-if="this.state.noteFor === t.id" class="mt-1"><input class="form-control form-control-sm" placeholder="Note" t-model.proxy="this.state.note"/></div>
                                    <div t-elif="t.note" class="small text-muted" t-out="t.note"/>
                                    <div t-if="t.done_by" class="small text-muted"><t t-out="t.state"/> by <t t-out="t.done_by"/> on <t t-out="t.done_on"/></div>
                                </div>
                                <select class="form-select form-select-sm" style="width:auto;font-size:.72rem;padding:.05rem 1.2rem .05rem .3rem" t-on-change="(ev) => this.assign(t, ev)" t-att-disabled="!this.state.data.can_write">
                                    <option value="">unassigned</option>
                                    <option t-foreach="this.state.data.users" t-as="u" t-key="u.id" t-att-value="u.id" t-att-selected="t.owner_id === u.id" t-out="u.name"/>
                                </select>
                                <div class="acts" t-if="this.state.data.can_write and this.state.data.period.state !== 'closed'">
                                    <button class="btn btn-sm btn-outline-success o_eaa_btn" t-if="t.state === 'todo'" t-on-click="() => this.setTask(t, 'done')" title="Done"><i class="oi" data-icon="check"/></button>
                                    <button class="btn btn-sm btn-outline-secondary o_eaa_btn" t-if="t.state === 'todo'" t-on-click="() => this.skipTask(t)" title="Skip with a note"><i class="oi" data-icon="skip_next"/></button>
                                    <button class="btn btn-sm btn-outline-secondary o_eaa_btn" t-if="t.state !== 'todo'" t-on-click="() => this.setTask(t, 'todo')" title="Back to do"><i class="oi" data-icon="undo"/></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
