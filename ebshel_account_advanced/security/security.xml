<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- An accounting Administrator gets the full accounting features: in Odoo 19 the
         role alone implies only billing, which hides Journal Entries, Journal Items,
         Analytic Items and the statement reports from the people who run the books. -->
    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_followup_level_company" model="ir.rule">
            <field name="name">Follow-up levels: own companies</field>
            <field name="model_id" ref="model_ebshel_followup_level"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_budget_company" model="ir.rule">
            <field name="name">Budgets: own companies</field>
            <field name="model_id" ref="model_ebshel_budget"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_deferral_company" model="ir.rule">
            <field name="name">Deferrals: own companies</field>
            <field name="model_id" ref="model_ebshel_deferral"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_close_period_company" model="ir.rule">
            <field name="name">Close periods: own companies</field>
            <field name="model_id" ref="model_ebshel_close_period"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_cash_item_company" model="ir.rule">
            <field name="name">Cash forecast items: own companies</field>
            <field name="model_id" ref="model_ebshel_cash_item"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_finding_company" model="ir.rule">
            <field name="name">Ledger findings: own companies</field>
            <field name="model_id" ref="model_ebshel_ledger_finding"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_bank_rule_company" model="ir.rule">
            <field name="name">Bank rules: own companies</field>
            <field name="model_id" ref="model_ebshel_bank_rule"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_bank_checkpoint_company" model="ir.rule">
            <field name="name">Bank balances: own companies</field>
            <field name="model_id" ref="model_ebshel_bank_checkpoint"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_entry_template_company" model="ir.rule">
            <field name="name">Entry templates: own companies</field>
            <field name="model_id" ref="model_ebshel_entry_template"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
