<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_entry_template_list" model="ir.ui.view">
        <field name="name">ebshel.entry.template.list</field>
        <field name="model">ebshel.entry.template</field>
        <field name="arch" type="xml">
            <list string="Entry templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="journal_id"/>
                <field name="ref"/>
                <field name="use_count"/>
            </list>
        </field>
    </record>
    <record id="view_entry_template_form" model="ir.ui.view">
        <field name="name">ebshel.entry.template.form</field>
        <field name="model">ebshel.entry.template</field>
        <field name="arch" type="xml">
            <form string="Entry template">
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Monthly rent split by branch"/></h1></div>
                    <group>
                        <group><field name="journal_id"/><field name="ref"/></group>
                        <group><field name="note"/><field name="use_count" readonly="1"/><field name="company_id" groups="base.group_multi_company"/></group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="account_id"/>
                            <field name="label"/>
                            <field name="partner_id" optional="show"/>
                            <field name="analytic_account_id" optional="show" groups="analytic.group_analytic_accounting"/>
                            <field name="side"/>
                            <field name="share"/>
                            <field name="fixed"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_entry_templates" model="ir.actions.act_window">
        <field name="name">Entry Templates</field>
        <field name="res_model">ebshel.entry.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Entries you write every month</p><p>Save one from the Entry Studio, or build it here: lines take a share of the amount you type, or a fixed amount.</p></field>
    </record>

    <record id="view_analytic_redistribute_form" model="ir.ui.view">
        <field name="name">ebshel.analytic.redistribute.form</field>
        <field name="model">ebshel.analytic.redistribute</field>
        <field name="arch" type="xml">
            <form string="Redistribute analytic accounts">
                <div class="alert alert-info" role="alert">
                    <b><field name="count" readonly="1" class="d-inline"/></b> journal item(s), <field name="with_distribution" readonly="1" class="d-inline"/> already distributed.
                    Posted items are allowed: Odoo rewrites their analytic items.
                </div>
                <group>
                    <field name="mode" widget="radio"/>
                    <field name="analytic_distribution" widget="analytic_distribution" invisible="mode == 'clear'"/>
                    <field name="line_ids" invisible="1"/>
                </group>
                <footer>
                    <button string="Apply" name="action_apply" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_analytic_redistribute" model="ir.actions.act_window">
        <field name="name">Redistribute analytic accounts</field>
        <field name="res_model">ebshel.analytic.redistribute</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move_line"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_user')), (4, ref('account.group_account_manager'))]"/>
    </record>

    <!-- Analytic items opened on the question people ask of them: where did the money go, by month -->
    <record id="action_analytic_items" model="ir.actions.act_window">
        <field name="name">Analytic Items</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">pivot,list,graph,form</field>
        <field name="context">{'pivot_row_groupby': ['account_id'], 'pivot_column_groupby': ['date:month'], 'pivot_measures': ['amount']}</field>
    </record>
</odoo>
