<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_deferrals" model="ir.ui.view">
        <field name="name">account.move.form.deferrals</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_ebshel_open_deferrals" type="object" class="oe_stat_button" icon="calendar_today"
                        invisible="not ebshel_deferral_count">
                    <field name="ebshel_deferral_count" widget="statinfo" string="Deferrals"/>
                </button>
            </div>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='account_id']" position="after">
                <field name="ebshel_deferral_start" optional="hide" string="Deferral from"/>
                <field name="ebshel_deferral_end" optional="hide" string="Deferral to"/>
            </xpath>
        </field>
    </record>

    <!-- Bank and cash accounts on a journal entry's lines (client, 2026-10-22): Odoo's
         list leaves out account_type asset_cash; the company switch in Settings >
         Accounting > Advanced Accounting brings them back. Only this list: an invoice's
         lines keep Odoo's own account list. -->
    <record id="view_move_form_cash_accounts" model="ir.ui.view">
        <field name="name">account.move.form.cash.accounts</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='aml_tab']/field[@name='line_ids']" position="before">
                <field name="entry_cash_accounts" invisible="1"/>
            </xpath>
            <xpath expr="//page[@id='aml_tab']/field[@name='line_ids']/list/field[@name='account_id']" position="attributes">
                <attribute name="domain">[('company_ids', 'parent_of', company_id)] + ([] if parent.entry_cash_accounts else [('account_type', '!=', 'asset_cash')])</attribute>
            </xpath>
        </field>
    </record>
</odoo>
