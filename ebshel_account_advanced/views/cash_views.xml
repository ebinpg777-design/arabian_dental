<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cash_item_list" model="ir.ui.view">
        <field name="name">ebshel.cash.item.list</field>
        <field name="model">ebshel.cash.item</field>
        <field name="arch" type="xml">
            <list string="Planned cash items" editable="bottom">
                <field name="date"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="amount" sum="Total"/>
                <field name="frequency"/>
                <field name="date_end" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="note" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_cash_items" model="ir.actions.act_window">
        <field name="name">Planned Cash Items</field>
        <field name="res_model">ebshel.cash.item</field>
        <field name="view_mode">list</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Money that is not in the ledger yet</p><p>Payroll, rent, loan instalments, tax payments, expected grants: add them once, with how often they repeat, and the cash forecast counts them.</p></field>
    </record>
</odoo>
