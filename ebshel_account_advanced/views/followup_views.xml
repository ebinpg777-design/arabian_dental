<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_followup_level_list" model="ir.ui.view">
        <field name="name">ebshel.followup.level.list</field>
        <field name="model">ebshel.followup.level</field>
        <field name="arch" type="xml">
            <list string="Follow-up levels">
                <field name="days"/>
                <field name="name"/>
                <field name="action"/>
                <field name="auto" widget="boolean_toggle"/>
                <field name="attach_statement" optional="show"/>
                <field name="attach_invoices" optional="show"/>
                <field name="on_hold" optional="show"/>
                <field name="partner_count" string="Customers at this level"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_followup_level_form" model="ir.ui.view">
        <field name="name">ebshel.followup.level.form</field>
        <field name="model">ebshel.followup.level</field>
        <field name="arch" type="xml">
            <form string="Follow-up level">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_partners" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="partner_count" widget="statinfo" string="Customers"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Second reminder"/></h1></div>
                    <group>
                        <group string="When">
                            <field name="days"/>
                            <field name="repeat_days"/>
                            <field name="auto"/>
                            <field name="on_hold"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="What">
                            <field name="action"/>
                            <field name="template_id" invisible="action not in ('email', 'email_call')"/>
                            <field name="attach_statement"/>
                            <field name="attach_invoices"/>
                            <field name="activity_type_id"/>
                            <field name="responsible"/>
                        </group>
                    </group>
                    <group string="Reminder text (used in the email without a template, and in the letter)">
                        <field name="text" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_followup_levels" model="ir.actions.act_window">
        <field name="name">Follow-up Levels</field>
        <field name="res_model">ebshel.followup.level</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Define the reminder steps</p><p>Each level applies once the oldest open invoice is that many days overdue: an email, a call, a letter, or a to-do.</p></field>
    </record>

    <record id="view_followup_action_list" model="ir.ui.view">
        <field name="name">ebshel.followup.action.list</field>
        <field name="model">ebshel.followup.action</field>
        <field name="arch" type="xml">
            <list string="Follow-up log" create="false" default_order="date desc">
                <field name="date"/>
                <field name="partner_id"/>
                <field name="kind"/>
                <field name="level_id"/>
                <field name="amount" sum="Total"/>
                <field name="promise_date" optional="show"/>
                <field name="user_id"/>
                <field name="note"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_followup_log" model="ir.actions.act_window">
        <field name="name">Follow-up Log</field>
        <field name="res_model">ebshel.followup.action</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
