<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_bank_statement_lines" model="ir.actions.act_window">
        <field name="name">Bank Lines</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_not_matched': 1}</field>
    </record>

    <!-- Everything lives inside Odoo's own Accounting app - there is no separate
         top-level menu. The reports and assets modules already sit there; this file
         only adds the screens that exist nowhere else, each where people look for it. -->

    <!-- Reporting: the cockpit opens the reporting menu -->
    <menuitem id="menu_finance_cockpit" name="Finance Cockpit" parent="account.menu_finance_reports"
              action="action_finance_cockpit" sequence="0"/>

    <!-- Customers: the collections work beside the invoices it chases -->
    <menuitem id="menu_followup_desk_core" name="Collections Desk" parent="account.menu_finance_receivables" action="action_followup_desk" sequence="35"
              groups="account.group_account_readonly,account.group_account_invoice"/>
    <menuitem id="menu_match_desk" name="Matching Desk" parent="account.menu_finance_receivables" action="action_match_desk" sequence="36"
              groups="account.group_account_readonly"/>
    <menuitem id="menu_followup_log" name="Follow-up Log" parent="account.menu_finance_receivables" action="action_followup_log" sequence="37"
              groups="account.group_account_readonly,account.group_account_invoice"/>

    <!-- Accounting: bank, entries, planning and closing -->
    <menuitem id="menu_bank" name="Bank" parent="account.menu_finance_entries" sequence="3"
              groups="account.group_account_readonly"/>
    <menuitem id="menu_bank_rec_core" name="Reconciliation" parent="menu_bank" action="action_bank_rec" sequence="1"/>
    <menuitem id="menu_bank_lines" name="Bank Lines" parent="menu_bank" action="action_bank_statement_lines" sequence="10"/>
    <menuitem id="menu_bank_balances" name="Statement Balances" parent="menu_bank" action="action_bank_checkpoints" sequence="20"/>

    <menuitem id="menu_entry_studio" name="Entry Studio" parent="account.account_transactions_menu" action="action_entry_studio" sequence="2"/>
    <menuitem id="menu_entry_templates" name="Entry Templates" parent="account.account_transactions_menu" action="action_entry_templates" sequence="3"/>

    <menuitem id="menu_planning" name="Planning" parent="account.menu_finance_entries" sequence="55"
              groups="account.group_account_readonly"/>
    <menuitem id="menu_budget_board" name="Budget Board" parent="menu_planning" action="action_budget_board" sequence="1"/>
    <menuitem id="menu_budgets" name="Budgets" parent="menu_planning" action="action_budgets" sequence="5"/>
    <menuitem id="menu_budget_lines" name="Budget Lines" parent="menu_planning" action="action_budget_lines" sequence="7"
              groups="account.group_account_manager"/>
    <menuitem id="menu_cash_forecast" name="Cash Forecast" parent="menu_planning" action="action_cash_forecast" sequence="10"/>
    <menuitem id="menu_cash_items" name="Planned Cash Items" parent="menu_planning" action="action_cash_items" sequence="15"/>

    <menuitem id="menu_close_cockpit" name="Close Cockpit" parent="account.account_closing_menu" action="action_close_cockpit" sequence="1"/>
    <menuitem id="menu_close_periods" name="Close Periods" parent="account.account_closing_menu" action="action_close_periods" sequence="5"/>
    <menuitem id="menu_deferrals" name="Deferrals" parent="account.account_closing_menu" action="action_deferrals" sequence="10"/>
    <menuitem id="menu_ledger_health" name="Ledger Health" parent="account.account_closing_menu" action="action_ledger_health" sequence="20"/>
    <menuitem id="menu_ledger_findings" name="Ledger Findings" parent="account.account_closing_menu" action="action_ledger_findings" sequence="25"
              groups="account.group_account_manager"/>

    <!-- Reporting: the analytic items pivot (core hides its own behind the analytic setting) and two statements -->
    <menuitem id="menu_analytic_items" name="Analytic Items" parent="account.account_reports_management_menu" action="action_analytic_items" sequence="25"
              groups="account.group_account_readonly"/>
    <menuitem id="menu_report_budget_core" name="Budget vs Actual" parent="account.account_reports_management_menu" action="action_report_budget" sequence="30"/>
    <menuitem id="menu_report_deferral_core" name="Deferral Schedule" parent="account.account_reports_management_menu" action="action_report_deferral" sequence="31"/>

    <!-- Configuration -->
    <menuitem id="menu_followup_levels" name="Follow-up Levels" parent="account.account_invoicing_menu" action="action_followup_levels" sequence="20"/>
    <menuitem id="menu_bank_rules" name="Bank Rules" parent="account.account_account_menu" action="action_bank_rules" sequence="35"/>
    <menuitem id="menu_close_task_templates" name="Close Checklist" parent="account.account_account_menu" action="action_close_task_templates" sequence="40"/>
</odoo>
