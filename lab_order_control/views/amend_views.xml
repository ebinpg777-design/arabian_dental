<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AMENDING A CONFIRMED ORDER WITHOUT STOPPING ITS JOBS.
         (client, 2026-11-26: "a solution for amending SO which should not affect
         the MOs ... do not block the amendment at any stage") -->
    <record id="view_order_form_amend" model="ir.ui.view">
        <field name="name">sale.order.form.lab.amend</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="lab_order_control.view_order_form_order_control"/>
        <field name="arch" type="xml">
            <!-- The button that was "Set to Draft": it cancelled the jobs nobody had
                 started and refused once one had. -->
            <xpath expr="//button[@name='action_set_to_draft']" position="attributes">
                <attribute name="string">Amend Order</attribute>
                <attribute name="icon">fa-pencil</attribute>
                <attribute name="confirm">Take this confirmed order back to draft to amend it? Nothing is cancelled: production, deliveries and invoices stay as they are, and the jobs follow what you change when the order is confirmed again.</attribute>
                <attribute name="groups">sales_team.group_sale_salesman,lab_order_control.group_lab_order_checker</attribute>
            </xpath>
            <!-- Cancel asks in one place, and offers the amendment there. -->
            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="context">{'lab_offer_amend': True}</attribute>
                <attribute name="confirm"/>
                <attribute name="confirm-title"/>
            </xpath>
            <!-- While the order is amended its unit prices can be changed, even on
                 a line already invoiced (core locks them once an invoice exists); the
                 draft invoice follows when the order is confirmed again.
                 (client, 2026-11-27) -->
            <xpath expr="//field[@name='order_line']//column[@name='price_unit']/field[@name='price_unit']"
                   position="attributes">
                <attribute name="readonly">qty_invoiced &gt; 0 and not parent.lab_amending</attribute>
            </xpath>
            <xpath expr="//sheet" position="before">
                <field name="lab_amending" invisible="1"/>
                <field name="lab_amend_count" invisible="1"/>
                <div class="alert alert-secondary m-0 rounded-0 py-1 small" role="status"
                     invisible="lab_amending or not lab_amend_count">
                    <i class="fa fa-pencil me-1" title="Amended"/>
                    Amended <field name="lab_amend_count" nolabel="1" readonly="1" class="d-inline"/> time(s),
                    last on <field name="lab_amended_on" nolabel="1" readonly="1" class="d-inline"/>
                    by <field name="lab_amended_by_id" nolabel="1" readonly="1" class="d-inline"
                              options="{'no_open': True}"/>.
                </div>
                <div class="alert alert-info m-0 rounded-0" role="alert"
                     invisible="not lab_amending or state not in ('draft', 'sent')">
                    <i class="fa fa-pencil me-1" title="Being amended"/>
                    <strong>Being amended.</strong>
                    Nothing was cancelled: confirm the order when the changes are made, and
                    its jobs follow them.
                    <span invisible="not lab_amending_jobs">
                        Production goes on:
                        <field name="lab_amending_jobs" nolabel="1" readonly="1" class="d-inline"/>
                    </span>
                    <div class="small">
                        Started by <field name="lab_amending_by_id" nolabel="1" readonly="1"
                                          class="d-inline" options="{'no_open': True}"/>
                        on <field name="lab_amending_at" nolabel="1" readonly="1" class="d-inline"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_amending" model="ir.ui.view">
        <field name="name">sale.order.search.lab.amending</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <search position="inside">
                <filter string="Being Amended" name="lab_amending"
                        domain="[('lab_amending', '=', True)]"/>
                <!-- every order that has been through an amendment, whether it is
                     in one now or was confirmed again (client, 2026-11-26) -->
                <filter string="Amended" name="lab_amended"
                        domain="[('lab_amend_count', '&gt;', 0)]"/>
            </search>
        </field>
    </record>

    <record id="view_order_list_amended" model="ir.ui.view">
        <field name="name">sale.order.list.lab.amended</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="lab_amend_count" string="Amended" optional="hide"/>
                <field name="lab_amended_on" optional="hide"/>
                <field name="lab_amended_by_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_lab_order_cancel_choice" model="ir.ui.view">
        <field name="name">lab.order.cancel.choice.form</field>
        <field name="model">lab.order.cancel.choice</field>
        <field name="arch" type="xml">
            <form string="Cancel Order">
                <field name="has_jobs" invisible="1"/>
                <field name="order_state" invisible="1"/>
                <div class="alert alert-warning mb-3" role="alert" invisible="not has_jobs">
                    <strong>The lab is making this order.</strong>
                    Cancelling it stops production: <field name="jobs" nolabel="1" readonly="1" class="d-inline"/>.
                    <div class="mt-2">
                        To <strong>change</strong> the order, amend it instead. Nothing is
                        cancelled, the jobs go on with the work already done on them, and
                        they follow your changes when the order is confirmed again.
                    </div>
                </div>
                <div class="mb-3" invisible="has_jobs">
                    Cancel order <field name="order_id" nolabel="1" readonly="1" class="d-inline"
                                        options="{'no_open': True}"/>? Its deliveries and draft
                    invoices are cancelled with it.
                </div>
                <div class="mb-3" invisible="not invoices">
                    Already invoiced: <field name="invoices" nolabel="1" readonly="1" class="d-inline"/>.
                    Cancelling the order cancels the invoice; amending it leaves the invoice as it is.
                </div>
                <footer>
                    <button name="action_amend" type="object" string="Amend the Order"
                            class="btn-primary" icon="fa-pencil" invisible="not has_jobs"/>
                    <button name="action_cancel_order" type="object" string="Cancel the Order"
                            class="btn-danger" invisible="not has_jobs"
                            confirm="Cancel the order and stop its production?"/>
                    <button name="action_cancel_order" type="object" string="Cancel the Order"
                            class="btn-primary" invisible="has_jobs"/>
                    <button special="cancel" string="Leave It" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
