<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_doctor_call_form" model="ir.ui.view">
        <field name="name">lab.doctor.call.log.form</field>
        <field name="model">lab.doctor.call.log</field>
        <field name="arch" type="xml">
            <form string="Doctor Call">
                <sheet>
                    <group>
                        <group>
                            <field name="order_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="phone" widget="phone"/>
                            <field name="called_by_id"/>
                        </group>
                        <group>
                            <field name="call_datetime"/>
                            <field name="response"/>
                            <field name="next_call_datetime"
                                   invisible="response == 'answered'"/>
                        </group>
                    </group>
                    <field name="remarks" placeholder="What the doctor said, or what happened…"/>
                </sheet>
                <footer invisible="not context.get('default_order_id')">
                    <button string="Save Call" type="object" name="create"
                            special="save" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_doctor_call_list" model="ir.ui.view">
        <field name="name">lab.doctor.call.log.list</field>
        <field name="model">lab.doctor.call.log</field>
        <field name="arch" type="xml">
            <list decoration-success="response == 'answered'"
                  decoration-muted="response == 'wrong_number'">
                <field name="call_datetime"/>
                <field name="order_id"/>
                <field name="partner_id" optional="show"/>
                <field name="phone" optional="hide"/>
                <field name="response" widget="badge"
                       decoration-success="response == 'answered'"
                       decoration-warning="response != 'answered'"/>
                <field name="called_by_id"/>
                <field name="next_call_datetime" optional="show"/>
                <field name="remarks" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_doctor_call" model="ir.actions.act_window">
        <field name="name">Doctor Calls</field>
        <field name="res_model">lab.doctor.call.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
