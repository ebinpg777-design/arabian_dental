<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="privilege_lab_order_control" model="res.groups.privilege">
            <field name="name">Order Control</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="sequence">35</field>
        </record>

        <record id="group_lab_order_entry" model="res.groups">
            <field name="name">Order Entry</field>
            <field name="privilege_id" ref="privilege_lab_order_control"/>
            <field name="comment">Registers cases and submits them for verification.</field>
        </record>

        <record id="group_lab_order_checker" model="res.groups">
            <field name="name">Order Checker</field>
            <field name="privilege_id" ref="privilege_lab_order_control"/>
            <field name="implied_ids" eval="[(4, ref('group_lab_order_entry'))]"/>
            <field name="comment">Verifies registered cases before they go into production.</field>
        </record>

        <record id="group_lab_credit_override" model="res.groups">
            <field name="name">Credit Controller</field>
            <field name="privilege_id" ref="privilege_lab_order_control"/>
            <field name="comment">Can release an order blocked by a clinic's credit limit.</field>
        </record>

        <!-- Salespeople register; managers check and control credit. -->
        <record id="sales_team.group_sale_salesman" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_lab_order_entry'))]"/>
        </record>
        <record id="sales_team.group_sale_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_lab_order_checker')),
                                             (4, ref('group_lab_credit_override'))]"/>
        </record>

    </data>
</odoo>
