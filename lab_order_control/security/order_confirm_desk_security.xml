<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Confirm Orders: the screen for the person who confirms the field executives'
         orders. Its own privilege, so it is a plain tick on the user, not one more
         step in the Order Entry / Checker ladder. (client, 2026-11-27) -->
    <record id="privilege_order_confirm_desk" model="res.groups.privilege">
        <field name="name">Confirm Orders Screen</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="sequence">36</field>
    </record>

    <record id="group_order_confirm_desk" model="res.groups">
        <field name="name">Confirm Orders</field>
        <field name="privilege_id" ref="privilege_order_confirm_desk"/>
        <!-- whoever confirms everybody's orders must be able to read them all -->
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        <field name="comment">Opens the Confirm Orders app: find an order by its number and confirm it.</field>
    </record>
</odoo>
