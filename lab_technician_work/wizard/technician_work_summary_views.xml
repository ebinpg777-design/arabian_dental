<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_technician_work_summary_form" model="ir.ui.view">
        <field name="name">sale.technician.work.summary.form</field>
        <field name="model">sale.technician.work.summary</field>
        <field name="arch" type="xml">
            <form string="Technician Work Summary">
                <group>
                    <group string="Period">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="date_field" widget="radio"/>
                    </group>
                    <group string="Narrow down (optional)">
                        <field name="technician_ids" widget="many2many_tags"
                               options="{'no_create': True}" placeholder="Every technician"/>
                        <field name="department_ids" widget="many2many_tags"
                               options="{'no_create': True}" placeholder="Every department"/>
                        <field name="include_reworks"/>
                        <field name="show_products"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <div class="text-muted small">
                    Every line of an order counts for each technician named on the order.
                    Cases = orders, Works = order lines.
                </div>
                <footer>
                    <button name="action_print" string="Print Summary" type="object"
                            class="btn-primary" data-hotkey="q" icon="fa-print"/>
                    <button name="action_open_analysis" string="Open Analysis" type="object"
                            class="btn-secondary" icon="fa-table"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_technician_work_summary" model="ir.actions.act_window">
        <field name="name">Technician Work Summary</field>
        <field name="res_model">sale.technician.work.summary</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_technician_work_summary"
              name="Technician Work Summary"
              parent="sale.menu_sale_report"
              action="action_technician_work_summary"
              sequence="62"/>
</odoo>
