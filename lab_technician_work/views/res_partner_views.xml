<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- a technician's contact opens their work -->
    <record id="view_partner_form_technician_work" model="ir.ui.view">
        <field name="name">res.partner.form.technician.work</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_technician_work" type="object" class="oe_stat_button"
                        icon="fa-wrench" invisible="not is_technician"
                        groups="sales_team.group_sale_salesman">
                    <field name="technician_work_count" widget="statinfo" string="Works"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
