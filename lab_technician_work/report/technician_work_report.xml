<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The Technician Work screen, printed: its filters, rows and chosen columns, on the
         lab letterhead, in the Order Count sheet's style (sale_custom's occ-* classes). -->
    <template id="report_technician_work">
        <t t-call="web.html_container">
            <t t-call="sale_custom.external_layout_lab"
                o="wizard"
                hide_letterhead="True"
                footer_note.translate="Technician work">
                <div class="page lab-invoice occ">
                    <t t-call="sale_custom.letterhead_block"/>

                    <table class="occ-title">
                        <tr>
                            <td style="vertical-align:bottom;">
                                <div class="oi-title">TECHNICIAN WORK</div>
                                <div class="occ-sub">By <t t-out="board['dimension']"/> · printed <t t-out="printed_on"/></div>
                            </td>
                            <td style="text-align:right;vertical-align:bottom;">
                                <div class="oi-numlabel">Period</div>
                                <div class="occ-period" t-out="board['period']['label']"/>
                            </td>
                        </tr>
                    </table>

                    <div class="occ-criteria" t-if="criteria">
                        <t t-foreach="criteria" t-as="c">
                            <span class="occ-crit"><span class="occ-crit-k"><t t-out="c[0]"/></span>
                                <t t-out="c[1]"/></span>
                        </t>
                    </div>

                    <t t-set="totals" t-value="board['totals']"/>
                    <table class="occ-summary">
                        <tr>
                            <td class="occ-card"><div class="oi-label">Technicians</div>
                                <div class="occ-card-value" t-out="totals['people']"/></td>
                            <td class="occ-card"><div class="oi-label">Cases</div>
                                <div class="occ-card-value" t-out="show('cases', totals['cases'])"/></td>
                            <td class="occ-card occ-card-due"><div class="oi-label">Works (order lines)</div>
                                <div class="occ-card-value" t-out="show('works', totals['works'])"/></td>
                            <td class="occ-card"><div class="oi-label">Quantity</div>
                                <div class="occ-card-value" t-out="show('quantity', totals['quantity'])"/></td>
                            <td class="occ-card"><div class="oi-label">Teeth</div>
                                <div class="occ-card-value" t-out="show('teeth', totals['teeth'])"/></td>
                        </tr>
                    </table>
                    <p class="occ-sub" style="margin:4px 0 10px;">
                        The totals count each case and line once. A technician's row counts every line
                        of their cases, so a case worked by three people is in three rows; the (Share)
                        columns divide it between them and add up to the totals. Contacts with the same
                        name are one technician. Previous period: <t t-out="board['period']['previous_label']"/>.
                    </p>

                    <ul t-if="board['insights']" style="margin:0 0 10px 16px;padding:0;font-size:9pt;">
                        <li t-foreach="board['insights']" t-as="insight" t-out="insight['text']"/>
                    </ul>

                    <p t-if="not board['rows']" class="occ-empty">No technician work in this period.</p>

                    <table class="occ-lines" t-if="board['rows']">
                        <thead>
                            <tr>
                                <th style="width:4%">#</th>
                                <th><t t-out="board['dimension']"/></th>
                                <th style="width:14%"/>
                                <th t-foreach="columns" t-as="col" class="num" t-out="col[1]"/>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="board['rows']" t-as="r">
                                <tr class="occ-l0">
                                    <td t-out="r['rank']"/>
                                    <td t-out="r['name']"/>
                                    <td>
                                        <table class="occ-bar" style="margin:0;"><tr>
                                            <td class="occ-bar-track">
                                                <div class="occ-bar-fill"
                                                     t-attf-style="width: {{'{:.1f}'.format(max(pct(r['works'], top), 2))}}%;"/>
                                            </td>
                                        </tr></table>
                                    </td>
                                    <td t-foreach="columns" t-as="col" class="num" t-out="show(col[0], r.get(col[0]))"/>
                                </tr>
                                <t t-if="breakdowns.get(r['key'])">
                                    <tr t-foreach="breakdowns[r['key']]['rows']" t-as="b" class="occ-l1">
                                        <td/>
                                        <td colspan="2"><span style="padding-left:14px;" t-out="b['name']"/></td>
                                        <td t-foreach="columns" t-as="col" class="num"
                                            t-out="show(col[0], b.get(col[0])) if col[0] in b else ''"/>
                                    </tr>
                                </t>
                            </t>
                            <tr class="occ-total">
                                <td colspan="3">TOTAL (each case and line once)</td>
                                <td t-foreach="columns" t-as="col" class="num"
                                    t-out="show(col[0], totals.get(col[0])) if col[0] in totals else ''"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_technician_work" model="ir.actions.report">
        <field name="name">Technician Work</field>
        <field name="model">sale.technician.work.summary</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lab_technician_work.report_technician_work</field>
        <field name="print_report_name">'Technician Work %s to %s' % (object.date_from or '', object.date_to or '')</field>
        <field name="paperformat_id" ref="sale_custom.paperformat_lab_invoice"/>
    </record>
</odoo>
