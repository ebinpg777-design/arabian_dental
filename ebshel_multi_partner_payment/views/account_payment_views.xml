<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Multi Partner Payment Form -->
    <record id="view_account_multi_partner_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form.multi.partner.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='payment_type']" position="before">
                <field  name="is_multi_partner" 
                        widget="boolean_toggle"
                        readonly="state != 'draft'"/>
            </xpath>

            <!-- Hide the single partner field for multi-partner payments -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">is_multi_partner</attribute>
            </xpath>

            <!-- Show computed partners instead -->
            <xpath expr="//field[@name='partner_id'][1]" position="after">
                <field name="partner_ids"
                       widget="many2many_tags"
                       options="{'no_create': True, 'no_open': True}"
                       readonly="1"
                       invisible="not is_multi_partner"/>
            </xpath>

            <!-- Multi partner lines -->
            <xpath expr="//notebook" position="inside">
                <page string="Multi Partner Payments" invisible="not is_multi_partner">
                    <field name="multi_partner_payment_ids" 
                           readonly="state != 'draft'" 
                           context="{'default_account_id': destination_account_id, 'default_currency_id': currency_id, 'default_company_id': company_id}">
                        <list editable="bottom">
                            <field name="partner_id" required="1"/>
                            <field name="account_id" required="1"/>
                            <field name="currency_id" groups="base.group_multi_currency" readonly="1"/>
                            <field name="ref"/>
                            <field name="amount" sum="Total" required="1"/>
                            <field name="company_id" column_invisible="1"/>
                             <field name="partner_type" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Multi Partner Payment List -->
    <record id="view_account_multi_partner_payment_list" model="ir.ui.view">
        <field name="name">account.payment.list.multi.partner.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="is_multi_partner" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="replace">
                <field name="partner_id" column_invisible="1"/>
                <field name="partner_ids" widget="many2many_tags" string="Partners"/>
            </xpath>
        </field>
    </record>

   <record id="view_account_payment_search" model="ir.ui.view">
        <field name="name">account.payment.search</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <filter name="state_draft" position="before">
                <filter name="is_multi_partner" string="Multi Partner Payments" domain="[('is_multi_partner', '=', True)]"/>
            </filter>
            <filter name="partner" position="attributes">
                <attribute name="context">{'group_by': 'partner_ids'}</attribute>
                <attribute name="string">Partners</attribute>
            </filter>

        </field>
    </record>
</odoo>