<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================= the wizard -->
    <record id="view_scan_whatsapp_form" model="ir.ui.view">
        <field name="name">lab.scan.whatsapp.form</field>
        <field name="model">lab.scan.whatsapp</field>
        <field name="arch" type="xml">
            <form>
                <field name="scan_id" invisible="1"/>
                <field name="can_group" invisible="1"/>
                <field name="can_sender" invisible="1"/>
                <group>
                    <group>
                        <field name="target" widget="radio"/>
                        <field name="channel_id" invisible="target != 'group'" readonly="1"
                               options="{'no_open': True}"/>
                        <field name="sender_number" invisible="target != 'sender'" string="Number"/>
                    </group>
                    <group>
                        <field name="template_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <div class="alert alert-warning mb-2" role="alert" invisible="target != 'group' or can_group">
                    <i class="fa fa-chain-broken me-1"/>This group has no invite link yet. Add it under
                    <b>Scans › Configuration › WhatsApp Groups</b> — in WhatsApp: <i>Group info › Invite via link › Copy link</i>.
                </div>
                <div class="alert alert-warning mb-2" role="alert" invisible="target != 'sender' or can_sender">
                    <i class="fa fa-phone me-1"/>There is no WhatsApp number for the sender or the clinic.
                </div>
                <div class="alert alert-info mb-2" role="alert" invisible="target != 'group' or not can_group">
                    <i class="fa fa-info-circle me-1"/>WhatsApp cannot fill in a message in a group. The message is
                    copied as the group opens in WhatsApp Web — paste it there with <b>Ctrl+V</b>.
                </div>
                <field name="message" nolabel="1" placeholder="Pick a template, or write the message…"/>
                <div class="d-flex justify-content-end">
                    <field name="message_copy" widget="CopyClipboardButton" nolabel="1"
                           options="{'btn_class': 'btn-link'}"/>
                </div>
                <footer>
                    <button name="action_send" type="object" string="Open WhatsApp" class="btn-primary"
                            icon="fa-whatsapp" data-hotkey="q"/>
                    <button special="cancel" string="Cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ======================================================= the templates -->
    <record id="view_scan_message_template_list" model="ir.ui.view">
        <field name="name">lab.scan.message.template.list</field>
        <field name="model">lab.scan.message.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="body"/>
            </list>
        </field>
    </record>

    <record id="view_scan_message_template_form" model="ir.ui.view">
        <field name="name">lab.scan.message.template.form</field>
        <field name="model">lab.scan.message.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Scans received"/></h1>
                    </div>
                    <field name="active" invisible="1"/>
                    <field name="body" nolabel="1" placeholder="Hello! We have received the scans for {patients} ({scan})."/>
                    <div class="text-muted small mt-3">
                        <b>Placeholders</b> — filled in from the register when the template is picked:<br/>
                        <code>{patients}</code> the patients' names ·
                        <code>{patient_count}</code> how many ·
                        <code>{scan}</code> the register's reference ·
                        <code>{clinic}</code> the doctor or clinic ·
                        <code>{doctor}</code> the doctor's name as received ·
                        <code>{sender}</code> who posted it ·
                        <code>{delivery}</code> earliest delivery date ·
                        <code>{orders}</code> the order numbers ·
                        <code>{channel}</code> the group ·
                        <code>{company}</code> the lab
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_scan_message_template" model="ir.actions.act_window">
        <field name="name">WhatsApp Templates</field>
        <field name="res_model">lab.scan.message.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the messages you send doctors about their scans</p>
            <p>They are offered by the WhatsApp button on every scan register, filled in for that register.</p>
        </field>
    </record>
</odoo>
