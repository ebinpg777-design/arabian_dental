<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scan_paste_form" model="ir.ui.view">
        <field name="name">lab.scan.paste.form</field>
        <field name="model">lab.scan.paste</field>
        <field name="arch" type="xml">
            <form>
                <field name="is_read" invisible="1"/>
                <group>
                    <field name="channel_id" options="{'no_create': True}" readonly="is_read"/>
                </group>
                <div invisible="is_read">
                    <p class="text-muted">
                        In WhatsApp, select the messages (or export the chat), copy, and paste below. Each message
                        becomes a line to check; chat and patients already registered are left unticked.
                    </p>
                    <field name="text" nolabel="1" placeholder="[12:36 pm, 11/10/2026] ANJALI MENON K: Patient name - Rahim VP&#10;Upper &amp; Lower Hawley's retainer&#10;Delivery -13-10-26&#10;[4:02 pm, 11/10/2026] +91 90000 12345: Patient name - Ayesha Nadia. P&#10;…"/>
                </div>
                <div invisible="not is_read">
                    <p class="text-muted mb-2">
                        <field name="line_count" class="oe_inline"/> message(s) found,
                        <b><field name="selected_count" class="oe_inline"/></b> ticked. One register is made per
                        sender, with a patient line for each of their messages.
                    </p>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="false" decoration-muted="not include">
                            <field name="include" widget="boolean_toggle"/>
                            <field name="date_received"/>
                            <field name="sender_name"/>
                            <field name="member_id" optional="hide"/>
                            <field name="partner_id"/>
                            <field name="patient_name"/>
                            <field name="description"/>
                            <field name="date_delivery"/>
                            <field name="file_names" optional="show"/>
                            <field name="note" decoration-warning="note"/>
                            <field name="sender_phone" column_invisible="1"/>
                            <field name="existing_line_id" column_invisible="1"/>
                        </list>
                    </field>
                </div>
                <footer>
                    <button name="action_read" type="object" string="Read Messages" class="btn-primary"
                            invisible="is_read" data-hotkey="q"/>
                    <button name="action_register" type="object" string="Register Scans" class="btn-primary"
                            invisible="not is_read" data-hotkey="q"/>
                    <button special="cancel" string="Cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_scan_paste" model="ir.actions.act_window">
        <field name="name">Paste WhatsApp Messages</field>
        <field name="res_model">lab.scan.paste</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
