<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="web_responsive.AppMenuItem">
        <a
            t-att-class="this.className"
            role="button"
            t-att-data-menu-xmlid="this.props.app.xmlid"
            t-att-href="this.props.href"
            t-on-click="this.onClick"
            draggable="false"
        >
            <div
                class="position-relative o_app"
                t-att-data-menu-xmlid="this.props.app.xmlid"
            >
                <img
                    class="o-app-menu-item__icon rounded-3"
                    draggable="false"
                    t-att-src="this.webIconData"
                />
                <i t-if="this.isActive" class="fa fa-check-circle o-app-menu-item__active" />
            </div>
            <span class="o-app-menu-item__name" t-att-title="this.props.app.name">
                <t t-out="this.props.app.name" />
            </span>
        </a>
    </t>
</templates>
