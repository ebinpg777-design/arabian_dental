<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <!-- Search bar -->
    <t
        t-name="web_responsive.AppsMenuFuseSearchBar"
        t-inherit="web_responsive.AppsMenuCanonicalSearchBar"
        t-inherit-mode="primary"
    >
        <xpath expr="//t[@t-foreach='this.state.rootItems']" position="attributes">
            <attribute name="t-as">result</attribute>
            <attribute name="t-key">this.result.item.xmlid</attribute>
        </xpath>
        <xpath expr="//t[@t-foreach='this.state.rootItems']/li" position="before">
            <t t-set="menu" t-value="this.result.item" />
        </xpath>
        <xpath expr="//t[@t-foreach='this.state.rootItems']/li" position="attributes">
            <attribute
                name="t-attf-class"
            >search-item {{this.highlighted(this.result_index)}}</attribute>
        </xpath>
        <xpath expr="//t[@t-foreach='this.state.subItems']" position="attributes">
            <attribute name="t-as">result</attribute>
            <attribute name="t-key">this.result.item.xmlid</attribute>
        </xpath>
        <xpath expr="//t[@t-foreach='this.state.subItems']/li" position="before">
            <t t-set="menu" t-value="this.result.item" />
        </xpath>
        <xpath expr="//t[@t-foreach='this.state.subItems']/li" position="attributes">
            <attribute
                name="t-attf-class"
            >search-item {{this.highlighted(this.result_index, true)}}</attribute>
        </xpath>
    </t>
</templates>
