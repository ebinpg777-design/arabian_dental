<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lists for the dashboard's drill-through.
         The stock invoice list opens on Number / Due Date / Total / Status, which
         does not say WHEN it was billed or WHO owes it - the first two questions
         asked of a figure you have just clicked. (client, 2026-08-21) -->
    <record id="view_collection_invoice_list" model="ir.ui.view">
        <field name="name">account.move.list.collection.invoices</field>
        <field name="model">account.move</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Invoices" create="false" edit="false" sample="0"
                  default_order="invoice_date desc, name desc">
                <field name="name" string="Number"/>
                <field name="invoice_date" string="Invoice Date"/>
                <field name="partner_id" string="Customer"/>
                <field name="patient_names" string="Patients" optional="hide"/>
                <field name="team_id" string="Sales Route" optional="show"/>
                <field name="invoice_user_id" string="Salesperson" optional="hide"/>
                <field name="invoice_date_due" string="Due Date" optional="hide"/>
                <field name="amount_total" string="Total" sum="Total"/>
                <field name="amount_residual" string="Amount Due" sum="Due"
                       optional="show"/>
                <field name="state" string="Status" widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-info="state == 'draft'"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="move_type" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Receipts are shown as the receivable CREDITS themselves: the partner lives
         on the line, and the credit column adds up to the Received card. -->
    <record id="view_collection_receipt_list" model="ir.ui.view">
        <field name="name">account.move.line.list.collection.receipts</field>
        <field name="model">account.move.line</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Receipts" create="false" edit="false" sample="0"
                  default_order="date desc, id desc">
                <field name="date" string="Date"/>
                <field name="move_id" string="Entry"/>
                <field name="partner_id" string="Customer"/>
                <field name="journal_id" string="Journal" optional="show"/>
                <field name="ref" string="Reference" optional="show"/>
                <field name="name" string="Label" optional="hide"/>
                <field name="credit" string="Received" sum="Received"/>
                <field name="debit" string="Refunded" sum="Refunded" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

</odoo>
