<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            The historic backlog, ground down in batches.

            Deliberately INACTIVE on install. Going forward, a delivery closes its own
            jobs the moment it is validated and nothing here is needed. This exists for
            the 20,978 already-delivered jobs left open before that rule existed, and
            working through them is a seven-and-a-half-hour job that rewrites 21,000
            manufacturing orders and posts roughly 108,000 stock move lines — not
            something a module upgrade should start on its own, and best begun when the
            lab is quiet. Switch it on from Close-out Worklist, or here.

            Once the backlog is clear each run costs a single query, so it is safe to
            leave running.
        -->
        <record id="cron_close_delivered_backlog" model="ir.cron">
            <field name="name">Close manufacturing orders already delivered</field>
            <field name="model_id" ref="mrp.model_mrp_production"/>
            <field name="state">code</field>
            <field name="code">model._lab_close_delivered_backlog()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>

        <!--
            THE OTHER TWO WAYS A JOB IS FINISHED. (client, 2026-09-25)

            The rule above closes a job when its appliance physically ships.
            These close it when the floor has scanned every step through, and
            when the office has invoiced the case and the invoice has stood
            untouched for a couple of days - an invoice raised this morning can
            still be corrected this afternoon, and a job closed underneath that
            is work the lab cannot put back.

            Daily, and batched: the first run on a lab that has never had this
            meets a backlog, and one transaction that long is a lock nobody
            wants across a working day. It drains over successive runs.

            INACTIVE in the lab (Ortho ships it active): the lab's database holds
            the migrated real book, and what this would close is to be seen
            before it is switched on. Switch it on here; the rule itself has its
            own switch too, lab_workcenter_scan.close_finished_mo (on unless set
            to 0). noupdate: once switched on, an upgrade leaves it on.
        -->
        <record id="cron_close_finished_jobs" model="ir.cron">
            <field name="name">Close manufacturing orders the lab has finished with</field>
            <field name="model_id" ref="mrp.model_mrp_production"/>
            <field name="state">code</field>
            <field name="code">model._cron_close_finished_jobs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
