<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="lab_workcenter_scan.DoingItDialog">
    <Dialog title="this.title" size="'md'" footer="false" contentClass="'o_st_doing_dlg'">
        <!-- The rule, as a label — not as a refusal. -->
        <div class="o_st_warnlabel" role="alert">
            <i class="fa fa-exclamation-triangle" title="Warning"/>
            <span t-out="this.warning"/>
        </div>

        <!-- The job, so a lead holding three cards knows which one this is. -->
        <div class="o_st_doing_job">
            <span class="o_st_mo" t-out="this.props.job.production or this.props.job.name"/>
            <span t-if="this.props.job.order" class="o_st_ref" t-out="this.props.job.order"/>
            <div t-if="this.props.job.patient or this.props.job.clinic" class="o_st_case">
                <span t-if="this.props.job.patient" class="o_st_patient" t-out="this.props.job.patient"/>
                <span t-if="this.props.job.patient and this.props.job.clinic"> · </span>
                <span t-if="this.props.job.clinic" class="o_st_clinic" t-out="this.props.job.clinic"/>
            </div>
            <div class="o_st_doing_next">
                <i class="fa fa-share me-1" title="Then"/>
                <t t-if="this.handsOn">Then it goes to </t>
                <t t-else="">Stays on the bench; later it goes to </t>
                <strong t-out="this.props.job.next_station or 'finish'"/>
            </div>
        </div>

        <t t-if="this.props.canAssign and this.props.people.length">
            <div class="o_st_doing_lead" t-out="this.lead"/>
            <div class="o_st_tiles">
                <button t-foreach="this.props.people" t-as="p" t-key="p.id"
                        class="o_st_tile"
                        t-att-class="{
                            'o_st_tile_lead': p.is_lead,
                            'o_st_tile_light': p.id === this.lightestId,
                            'o_st_tile_busy': this.state.picked === p.id,
                        }"
                        t-att-disabled="this.state.busy"
                        t-on-click="() => this.pick(p)">
                    <span class="o_st_tile_key" t-if="p_index lt 9" t-out="p_index + 1"/>
                    <span class="o_st_avatar" t-out="this.initials(p.name)"/>
                    <span class="o_st_tile_name" t-out="p.name"/>
                    <span class="o_st_tile_load">
                        <i t-if="this.state.picked === p.id" class="fa fa-circle-o-notch fa-spin" title="Saving"/>
                        <t t-else="">
                            <t t-out="p.load or 0"/> on bench
                            <t t-if="p.id === this.lightestId"> · lightest</t>
                        </t>
                    </span>
                </button>
            </div>
        </t>
        <t t-else="">
            <div class="o_st_doing_lead o_st_doing_noone">
                <i class="fa fa-lock me-1" title="Lead only"/>
                <t t-if="!this.props.people.length">Nobody is posted to this station yet, so the job cannot be given to anyone. Ask an administrator to add the bench's people to the work centre.</t>
                <t t-else="">Only the station lead can name the technician. Ask them to give it out — the job stays on the bench until then.</t>
            </div>
        </t>

        <div class="o_st_doing_foot">
            <button class="btn btn-link" t-on-click="() => this.props.close()">Not now</button>
        </div>
    </Dialog>
</t>

</templates>
