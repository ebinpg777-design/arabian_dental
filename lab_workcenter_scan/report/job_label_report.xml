<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_job_label" model="ir.actions.report">
        <field name="name">Job Label (QR)</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lab_workcenter_scan.report_job_label</field>
        <field name="report_file">lab_workcenter_scan.report_job_label</field>
        <field name="print_report_name">'Job Labels'</field>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_job_label">
        <!-- Stuck to the case bag. The code under the QR is the manufacturing reference
             itself, so a bench with no working camera can still type it, and a job card
             that already prints the MO number needs no reprint. -->
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="mo">
                <div class="page" style="text-align:center; padding-top:12mm;">
                    <div style="font-size:15px; color:#666;"
                         t-esc="mo.product_id.display_name"/>
                    <h1 style="margin:2mm 0; font-size:30px;"
                        t-esc="env['report.lab.floor']._patient_label(mo.sale_id, mo.name)"/>
                    <!-- The arch, in its own line and large. An upper and a lower for the
                         same patient are two near-identical bags on the same shelf, and
                         the arch is the only thing that tells them apart at a glance.
                         (client, 2026-08-26) -->
                    <div t-if="env['report.lab.floor']._arch_label(mo)"
                         style="font-size:26px; font-weight:bold; letter-spacing:.08em;">
                        <t t-esc="env['report.lab.floor']._arch_label(mo)"/>
                    </div>
                    <div t-if="mo.sale_id.partner_id" style="font-size:13px; color:#444;"
                         t-esc="mo.sale_id.partner_id.display_name"/>
                    <!-- 55mm rather than 70: it still scans across a bench, and the
                         15mm it gives back is what the arch and the clinic sit in. -->
                    <img t-if="mo.qr_image"
                         t-att-src="'data:image/png;base64,%s' % mo.qr_image.decode()"
                         style="width:55mm; height:55mm; margin:4mm auto;"/>
                    <div style="font-size:24px; letter-spacing:.1em; font-weight:bold;"
                         t-esc="mo.name"/>
                    <div style="font-size:12px; color:#666; margin-top:3mm;">
                        Scan at any station to accept or hand over.
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
