<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        One row per job, with the three clocks side by side. Waiting sits next to
        hands-on deliberately: read alone, a small hands-on figure looks like a lazy
        bench when it is usually a queue nobody handed out.
    -->
    <record id="view_production_performance_list" model="ir.ui.view">
        <field name="name">lab.production.performance.list</field>
        <field name="model">lab.production.performance</field>
        <field name="arch" type="xml">
            <list string="Production Performance" create="false" sample="1"
                  default_order="handed_over_at desc">
                <field name="handed_over_at" optional="show"/>
                <field name="workcenter_id"/>
                <field name="workorder_name" string="Operation"/>
                <field name="bench_user_id" optional="show"/>
                <field name="finisher_user_id" optional="show"/>
                <field name="patient" optional="show"/>
                <field name="sale_id" optional="show"/>
                <field name="production_id" optional="hide"/>
                <field name="partner_id" optional="hide" string="Clinic"/>
                <field name="team_id" optional="hide"/>
                <field name="stage" optional="show" widget="badge"
                       decoration-warning="stage == 'queued'"
                       decoration-info="stage == 'bench'"
                       decoration-success="stage == 'finished'"/>
                <field name="waiting_hours" sum="Total" optional="show"
                       decoration-danger="waiting_hours &gt; 24"
                       decoration-bf="waiting_hours &gt; 24"/>
                <field name="working_hours" optional="show"/>
                <field name="total_hours" optional="hide"/>
                <field name="clocked_minutes" optional="show"/>
                <field name="expected_minutes" optional="hide"/>
                <field name="over_expected" optional="hide"
                       decoration-danger="over_expected &gt; 0"/>
                <field name="priority" optional="hide"/>
                <field name="jobs" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_production_performance_pivot" model="ir.ui.view">
        <field name="name">lab.production.performance.pivot</field>
        <field name="model">lab.production.performance</field>
        <field name="arch" type="xml">
            <!-- Opens on the question the lab actually asks: how long does each station
                 take, and how much of that was waiting. -->
            <pivot string="Production Performance" sample="1">
                <field name="workcenter_id" type="row"/>
                <field name="jobs" type="measure"/>
                <field name="waiting_hours" type="measure"/>
                <field name="working_hours" type="measure"/>
                <field name="clocked_minutes" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_production_performance_graph" model="ir.ui.view">
        <field name="name">lab.production.performance.graph</field>
        <field name="model">lab.production.performance</field>
        <field name="arch" type="xml">
            <graph string="Production Performance" type="bar" sample="1">
                <field name="workcenter_id"/>
                <field name="jobs" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_production_performance_search" model="ir.ui.view">
        <field name="name">lab.production.performance.search</field>
        <field name="model">lab.production.performance</field>
        <field name="arch" type="xml">
            <search string="Production Performance">
                <field name="workcenter_id"/>
                <field name="bench_user_id" string="Technician"/>
                <field name="patient"/>
                <field name="sale_id" string="Sales Order"/>
                <field name="production_id" string="Manufacturing Order"/>
                <field name="partner_id" string="Clinic"/>

                <filter name="finished" string="Finished"
                        domain="[('handed_over_at', '!=', False)]"/>
                <filter name="open" string="Still open"
                        domain="[('state', 'not in', ('done', 'cancel'))]"/>
                <separator/>
                <!-- The one a lead opens this report for. -->
                <filter name="waiting_over_day" string="Waiting over a day"
                        domain="[('waiting_hours', '&gt;', 24),
                                 ('state', 'not in', ('done', 'cancel'))]"/>
                <filter name="not_given_out" string="Nobody has been given it"
                        domain="[('stage', '=', 'queued'),
                                 ('state', 'not in', ('done', 'cancel'))]"/>
                <filter name="urgent" string="Urgent" domain="[('priority', '=', 'urgent')]"/>
                <filter name="over_expected" string="Slower than costed"
                        domain="[('over_expected', '&gt;', 0)]"/>
                <separator/>
                <filter name="handed_this_month" string="Handed on this month"
                        date="handed_over_at" default_period="month"/>

                <group>
                    <filter name="by_station" string="Station"
                            context="{'group_by': 'workcenter_id'}"/>
                    <filter name="by_person" string="Technician"
                            context="{'group_by': 'bench_user_id'}"/>
                    <filter name="by_finisher" string="Finishing Technician"
                            context="{'group_by': 'finisher_user_id'}"/>
                    <filter name="by_accepted_by" string="Accepted by"
                            context="{'group_by': 'accepted_by_id'}"/>
                    <filter name="by_stage" string="Where it got to"
                            context="{'group_by': 'stage'}"/>
                    <filter name="by_appliance" string="Appliance"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="by_route" string="Sales Route"
                            context="{'group_by': 'team_id'}"/>
                    <filter name="by_clinic" string="Clinic"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="by_day" string="Day handed on"
                            context="{'group_by': 'handed_over_at:day'}"/>
                    <filter name="by_month" string="Month handed on"
                            context="{'group_by': 'handed_over_at:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_production_performance" model="ir.actions.act_window">
        <field name="name">Production Performance</field>
        <field name="res_model">lab.production.performance</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_production_performance_search"/>
        <field name="context">{'search_default_finished': 1,
                               'search_default_by_station': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No finished jobs in this period yet</p>
            <p>Every figure here comes from the station board: a job is timed from the
               moment it arrives at a bench, through the moment somebody accepts it, to
               the moment it is handed on. Nothing has to be filled in afterwards — but
               nothing appears until the floor is accepting and handing over on the
               board.</p>
        </field>
    </record>

    <!-- "Who Did What" and "Work Nobody Has Started" used to live here as two
         more pivots. Both questions are now answered live and by case - the
         first by Production Reports (Against target / What we did), the
         second by the station board's "Not given out" pile and the flow
         board's waiting column - so the pivots were two menus that said the
         same thing a day late. Removed 2026-09-09 at the client's request to
         take out reports that do not help. -->

    <menuitem id="menu_production_performance" name="Production Performance"
              parent="mrp.menu_mrp_reporting"
              action="action_production_performance" sequence="12"
              groups="mrp.group_mrp_user"/>


    <!-- The people-and-weeks board. A widget rather than a pivot: the two questions it
         answers — how much did each person get through, and are they getting quicker —
         are read at a glance, and a reader who wants to slice further can click any bar
         through to the operations behind it. (client, 2026-08-27) -->
    <record id="action_mrp_report" model="ir.actions.client">
        <field name="name">Production Reports</field>
        <field name="tag">lab_mrp_report</field>
    </record>

    <menuitem id="menu_mrp_report" name="Production Reports"
              parent="mrp.menu_mrp_reporting" action="action_mrp_report"
              sequence="11" groups="mrp.group_mrp_user"/>
</odoo>
