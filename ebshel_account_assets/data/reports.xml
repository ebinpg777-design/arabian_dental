<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_asset_schedule" model="ebshel.fin.report">
        <field name="name">Depreciation Schedule</field>
        <field name="key">asset_schedule</field>
        <field name="kind">asset_schedule</field>
        <field name="sequence">170</field>
        <field name="custom" eval="False"/>
        <field name="allow_comparison" eval="False"/>
        <field name="allow_journals" eval="False"/>
        <field name="allow_analytic" eval="False"/>
        <field name="default_preset">fiscal_year</field>
        <field name="description">Every asset by category: gross value, what was depreciated before the period, during it, to its end, and the book value it leaves. Untick "posted only" to include the depreciation still to post.</field>
    </record>
    <record id="action_asset_schedule" model="ir.actions.client">
        <field name="name">Depreciation Schedule</field>
        <field name="tag">ebshel_fin_report</field>
        <field name="params" eval="{'report_key': 'asset_schedule'}"/>
    </record>
</odoo>
