<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_group_list" model="ir.ui.view">
        <field name="name">ebshel.asset.group.list</field>
        <field name="model">ebshel.asset.group</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="parent_id"/>
                <field name="complete_name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="action_asset_groups" model="ir.actions.act_window">
        <field name="name">Asset Groups</field>
        <field name="res_model">ebshel.asset.group</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_asset_category_list" model="ir.ui.view">
        <field name="name">ebshel.asset.category.list</field>
        <field name="model">ebshel.asset.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="group_id"/>
                <field name="method"/>
                <field name="period"/>
                <field name="duration"/>
                <field name="asset_account_id"/>
                <field name="bill_trigger"/>
                <field name="asset_count" string="Assets"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_asset_category_form" model="ir.ui.view">
        <field name="name">ebshel.asset.category.form</field>
        <field name="model">ebshel.asset.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_assets" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="asset_count" widget="statinfo" string="Assets"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Dental chairs"/></h1></div>
                    <group>
                        <group string="Method">
                            <field name="active" invisible="1"/>
                            <field name="group_id"/>
                            <field name="method"/>
                            <field name="declining_rate" invisible="method == 'linear'"/>
                            <field name="period"/>
                            <field name="duration"/>
                            <field name="prorata"/>
                            <field name="salvage_pct"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Accounts">
                            <field name="asset_account_id"/>
                            <field name="depreciation_account_id"/>
                            <field name="expense_account_id"/>
                            <field name="gain_account_id"/>
                            <field name="loss_account_id"/>
                            <field name="journal_id"/>
                            <field name="analytic_distribution" widget="analytic_distribution" groups="analytic.group_analytic_accounting"/>
                        </group>
                    </group>
                    <group string="Automation">
                        <group>
                            <field name="auto_post"/>
                        </group>
                        <group>
                            <field name="bill_trigger"/>
                            <field name="trigger_account_ids" widget="many2many_tags" invisible="bill_trigger == 'no'"/>
                            <field name="one_per_unit" invisible="bill_trigger == 'no'"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes for whoever files assets here…"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_asset_categories" model="ir.actions.act_window">
        <field name="name">Asset Categories</field>
        <field name="res_model">ebshel.asset.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set up a category</p>
            <p>The accounts, the journal and the method every asset of that kind shares.
               Point it at an account and vendor bills will file assets here by themselves.</p>
        </field>
    </record>
</odoo>
