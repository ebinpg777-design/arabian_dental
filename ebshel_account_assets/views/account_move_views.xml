<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_assets" model="ir.ui.view">
        <field name="name">account.move.form.assets</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_ebshel_open_assets" type="object" class="oe_stat_button" icon="inventory_2"
                        invisible="not ebshel_asset_count">
                    <field name="ebshel_asset_count" widget="statinfo" string="Assets"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_ebshel_create_assets" type="object" string="Create assets"
                        invisible="move_type != 'in_invoice' or state == 'cancel' or not ebshel_asset_candidate_count" groups="account.group_account_invoice"/>
            </xpath>
            <xpath expr="//header" position="after">
                <field name="ebshel_asset_candidate_count" invisible="1"/>
                <div class="alert alert-info mb-0 d-flex flex-wrap align-items-center gap-2" role="alert"
                     invisible="move_type != 'in_invoice' or state != 'posted' or not ebshel_asset_candidate_count">
                    <field name="ebshel_asset_candidate_note" readonly="1" nolabel="1" class="d-inline"/>
                    <button name="action_ebshel_create_assets" type="object" class="btn btn-link p-0" string="Create them now" groups="account.group_account_invoice"/>
                </div>
                <div class="alert alert-light text-muted small mb-0" role="alert"
                     invisible="move_type != 'in_invoice' or state != 'draft' or not ebshel_asset_candidate_count">
                    <field name="ebshel_asset_candidate_note" readonly="1" nolabel="1" class="d-inline"/> — they become assets when the bill is posted, as their categories say; <i>Create assets</i> sets them up by hand instead.
                </div>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='name']" position="after">
                <field name="ebshel_asset_ids" widget="many2many_tags" string="Asset" optional="show" readonly="1" column_invisible="parent.move_type != 'in_invoice'"/>
            </xpath>
        </field>
    </record>
</odoo>
