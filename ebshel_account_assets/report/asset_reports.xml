<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_labels" model="report.paperformat">
        <field name="name">Asset labels (A4)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_report_asset_label" model="ir.actions.report">
        <field name="name">Asset QR labels</field>
        <field name="model">ebshel.asset</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ebshel_account_assets.asset_labels</field>
        <field name="report_file">ebshel_account_assets.asset_labels</field>
        <field name="paperformat_id" ref="paperformat_labels"/>
        <field name="binding_model_id" ref="model_ebshel_asset"/>
        <field name="binding_type">report</field>
    </record>
    <template id="asset_labels">
        <t t-call="web.html_container">
            <div class="page" style="display:flex; flex-wrap:wrap; gap:6mm; padding:4mm;">
                <t t-foreach="docs" t-as="a">
                    <div style="width:88mm; height:38mm; border:1px solid #1f3a5f; border-radius:3mm; padding:3mm; display:flex; gap:3mm; box-sizing:border-box; page-break-inside:avoid;">
                        <img t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=120&amp;height=120' % (a.code or a.name)" style="width:30mm; height:30mm;"/>
                        <div style="font-size:10px; min-width:0; overflow:hidden;">
                            <div style="font-weight:700; font-size:12px; color:#1f3a5f;"><t t-out="a.code"/></div>
                            <div style="font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><t t-out="a.name"/></div>
                            <div><t t-out="a.category_id.name"/></div>
                            <div t-if="a.serial">S/N <t t-out="a.serial"/></div>
                            <div t-if="a.location"><t t-out="a.location"/></div>
                            <div t-if="a.custodian_id">Held by <t t-out="a.custodian_id.name"/></div>
                            <div style="color:#666;"><t t-out="a.company_id.name"/> · <t t-out="a.purchase_date"/></div>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <record id="action_report_asset_register" model="ir.actions.report">
        <field name="name">Asset register</field>
        <field name="model">ebshel.asset</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ebshel_account_assets.asset_register</field>
        <field name="report_file">ebshel_account_assets.asset_register</field>
        <field name="paperformat_id" ref="ebshel_account_reports.paperformat_landscape"/>
        <field name="binding_model_id" ref="model_ebshel_asset"/>
        <field name="binding_type">report</field>
    </record>
    <template id="asset_register">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-size:11px;">
                    <h2 style="color:#1f3a5f;">Asset register</h2>
                    <t t-set="by_cat" t-value="{}"/>
                    <t t-foreach="docs.sorted(key=lambda a: (a.category_id.name, a.purchase_date))" t-as="a">
                        <t t-set="_x" t-value="by_cat.setdefault(a.category_id.name, []).append(a)"/>
                    </t>
                    <t t-foreach="sorted(by_cat)" t-as="cat">
                        <h4 style="margin-top:10px; color:#1f3a5f;"><t t-out="cat"/></h4>
                        <table class="table table-sm" style="width:100%; border-collapse:collapse;">
                            <thead><tr style="border-bottom:2px solid #1f3a5f;">
                                <th>Code</th><th>Asset</th><th>Bought</th><th>Held by</th><th>Location</th>
                                <th style="text-align:right">Gross</th><th style="text-align:right">Depreciated</th><th style="text-align:right">Book value</th><th>Status</th>
                            </tr></thead>
                            <tbody>
                                <tr t-foreach="by_cat[cat]" t-as="a">
                                    <td t-out="a.code"/><td t-out="a.name"/><td t-out="a.purchase_date"/>
                                    <td t-out="a.custodian_id.name or ''"/><td t-out="a.location or ''"/>
                                    <td style="text-align:right" t-out="a.purchase_value" t-options="{'widget': 'monetary', 'display_currency': a.currency_id}"/>
                                    <td style="text-align:right" t-out="a.depreciated_value" t-options="{'widget': 'monetary', 'display_currency': a.currency_id}"/>
                                    <td style="text-align:right" t-out="a.book_value" t-options="{'widget': 'monetary', 'display_currency': a.currency_id}"/>
                                    <td t-out="dict(a._fields['state'].selection).get(a.state)"/>
                                </tr>
                            </tbody>
                            <tfoot><tr style="border-top:2px solid #1f3a5f; font-weight:700;">
                                <td colspan="5">Total</td>
                                <td style="text-align:right" t-out="sum(x.purchase_value for x in by_cat[cat])" t-options="{'widget': 'monetary', 'display_currency': docs[0].currency_id}"/>
                                <td style="text-align:right" t-out="sum(x.depreciated_value for x in by_cat[cat])" t-options="{'widget': 'monetary', 'display_currency': docs[0].currency_id}"/>
                                <td style="text-align:right" t-out="sum(x.book_value for x in by_cat[cat])" t-options="{'widget': 'monetary', 'display_currency': docs[0].currency_id}"/>
                                <td/>
                            </tr></tfoot>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
