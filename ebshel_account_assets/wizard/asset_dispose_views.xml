<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_dispose_form" model="ir.ui.view">
        <field name="name">ebshel.asset.dispose.form</field>
        <field name="model">ebshel.asset.dispose</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="asset_id" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="kind" widget="radio"/>
                        <field name="date"/>
                    </group>
                    <group>
                        <field name="book_value"/>
                        <field name="invoice_id" invisible="kind != 'sale'"/>
                        <field name="proceeds" invisible="kind != 'sale'" readonly="invoice_id"/>
                        <field name="company_id" invisible="1"/>
                        <field name="proceeds_account_id" invisible="kind != 'sale' or invoice_id"
                               required="kind == 'sale' and proceeds and not invoice_id"/>
                    </group>
                </group>
                <group>
                    <field name="note" placeholder="Why - it goes on the timeline"/>
                </group>
                <div class="text-muted small">
                    Depreciation is posted up to the date, the gross value and its accumulated depreciation
                    leave the books with its gross increases, and the proceeds less the book value go to the
                    gain or loss account. A sale's proceeds come off the invoice's income lines, or off the
                    proceeds account when there is no invoice.
                </div>
                <footer>
                    <button name="action_apply" type="object" string="Dispose" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
