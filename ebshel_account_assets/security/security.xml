<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_asset_company" model="ir.rule">
        <field name="name">Assets: own companies</field>
        <field name="model_id" ref="model_ebshel_asset"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_asset_category_company" model="ir.rule">
        <field name="name">Asset categories: own companies</field>
        <field name="model_id" ref="model_ebshel_asset_category"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
