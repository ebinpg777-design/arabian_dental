<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="res_config_edition" t-inherit-mode="extension">
        <xpath expr="//h3" position="replace">
            <h3 class="px-0">
                Odoo <t t-esc="serverVersion"/> (Community Edition)
            </h3>
        </xpath>
        <xpath expr="//*[@id='license']" position="replace">
            <a id="license" target="_blank" href="https://www.gnu.org/licenses/lgpl-3.0.html" style="text-decoration: underline;">GNU LGPL v3</a>
        </xpath>
        <xpath expr="//h3" position="after">
            <h5 class="text-muted">Enhanced with ZXS Enterprise Theme</h5>
        </xpath>
    </t>

</templates>
