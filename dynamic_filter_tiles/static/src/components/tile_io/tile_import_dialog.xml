<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="dynamic_filter_tiles.TileImportDialog">
        <Dialog title="'Import a tile set'" size="'md'">
            <div class="o_dft_import">
                <p class="text-muted">
                    Pick a file exported from another database (or paste its contents).
                    Tiles whose model or fields do not exist here are skipped and listed.
                </p>

                <label class="o_dft_import_drop btn btn-secondary w-100">
                    <i class="fa fa-upload me-2"/>
                    <t t-esc="state.fileName or 'Choose a .json file'"/>
                    <input type="file" accept="application/json,.json" class="d-none"
                           t-on-change="onFileSelected"/>
                </label>

                <textarea class="form-control mt-3 font-monospace" rows="7"
                          placeholder='{"version": 1, "tiles": [...]}'
                          t-model="state.payload"/>

                <div class="form-check mt-3">
                    <input type="checkbox" class="form-check-input" id="dft_import_replace"
                           t-model="state.replace"/>
                    <label class="form-check-label" for="dft_import_replace">
                        Replace tiles that already have the same name on the same model
                    </label>
                </div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-primary" t-att-disabled="!canImport" t-on-click="confirm">
                    <i class="fa fa-check me-1" t-if="!state.busy"/>
                    <i class="fa fa-circle-o-notch fa-spin me-1" t-if="state.busy"/>
                    Import
                </button>
                <button class="btn btn-secondary" t-on-click="() => props.close()">Cancel</button>
            </t>
        </Dialog>
    </t>

</templates>
