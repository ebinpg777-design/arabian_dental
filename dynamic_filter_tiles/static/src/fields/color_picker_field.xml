<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="dynamic_filter_tiles.TileColorPickerField">
        <div class="o_dft_swatches" t-att-class="{ o_dft_swatches_readonly: props.readonly }">
            <button t-foreach="palette" t-as="entry" t-key="entry.key"
                    class="o_dft_swatch"
                    t-att-class="{ o_dft_swatch_current: entry.key === current }"
                    t-attf-style="--dft-color: {{ entry.hex }};"
                    t-att-title="entry.label"
                    t-att-aria-label="entry.label"
                    t-att-disabled="props.readonly"
                    t-on-click="() => this.select(entry.key)">
                <i class="fa fa-check"/>
            </button>
        </div>
    </t>

</templates>
