<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The Wall: every ribbon in the database on one screen, grouped by model.
        A tile there is still a filter - clicking one opens its model's list with
        the filter already applied, so the overview is a way *into* the data
        rather than a dead-end dashboard.
    -->
    <record id="action_tile_overview" model="ir.actions.client">
        <field name="name">Tile Wall</field>
        <field name="tag">dynamic_filter_tiles.overview</field>
    </record>

    <menuitem id="menu_tile_overview"
              name="Tile Wall"
              parent="menu_filter_tile_root"
              action="action_tile_overview"
              sequence="20"/>

</odoo>
