<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            A ready-made ribbon on Contacts: every database has them, so the
            feature can be seen working the moment the module is installed with
            demo data. Delete them, or archive them, once you have your own.
        -->
        <record id="tile_partner_companies" model="filter.tile">
            <field name="name">Companies</field>
            <field name="sequence">10</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain">[('is_company', '=', True)]</field>
            <field name="color">sky</field>
            <field name="icon">fa-building-o</field>
            <field name="tooltip">Contacts that are organisations</field>
        </record>

        <record id="tile_partner_people" model="filter.tile">
            <field name="name">People</field>
            <field name="sequence">20</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain">[('is_company', '=', False)]</field>
            <field name="color">violet</field>
            <field name="icon">fa-user-o</field>
            <field name="tooltip">Individual contacts</field>
        </record>

        <record id="tile_partner_reachable" model="filter.tile">
            <field name="name">With an email</field>
            <field name="sequence">30</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain">[('email', '!=', False)]</field>
            <field name="color">emerald</field>
            <field name="icon">fa-envelope-o</field>
        </record>

        <record id="tile_partner_new" model="filter.tile">
            <field name="name">Added this month</field>
            <field name="sequence">40</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain">[('create_date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]</field>
            <field name="color">amber</field>
            <field name="icon">fa-calendar</field>
            <field name="tooltip">Contacts created since the 1st</field>
        </record>

    </data>
</odoo>
