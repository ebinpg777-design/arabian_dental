<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_lab_visit" model="ir.sequence">
            <field name="name">Clinic Visit</field>
            <field name="code">lab.visit</field>
            <field name="prefix">V/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_lab_trip" model="ir.sequence">
            <field name="name">Day Trip</field>
            <field name="code">lab.trip</field>
            <field name="prefix">T/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_cash_handover" model="ir.sequence">
            <field name="name">Cash Handover</field>
            <field name="code">lab.cash.handover</field>
            <field name="prefix">CH/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
