<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Hourly, not once at 21:00. The cutoff is evaluated in each executive's own
            timezone, so a single scheduled hour would close one region's day in the
            middle of their afternoon. Running hourly and asking "is it past the cutoff
            where THIS person is" costs one cheap query and is right everywhere.
        -->
        <record id="cron_close_field_day" model="ir.cron">
            <field name="name">Field Work: close the day for anyone who forgot</field>
            <field name="model_id" ref="model_lab_day_closer"/>
            <field name="state">code</field>
            <field name="code">model._cron_close_day()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!--
            The achieved figures on a target are stored so the desks can order by
            them, and a stored compute does not hear about visits or collections
            arriving. The screens refresh what they read; this keeps the lists and
            exports honest in between. (2026-09-15)
        -->
        <record id="cron_refresh_targets" model="ir.cron">
            <field name="name">Field Work: bring running targets up to date</field>
            <field name="model_id" ref="model_lab_target"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_done()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!--
            Cash carried past the policy (days or amount) raises ONE to-do for
            the executive, in their own name. Daily: the policy is in days.
            (client, 2026-09-18)
        -->
        <record id="cron_cash_reminders" model="ir.cron">
            <field name="name">Field Work: chase collected cash not handed over</field>
            <field name="model_id" ref="model_lab_cash_handover"/>
            <field name="state">code</field>
            <field name="code">model._cron_cash_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
