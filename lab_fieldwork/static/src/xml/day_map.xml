<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="lab_fieldwork.DayMap">
        <div class="o_fw_daymap">
            <div t-if="this.state.loading" class="o_fw_daymap_msg">
                <i class="fa fa-circle-o-notch fa-spin me-2"/>Drawing the day…
            </div>
            <div t-elif="this.state.error" class="o_fw_daymap_msg text-danger">
                <i class="fa fa-exclamation-triangle me-2"/><t t-out="this.state.error"/>
            </div>
            <t t-elif="this.hasPoints">
                <div class="o_fw_daymap_cap">
                    <t t-out="this.caption"/>
                    <a t-if="this.state.track.route_state === 'failed'" href="#"
                       class="ms-2" t-on-click.prevent="this.redraw">try the routing again</a>
                </div>
                <div class="o_fw_daymap_canvas" t-ref="this.mapRef"/>
                <div class="o_fw_daymap_key">
                    <span><i style="background:#0f9d58"/>at the door</span>
                    <span><i style="background:#dc3545"/>away from the clinic</span>
                    <span><i style="background:#2563eb"/>clinic not pinned</span>
                    <span t-if="this.state.track.trail &amp;&amp; this.state.track.trail.length">
                        <i style="background:#0ea5e9"/>live GPS trail
                    </span>
                    <span t-if="this.state.track.halts &amp;&amp; this.state.track.halts.length"
                          class="o_fw_daymap_key_halt"><i/>stopped (minutes)</span>
                    <span t-if="this.state.track.overspeed &amp;&amp; this.state.track.overspeed.length">
                        <i style="background:#dc2626"/>over the speed limit
                    </span>
                    <span t-if="this.state.track.geometry.length"><i style="background:#6d28d9"/>the round, by road (computed)</span>
                    <span t-else=""><i style="background:#6d28d9"/>the round, in order (straight lines)</span>
                    <span class="o_fw_daymap_ring"><i/>clinic's own pin</span>
                </div>
            </t>
            <div t-else="" class="o_fw_daymap_msg text-muted">
                <i class="fa fa-map-o me-2"/>
                No locations were recorded on this day, so there is no track to draw.
            </div>
        </div>
    </t>

</templates>
