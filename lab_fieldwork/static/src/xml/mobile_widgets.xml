<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!-- A selection as chips. Big enough to hit while walking, and no keyboard. -->
<t t-name="lab_fieldwork.FwChoice">
    <div class="o_fw_choice" t-att-class="this.props.readonly ? 'o_fw_choice_ro' : ''">
        <button t-foreach="this.choices" t-as="c" t-key="c[0]" type="button"
                class="o_fw_choice_chip"
                t-att-class="(this.value === c[0] ? 'o_fw_choice_on ' : '') + this.tone(c[0])"
                t-att-aria-pressed="this.value === c[0] ? 'true' : 'false'"
                t-att-disabled="this.props.readonly"
                t-on-click="() => this.onPick(c[0])">
            <i t-if="this.value === c[0]" class="fa fa-check me-1" title="Chosen"/>
            <t t-esc="c[1]"/>
        </button>
    </div>
</t>

<!-- The multi-select twin: several can be on at once, so the check mark is a real
     state per chip rather than "the one chip that differs from the rest". -->
<t t-name="lab_fieldwork.FwChoiceMulti">
    <div class="o_fw_choice" t-att-class="this.props.readonly ? 'o_fw_choice_ro' : ''">
        <button t-foreach="this.choices" t-as="c" t-key="c.id" type="button"
                class="o_fw_choice_chip"
                t-att-class="this.isOn(c.id) ? 'o_fw_choice_on' : ''"
                t-att-aria-pressed="this.isOn(c.id) ? 'true' : 'false'"
                t-att-disabled="this.props.readonly"
                t-on-click="() => this.onPick(c.id)">
            <i t-if="this.isOn(c.id)" class="fa fa-check me-1" title="Selected"/>
            <t t-esc="c.display_name"/>
        </button>
    </div>
</t>

<!-- Money. The figure is readable at arm's length; the chips cover almost every real
     amount; the keyboard is the fallback, not the first move. -->
<t t-name="lab_fieldwork.FwAmount">
    <div class="o_fw_amount">
        <div class="o_fw_amount_now" t-esc="this.display"/>
        <t t-if="!this.props.readonly">
            <div class="o_fw_amount_steps">
                <button t-foreach="this.steps" t-as="s" t-key="s" type="button"
                        class="o_fw_amount_step" t-on-click="() => this.add(s)">
                    +<t t-esc="s"/>
                </button>
                <button type="button" class="o_fw_amount_step o_fw_amount_clear"
                        t-on-click="() => this.clear()">
                    <i class="fa fa-undo me-1" title="Clear"/>Clear
                </button>
            </div>
            <!-- inputmode gives the phone a number pad instead of a full keyboard. -->
            <input type="text" inputmode="decimal" t-custom-ref="input"
                   class="o_fw_amount_input" placeholder="or type the exact amount"
                   t-att-value="this.value or ''" t-on-change="this.onInput"/>
        </t>
    </div>
</t>

<!-- Proof photo. `capture` makes the phone open the rear camera directly rather than
     the gallery, which is the difference between one tap and four. -->
<t t-name="lab_fieldwork.FwCamera">
    <div class="o_fw_camera">
        <div t-if="this.value" class="o_fw_camera_has">
            <img t-att-src="this.src" alt="Proof photo" class="o_fw_camera_img"/>
            <div t-if="!this.props.readonly" class="o_fw_camera_actions">
                <label class="o_fw_camera_btn">
                    <i class="fa fa-refresh me-1" title="Retake"/>Retake
                    <input type="file" accept="image/*" capture="environment"
                           class="d-none" t-on-change="this.onFile"/>
                </label>
                <button type="button" class="o_fw_camera_btn o_fw_camera_del"
                        t-on-click="() => this.remove()">
                    <i class="fa fa-trash-o me-1" title="Remove"/>Remove
                </button>
            </div>
        </div>
        <label t-else="" class="o_fw_camera_drop"
               t-att-class="this.props.readonly ? 'o_fw_camera_ro' : ''">
            <i class="fa fa-camera fa-2x mb-2" title="Take a photo"/>
            <span t-if="this.state.busy">Reading the photo…</span>
            <span t-elif="this.props.readonly">No photo</span>
            <span t-else="">Take a photo</span>
            <input t-if="!this.props.readonly" type="file" accept="image/*"
                   capture="environment" class="d-none" t-on-change="this.onFile"/>
        </label>
    </div>
</t>

<!-- The three things done with a phone rather than in a form. Sticky at the bottom on
     a small screen, so they stay under the thumb however far the form is scrolled. -->
<t t-name="lab_fieldwork.FwContactBar">
    <div class="o_fw_contact_bar">
        <a t-if="this.mapUrl" t-att-href="this.mapUrl" target="_blank" rel="noopener"
           class="o_fw_contact_btn o_fw_contact_map">
            <i class="fa fa-location-arrow" title="Navigate"/>
            <span>Navigate</span>
        </a>
        <a t-if="this.telUrl" t-att-href="this.telUrl" class="o_fw_contact_btn">
            <i class="fa fa-phone" title="Call"/>
            <span>Call</span>
        </a>
        <a t-if="this.waUrl" t-att-href="this.waUrl" target="_blank" rel="noopener"
           class="o_fw_contact_btn">
            <i class="fa fa-whatsapp" title="WhatsApp"/>
            <span>WhatsApp</span>
        </a>
        <span t-if="!this.mapUrl and !this.telUrl" class="o_fw_contact_none">
            No phone number or map pin on this clinic yet.
        </span>
    </div>
</t>


<!-- Upper / lower, drawn as the arches. Two toggles that combine into U, L or UL:
     nobody thinks in three options, they think "is the upper in this job". -->
<t t-name="lab_fieldwork.FwArch">
    <div class="o_fw_arch" t-att-class="this.props.readonly ? 'o_fw_arch_ro' : ''">
        <button type="button" class="o_fw_arch_btn"
                t-att-class="this.has('upper') ? 'o_fw_arch_on' : ''"
                t-att-aria-pressed="this.has('upper') ? 'true' : 'false'"
                t-att-disabled="this.props.readonly" aria-label="Upper arch"
                t-on-click="() => this.toggle('upper')">
            <svg viewBox="0 0 60 34" class="o_fw_arch_svg" aria-hidden="true">
                <path d="M6 30 A24 26 0 0 1 54 30" fill="none" stroke="currentColor"
                      stroke-width="7" stroke-linecap="round"/>
            </svg>
            <span>Upper</span>
        </button>
        <button type="button" class="o_fw_arch_btn"
                t-att-class="this.has('lower') ? 'o_fw_arch_on' : ''"
                t-att-aria-pressed="this.has('lower') ? 'true' : 'false'"
                t-att-disabled="this.props.readonly" aria-label="Lower arch"
                t-on-click="() => this.toggle('lower')">
            <svg viewBox="0 0 60 34" class="o_fw_arch_svg" aria-hidden="true">
                <path d="M6 4 A24 26 0 0 0 54 4" fill="none" stroke="currentColor"
                      stroke-width="7" stroke-linecap="round"/>
            </svg>
            <span>Lower</span>
        </button>
        <!-- The shape is not the only carrier: the selection is also written out. -->
        <span class="o_fw_arch_label" t-esc="this.label"/>
    </div>
</t>

<!-- Two big targets for the small adjustment, and a field for everything else:
     stepping to an age of 34 would be thirty-four taps. -->
<t t-name="lab_fieldwork.FwStepper">
    <div class="o_fw_stepper">
        <button type="button" class="o_fw_step_btn" aria-label="One less"
                t-att-disabled="this.props.readonly" t-on-click="() => this.step(-1)">
            <i class="fa fa-minus" title="One less"/>
        </button>
        <span t-if="this.props.readonly" class="o_fw_step_v" t-esc="this.display"/>
        <input t-else="" type="text" inputmode="numeric" class="o_fw_step_v o_fw_step_in"
               t-att-value="this.display" t-on-change="this.onInput"
               t-att-aria-label="this.props.record.fields[this.props.name].string"/>
        <button type="button" class="o_fw_step_btn" aria-label="One more"
                t-att-disabled="this.props.readonly" t-on-click="() => this.step(1)">
            <i class="fa fa-plus" title="One more"/>
        </button>
    </div>
</t>

<!-- What came in the bag, as chips. Six checkboxes is six precise taps; six chips is
     six targets the width of a thumb. -->
<t t-name="lab_fieldwork.FwToggles">
    <div class="o_fw_choice">
        <button t-foreach="this.items" t-as="item" t-key="item.name" type="button"
                class="o_fw_choice_chip" t-att-class="(item.on ? 'o_fw_choice_on ' : '') + item.tone"
                t-att-aria-pressed="item.on ? 'true' : 'false'"
                t-att-disabled="this.props.readonly"
                t-on-click="() => this.toggle(item)">
            <i t-if="item.on" class="fa fa-check me-1" title="Included"/>
            <t t-esc="item.label"/>
        </button>
    </div>
</t>


<!-- A flag that changes what the LAB does, set by somebody standing at a counter. A
     checkbox in a group of six gets missed both ways: ticked by accident and forgotten
     when it matters. This is one target, it states the consequence, and it is loud only
     when it is on. -->
<t t-name="lab_fieldwork.FwFlag">
    <div class="o_fw_flag" t-att-class="this.on ? 'o_fw_flag_on' : ''"
         role="button" tabindex="0"
         t-att-aria-pressed="this.on ? 'true' : 'false'"
         t-on-click="() => this.toggle()"
         t-on-keydown="(ev) => ev.key === 'Enter' || ev.key === ' ' ? this.toggle() : null">
        <i t-att-class="'fa ' + (this.props.icon or 'fa-phone') + ' o_fw_flag_icon'"
           t-att-title="this.field.string"/>
        <div class="o_fw_flag_body">
            <div class="o_fw_flag_title" t-esc="this.field.string"/>
            <div class="o_fw_flag_help">
                <t t-if="this.on">The lab will not start until the doctor has been called.</t>
                <t t-else="" t-esc="this.field.help or 'Tap if the lab must call the doctor first.'"/>
            </div>
        </div>
        <span class="o_fw_flag_state"><t t-esc="this.on ? 'ON' : 'OFF'"/></span>
    </div>
</t>

</templates>
