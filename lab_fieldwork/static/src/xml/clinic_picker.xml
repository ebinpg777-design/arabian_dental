<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="lab_fieldwork.FwClinicPicker">
    <div class="o_fw_cp">
        <!-- The clinic chosen: a card that says where it is. -->
        <div t-if="this.value and !this.state.open" class="o_fw_cp_card"
             t-att-class="{ o_fw_cp_card_ro: this.props.readonly }"
             t-on-click="() => this.openPicker()">
            <span class="o_fw_cp_ico"><i class="fa fa-hospital-o" title="Clinic"/></span>
            <span class="o_fw_cp_body">
                <span class="o_fw_cp_name" t-out="this.chosenName"/>
                <span t-if="this.state.chosen and (this.state.chosen.place or this.state.chosen.phone)" class="o_fw_cp_meta">
                    <t t-if="this.state.chosen.place"><i class="fa fa-map-marker me-1" title="Place"/><t t-out="this.state.chosen.place"/></t>
                    <t t-if="this.state.chosen.place and this.state.chosen.phone"> · </t>
                    <t t-if="this.state.chosen.phone"><i class="fa fa-phone me-1" title="Phone"/><t t-out="this.state.chosen.phone"/></t>
                </span>
            </span>
            <span t-if="!this.props.readonly" class="o_fw_cp_change">Change</span>
        </div>

        <!-- Picking one. -->
        <div t-if="this.state.open" class="o_fw_cp_sheet">
            <div class="o_fw_cp_search">
                <i class="fa fa-search" title="Search"/>
                <input type="search" class="o_fw_cp_input" t-att-value="this.state.query"
                       t-on-input="this.onInput" autocomplete="off" enterkeyhint="search"
                       t-att-placeholder="this.props.placeholder or 'Search clinic, doctor, place or phone'"/>
                <button t-if="this.state.query" class="o_fw_cp_clear" title="Clear"
                        t-on-click="() => this.clearQuery()"><i class="fa fa-times" title="Clear"/></button>
                <i t-if="this.state.busy" class="fa fa-circle-o-notch fa-spin o_fw_cp_spin" title="Searching"/>
            </div>

            <t t-if="this.state.query.trim()">
                <t t-set="list" t-value="this.state.results"/>
                <t t-call="lab_fieldwork.FwClinicRows"/>
            </t>
            <t t-else="">
                <div t-if="this.state.starred.length" class="o_fw_cp_h"><i class="fa fa-star me-1" title="Starred"/>Your starred clinics</div>
                <t t-set="list" t-value="this.state.starred"/>
                <t t-call="lab_fieldwork.FwClinicRows"/>
                <div t-if="this.state.recent.length" class="o_fw_cp_h"><i class="fa fa-history me-1" title="Recent"/>Lately</div>
                <t t-set="list" t-value="this.state.recent"/>
                <t t-call="lab_fieldwork.FwClinicRows"/>
            </t>
            <div t-if="this.showEmpty" class="o_fw_cp_empty" t-out="this.emptyText"/>
            <button t-if="this.value" class="o_fw_cp_keep" t-on-click="() => this.closePicker()">
                Keep <t t-out="this.chosenName"/>
            </button>
        </div>
    </div>
</t>

<t t-name="lab_fieldwork.FwClinicRows">
    <button t-foreach="list" t-as="row" t-key="row.id" class="o_fw_cp_row"
            t-att-class="{ o_fw_cp_row_on: this.value and this.value.id === row.id }"
            t-on-click="() => this.pick(row)">
        <span class="o_fw_cp_ico o_fw_cp_ico_sm"><i class="fa fa-hospital-o" title="Clinic"/></span>
        <span class="o_fw_cp_body">
            <span class="o_fw_cp_name" t-out="row.name"/>
            <span t-if="row.place or row.phone" class="o_fw_cp_meta">
                <t t-out="row.place"/><t t-if="row.place and row.phone"> · </t><t t-out="row.phone"/>
            </span>
        </span>
        <span class="o_fw_cp_star" t-att-class="{ o_fw_cp_star_on: row.starred }"
              t-att-title="row.starred ? 'Starred' : 'Star this clinic'"
              t-on-click="(ev) => this.toggleStar(row, ev)">
            <i t-att-class="row.starred ? 'fa fa-star' : 'fa fa-star-o'" title="Star"/>
        </span>
    </button>
</t>

</templates>
