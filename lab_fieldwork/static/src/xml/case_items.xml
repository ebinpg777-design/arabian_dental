<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="lab_fieldwork.FwCaseItems">
    <div class="o_fwci" t-att-class="this.readonly ? 'o_fwci_ro' : ''">
        <!-- what is on the slip so far, in one line -->
        <div class="o_fwci_sum" t-if="this.lines.length">
            <span class="o_fwci_pill o_fwci_p_items"><i class="fa fa-cubes me-1" title="Items"/><b t-out="this.summary.items"/> item<t t-if="this.summary.items !== 1">s</t></span>
            <span class="o_fwci_pill o_fwci_p_units"><i class="fa fa-hashtag me-1" title="Units"/><b t-out="this.qtyLabel(this.summary.units)"/> unit<t t-if="this.summary.units !== 1">s</t></span>
            <span class="o_fwci_pill o_fwci_p_teeth" t-if="this.summary.teeth"><i class="fa fa-th me-1" title="Teeth"/><b t-out="this.summary.teeth"/> <t t-if="this.summary.teeth === 1">tooth</t><t t-else="">teeth</t></span>
            <span class="o_fwci_pill o_fwci_p_urgent" t-if="this.summary.urgent"><i class="fa fa-bolt me-1" title="Urgent"/><b t-out="this.summary.urgent"/> urgent</span>
        </div>

        <div t-if="!this.lines.length" class="o_fwci_empty">
            <i class="fa fa-medkit" title="Nothing yet"/>
            <div class="o_fwci_empty_t">Nothing on this case yet</div>
            <div class="o_fwci_empty_s" t-if="!this.readonly">Tap the green button and pick what the doctor handed over.</div>
        </div>

        <div t-foreach="this.lines" t-as="l" t-key="l.key" t-att-class="'o_fwci_card o_fwci_t_' + l.tone + (l.urgent ? ' o_fwci_card_urgent' : '')">
            <div class="o_fwci_head">
                <span class="o_fwci_no" t-out="l_index + 1"/>
                <div class="o_fwci_name">
                    <div class="o_fwci_product" t-out="l.product or 'Pick what is being made'"/>
                    <div class="o_fwci_meta">
                        <span class="o_fwci_tag o_fwci_tag_arch" t-out="this.archLabel(l)"/>
                        <span class="o_fwci_tag o_fwci_tag_teeth" t-if="l.teeth"><i class="fa fa-th me-1" title="Teeth"/><t t-out="l.teeth"/></span>
                        <span class="o_fwci_tag o_fwci_tag_cast" t-if="l.cast"><i class="fa fa-cube me-1" title="Cast"/>Cast <t t-out="{upper: 'U', lower: 'L', ul: 'U+L'}[l.cast]"/></span>
                        <span class="o_fwci_tag o_fwci_tag_shade" t-if="l.shade"><i class="fa fa-tint me-1" title="Shade"/><t t-out="l.shade"/></span>
                        <span class="o_fwci_tag o_fwci_tag_urgent" t-if="l.urgent"><i class="fa fa-bolt me-1" title="Urgent"/>Urgent</span>
                        <span class="o_fwci_tag o_fwci_tag_note" t-if="l.note and this.state.noteFor !== l.key"><i class="fa fa-comment-o me-1" title="Remark"/><t t-out="l.note"/></span>
                    </div>
                </div>
                <span class="o_fwci_qtybadge" t-if="this.readonly">× <t t-out="this.qtyLabel(l.qty)"/></span>
                <button t-if="!this.readonly" type="button" class="o_fwci_x" aria-label="Remove this item" t-on-click="() => this.remove(l)">
                    <i class="fa fa-trash-o" title="Remove"/>
                </button>
            </div>

            <div class="o_fwci_controls" t-if="!this.readonly">
                <!-- the arch: two toggles that combine, drawn as the arches -->
                <div class="o_fwci_arch" role="group" aria-label="Arch">
                    <button type="button" class="o_fwci_archbtn o_fwci_upper" t-att-class="this.has(l, 'upper') ? 'on' : ''"
                            t-att-aria-pressed="this.has(l, 'upper') ? 'true' : 'false'" t-on-click="() => this.toggleArch(l, 'upper')">
                        <svg viewBox="0 0 60 34" aria-hidden="true"><path d="M6 30 A24 26 0 0 1 54 30" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round"/></svg>
                        <span>Upper</span>
                    </button>
                    <button type="button" class="o_fwci_archbtn o_fwci_lower" t-att-class="this.has(l, 'lower') ? 'on' : ''"
                            t-att-aria-pressed="this.has(l, 'lower') ? 'true' : 'false'" t-on-click="() => this.toggleArch(l, 'lower')">
                        <svg viewBox="0 0 60 34" aria-hidden="true"><path d="M6 4 A24 26 0 0 0 54 4" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round"/></svg>
                        <span>Lower</span>
                    </button>
                </div>
                <!-- quantity: two big targets, and a number pad for the rare large one -->
                <div class="o_fwci_qty" role="group" aria-label="Quantity">
                    <button type="button" class="o_fwci_qbtn" aria-label="One less" t-att-disabled="l.qty &lt;= 1" t-on-click="() => this.step(l, -1)"><i class="fa fa-minus" title="One less"/></button>
                    <input type="text" inputmode="decimal" class="o_fwci_qin" t-att-value="this.qtyLabel(l.qty)" aria-label="Quantity" t-on-change="(ev) => this.onQty(l, ev)"/>
                    <button type="button" class="o_fwci_qbtn" aria-label="One more" t-on-click="() => this.step(l, 1)"><i class="fa fa-plus" title="One more"/></button>
                </div>
            </div>

            <!-- the teeth, off a chart; and the cast that came with the case -->
            <div class="o_fwci_mouth" t-if="!this.readonly">
                <button type="button" t-att-class="'o_fwci_teethbtn' + (l.teeth ? ' on' : '')" t-on-click="() => this.openTeeth(l)">
                    <i class="fa fa-th" title="Teeth"/>
                    <span class="o_fwci_teethbtn_t">
                        <b t-if="l.teeth" t-out="l.teeth"/>
                        <b t-else="">Which teeth?</b>
                        <em t-if="l.teeth"><t t-out="l.teethCount"/> <t t-if="l.teethCount === 1">tooth</t><t t-else="">teeth</t> · tap to change</em>
                        <em t-else="">Tap to pick them off the chart</em>
                    </span>
                    <i class="fa fa-angle-right" title="Open"/>
                </button>
                <div class="o_fwci_cast" role="group" aria-label="Cast received">
                    <span class="o_fwci_cast_l">Cast</span>
                    <button type="button" t-att-class="'o_fwci_castbtn o_fwci_upper' + (l.cast === 'upper' ? ' on' : '')" t-on-click="() => this.setCast(l, 'upper')">U</button>
                    <button type="button" t-att-class="'o_fwci_castbtn o_fwci_lower' + (l.cast === 'lower' ? ' on' : '')" t-on-click="() => this.setCast(l, 'lower')">L</button>
                    <button type="button" t-att-class="'o_fwci_castbtn o_fwci_both' + (l.cast === 'ul' ? ' on' : '')" t-on-click="() => this.setCast(l, 'ul')">U+L</button>
                </div>
            </div>

            <div class="o_fwci_actions" t-if="!this.readonly">
                <button type="button" class="o_fwci_act o_fwci_a_shade" t-att-class="l.shade ? 'on' : ''" t-on-click="() => this.openShades(l)">
                    <i class="fa fa-tint" title="Shade"/><span t-out="l.shade or 'Shade'"/>
                </button>
                <button type="button" class="o_fwci_act o_fwci_a_urgent" t-att-class="l.urgent ? 'on' : ''"
                        t-att-aria-pressed="l.urgent ? 'true' : 'false'" t-on-click="() => this.toggleUrgent(l)">
                    <i class="fa fa-bolt" title="Urgent"/><span>Urgent</span>
                </button>
                <button type="button" class="o_fwci_act o_fwci_a_note" t-att-class="l.note ? 'on' : ''" t-on-click="() => this.toggleNote(l)">
                    <i class="fa fa-comment-o" title="Remark"/><span>Remark</span>
                </button>
                <button type="button" class="o_fwci_act o_fwci_a_copy" t-on-click="() => this.duplicate(l)" title="The same item for the other arch">
                    <i class="fa fa-clone" title="Copy"/><span>Other arch</span>
                </button>
            </div>
            <input t-if="!this.readonly and this.state.noteFor === l.key" type="text" class="o_fwci_notein" t-att-value="l.note"
                   placeholder="e.g. extra clasp on 16" t-on-change="(ev) => this.onNote(l, ev)"/>
        </div>

        <button t-if="!this.readonly" type="button" class="o_fwci_add" t-on-click="this.openPicker">
            <i class="fa fa-plus-circle" title="Add"/>
            <span t-out="this.lines.length ? 'Add another item' : 'Add what is being made'"/>
        </button>

        <!-- ================================================= the product picker -->
        <div class="o_fwci_sheet" t-if="this.state.sheet === 'product'" role="dialog" aria-label="Pick what is being made">
            <div class="o_fwci_sheet_h o_fwci_sh_green">
                <button type="button" class="o_fwci_back" aria-label="Close" t-on-click="this.closeSheet"><i class="fa fa-arrow-left" title="Back"/></button>
                <div class="o_fwci_sheet_t">
                    <div>What is being made</div>
                    <small t-if="this.state.added"><t t-out="this.state.added"/> added · last: <t t-out="this.state.lastAdded"/></small>
                    <small t-else="">Tap an item to add it. Add as many as you need.</small>
                </div>
                <button type="button" class="o_fwci_done" t-on-click="this.closeSheet">Done<t t-if="this.state.added"> (<t t-out="this.state.added"/>)</t></button>
            </div>
            <div class="o_fwci_search">
                <i class="fa fa-search" title="Search"/>
                <input type="search" inputmode="search" placeholder="Search by name or code" t-att-value="this.state.query" t-on-input="this.onQuery"/>
                <button t-if="this.state.query" type="button" class="o_fwci_clear" aria-label="Clear the search" t-on-click="this.clearQuery"><i class="fa fa-times-circle" title="Clear"/></button>
            </div>
            <div class="o_fwci_cats" t-if="this.state.catalog and this.state.catalog.categories.length">
                <button type="button" t-foreach="this.state.catalog.categories" t-as="c" t-key="c.id"
                        t-att-class="'o_fwci_cat o_fwci_t_' + this.tone(c.id) + (this.state.categ === c.id ? ' on' : '')" t-on-click="() => this.pickCateg(c.id)">
                    <t t-out="c.name"/><small t-out="c.count"/>
                </button>
            </div>
            <div class="o_fwci_sheet_b">
                <div t-if="this.state.loading and !this.state.catalog" class="o_fwci_wait"><i class="fa fa-circle-o-notch fa-spin" title="Loading"/></div>
                <t t-if="this.state.catalog">
                    <t t-set="cat" t-value="this.state.catalog"/>
                    <t t-if="cat.clinic.length">
                        <div class="o_fwci_shelf o_fwci_shelf_clinic"><i class="fa fa-hospital-o me-1" title="This clinic"/>This clinic usually orders</div>
                        <t t-foreach="cat.clinic" t-as="p" t-key="'c' + p.id"><t t-call="lab_fieldwork.FwCaseItems.Product"/></t>
                    </t>
                    <t t-if="cat.frequent.length">
                        <div class="o_fwci_shelf o_fwci_shelf_top"><i class="fa fa-star me-1" title="Most made"/>The lab makes these most</div>
                        <t t-foreach="cat.frequent" t-as="p" t-key="'f' + p.id"><t t-call="lab_fieldwork.FwCaseItems.Product"/></t>
                    </t>
                    <t t-if="this.state.query or this.state.categ">
                        <div class="o_fwci_shelf o_fwci_shelf_find"><i class="fa fa-search me-1" title="Found"/><t t-out="cat.results.length"/> found</div>
                        <t t-foreach="cat.results" t-as="p" t-key="'r' + p.id"><t t-call="lab_fieldwork.FwCaseItems.Product"/></t>
                        <div t-if="!cat.results.length" class="o_fwci_none">Nothing matches. Try fewer letters, or another category.</div>
                    </t>
                </t>
            </div>
        </div>

        <!-- ================================================= the shade picker -->
        <div class="o_fwci_sheet" t-if="this.state.sheet === 'shade'" role="dialog" aria-label="Pick a shade">
            <div class="o_fwci_sheet_h o_fwci_sh_pink">
                <button type="button" class="o_fwci_back" aria-label="Close" t-on-click="this.closeSheet"><i class="fa fa-arrow-left" title="Back"/></button>
                <div class="o_fwci_sheet_t">
                    <div>Shade</div>
                    <small t-if="this.shadeLine" t-out="this.shadeLine.product"/>
                </div>
                <button type="button" class="o_fwci_done" t-on-click="() => this.pickShade(false)">No shade</button>
            </div>
            <div class="o_fwci_search">
                <i class="fa fa-search" title="Search"/>
                <input type="search" placeholder="A2, 2M2, B3…" t-att-value="this.state.shadeQuery" t-on-input="this.onShadeQuery"/>
            </div>
            <div class="o_fwci_sheet_b">
                <div class="o_fwci_shelf o_fwci_shelf_top" t-if="!this.state.shadeQuery"><i class="fa fa-star me-1" title="Most used"/>Most used first</div>
                <div class="o_fwci_shades">
                    <button type="button" t-foreach="this.state.shades" t-as="s" t-key="s.id" class="o_fwci_shade"
                            t-att-class="this.shadeLine and this.shadeLine.shade === s.name ? 'on' : ''" t-on-click="() => this.pickShade(s)">
                        <t t-out="s.name"/>
                    </button>
                </div>
                <div t-if="!this.state.shades.length" class="o_fwci_none">No shade with that name.</div>
            </div>
        </div>

        <!-- ═════════ the teeth, off a chart ═════════ -->
        <div class="o_fwci_sheet o_fwci_sheet_teeth" t-if="this.state.sheet === 'teeth'" role="dialog" aria-label="Pick the teeth">
            <div class="o_fwci_sheet_h o_fwci_sh_indigo">
                <button type="button" class="o_fwci_back" aria-label="Close" t-on-click="this.closeSheet"><i class="fa fa-arrow-left" title="Back"/></button>
                <div class="o_fwci_sheet_t">
                    <div>Which teeth</div>
                    <small t-if="this.teethLine" t-out="this.teethLine.product"/>
                </div>
                <button type="button" class="o_fwci_done" t-on-click="this.saveTeeth">Done<t t-if="this.state.teeth.length"> (<t t-out="this.state.teeth.length"/>)</t></button>
            </div>
            <div class="o_fwci_teeth_now">
                <t t-if="this.state.teeth.length">
                    <b t-out="this.teethText"/>
                    <span><t t-out="this.state.teeth.length"/> <t t-if="this.state.teeth.length === 1">tooth</t><t t-else="">teeth</t></span>
                </t>
                <span t-else="">Tap the teeth the work is for. The patient's right is on your left, as on a chart.</span>
            </div>
            <div class="o_fwci_sheet_b o_fwci_teeth_b">
                <div class="o_fwci_sets">
                    <button type="button" t-foreach="this.teethSets" t-as="set" t-key="set.key"
                            t-att-class="'o_fwci_set o_fwci_set_' + set.tone + (this.setOn(set.teeth) ? ' on' : '')"
                            t-on-click="() => this.toggleSet(set.teeth)" t-out="set.name"/>
                </div>
                <div t-foreach="this.quadrants" t-as="q" t-key="q.key" t-att-class="'o_fwci_quad o_fwci_quad_' + q.arch + (q.primary ? ' o_fwci_quad_primary' : '')">
                    <button type="button" t-att-class="'o_fwci_quad_n' + (this.setOn(q.teeth) ? ' on' : '')" t-on-click="() => this.toggleSet(q.teeth)">
                        <t t-out="q.name"/><em t-if="q.primary"> · baby teeth</em><small>all</small>
                    </button>
                    <div class="o_fwci_quad_t">
                        <button type="button" t-foreach="q.teeth" t-as="tooth" t-key="tooth"
                                t-att-class="'o_fwci_tooth' + (this.hasTooth(tooth) ? ' on' : '')"
                                t-att-aria-pressed="this.hasTooth(tooth) ? 'true' : 'false'"
                                t-on-click="() => this.toggleTooth(tooth)" t-out="tooth"/>
                    </div>
                </div>
                <div class="o_fwci_teeth_opts">
                    <button type="button" t-att-class="'o_fwci_opt' + (this.state.primary ? ' on' : '')" t-on-click="() => this.state.primary = !this.state.primary">
                        <i class="fa fa-child" title="Baby teeth"/> Baby teeth</button>
                    <button type="button" t-att-class="'o_fwci_opt' + (this.state.follow ? ' on' : '')" t-on-click="() => this.state.follow = !this.state.follow"
                            title="The quantity of the item is the number of teeth">
                        <i class="fa fa-hashtag" title="Quantity"/> Quantity = teeth</button>
                    <button type="button" class="o_fwci_opt o_fwci_opt_clear" t-att-disabled="!this.state.teeth.length" t-on-click="this.clearTeeth">
                        <i class="fa fa-eraser" title="Clear"/> Clear</button>
                </div>
            </div>
            <div class="o_fwci_teeth_f">
                <button type="button" class="o_fwci_teeth_go" t-on-click="this.saveTeeth">
                    <i class="fa fa-check me-1" title="Done"/>
                    <t t-if="this.state.teeth.length">Put <t t-out="this.state.teeth.length"/> on the case</t><t t-else="">Done</t>
                </button>
            </div>
        </div>
    </div>
</t>

<t t-name="lab_fieldwork.FwCaseItems.Product">
    <button type="button" t-att-class="'o_fwci_prod o_fwci_t_' + this.tone(p.categ_id)" t-on-click="() => this.add(p)">
        <span class="o_fwci_prod_dot"/>
        <span class="o_fwci_prod_main">
            <span class="o_fwci_prod_name" t-out="p.name"/>
            <span class="o_fwci_prod_sub"><t t-out="p.categ"/><t t-if="p.uses"> · ordered <t t-out="p.uses"/>×</t></span>
        </span>
        <span class="o_fwci_prod_in" t-if="this.inCase(p.id)">× <t t-out="this.inCase(p.id)"/></span>
        <span class="o_fwci_prod_add"><i class="fa fa-plus" title="Add"/></span>
    </button>
</t>

</templates>
