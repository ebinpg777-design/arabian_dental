<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="lab_fieldwork.NavBar" t-inherit="web.NavBar" t-inherit-mode="extension">
    <!-- First on the bar, before the apps menu: the one place a thumb finds without looking. -->
    <xpath expr="//t[@t-call='web.NavBar.AppsMenu']" position="before">
        <!-- Phone only: the desktop bar already shows the app name and its menus. -->
        <div t-if="this.ui.isSmall and this.fwHasHome" class="o_fw_mobile_nav d-flex align-items-center">
            <button type="button" class="o_fw_mobile_home" title="Home" aria-label="Home"
                    t-on-click="() => this.fwGoHome()">
                <i class="fa fa-home" aria-hidden="true"/>
            </button>
            <!-- Only where the screen has no back arrow of its own (see mobile_home.scss). -->
            <button type="button" class="o_fw_mobile_btn o_fw_mobile_back" title="Back"
                    aria-label="Back" t-on-click="() => this.fwGoBack()">
                <i class="fa fa-chevron-left" aria-hidden="true"/>
            </button>
        </div>
    </xpath>
</t>

</templates>
