<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="lab_fieldwork.MyDay">
    <div class="o_fw_day o_action">

        <!-- Header: what today amounts to, in four numbers and a progress ring. -->
        <div class="o_fw_hero">
            <div class="o_fw_hero_top">
                <div>
                    <div class="o_fw_hero_eyebrow">
                        <t t-if="this.state.data">
                            <t t-out="this.state.data.greeting"/><t t-if="this.state.data.user_name">, <t t-out="this.state.data.user_name"/></t>
                        </t>
                        <t t-else="">My Day</t>
                    </div>
                    <h2 class="o_fw_hero_date">
                        <t t-out="this.state.data and (this.state.data.date_label or this.state.data.date)"/>
                    </h2>
                    <!-- The day stepper and the month's door count on ONE row:
                         two stacked control rows ate a third of a phone's
                         header. They wrap only when they must.
                         (client, 2026-08-28) -->
                    <div class="o_fw_hero_controls">
                        <!-- Step back over the days the office allows, so a round the
                             phone died on can still be written up. Never past today.
                             (client, 2026-08-25) -->
                        <div class="o_fw_daynav"
                             t-if="this.state.data and (this.state.data.backdate_days or this.state.data.any_day)">
                            <button class="o_fw_daynav_btn" title="Previous day"
                                    t-att-disabled="this.state.data.day &lt;= this.state.data.earliest"
                                    t-on-click="() => this.shiftDay(-1)">
                                <i class="fa fa-chevron-left"/>
                            </button>
                            <button class="o_fw_daynav_today" t-if="!this.state.data.is_today"
                                    t-on-click="() => this.backToToday()">Today</button>
                            <button class="o_fw_daynav_btn" title="Next day"
                                    t-att-disabled="this.state.data.is_today"
                                    t-on-click="() => this.shiftDay(1)">
                                <i class="fa fa-chevron-right"/>
                            </button>
                        </div>
                        <!-- Doors opened this month. An executive is judged on the work they
                             bring back AND the clinics they open. (client, 2026-08-27) -->
                        <div class="o_fw_newclinic_line" t-if="this.state.data"
                             t-on-click="() => this.openNewClinics()">
                            <i class="fa fa-hospital-o me-1" title="New clinics"/>
                            <b t-out="this.state.data.new_clinics"/> new clinic(s) this month
                            <i class="fa fa-chevron-right ms-1"/>
                        </div>
                    </div>
                </div>
                <div t-if="this.state.data and this.state.data.target" class="o_fw_ring_wrap"
                     t-on-click="() => this.openTarget()">
                    <!-- A ring, not a bar: it reads as "how far round the month am I"
                         at a glance and takes no horizontal space on a phone. -->
                    <div class="o_fw_ring"
                         t-attf-style="--fw-pct: {{ Math.min(this.state.data.target.progress, 100) }}">
                        <span class="o_fw_ring_label">
                            <t t-out="Math.round(this.state.data.target.progress)"/>%
                        </span>
                    </div>
                    <div class="o_fw_ring_caption">of target</div>
                </div>
            </div>

            <div t-if="!this.state.loading" class="o_fw_stats">
                <div class="o_fw_stat">
                    <span class="o_fw_stat_v">
                        <t t-out="this.state.data.summary.done"/>/<t t-out="this.state.data.summary.planned"/>
                    </span>
                    <span class="o_fw_stat_l">visits</span>
                </div>
                <div class="o_fw_stat">
                    <span class="o_fw_stat_v"><t t-out="this.state.data.summary.cases"/></span>
                    <!-- "registered", now that a hand count sits on the next row:
                         this one is the slips that became orders at check-out. -->
                    <span class="o_fw_stat_l">cases registered</span>
                </div>
                <div class="o_fw_stat">
                    <span t-att-class="this.statCls(this.money(this.state.data.summary.value))"><t t-out="this.money(this.state.data.summary.value)"/></span>
                    <span class="o_fw_stat_l">case value</span>
                </div>
                <div class="o_fw_stat">
                    <span t-att-class="this.statCls(this.money(this.state.data.summary.collected))"><t t-out="this.money(this.state.data.summary.collected)"/></span>
                    <span class="o_fw_stat_l">collected</span>
                </div>
                <!-- The lab's money in this person's hands: taken as cash, not yet
                     counted back by the office, from any day. The same number the
                     card below and the Ops Desk show. (client, 2026-09-18) -->
                <div class="o_fw_stat">
                    <span t-att-class="this.statCls(this.money(this.state.data.summary.cash_in_hand))"><t t-out="this.money(this.state.data.summary.cash_in_hand)"/></span>
                    <span class="o_fw_stat_l">cash with you</span>
                </div>
                <!-- Second row, on purpose: what the executive carried in and out
                     today, counted at the doors. The strip is a four-column grid,
                     so these fall under the money stats on a row of their own -
                     lab_delivery appends the dispatches delivered after them.
                     (client, 2026-09-08) -->
                <div class="o_fw_stat">
                    <span class="o_fw_stat_v"><t t-out="this.state.data.summary.cases_collected"/></span>
                    <span class="o_fw_stat_l">cases collected</span>
                </div>
                <div class="o_fw_stat">
                    <span class="o_fw_stat_v"><t t-out="this.state.data.summary.reworks_collected"/></span>
                    <span class="o_fw_stat_l">reworks collected</span>
                </div>
            </div>
        </div>

        <div t-if="this.state.loading" class="text-center text-muted py-5">
            <i class="fa fa-circle-o-notch fa-spin fa-2x" title="Loading"/>
        </div>

        <t t-else="">
            <!--
                Attendance first, literally: nothing below this works until the day is
                started, so it is the first thing on the screen and it is the only card
                that changes colour when it needs attention.
            -->
            <div class="o_fw_clock" t-att-class="this.onDuty ? 'o_fw_clock_on' : 'o_fw_clock_off'">
                <div class="o_fw_clock_body">
                    <div class="o_fw_clock_state">
                        <span class="o_fw_pulse" t-if="this.onDuty"/>
                        <t t-if="this.attendance.state === 'no_employee'">Not set up for attendance</t>
                        <t t-elif="this.onDuty">On duty</t>
                        <t t-else="">Not started yet</t>
                    </div>
                    <div class="o_fw_clock_sub">
                        <t t-if="this.attendance.state === 'no_employee'">
                            Ask HR to link your user to an employee record.
                        </t>
                        <t t-elif="this.onDuty">
                            Since <t t-out="this.attendance.since"/> · <t t-out="this.hoursToday"/> today
                            <!-- The badge moves to the "Where I am" card when that
                                 card is up; here only when it is not (a past day). -->
                            <span t-if="this.tracking and !this.showWhere" class="o_fw_tracking"
                                  title="Your route is recorded while your day is running, and stops when you end it.">
                                <i class="fa fa-location-arrow"/> route recording
                            </span>
                        </t>
                        <t t-elif="this.attendance.checked_out_at">
                            Ended <t t-out="this.attendance.checked_out_at"/> · <t t-out="this.hoursToday"/> today
                        </t>
                        <t t-else="">
                            Mark your attendance to begin. Visits and travel stay locked
                            until you do.
                        </t>
                    </div>
                </div>
                <button class="o_fw_clock_btn"
                        t-att-disabled="this.state.busy === 'att' or this.attendance.state === 'no_employee'"
                        t-on-click="() => this.toggleAttendance()">
                    <i t-att-class="'fa ' + (this.onDuty ? 'fa-sign-out' : 'fa-play')"
                       t-att-title="this.clockLabel"/>
                    <span class="ms-2"><t t-out="this.clockLabel"/></span>
                </button>
            </div>

            <!-- Where I am. The light on the attendance card says the route is being
                 kept; this card says what that amounts to - how many fixes, how
                 fresh, how far - so the executive sees what the manager's board
                 sees about them, and a dead GPS is noticed at the clinic door rather
                 than at the day sheet. Today only, on duty only, recording only.
                 (client, 2026-10-19) -->
            <t t-if="this.showWhere">
                <!-- The phone has noticed something the executive has not pressed.
                     A nudge, not an action: nothing is written until they tap. The X
                     remembers the refusal for that visit and kind. -->
                <div t-foreach="this.nudges" t-as="n" t-key="n.visit_id + ':' + n.kind"
                     class="o_fw_nudge" t-att-class="'o_fw_nudge_' + n.kind">
                    <div class="o_fw_nudge_body">
                        <div class="o_fw_nudge_text">
                            <t t-if="n.kind === 'arrived'">
                                <i class="fa fa-map-marker me-1" title="At a clinic"/>
                                You seem to be at <t t-out="n.clinic"/><t t-if="n.since_label"> (since <t t-out="n.since_label"/>)</t>. Check in?
                            </t>
                            <t t-else="">
                                <i class="fa fa-sign-out me-1" title="Away from the clinic"/>
                                Left <t t-out="n.clinic"/><t t-if="n.since_label"> at <t t-out="n.since_label"/></t>? Check out.
                            </t>
                        </div>
                        <button class="o_fw_nudge_x" title="Not now"
                                t-on-click="() => this.dismissNudge(n)">
                            <i class="fa fa-times"/>
                        </button>
                    </div>
                    <button t-if="n.kind === 'arrived'" class="o_fw_nudge_btn"
                            t-att-disabled="this.state.busy === n.visit_id"
                            t-on-click="() => this.checkInFromNudge(n)">
                        <i class="fa fa-map-marker" title="I'm Here"/>
                        <span class="ms-2">I'm Here</span>
                    </button>
                    <button t-else="" class="o_fw_nudge_btn"
                            t-on-click="() => this.checkOutFromNudge(n)">
                        <i class="fa fa-check" title="Check out"/>
                        <span class="ms-2">Check out</span>
                    </button>
                </div>

                <div class="o_fw_where">
                    <div class="o_fw_where_row">
                        <t t-if="this.appSetup">
                            <!-- the Traccar Client app records instead of this page -->
                            <span class="o_fw_tracking"
                                  title="The Traccar Client app records your route, even with the screen off.">
                                <i class="fa fa-mobile"/> tracking app
                            </span>
                            <span class="o_fw_where_line" t-out="this.appLine"/>
                        </t>
                        <t t-else="">
                        <span t-if="this.whereStatus.recording" class="o_fw_tracking"
                              title="Your route is recorded while your day is running, and stops when you end it.">
                            <i class="fa fa-location-arrow"/> route recording
                        </span>
                        <span t-else="" class="o_fw_tracking o_fw_tracking_off"
                              title="The day is running but this phone is not giving a position.">
                            <i class="fa fa-location-arrow"/> not recording
                        </span>
                        <span class="o_fw_where_line" t-out="this.whereLine"/>
                        </t>
                    </div>
                    <div class="o_fw_where_row">
                        <span class="o_fw_where_km">
                            <strong t-out="this.kmToday"/> km today
                        </span>
                        <button class="o_fw_where_btn" t-on-click="() => this.toggleTrail()">
                            <i t-att-class="'fa me-1 ' + (this.state.where.trail ? 'fa-chevron-up' : 'fa-map-o')"
                               t-att-title="this.state.where.trail ? 'Hide my trail' : 'Show my trail'"/>
                            <t t-if="this.state.where.trail">Hide my trail</t>
                            <t t-else="">Show my trail</t>
                        </button>
                    </div>
                    <details t-if="this.appSetup" class="o_fw_app_setup">
                        <summary>Set up the tracking app</summary>
                        <ol>
                            <li>Install <b>Traccar Client</b> (free) from the Play Store or App Store.</li>
                            <li>Server URL: <code class="user-select-all" t-out="this.appSetup.server_url"/></li>
                            <li>Device identifier: <code class="user-select-all" t-out="this.appSetup.device_id"/></li>
                            <li>Frequency 60 s, distance 50 m, high accuracy; switch the service on.</li>
                            <li>Allow location <b>all the time</b>, and switch off battery saving for the app.</li>
                        </ol>
                        <div class="small text-muted">Positions are kept only between Start my day and End the day.</div>
                    </details>
                    <div t-if="this.appProblem" class="o_fw_warn">
                        <i class="fa fa-exclamation-triangle me-1" title="Not receiving"/>
                        <t t-out="this.appProblem"/>
                    </div>
                    <div t-if="!this.appSetup and this.whereProblem" class="o_fw_warn">
                        <i class="fa fa-exclamation-triangle me-1" title="Not recording"/>
                        <t t-out="this.whereProblem"/>
                    </div>
                    <MyTrail t-if="this.state.where.trail" userId="this.userId"/>
                </div>
            </t>

            <!-- Two kinds of button, kept apart because they are used at different
                 moments. DO is the doorstep: things done without opening a record -
                 travel, scan, hand over, collect, a quick note, a search. MINE is the
                 evening: the executive's own pages - visits, cases, cash, target,
                 travel, deliveries, incentive. Other modules add their buttons to
                 whichever grid fits (anchor on the grid, never on "the last button").
                 (client, 2026-08-28) -->
            <div class="o_fw_quickbar">
                <section class="o_fw_sec o_fw_sec_do">
                    <div class="o_fw_sec_head">
                        <span class="o_fw_sec_title">
                            <i class="fa fa-bolt me-1"/>Do
                        </span>
                        <span class="o_fw_sec_hint">at the door</span>
                    </div>
                    <div class="o_fw_sec_grid">
                        <button class="o_fw_qa o_fw_qa_trip" t-on-click="() => this.openTrip()">
                            <i class="fa fa-motorcycle" title="Travel"/>
                            <span t-if="this.state.data.trip">Travel</span>
                            <span t-else="">Start the day</span>
                        </button>
                        <button class="o_fw_qa" t-on-click="() => this.openQuickEntry()">
                            <i class="fa fa-pencil-square-o" title="Quick entry"/>
                            <span>Quick entry</span>
                        </button>
                        <button class="o_fw_qa" t-on-click="() => this.toggleTrack()">
                            <i class="fa fa-search" title="Track order"/>
                            <span>Track order</span>
                        </button>
                        <!-- Who else is on this road. (client, 2026-09-02) -->
                        <button class="o_fw_qa o_fw_qa_clinics"
                                t-att-class="{ o_fw_qa_on: this.state.clinics.open }"
                                t-on-click="() => this.toggleClinics()">
                            <i class="fa fa-hospital-o" title="Doctors on my round"/>
                            <span>Doctors / Clinics</span>
                        </button>
                        <!-- Money arrives ahead of the paperwork: a doctor settles
                             an old bill while the executive is there for something
                             else. Recording it used to mean inventing a visit that
                             never happened. (client, 2026-09-12) -->
                        <button class="o_fw_qa" t-on-click="() => this.collectCash()">
                            <i class="fa fa-inr" title="Cash collected, without a visit"/>
                            <span>Cash in</span>
                        </button>
                    </div>
                </section>

                <section class="o_fw_sec o_fw_sec_mine">
                    <div class="o_fw_sec_head">
                        <span class="o_fw_sec_title">
                            <i class="fa fa-user-circle-o me-1"/>My
                        </span>
                        <button class="o_fw_sec_refresh" t-on-click="() => this.reload()"
                                title="Refresh">
                            <i class="fa fa-refresh"/>
                        </button>
                    </div>
                    <div class="o_fw_sec_grid">
                        <button class="o_fw_qa" t-on-click="() => this.openVisits()">
                            <i class="fa fa-map-marker" title="My visits"/>
                            <span>Visits</span>
                        </button>
                        <button class="o_fw_qa" t-on-click="() => this.openCases()">
                            <i class="fa fa-file-text-o" title="My cases"/>
                            <span>Cases</span>
                        </button>
                        <button class="o_fw_qa" t-on-click="() => this.openTrips()">
                            <i class="fa fa-road" title="My travel"/>
                            <span>Travel</span>
                        </button>
                        <button class="o_fw_qa" t-on-click="() => this.openCash()">
                            <i class="fa fa-money" title="My cash"/>
                            <span>Cash</span>
                        </button>
                        <button class="o_fw_qa" t-on-click="() => this.openTargets()">
                            <i class="fa fa-bullseye" title="My target"/>
                            <span>Targets</span>
                        </button>
                    </div>
                </section>
            </div>

            <!-- The doctors on this person's routes, as cards. Name, where it is,
                 what it owes, what is still open - and a star that is theirs
                 alone. No form view: res.partner opens on accounting fields an
                 executive cannot read. (client, 2026-09-02) -->
            <div class="o_fw_clinics" t-if="this.state.clinics.open" t-ref="this.clinicsPanel">
                <div class="o_fw_track_bar">
                    <i class="fa fa-hospital-o"/>
                    <input type="search" class="o_fw_track_input"
                           placeholder="Doctor, town or phone"
                           t-att-value="this.state.clinics.query"
                           t-on-input="(ev) => this.onClinicInput(ev)"/>
                    <button class="o_fw_clinic_fav_toggle"
                            t-att-class="{ o_fw_clinic_fav_on: this.state.clinics.favouritesOnly }"
                            t-att-title="this.state.clinics.favouritesOnly ? 'Showing your favourites only' : 'Show only your favourites'"
                            t-on-click="() => this.toggleFavouritesOnly()">
                        <i class="fa fa-star"/>
                        <t t-out="this.state.clinics.favourites"/>
                    </button>
                    <button class="o_fw_track_close" t-on-click="() => this.toggleClinics()">
                        <i class="fa fa-times" title="Close"/>
                    </button>
                </div>

                <div t-if="this.state.clinics.busy" class="o_fw_track_busy">
                    <i class="fa fa-circle-o-notch fa-spin" title="Loading"/>
                </div>

                <div t-if="this.state.clinics.noRoute" class="o_fw_track_none">
                    You are not on a sales route yet, so there are no clinics to show.
                    Ask your manager to put you on one.
                </div>
                <div t-elif="!this.state.clinics.busy and !this.state.clinics.rows.length"
                     class="o_fw_track_none">
                    <t t-if="this.state.clinics.favouritesOnly">
                        You have not starred any clinic yet. Tap a star to keep one here.
                    </t>
                    <t t-else="">No clinic on your routes matches that.</t>
                </div>

                <div class="o_fw_clinic_grid">
                    <div t-foreach="this.state.clinics.rows" t-as="c" t-key="c.id"
                         class="o_fw_clinic_card"
                         t-att-class="{ o_fw_clinic_fav: c.favourite }">
                        <div class="o_fw_clinic_top">
                            <div class="o_fw_clinic_name">
                                <t t-out="c.name"/>
                                <div t-if="c.route" class="o_fw_clinic_route">
                                    <t t-out="c.route"/>
                                </div>
                            </div>
                            <button class="o_fw_clinic_star"
                                    t-att-class="{ o_fw_clinic_star_on: c.favourite }"
                                    t-att-title="c.favourite ? 'Remove from your favourites' : 'Keep in your favourites'"
                                    t-on-click="(ev) => this.toggleFavourite(c, ev)">
                                <i t-att-class="c.favourite ? 'fa fa-star' : 'fa fa-star-o'"/>
                            </button>
                        </div>

                        <div t-if="c.address" class="o_fw_clinic_addr">
                            <i class="fa fa-map-marker me-1"/><t t-out="c.address"/>
                        </div>

                        <div class="o_fw_clinic_facts">
                            <div class="o_fw_clinic_fact">
                                <span class="o_fw_clinic_fact_v"
                                      t-att-class="c.open_receivable ? 'o_fw_clinic_owes' : ''">
                                    <t t-if="c.open_receivable"><t t-out="this.money(c.open_receivable)"/></t>
                                    <t t-else="">—</t>
                                </span>
                                <span class="o_fw_clinic_fact_l">open receivable</span>
                            </div>
                            <div class="o_fw_clinic_fact">
                                <span class="o_fw_clinic_fact_v">
                                    <t t-out="c.open_orders"/>
                                </span>
                                <span class="o_fw_clinic_fact_l">
                                    <t t-if="c.open_orders === 1">open order</t>
                                    <t t-else="">open orders</t><t t-if="c.open_order_value">
                                        · <t t-out="this.money(c.open_order_value)"/></t>
                                </span>
                            </div>
                        </div>

                        <div class="o_fw_clinic_acts">
                            <button class="o_fw_clinic_go" t-att-disabled="this.state.busy"
                                    t-on-click="(ev) => this.newVisitFor(c, ev)">
                                <i class="fa fa-plus me-1"/>
                                <t t-if="c.visited_today">On today's round</t>
                                <t t-else="">New visit</t>
                            </button>
                            <a t-if="c.map_url" class="o_fw_clinic_ico"
                               t-att-href="c.map_url" title="Directions">
                                <i class="fa fa-location-arrow"/></a>
                            <a t-if="c.phone" class="o_fw_clinic_ico"
                               t-attf-href="tel:{{c.phone}}" t-att-title="c.phone">
                                <i class="fa fa-phone"/></a>
                            <a t-if="c.whatsapp" class="o_fw_clinic_ico"
                               t-attf-href="https://wa.me/{{c.whatsapp}}"
                               target="_blank" title="WhatsApp">
                                <i class="fa fa-whatsapp"/></a>
                        </div>
                    </div>
                </div>

                <div t-if="this.state.clinics.more" class="o_fw_track_more">
                    Showing the first <t t-out="this.state.clinics.rows.length"/> — search to narrow it.
                </div>
                <div t-elif="this.state.clinics.rows.length" class="o_fw_track_more">
                    <t t-out="this.state.clinics.rows.length"/>
                    <t t-if="this.state.clinics.favouritesOnly"> starred</t>
                    <t t-elif="this.state.clinics.query"> matching</t>
                    <t t-if="this.state.clinics.rows.length > 1">doctors and clinics</t>
                    <t t-else="">doctor or clinic</t>
                    <t t-if="!this.state.clinics.query and !this.state.clinics.favouritesOnly"> on your route</t>
                </div>
            </div>

            <!-- Track a work: the question asked at the clinic door. Only work that
                 is still open appears - an invoiced case is finished with - and only
                 on this person's own routes. (client, 2026-08-24) -->
            <div class="o_fw_track" t-if="this.state.track.open" t-ref="this.trackPanel">
                <div class="o_fw_track_bar">
                    <i class="fa fa-search"/>
                    <input type="text" t-ref="this.trackInput"
                           placeholder="Patient, clinic or order number"
                           t-on-input="(ev) => this.onTrackInput(ev)"/>
                    <button class="o_fw_track_close" t-on-click="() => this.toggleTrack()">
                        <i class="fa fa-times"/>
                    </button>
                </div>
                <!-- Standing in a clinic? One tap for everything pending there. -->
                <div class="o_fw_track_chips" t-if="this.state.track.here">
                    <button t-att-class="'o_fw_chip' + (this.state.track.partnerId ? ' o_fw_chip_on' : '')"
                            t-on-click="() => this.toggleHere()">
                        <i class="fa fa-map-marker me-1"/>
                        At <t t-out="this.state.track.here.name"/>
                    </button>
                </div>
                <div t-if="this.state.track.busy" class="o_fw_track_note">Searching…</div>
                <div t-elif="this.state.track.no_route" class="o_fw_track_note">
                    You are not on a sales route yet — ask your manager to add you.
                </div>
                <div t-elif="!this.state.track.rows.length" class="o_fw_track_note">
                    <t t-if="this.state.track.query">Nothing open matches that.</t>
                    <t t-else="">No work is open on your route or in your bag.</t>
                </div>
                <t t-else="">
                    <t t-foreach="this.state.track.rows" t-as="r" t-key="r.id">
                        <div class="o_fw_track_row"
                             t-on-click="() => this.openTrackDetail(r)">
                            <div class="o_fw_track_main">
                                <strong t-out="r.patient or r.name"/>
                                <span class="o_fw_track_clinic">
                                    <t t-if="r.work"><t t-out="r.work"/> · </t>
                                    <t t-out="r.clinic"/>
                                </span>
                            </div>
                            <div class="o_fw_track_side">
                                <span t-att-class="'o_fw_track_stage o_fw_track_' + r.tone"
                                      t-out="r.stage"/>
                                <small>
                                    <t t-out="r.name"/> ·
                                    <!-- How long the doctor has been waiting is the
                                         fact that decides the tone of the answer. -->
                                    <span t-att-class="r.waiting > 14 ? 'o_fw_track_old' : ''">
                                        <t t-if="r.waiting === 0">today</t>
                                        <t t-elif="r.waiting === 1">1 day</t>
                                        <t t-else=""><t t-out="r.waiting"/> days</t>
                                    </span>
                                    <t t-if="r.late"> · <span class="o_fw_track_old">past promise</span></t>
                                </small>
                            </div>
                        </div>

                        <div class="o_fw_track_detail" t-if="this.state.track.openId === r.id">
                            <t t-set="d" t-value="this.trackDetail(r.id)"/>
                            <div t-if="!d" class="o_fw_track_note">Reading the file…</div>
                            <t t-elif="!d.ok">
                                <div class="o_fw_track_note">That job is not on your route or in your bag.</div>
                            </t>
                            <t t-else="">
                                <div class="o_fw_track_steps">
                                    <div t-foreach="d.steps" t-as="s" t-key="s_index"
                                         t-att-class="'o_fw_step' + (s.done ? ' o_fw_step_done' : '')">
                                        <i t-att-class="s.done ? 'fa fa-check-circle' : 'fa fa-circle-o'"/>
                                        <span class="o_fw_step_label" t-out="s.label"/>
                                        <small t-out="s.when"/>
                                    </div>
                                </div>
                                <!-- Who made it, and who finished it. The question a
                                     doctor asks at the door about a case they are
                                     unhappy with, and the one an executive could
                                     only answer by ringing the lab. The two are
                                     separate people at a finishing bench.
                                     (client, 2026-09-09) -->
                                <div t-if="d.people and d.people.length" class="o_fw_track_who">
                                    <div class="o_fw_track_who_h">Who worked on it</div>
                                    <div t-foreach="d.people" t-as="w" t-key="w_index"
                                         class="o_fw_track_who_row">
                                        <span class="o_fw_track_who_op">
                                            <t t-out="w.operation or w.station"/>
                                        </span>
                                        <span class="o_fw_track_who_n">
                                            <t t-if="w.technician">
                                                <i class="fa fa-user me-1" title="Technician"/>
                                                <t t-out="w.technician"/>
                                            </t>
                                            <t t-if="w.technician and w.finisher"> · </t>
                                            <t t-if="w.finisher">
                                                <i class="fa fa-check-square-o me-1"
                                                   title="Finishing technician"/>
                                                finished by <t t-out="w.finisher"/>
                                            </t>
                                        </span>
                                    </div>
                                </div>
                                <!-- When the file was read, and the way to read it
                                     again. Refresh belongs to the timestamp it
                                     changes, not to Call/WhatsApp/Copy - those act
                                     on the doctor. It also kept the action row from
                                     fitting a phone, and wrapped alone onto a line
                                     of its own. (client, 2026-09-09) -->
                                <div class="o_fw_track_read">
                                    <span t-if="d.read_at">as of <t t-out="d.read_at"/></span>
                                    <button class="o_fw_track_reread"
                                            t-att-disabled="this.state.track.refreshing === r.id"
                                            t-on-click="(ev) => this.refreshTrack(r, ev)">
                                        <i t-att-class="'fa fa-refresh me-1'
                                            + (this.state.track.refreshing === r.id ? ' fa-spin' : '')"/>
                                        <t t-if="this.state.track.refreshing === r.id">Reading…</t>
                                        <t t-else="">Refresh</t>
                                    </button>
                                </div>
                                <div class="o_fw_track_acts">
                                    <a t-if="d.phone" class="o_fw_track_act"
                                       t-attf-href="tel:{{ d.phone }}" t-on-click.stop="">
                                        <i class="fa fa-phone me-1"/>Call
                                    </a>
                                    <a t-if="d.whatsapp" class="o_fw_track_act"
                                       t-attf-href="https://wa.me/{{ d.whatsapp }}"
                                       target="_blank" t-on-click.stop="">
                                        <i class="fa fa-whatsapp me-1"/>WhatsApp
                                    </a>
                                    <button class="o_fw_track_act"
                                            t-on-click="(ev) => this.copyTrackSummary(d, ev)">
                                        <i class="fa fa-copy me-1"/>Copy status
                                    </button>
                                </div>
                            </t>
                        </div>
                    </t>
                    <div t-if="this.state.track.more" class="o_fw_track_note">
                        Showing the newest 25 — type a name to narrow it.
                    </div>
                </t>
            </div>

            <!-- Travel: one line, because most days it needs no attention. -->
            <div class="o_fw_trip" t-on-click="() => this.openTrip()">
                <i class="fa fa-motorcycle me-2" title="Travel"/>
                <t t-if="this.state.data.trip">
                    <span class="flex-grow-1">
                        Travel — <t t-out="this.state.data.trip.distance"/> km
                    </span>
                    <strong class="me-2"><t t-out="this.money(this.state.data.trip.amount)"/></strong>
                    <span class="o_fw_chip" t-out="this.state.data.trip.state"/>
                </t>
                <t t-else="">
                    <span class="flex-grow-1 text-muted">
                        No trip started today — tap to record your odometer
                    </span>
                    <i class="fa fa-chevron-right text-muted" title="Open"/>
                </t>
            </div>

            <!-- Cash, only when there is some. Money in a pocket is the one thing an
                 executive must not forget, so it is stated rather than left to be
                 remembered - with the way to be rid of it on the same card.
                 (client, 2026-09-18) -->
            <div t-if="this.state.data.cash.with_you" class="o_fw_cash"
                 t-att-class="{ o_fw_cash_overdue: this.state.data.cash.overdue }">
                <div class="o_fw_cash_row" t-on-click="() => this.openCash()">
                    <i class="fa fa-money me-2" title="Cash"/>
                    <span class="flex-grow-1">
                        Cash with you — <strong t-out="this.money(this.state.data.cash.available)"/>
                    </span>
                    <span t-if="this.state.data.cash.overdue" class="o_fw_chip o_fw_chip_danger">
                        <t t-if="this.state.data.cash.days">oldest <t t-out="this.state.data.cash.days"/> day<t t-if="this.state.data.cash.days > 1">s</t></t>
                        <t t-else="">hand over today</t>
                    </span>
                    <span t-elif="this.state.data.cash.days > 0" class="o_fw_chip">
                        oldest <t t-out="this.state.data.cash.days"/> day<t t-if="this.state.data.cash.days > 1">s</t>
                    </span>
                    <i t-else="" class="fa fa-chevron-right text-muted" title="Open"/>
                </div>
                <!-- On the desk, not yet counted: still yours until they confirm. -->
                <div t-foreach="this.state.data.cash.pending_rows" t-as="h" t-key="h.id"
                     class="o_fw_cash_pending" t-on-click="() => this.openHandover(h)">
                    <i class="fa fa-inbox me-2" title="Waiting"/>
                    <span class="flex-grow-1">
                        <strong t-out="this.money(h.amount)"/> handed over <t t-out="h.date"/>
                        — waiting for the office to count
                    </span>
                    <span class="o_fw_code_chip" t-out="h.code"/>
                </div>
                <button t-if="this.state.data.cash.available > 0" class="o_fw_cash_btn"
                        t-on-click="() => this.handOverCash()">
                    <i class="fa fa-hand-paper-o me-2" title="Hand over"/>
                    Hand over cash
                </button>
            </div>

            <!-- The list. This is the app. -->
            <div t-if="!this.state.data.visits.length" class="o_fw_empty">
                <i class="fa fa-coffee fa-2x mb-2" title="Nothing planned"/>
                <div class="fw-bold">Nothing planned for today.</div>
                <!-- Never a dead end: if there is a round to work from, the suggestions
                     below are the answer; if there is not, say who can fix it. -->
                <div t-if="this.state.data.suggestions.length" class="small mt-1">
                    There are clinics on your round worth a stop — see below.
                </div>
                <div t-else="" class="small mt-1">
                    Ask your manager to plan your beat, and it will appear here each
                    morning.
                </div>
            </div>

            <div t-foreach="this.state.data.visits" t-as="v" t-key="v.id"
                 class="o_fw_card" t-att-class="'o_fw_card_' + v.state">
                <div class="o_fw_card_body" t-on-click="() => this.openVisit(v)">
                    <div class="d-flex justify-content-between align-items-start">
                        <strong class="o_fw_clinic"><t t-out="v.clinic"/></strong>
                        <span class="o_fw_chip" t-att-class="'o_fw_chip_' + v.state">
                            <t t-out="v.state === 'planned' ? 'To do'
                                     : v.state === 'open' ? 'At clinic' : 'Done'"/>
                        </span>
                    </div>
                    <div class="o_fw_meta">
                        <span t-if="v.city"><t t-out="v.city"/> · </span>
                        <t t-out="v.purpose"/>
                    </div>

                    <!-- The address as plain text, not only behind the Navigate link:
                         the field app is a WebView wrapper with no browser behind it,
                         and a geo: link it cannot open would otherwise leave the
                         executive with nothing to act on at all. (client, 2026-08-29) -->
                    <div t-if="v.map_address" class="o_fw_meta o_fw_addr"
                         t-out="v.map_address"/>

                    <!-- Stop the click reaching the card: tapping Navigate must not
                         also open the visit behind it. -->
                    <div t-if="v.map_url or v.call" class="o_fw_quick"
                         t-on-click.stop="() => {}">
                        <a t-if="v.map_url" t-att-href="v.map_url" target="_blank"
                           rel="noopener" class="o_fw_quick_btn">
                            <i class="fa fa-location-arrow" title="Navigate"/>
                            <span>Navigate</span>
                        </a>
                        <a t-if="v.call" t-att-href="'tel:' + v.call"
                           class="o_fw_quick_btn">
                            <i class="fa fa-phone" title="Call"/>
                            <span>Call</span>
                        </a>
                        <a t-if="v.whatsapp" t-att-href="'https://wa.me/' + v.whatsapp"
                           target="_blank" rel="noopener" class="o_fw_quick_btn">
                            <i class="fa fa-whatsapp" title="WhatsApp"/>
                            <span>Chat</span>
                        </a>
                    </div>

                    <!-- While the visit is open, say what has been taken down so far. -->
                    <div t-if="v.state !== 'done' and v.cases" class="o_fw_result">
                        <i class="fa fa-medkit me-1" title="Cases"/>
                        <t t-out="v.cases"/> case(s) registered
                    </div>

                    <div t-if="v.state === 'done'" class="o_fw_result">
                        <span t-if="v.outcome" class="me-3"><t t-out="v.outcome"/></span>
                        <span t-if="v.cases" class="me-3">
                            <i class="fa fa-medkit me-1" title="Cases"/><t t-out="v.cases"/>
                            · <t t-out="this.money(v.value)"/>
                        </span>
                        <span t-if="v.collected">
                            <i class="fa fa-money me-1" title="Collected"/>
                            <t t-out="this.money(v.collected)"/>
                        </span>
                    </div>

                    <!-- Location trouble is said in words, never colour alone. -->
                    <div t-if="v.gps === 'far'" class="o_fw_warn">
                        <i class="fa fa-exclamation-triangle me-1" title="Away from clinic"/>
                        Checked in away from the clinic
                    </div>
                    <div t-if="v.gps === 'nofix'" class="o_fw_warn">
                        <i class="fa fa-map-marker me-1" title="No location"/>
                        No location was recorded for this check-in
                    </div>
                    <!-- After the check-in the executive is the only person who can
                         still say where they were, so the fact that nothing could be
                         verified has to reach them too - not only the manager's sheet.
                         Previously this hint disappeared the moment they checked in.
                         (client, 2026-09-05) -->
                    <div t-if="v.gps === 'nopin'" class="o_fw_warn">
                        <i class="fa fa-map-o me-1" title="Clinic not pinned"/>
                        GPS not checked — this clinic has no location on the map
                    </div>
                    <div t-if="v.state === 'planned' and !v.pinned" class="o_fw_hint">
                        <i class="fa fa-map-o me-1" title="Not pinned"/>
                        This clinic is not pinned on the map
                    </div>
                </div>

                <!-- One button. What it does depends on where the visit is, so there is
                     never a choice to make. -->
                <button class="o_fw_action" t-att-disabled="this.state.busy === v.id"
                        t-on-click="() => this.onPrimary(v)">
                    <i t-att-class="'fa ' + this.primaryIcon(v)" t-att-title="this.primaryLabel(v)"/>
                    <span class="ms-2"><t t-out="this.primaryLabel(v)"/></span>
                </button>
            </div>

            <!--
                Worth a stop. Clinics on this person's own beats that have gone quiet,
                offered where the work happens rather than in a report somebody else
                reads once a month. Ordered by what is at stake, so the first card is
                always the one worth the detour.
            -->
            <div t-if="this.state.data.suggestions.length" class="o_fw_suggest">
                <div class="o_fw_suggest_head">
                    <i class="fa fa-lightbulb-o me-2" title="Suggestions"/>
                    Worth a stop while you are out
                </div>
                <div t-foreach="this.state.data.suggestions" t-as="s" t-key="s.partner_id"
                     class="o_fw_card o_fw_card_suggest">
                    <div class="o_fw_card_body">
                        <div class="d-flex justify-content-between align-items-start">
                            <strong class="o_fw_clinic"><t t-out="s.clinic"/></strong>
                            <span class="o_fw_chip o_fw_chip_warn"><t t-out="s.status_label"/></span>
                        </div>
                        <div class="o_fw_meta">
                            <span t-if="s.city"><t t-out="s.city"/> · </span>
                            <t t-if="s.days">Not seen for <t t-out="s.days"/> days</t>
                            <t t-else="">Never visited</t>
                        </div>
                        <div class="o_fw_result">
                            <span t-if="s.value" class="me-3">
                                <i class="fa fa-medkit me-1" title="Recent business"/>
                                <t t-out="this.money(s.value)"/> in the last 90 days
                            </span>
                            <span t-if="s.declining" class="text-danger">
                                <i class="fa fa-arrow-down me-1" title="Declining"/>
                                ordering less than before
                            </span>
                        </div>
                    </div>
                    <button class="o_fw_action o_fw_action_ghost"
                            t-att-disabled="this.state.busy === 's' + s.partner_id"
                            t-on-click="() => this.addStop(s)">
                        <i class="fa fa-plus" title="Add to today"/>
                        <span class="ms-2">Add</span>
                    </button>
                </div>
            </div>
        </t>
    </div>
</t>

</templates>
