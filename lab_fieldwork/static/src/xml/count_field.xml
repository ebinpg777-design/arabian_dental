<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lab_fieldwork.CountField">
        <div class="o_fw_count" t-att-class="{ 'o_fw_count_ro': this.props.readonly }">
            <button t-if="!this.props.readonly" type="button" class="o_fw_count_btn"
                    t-att-disabled="this.value &lt;= 0" aria-label="One fewer"
                    t-on-click="() => this.bump(-1)">&#8722;</button>
            <input t-if="!this.props.readonly" type="number" inputmode="numeric"
                   min="0" t-att-max="this.props.max" class="o_fw_count_input"
                   t-att-id="this.props.id" t-att-value="this.value"
                   t-on-input="this.onInput" t-on-change="this.onChange"/>
            <span t-else="" class="o_fw_count_value" t-out="this.value"/>
            <button t-if="!this.props.readonly" type="button" class="o_fw_count_btn"
                    aria-label="One more" t-on-click="() => this.bump(1)">+</button>
        </div>
    </t>
</templates>
