<odoo>
    <data noupdate="0">

        <record id="privilege_fieldwork" model="res.groups.privilege">
            <field name="name">Field Work</field>
            <field name="category_id" ref="base.module_category_services"/>
            <field name="sequence">20</field>
        </record>

        <!--
            Three roles, and each is a different application rather than the same one
            with pieces greyed out. An executive who can see a menu they may not use
            learns to ignore menus.

            THE ROLES DO NOT INHERIT EACH OTHER'S MENUS. A manager is not "an executive
            with extra powers" &#8212; they never work a beat, so "My Day", "My Visits" and
            "My Travel" are noise on their screen, and worse, they invite a manager to
            record field work as if it were their own. Odoo has no way to hide a menu
            from a group, only to show it, so the roles are kept PARALLEL and each is
            granted its access directly. That is the whole reason Manager does not
            imply Executive.

            Administrator still implies Manager: an administrator genuinely is a
            manager who can also change the rules, and nothing on the manager's screen
            misleads them.
        -->
        <record id="group_fieldwork_executive" model="res.groups">
            <field name="name">Executive</field>
            <field name="privilege_id" ref="privilege_fieldwork"/>
            <field name="comment">Works a beat: sees their own visits, trips and target,
                and nothing else.</field>
        </record>

        <!-- The manager role was SPLIT on 2026-08-29 into the two questions one
             person used to answer alone. This group stays as the shared base the
             two specialisations imply - every rule, ACL and menu keyed on it
             keeps working for both - but it is no longer a pickable role: the
             privilege_id is deliberately absent, so the user form offers
             Executive / Operational Manager / Marketing Manager / Administrator
             and nothing in between. -->
        <record id="group_fieldwork_manager" model="res.groups">
            <field name="name">Manager (base)</field>
            <field name="privilege_id" eval="False"/>
            <field name="comment">Technical shared base of the two manager roles.
                Sees the whole team. Assigned only through Operational Manager,
                Marketing Manager or Administrator &#8212; never directly.</field>
        </record>

        <record id="group_fieldwork_ops_manager" model="res.groups">
            <field name="name">Operational Manager</field>
            <field name="privilege_id" ref="privilege_fieldwork"/>
            <field name="implied_ids" eval="[(4, ref('group_fieldwork_manager'))]"/>
            <field name="comment">First desk of the day sheet: did the day
                physically happen as recorded &#8212; attendance, kilometres, GPS at
                the door, visits closed. Approves daily updates and travel.</field>
        </record>

        <record id="group_fieldwork_marketing_manager" model="res.groups">
            <field name="name">Marketing Manager</field>
            <field name="privilege_id" ref="privilege_fieldwork"/>
            <field name="implied_ids" eval="[(4, ref('group_fieldwork_manager'))]"/>
            <field name="comment">Second desk of the day sheet: was the day worth
                anything &#8212; activities, new clinics, the relationships moved.
                Approves activities only on days operations has vouched for.</field>
        </record>

        <record id="group_fieldwork_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_fieldwork"/>
            <field name="implied_ids" eval="[(4, ref('group_fieldwork_manager')),                                              (4, ref('group_fieldwork_ops_manager')),                                              (4, ref('group_fieldwork_marketing_manager'))]"/>
            <field name="comment">Owns the configuration and receives the weekly
                report of activities and approvals. Implies both manager desks, so
                an administrator can unblock either. The person a rule constrains
                should not be the person who can relax it.</field>
        </record>

        </data>

        </odoo>
