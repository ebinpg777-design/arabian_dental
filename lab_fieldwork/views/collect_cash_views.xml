<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_collect_cash_form" model="ir.ui.view">
        <field name="name">lab.collect.cash.form</field>
        <field name="model">lab.collect.cash</field>
        <field name="arch" type="xml">
            <form string="Record Cash Collected">
                <!-- Money first: it is the one thing the person holding an
                     envelope already knows. -->
                <group>
                    <group>
                        <field name="partner_id"
                               options="{'no_create': True}"
                               placeholder="Which doctor or clinic?"/>
                        <field name="amount"/>
                        <!-- Cash, cheque or UPI: without this every payment
                             would default to cash and a cheque would be swept
                             into the float, counting the same money twice.
                             (client, 2026-09-12) -->
                        <field name="pay_mode" widget="radio"
                               options="{'horizontal': true}"/>
                        <field name="date"/>
                    </group>
                    <group>
                        <field name="user_id"
                               groups="lab_fieldwork.group_fieldwork_manager"/>
                        <field name="allocation_id" readonly="1"
                               invisible="not allocation_id"/>
                        <field name="balance" readonly="1"
                               invisible="not allocation_id"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <field name="note" placeholder="What was this payment for?"/>
                <!-- Said here rather than after the fact: this is the whole
                     point of the screen. -->
                <p class="text-muted mt-2">
                    No visit is needed — use this for money taken at a door you
                    did not raise a visit for. It counts in today's collections
                    and towards your target straight away<span
                        invisible="not allocation_id">, and cash goes into your
                    float</span>.
                </p>
                <footer>
                    <button string="Record" name="action_record" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_collect_cash" model="ir.actions.act_window">
        <field name="name">Record Cash Collected</field>
        <field name="res_model">lab.collect.cash</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_collect_cash_form"/>
    </record>

    <record id="view_cash_collection_list" model="ir.ui.view">
        <field name="name">lab.cash.collection.list</field>
        <field name="model">lab.cash.collection</field>
        <field name="arch" type="xml">
            <list string="Cash Collected">
                <field name="date"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="pay_mode"/>
                <field name="amount" sum="Collected"/>
                <field name="cash_banked" string="In float" optional="show"/>
                <field name="note" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_cash_collection_form" model="ir.ui.view">
        <field name="name">lab.cash.collection.form</field>
        <field name="model">lab.cash.collection</field>
        <field name="arch" type="xml">
            <form string="Cash Collected">
                <header>
                    <button name="action_cash_to_float" type="object"
                            string="Into my float" class="btn-primary"
                            invisible="cash_banked or pay_mode != 'cash'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="amount"/>
                            <field name="pay_mode"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="cash_banked"/>
                            <field name="cash_txn_id" invisible="not cash_txn_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

</odoo>
