<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The visit form is where an executive spends their working day, so it is built
        for a phone held one-handed at a clinic door: one column, big buttons, and the
        next thing to do always at the top.

        Readonly is expressed once per field against the state. It mirrors the server
        lock rather than substituting for it — the lock in write() is what actually
        holds; this is so the user sees the rule before they type into it.
    -->
    <record id="view_visit_form" model="ir.ui.view">
        <field name="name">lab.visit.form</field>
        <field name="model">lab.visit</field>
        <field name="arch" type="xml">
            <form class="o_fw_form">
                <header>
                    <widget name="fw_geo_button" method="do_check_in"
                            label="I'm at the Clinic" icon="fa-map-marker"
                            btn_class="btn-primary"
                            invisible="state != 'planned'"/>
                    <!-- A geo button, not a plain one: finishing takes a second
                         fix, so the record says where the visit ended as well as
                         where it began. (client, 2026-09-05) -->
                    <widget name="fw_geo_button" method="do_check_out"
                            label="Finish Visit" icon="fa-flag-checkered"
                            btn_class="btn-primary"
                            invisible="state != 'open'"/>
                    <!-- Always a NEW case: a doctor commonly hands over several in one
                         visit, and sending the executive back to the one they already
                         booked is the wrong answer at the counter. -->
                    <button name="action_new_case" type="object" string="Add Case"
                            class="btn-secondary" invisible="state not in ('open', 'done')"/>
                    <button name="action_cash_to_float" type="object"
                            string="Cash into My Float" class="btn-secondary"
                            invisible="pay_mode != 'cash' or collected &lt;= 0
                                       or cash_banked or not petty_cash_allocation_id"/>
                    <button name="action_view_cash_txn" type="object"
                            string="View Cash Movement" class="btn-secondary"
                            invisible="not cash_banked"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancel')"/>
                    <button name="action_reset" type="object" string="Reopen"
                            invisible="state == 'planned'"
                            groups="lab_fieldwork.group_fieldwork_manager"/>
                    <!-- The way out of "clinic not pinned" for 2,178 clinics:
                         a manager confirming one real visit is a tap; geocoding
                         the address book is a project. (client, 2026-09-08) -->
                    <button name="action_pin_clinic_here" type="object"
                            string="Pin Clinic Here" class="btn-secondary"
                            invisible="gps_state != 'nopin'"
                            groups="lab_fieldwork.group_fieldwork_manager"
                            confirm="Set this clinic's map pin to where this visit was recorded? Every later visit here will be measured against it."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="planned,open,done"/>
                </header>
                <sheet>
                    <!-- The outcome of a closed visit, readable before anything else on
                         the page. A ribbon says "this is finished" faster than a
                         statusbar the eye has to travel to. -->
                    <widget name="web_ribbon" title="Completed" bg_color="text-bg-success"
                            invisible="state != 'done'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger"
                            invisible="state != 'cancel'"/>

                    <!-- Tell the user the record is closed before they type into it. -->
                    <div class="alert alert-warning m-0 mb-3 rounded d-flex align-items-center"
                         role="alert" invisible="not lock_is_locked or lock_can_edit">
                        <i class="fa fa-lock me-2" title="Locked"/>
                        <field name="lock_message" nolabel="1" readonly="1" class="mb-0"/>
                    </div>
                    <field name="lock_is_locked" invisible="1"/>
                    <field name="lock_can_edit" invisible="1"/>
                    <field name="case_count" invisible="1"/>
                    <field name="case_draft_count" invisible="1"/>
                    <field name="case_ready_count" invisible="1"/>

                    <!-- Answers "where did my cases go?" before it is asked. -->
                    <div class="alert alert-info m-0 mb-3 rounded d-flex align-items-center"
                         role="status" invisible="case_ready_count == 0 or state == 'done'">
                        <i class="fa fa-info-circle me-2" title="Ready"/>
                        <span>
                            <field name="case_ready_count" nolabel="1" readonly="1"
                                   class="oe_inline fw-bold"/>
                            case(s) submitted. They become orders awaiting verification
                            when you finish this visit.
                        </span>
                    </div>

                    <!-- Finishing will refuse while these exist, so say so first. -->
                    <div class="alert alert-warning m-0 mb-3 rounded d-flex align-items-center"
                         role="alert" invisible="case_draft_count == 0 or state == 'done'">
                        <i class="fa fa-exclamation-triangle me-2" title="Not submitted"/>
                        <span>
                            <field name="case_draft_count" nolabel="1" readonly="1"
                                   class="oe_inline fw-bold"/>
                            case(s) not submitted yet. Open each one and press
                            <b>Submit Case</b>, or delete it — the visit will not finish
                            until then.
                        </span>
                    </div>

                    <!-- Every related record reachable from here, so nobody has to go
                         and build a filter to answer an obvious question. -->
                    <div class="oe_button_box" name="button_box">
                        <!-- Cases means the SLIPS entered at the counter. They only
                             become orders at check-out, so pointing this at sale orders
                             showed an executive an empty button for the entire time
                             they were actually registering cases. -->
                        <button name="action_view_case_slips" type="object"
                                class="oe_stat_button" icon="fa-medkit"
                                invisible="case_count == 0">
                            <field name="case_count" widget="statinfo" string="Cases"/>
                        </button>
                        <button name="action_view_cases" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="order_count == 0">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                        <button name="action_view_clinic_history" type="object"
                                class="oe_stat_button" icon="fa-history"
                                invisible="clinic_visit_count == 0">
                            <field name="clinic_visit_count" widget="statinfo"
                                   string="Past Visits"/>
                        </button>
                        <button name="action_view_cash_txn" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="not cash_banked">
                            <div class="o_stat_info">
                                <field name="collected" widget="monetary"
                                       class="o_stat_value"/>
                                <span class="o_stat_text">In Float</span>
                            </div>
                        </button>
                        <button name="action_view_clinic" type="object"
                                class="oe_stat_button" icon="fa-stethoscope">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Clinic</span>
                                <span class="o_stat_text">Record</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <!-- Who and where, under the reference: the two things that
                             identify a visit to a human being. -->
                        <h2 class="text-muted mt-0">
                            <field name="partner_id" readonly="1" nolabel="1"
                                   options="{'no_open': True}"/>
                        </h2>
                        <div class="text-muted" invisible="not clinic_last_visit">
                            <i class="fa fa-history me-1" title="Previously"/>
                            Last seen <field name="clinic_last_visit" readonly="1"
                                             nolabel="1" class="oe_inline"/>
                        </div>
                    </div>

                    <field name="map_url" invisible="1"/>
                    <field name="call_number" invisible="1"/>
                    <field name="whatsapp_number" invisible="1"/>
                    <widget name="fw_contact_bar"/>
                    <!-- The field app is a plain WebView wrapper (no browser behind
                         it), so a geo: link it can't open must not be the only way
                         to find this place - the address stays readable regardless.
                         (client, 2026-08-29) -->
                    <field name="map_address" nolabel="1" readonly="1"
                           class="text-muted small" invisible="not map_address"/>

                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'planned'"
                                   options="{'no_create': True, 'no_quick_create': True, 'no_open': True}"/>
                            <field name="contact_id" readonly="state == 'done'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <!-- purpose_ids IS the field now — one control, not the
                                 old single-select plus a second tags block beside it.
                                 `purpose` (scalar) stays in the model, derived from
                                 whichever chip has the lowest sequence, for the code
                                 that still reads it (day-close, the checkout gate). -->
                            <field name="purpose" invisible="1"/>
                            <field name="purpose_ids" widget="fw_choice_multi"
                                   readonly="state == 'done'"/>
                        </group>
                        <group>
                            <field name="allowed_user_ids" invisible="1"/>
                            <field name="user_id" readonly="state != 'planned'"
                                   domain="[('id', 'in', allowed_user_ids)]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="date" readonly="state != 'planned'"/>
                            <field name="beat_id" readonly="1"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <!-- Everything below only matters once the executive is there. -->
                    <group string="At the Clinic" invisible="state == 'planned'">
                        <group>
                            <field name="check_in" readonly="1"/>
                            <field name="check_out" readonly="1"/>
                            <field name="minutes" readonly="1"
                                   invisible="state != 'done'"/>
                        </group>
                        <group>
                            <!-- Location is a status, so it is never colour alone: the
                                 badge carries its own words. -->
                            <field name="gps_state" widget="badge" readonly="1"
                                   decoration-success="gps_state == 'ok'"
                                   decoration-danger="gps_state == 'far'"
                                   decoration-warning="gps_state in ('nofix', 'nopin')"/>
                            <field name="distance_m" readonly="1"
                                   invisible="gps_state not in ('ok', 'far')"/>
                            <field name="gps_reason" invisible="gps_state != 'far'"
                                   required="gps_state == 'far' and state == 'done'"
                                   readonly="state == 'done'"
                                   placeholder="e.g. met the doctor at their other branch"/>
                            <!-- Where the visit ENDED. Shown beside where it began,
                                 because the pair is the story: same place is a
                                 visit, two towns apart is not. -->
                            <field name="out_gps_state" widget="badge" readonly="1"
                                   invisible="not check_out"
                                   decoration-success="out_gps_state == 'ok'"
                                   decoration-danger="out_gps_state == 'far'"
                                   decoration-warning="out_gps_state in ('nofix', 'nopin')"/>
                            <field name="out_distance_m" readonly="1"
                                   invisible="out_gps_state not in ('ok', 'far')"/>
                        </group>
                    </group>

                    <!-- The two fixes themselves, openable on a map. An executive
                         asked "where were you" needs to be able to answer, and a
                         supervisor needs to check without reading the database. -->
                    <group string="Where This Visit Was Recorded" invisible="not check_in">
                        <group string="Start">
                            <field name="gps_lat" readonly="1" digits="[10, 7]"/>
                            <field name="gps_lon" readonly="1" digits="[10, 7]"/>
                            <field name="gps_map_url" widget="url" readonly="1"
                                   text="Open on the map"
                                   invisible="not gps_map_url"/>
                        </group>
                        <group string="Finish" invisible="not check_out">
                            <field name="out_gps_lat" readonly="1" digits="[10, 7]"/>
                            <field name="out_gps_lon" readonly="1" digits="[10, 7]"/>
                            <field name="out_gps_map_url" widget="url" readonly="1"
                                   text="Open on the map"
                                   invisible="not out_gps_map_url"/>
                        </group>
                    </group>

                    <group string="What Happened" invisible="state == 'planned'">
                        <group>
                            <!-- NOT required by the form. `required` here means "you
                                 cannot SAVE without it", which stops an executive
                                 recording anything at all — a note, a photo, the cash —
                                 until they have decided how the visit ended. They often
                                 do not know yet: they are still standing at the counter.
                                 do_check_out() refuses without it, so it is mandatory at
                                 the moment it is actually knowable and not before. -->
                            <!-- First thing in the group, in the big widget: the
                                 executive counts the cases at the counter while the
                                 doctor is still talking, with one thumb. Registered
                                 slips stay a separate figure. (client, 2026-09-08) -->
                            <field name="cases_counted" widget="fw_count"
                                   readonly="state == 'cancel'"/>
                            <field name="outcome" invisible="1"/>
                            <field name="outcome_ids" widget="fw_choice_multi"
                                   readonly="state == 'cancel'"/>
                            <!-- Under the chips, and only while Rework(s) Collected
                                 is lit: the count follows the statement that
                                 gives it meaning. (client, 2026-09-08) -->
                            <field name="has_rework_outcome" invisible="1"/>
                            <field name="reworks_collected" widget="fw_count"
                                   invisible="not has_rework_outcome"
                                   readonly="state == 'cancel'"/>
                            <field name="order_value" readonly="1"
                                   invisible="order_count == 0"/>
                        </group>
                        <group>
                            <field name="collected" widget="fw_amount"
                                   readonly="state == 'cancel'"/>
                            <field name="pay_mode" widget="fw_choice"
                                   readonly="state == 'cancel'"
                                   required="collected &gt; 0"
                                   invisible="collected &lt;= 0"/>
                            <field name="cash_banked" invisible="1"/>
                            <field name="petty_cash_allocation_id" readonly="1"
                                   invisible="not petty_cash_allocation_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="cash_txn_id" readonly="1"
                                   invisible="not cash_banked"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>

                    <notebook invisible="state == 'planned'">
                        <page string="Notes &amp; Proof" name="notes">
                            <group>
                                <!-- note is the visit's exempt field: a supervisor can
                                     still add to it after the visit closes. -->
                                <field name="note" nolabel="1" colspan="2"
                                       placeholder="What was discussed, what to do next…"/>
                                <field name="photo" widget="fw_camera"
                                       readonly="state == 'done'"/>
                            </group>
                        </page>
                        <page string="Cases" name="cases">
                            <div class="mb-2" invisible="state == 'planned'">
                                <button name="action_new_case" type="object"
                                        string="Register a Case" icon="fa-plus"
                                        class="btn-link ps-0"/>
                                <span class="text-muted ms-2" invisible="case_count != 0">
                                    A visit can carry as many cases as the doctor hands over.
                                </span>
                            </div>
                            <field name="case_ids" readonly="1" nolabel="1">
                                <list decoration-muted="state == 'cancel'"
                                      decoration-success="state == 'registered'"
                                      decoration-warning="duplicate_warning and not duplicate_ack">
                                    <field name="patient"/>
                                    <field name="line_count" string="Items"/>
                                    <field name="priority" widget="badge" optional="show"/>
                                    <field name="sale_order_id" optional="show"/>
                                    <field name="state" widget="badge"/>
                                    <field name="duplicate_warning" column_invisible="1"/>
                                    <field name="duplicate_ack" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Orders" name="orders"
                              invisible="order_count == 0">
                            <field name="order_ids" readonly="1" nolabel="1">
                                <list decoration-muted="state == 'cancel'">
                                    <field name="name"/>
                                    <field name="patient" optional="show"/>
                                    <field name="date_order"/>
                                    <field name="verification_state" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                    <field name="amount_untaxed" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Mobile-first kanban: this is the list an executive scrolls at a traffic light. -->
    <record id="view_visit_kanban" model="ir.ui.view">
        <field name="name">lab.visit.kanban</field>
        <field name="model">lab.visit</field>
        <field name="arch" type="xml">
            <!-- Ungrouped on purpose. Grouping by state turned a phone screen into
                 side-scrolling columns an executive has to swipe between to find
                 today's work; one plain list of cards, newest first, is what the
                 screen is actually for. (client, 2026-08-24) -->
            <kanban quick_create="false" class="o_fw_kanban" default_order="date desc, id desc">
                <field name="state"/>
                <field name="gps_state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <!-- The strip is the state, readable without reading: grey
                             planned, blue at-clinic, green done, red cancelled. -->
                        <div t-attf-class="o_fw_edge o_fw_edge_#{record.state.raw_value}"/>
                        <div class="d-flex justify-content-between align-items-start">
                            <strong class="fs-6"><field name="partner_id"/></strong>
                            <field name="date" widget="date" class="text-muted small"/>
                        </div>
                        <div class="text-muted small mb-2"><field name="purpose"/></div>

                        <div t-if="record.state.raw_value == 'done'"
                             class="d-flex justify-content-between align-items-center">
                            <field name="outcome" widget="badge"/>
                            <span t-if="record.order_value.raw_value" class="fw-bold">
                                <field name="order_value" widget="monetary"/>
                            </span>
                        </div>

                        <div t-if="record.gps_state.raw_value == 'far'" class="text-danger small mt-1">
                            <i class="fa fa-exclamation-triangle me-1" title="Away from the clinic"/>
                            <field name="distance_m"/> m away
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_visit_list" model="ir.ui.view">
        <field name="name">lab.visit.list</field>
        <field name="model">lab.visit</field>
        <field name="arch" type="xml">
            <!-- Defaults trimmed to what fits a phone: date, clinic, value, state.
                 Everything else stays one tap away behind the column picker - on a
                 412px screen eight default columns was a table to drag sideways,
                 not a list to read. (client, 2026-08-24) -->
            <list decoration-muted="state == 'cancel'" decoration-success="state == 'done'">
                <field name="date"/>
                <field name="name" optional="hide"/>
                <field name="partner_id"/>
                <field name="user_id" optional="hide"
                       groups="lab_fieldwork.group_fieldwork_manager"/>
                <field name="purpose" optional="hide"/>
                <field name="outcome" optional="hide"/>
                <field name="order_count" optional="hide"/>
                <field name="cases_counted" optional="show" sum="Cases counted"/>
                <field name="reworks_collected" optional="hide" sum="Reworks"/>
                <field name="order_value" sum="Case Value"/>
                <field name="collected" sum="Collected" optional="hide"/>
                <field name="gps_state" widget="badge" optional="hide"
                       decoration-success="gps_state == 'ok'"
                       decoration-danger="gps_state == 'far'"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_visit_search" model="ir.ui.view">
        <field name="name">lab.visit.search</field>
        <field name="model">lab.visit</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="beat_id"/>
                <filter name="today" string="Today"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="week" string="This Week"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(weeks=-1, weekday=0)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="todo" string="Still To Do"
                        domain="[('state', 'in', ('planned', 'open'))]"/>
                <filter name="done" string="Completed" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="far" string="Checked in Away from Clinic"
                        domain="[('gps_state', '=', 'far')]"/>
                <filter name="with_cases" string="Brought Cases"
                        domain="[('order_count', '&gt;', 0)]"/>
                <group>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_user" string="Executive" context="{'group_by': 'user_id'}"
                            groups="lab_fieldwork.group_fieldwork_manager"/>
                    <filter name="g_clinic" string="Clinic" context="{'group_by': 'partner_id'}"/>
                    <filter name="g_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_visit_my" model="ir.actions.act_window">
        <field name="name">My Visits</field>
        <field name="res_model">lab.visit</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'search_default_week': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No visits yet</p>
            <p>Visits appear here when your manager plans your beat.</p>
        </field>
    </record>

    <record id="action_visit_all" model="ir.actions.act_window">
        <field name="name">All Visits</field>
        <field name="res_model">lab.visit</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_week': 1, 'search_default_g_user': 1}</field>
    </record>
</odoo>
