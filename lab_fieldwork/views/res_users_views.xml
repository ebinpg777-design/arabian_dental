<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The two phone exceptions, on the person (Field Roles opens this form).
         Only the field-work administrator and the system administrator see the
         page: it changes what the lab can check about somebody. (client, 2026-09-28) -->
    <record id="view_users_form_fieldwork" model="ir.ui.view">
        <field name="name">res.users.form.fieldwork</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='access_rights']" position="after">
                <page string="Field Work" name="fieldwork"
                      groups="lab_fieldwork.group_fieldwork_admin,base.group_system">
                    <group string="Phone exceptions">
                        <field name="fw_location_exception"/>
                        <field name="fw_camera_exception"/>
                    </group>
                    <group string="Tracking app (screen off)">
                        <field name="fw_gps_app"/>
                        <field name="fw_gps_device_id" invisible="not fw_gps_app" class="font-monospace"/>
                    </group>
                    <div class="text-muted">
                        <p><b>Location:</b> field work records the time only for this
                        person — no position is asked for on visits, deliveries or the
                        day trail, and no location warning is shown to them or raised on
                        their day sheet.</p>
                        <p class="mb-0"><b>Camera:</b> on dispatched deliveries they type
                        the order number from the case's sticker instead of scanning it.</p>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Field Roles opens the SIMPLIFIED user form: `base.view_users_simple_form`,
         priority 1, is what res.users resolves to when an action names no view. It
         has no tabs, so the page above never appeared on the executive's profile -
         the two boxes have to be on this form too. (client, 2026-09-29) -->
    <record id="view_users_simple_form_fieldwork" model="ir.ui.view">
        <field name="name">res.users.simplified.form.fieldwork</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_simple_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Field Work — Phone exceptions" name="fw_phone_exceptions"
                       groups="lab_fieldwork.group_fieldwork_admin,base.group_system">
                    <!-- switched by button: a field-work administrator cannot edit a user
                         record, and a box they cannot tick is worse than none -->
                    <label for="fw_location_exception"/>
                    <div class="d-flex align-items-center gap-2" name="fw_location_switch">
                        <field name="fw_location_exception" readonly="1" nolabel="1" widget="boolean"/>
                        <span invisible="not fw_location_exception" class="badge text-bg-warning">On: time only, no location</span>
                        <button name="action_fw_set_exception" type="object" string="Switch on" class="btn btn-sm btn-warning"
                                context="{'fw_exception': 'location', 'fw_value': True}" invisible="fw_location_exception"/>
                        <button name="action_fw_set_exception" type="object" string="Switch off" class="btn btn-sm btn-secondary"
                                context="{'fw_exception': 'location', 'fw_value': False}" invisible="not fw_location_exception"/>
                    </div>
                    <label for="fw_camera_exception"/>
                    <div class="d-flex align-items-center gap-2" name="fw_camera_switch">
                        <field name="fw_camera_exception" readonly="1" nolabel="1" widget="boolean"/>
                        <span invisible="not fw_camera_exception" class="badge text-bg-warning">On: order number typed, not scanned</span>
                        <button name="action_fw_set_exception" type="object" string="Switch on" class="btn btn-sm btn-warning"
                                context="{'fw_exception': 'camera', 'fw_value': True}" invisible="fw_camera_exception"/>
                        <button name="action_fw_set_exception" type="object" string="Switch off" class="btn btn-sm btn-secondary"
                                context="{'fw_exception': 'camera', 'fw_value': False}" invisible="not fw_camera_exception"/>
                    </div>
                    <!-- the Lab app (2026-10-20): set by the app itself the first time it
                         is opened - the switch is the executive's phone, not this form -->
                    <label for="fw_native_app" string="ADL Pro"/>
                    <div class="d-flex align-items-center gap-2">
                        <field name="fw_native_app" readonly="1" nolabel="1" widget="boolean"/>
                        <span invisible="not fw_native_app" class="badge text-bg-success">Installed</span>
                        <span invisible="not fw_native_app_version" class="text-muted small">
                            v<field name="fw_native_app_version" readonly="1" nolabel="1" class="d-inline"/>
                            <span invisible="not fw_native_device"> · <field name="fw_native_device" readonly="1" nolabel="1" class="d-inline"/></span>
                        </span>
                    </div>
                    <!-- the free Traccar Client app (2026-10-19): switched by button like
                         the exceptions above, for the same reason -->
                    <label for="fw_gps_app"/>
                    <div class="d-flex align-items-center gap-2" name="fw_app_switch">
                        <field name="fw_gps_app" readonly="1" nolabel="1" widget="boolean"/>
                        <span invisible="not fw_gps_app" class="badge text-bg-info">On: Traccar Client app</span>
                        <button name="action_fw_tracking_app" type="object" string="Switch on" class="btn btn-sm btn-primary"
                                context="{'fw_value': True}" invisible="fw_gps_app"/>
                        <button name="action_fw_tracking_app" type="object" string="Switch off" class="btn btn-sm btn-secondary"
                                context="{'fw_value': False}" invisible="not fw_gps_app"/>
                    </div>
                    <label for="fw_gps_device_id" invisible="not fw_gps_app"/>
                    <div class="d-flex align-items-center gap-2" invisible="not fw_gps_app">
                        <field name="fw_gps_device_id" nolabel="1" class="font-monospace"/>
                        <button name="action_fw_new_device_id" type="object" string="New ID" class="btn btn-sm btn-link"
                                confirm="The phone will have to be set up again with the new ID, and the old one stops being accepted at once. Continue?"/>
                    </div>
                    <div colspan="2" class="alert alert-info small mb-0" role="alert" invisible="not fw_gps_app">
                        <p class="mb-1"><b>Tracking with the screen off:</b> install the free
                            <em>Traccar Client</em> app (Play Store / App Store) on this person's phone and set</p>
                        <ul class="mb-1">
                            <li>Server URL: <code>https://&lt;your Odoo address&gt;/lab_fieldwork/gps</code></li>
                            <li>Device identifier: the Device ID above</li>
                            <li>Frequency 60 s, distance 50 m, accuracy high; offline buffering on</li>
                        </ul>
                        <p class="mb-0">The app may run all day: positions are kept only while their day is running
                            (Start my day to End the day). My Day shows them the same settings.</p>
                    </div>
                    <div colspan="2" class="text-muted small">
                        <p class="mb-1"><b>Location:</b> field work records the time only for this
                        person - no position is asked for on visits, deliveries or the day trail,
                        and no location warning is shown to them or raised on their day sheet.</p>
                        <p class="mb-0"><b>Camera:</b> on dispatched deliveries they type the
                        order number from the case's sticker instead of scanning it.</p>
                    </div>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Field Roles as a list: who is on an exception, seen without opening anyone. -->
    <record id="view_users_list_fieldwork" model="ir.ui.view">
        <field name="name">res.users.list.fieldwork</field>
        <field name="model">res.users</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Field Roles">
                <field name="name"/>
                <field name="login"/>
                <field name="fw_location_exception" string="No location" widget="boolean"
                       groups="lab_fieldwork.group_fieldwork_admin,base.group_system"/>
                <field name="fw_camera_exception" string="No camera" widget="boolean"
                       groups="lab_fieldwork.group_fieldwork_admin,base.group_system"/>
                <field name="fw_gps_app" string="Tracking app" widget="boolean"
                       groups="lab_fieldwork.group_fieldwork_admin,base.group_system"/>
                <field name="login_date" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ...and Field Roles opens on it. Configuration owns who is in the field. The
         whole action lives here since the desk views file that defined it went
         (7ce1782): a database built from scratch had only this file's view_ids and
         no name, and failed to install (2026-10-28). Same xmlid, same values. -->
    <record id="action_fieldwork_users" model="ir.actions.act_window">
        <field name="name">Field Roles</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <!-- eval + ref(), not %(xml_id)d: that substitution is NOT applied to an
             act_window domain, so the literal text reaches the browser and py_js
             dies the first time anyone opens the menu. -->
        <field name="domain" eval="[('all_group_ids', 'in', [
                   ref('group_fieldwork_executive'),
                   ref('group_fieldwork_manager'),
                   ref('group_fieldwork_ops_manager'),
                   ref('group_fieldwork_marketing_manager'),
                   ref('group_fieldwork_admin')])]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nobody is in the field yet</p>
            <p>Give a user the <b>Executive</b>, <b>Operational Manager</b>,
               <b>Marketing Manager</b> or <b>Administrator</b> role under Field Work
               and they will appear here. The roles are separate applications, not
               levels of one — a manager does not get the executive's own-work menus,
               and each manager desk sees its own approval queue.</p>
        </field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_users_list_fieldwork')})]"/>
    </record>
</odoo>
