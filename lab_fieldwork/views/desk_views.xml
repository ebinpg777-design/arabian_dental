<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The three role desks that replaced the Control Tower and Field Health
         (2026-08-31): one screen per desk, each leading with what its owner
         must DO today. -->
    <record id="action_ops_desk" model="ir.actions.client">
        <field name="name">Ops Desk</field>
        <field name="tag">lab_ops_desk</field>
    </record>

    <record id="action_marketing_desk" model="ir.actions.client">
        <field name="name">Marketing Desk</field>
        <field name="tag">lab_marketing_desk</field>
    </record>

    <record id="action_admin_desk" model="ir.actions.client">
        <field name="name">Command Center</field>
        <field name="tag">lab_admin_desk</field>
    </record>

    <!-- Configuration owns who is in the field. (moved here when the Control
         Tower's view file was retired; same xmlid, so nothing else changes) -->
    <record id="action_fieldwork_users" model="ir.actions.act_window">
        <field name="name">Field Roles</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <!-- eval + ref(), not %(xml_id)d: that substitution is NOT applied to an
             act_window domain, so the literal text reaches the browser and py_js
             dies the first time anyone opens the menu. -->
        <field name="domain" eval="[('all_group_ids', 'in', [
                   ref('group_fieldwork_executive'),
                   ref('group_fieldwork_manager'),
                   ref('group_fieldwork_ops_manager'),
                   ref('group_fieldwork_marketing_manager'),
                   ref('group_fieldwork_admin')])]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nobody is in the field yet</p>
            <p>Give a user the <b>Executive</b>, <b>Operational Manager</b>,
               <b>Marketing Manager</b> or <b>Administrator</b> role under Field Work
               and they will appear here. The roles are separate applications, not
               levels of one — a manager does not get the executive's own-work menus,
               and each manager desk sees its own approval queue.</p>
        </field>
    </record>
</odoo>
