<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Case registration, as filled in at a clinic counter with the doctor waiting.

        The order of the form IS the order of the conversation: who is the patient, what
        are you making, what came in the bag, anything special. Nothing commercial
        appears — no price, no tax, no delivery — because none of that is the
        executive's to decide and every one of those fields is a chance to get an order
        wrong that somebody else then has to correct.
    -->
    <record id="view_case_form" model="ir.ui.view">
        <field name="name">lab.case.form</field>
        <field name="model">lab.case</field>
        <field name="arch" type="xml">
            <form class="o_fw_form o_fw_case">
                <header>
                    <!-- The one thing to do on this screen, so it is the only primary
                         button and it is first. -->
                    <button name="action_submit" type="object" string="Submit Case"
                            class="btn-primary o_fw_btn_submit" icon="fa-paper-plane"
                            invisible="state != 'draft'" data-hotkey="v"/>
                    <button name="action_reset_to_draft" type="object" string="Reopen"
                            class="o_fw_btn_reopen" icon="fa-undo"
                            invisible="state != 'submitted'"/>
                    <button name="action_create_order" type="object"
                            string="Create Order Now" class="o_fw_btn_order" icon="fa-file-text-o"
                            invisible="state != 'submitted'"
                            groups="lab_fieldwork.group_fieldwork_manager"/>
                    <button name="action_view_order" type="object" string="View Order"
                            class="btn-primary" invisible="not sale_order_id"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            class="o_fw_btn_cancel" icon="fa-times"
                            invisible="state not in ('draft', 'submitted')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,registered"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Order Created"
                            bg_color="text-bg-success" invisible="state != 'registered'"/>
                    <widget name="web_ribbon" title="Submitted" bg_color="text-bg-info"
                            invisible="state != 'submitted'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger"
                            invisible="state != 'cancel'"/>

                    <div class="alert alert-warning m-0 mb-3 rounded"
                         role="alert" invisible="not duplicate_warning or duplicate_ack">
                        <div class="d-flex align-items-start">
                            <i class="fa fa-exclamation-triangle me-2 mt-1"
                               title="Possible duplicate"/>
                            <div class="flex-grow-1">
                                <field name="duplicate_warning" nolabel="1" readonly="1"/>
                                <div class="mt-2 d-flex flex-wrap align-items-center gap-3">
                                    <button name="action_view_duplicates" type="object"
                                            string="See the earlier case"
                                            class="btn btn-sm btn-outline-secondary"
                                            invisible="not duplicate_ids"/>
                                    <label class="d-flex align-items-center gap-2 mb-0"
                                           for="duplicate_ack">
                                        <field name="duplicate_ack" nolabel="1"
                                               widget="boolean_toggle"/>
                                        <span class="fw-bold">This is a different case</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_order" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not sale_order_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Order</span>
                                <span class="o_stat_text">Created</span>
                            </div>
                        </button>
                        <button name="action_view_duplicates" type="object"
                                class="oe_stat_button" icon="fa-clone"
                                invisible="not duplicate_ids">
                            <div class="o_stat_info">
                                <span class="o_stat_value text-warning">!</span>
                                <span class="o_stat_text">Earlier</span>
                            </div>
                        </button>
                    </div>

                    <field name="visit_id" invisible="1"/>
                    <field name="patient_key" invisible="1"/>
                    <field name="duplicate_ids" invisible="1" widget="many2many_tags"/>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="line_count" invisible="1"/>

                    <!-- 1. Who. Violet: the patient is the case. -->
                    <div class="o_fw_sec o_fw_sec_violet">
                        <div class="o_fw_sec_h">
                            <span class="o_fw_sec_i"><i class="fa fa-user" title="Patient"/></span>
                            <div>
                                <div class="o_fw_sec_t">Patient</div>
                                <div class="o_fw_where">
                                    <span class="o_fw_where_c"><i class="fa fa-hospital-o me-1" title="Clinic"/><field name="partner_id" readonly="1" nolabel="1" options="{'no_open': True}"/></span>
                                    <span class="o_fw_where_d"><i class="fa fa-calendar-o me-1" title="Date"/><field name="date" readonly="1" nolabel="1" class="oe_inline"/></span>
                                </div>
                            </div>
                        </div>
                        <h1 class="o_fw_patient mb-1">
                            <field name="patient" placeholder="Patient name"
                                   readonly="state != 'draft'"/>
                        </h1>
                        <div class="o_fw_sec_l">Age</div>
                        <field name="age" widget="fw_stepper" readonly="state != 'draft'"/>
                        <div class="o_fw_sec_l">Gender</div>
                        <field name="gender" widget="fw_choice" readonly="state != 'draft'"
                               options="{'colors': {'male': 'blue', 'female': 'pink'}}"/>
                    </div>

                    <!-- 2. How soon. The colour climbs with the hurry. -->
                    <div class="o_fw_sec o_fw_sec_amber">
                        <div class="o_fw_sec_h">
                            <span class="o_fw_sec_i"><i class="fa fa-clock-o" title="How soon"/></span>
                            <div>
                                <div class="o_fw_sec_t">How soon</div>
                                <div class="o_fw_sec_s">Normal unless the doctor asked for it sooner.</div>
                            </div>
                        </div>
                        <field name="priority" widget="fw_choice" readonly="state != 'draft'"
                               options="{'colors': {'low': 'slate', 'normal': 'blue', 'urgent': 'amber', 'emergency': 'red'}}"/>
                    </div>

                    <!-- 3. The work. One card per appliance; every choice is a tap. -->
                    <div class="o_fw_sec o_fw_sec_green">
                        <div class="o_fw_sec_h">
                            <span class="o_fw_sec_i"><i class="fa fa-medkit" title="Work"/></span>
                            <div>
                                <div class="o_fw_sec_t">What is being made</div>
                                <div class="o_fw_sec_s">Blue is upper, teal is lower. Tap both for upper and lower.</div>
                            </div>
                        </div>
                        <field name="line_ids" widget="fw_case_items" nolabel="1"
                               readonly="state != 'draft'"
                               context="{'default_ul': 'upper'}">
                            <!-- names the fields to load; the widget draws them as cards -->
                            <list>
                                <field name="sequence"/>
                                <field name="product_id"/>
                                <field name="ul"/>
                                <field name="quantity"/>
                                <field name="colour_id"/>
                                <field name="is_urgent"/>
                                <field name="note"/>
                                <field name="company_id"/>
                            </list>
                        </field>
                    </div>

                    <!-- 4. Before the bag contents: it changes whether the lab starts at
                         all, so it is not buried under six checkboxes. -->
                    <field name="needs_doctor_call" widget="fw_flag"
                           options="{'icon': 'fa-phone'}" nolabel="1"
                           readonly="state != 'draft'"/>
                    <group invisible="not needs_doctor_call">
                        <field name="doctor_call_note" nolabel="1" colspan="2"
                               readonly="state != 'draft'"
                               placeholder="What does the lab need to ask? e.g. confirm shade on 21, or which clasp design"/>
                    </group>

                    <!-- 5. What came with it. -->
                    <div class="o_fw_sec o_fw_sec_teal">
                        <div class="o_fw_sec_h">
                            <span class="o_fw_sec_i"><i class="fa fa-shopping-bag" title="Bag"/></span>
                            <div>
                                <div class="o_fw_sec_t">What came in the bag</div>
                                <div class="o_fw_sec_s">Tap everything the doctor handed over.</div>
                            </div>
                        </div>
                        <field name="is_screw" invisible="1"/>
                        <field name="is_bite" invisible="1"/>
                        <field name="is_bands" invisible="1"/>
                        <field name="is_wires" invisible="1"/>
                        <field name="is_teeth" invisible="1"/>
                        <field name="is_facebow" invisible="1"/>
                        <widget name="fw_toggles"
                                fields="is_screw,is_bite,is_bands,is_wires,is_teeth,is_facebow"
                                colors="indigo,teal,amber,blue,pink,green"/>
                    </div>

                    <!-- 6. The impression. -->
                    <div class="o_fw_sec o_fw_sec_blue">
                        <div class="o_fw_sec_h">
                            <span class="o_fw_sec_i"><i class="fa fa-hand-paper-o" title="Impression"/></span>
                            <div>
                                <div class="o_fw_sec_t">Impression</div>
                                <div class="o_fw_sec_s">What it was taken in, and with what.</div>
                            </div>
                        </div>
                        <div class="o_fw_sec_l">Material</div>
                        <field name="impression_type" widget="fw_choice" readonly="state != 'draft'"
                               options="{'colors': {'Alginate': 'teal', 'Rubber Base': 'indigo'}}"/>
                        <div class="o_fw_sec_l">Tray</div>
                        <field name="impression_tray" widget="fw_choice" readonly="state != 'draft'"
                               options="{'colors': {'Upper': 'blue', 'Lower': 'teal', 'Both': 'violet'}}"/>
                        <div class="o_fw_sec_l">Scanned</div>
                        <field name="scanned_impression" widget="fw_choice" readonly="state != 'draft'"
                               options="{'colors': {'Yes': 'green', 'No': 'slate'}}"/>
                        <div class="o_fw_sec_l">Wax bite</div>
                        <field name="wax_bite" widget="fw_choice" readonly="state != 'draft'"
                               options="{'colors': {'Yes': 'green', 'No': 'slate'}}"/>
                        <div class="o_fw_sec_l">Send through</div>
                        <field name="send_through_id" readonly="state != 'draft'"
                               options="{'no_quick_create': True}"/>
                    </div>

                    <!-- 7. Anything special, and the photo. -->
                    <div class="o_fw_sec o_fw_sec_pink">
                        <div class="o_fw_sec_h">
                            <span class="o_fw_sec_i"><i class="fa fa-pencil" title="Notes"/></span>
                            <div>
                                <div class="o_fw_sec_t">Anything special</div>
                                <div class="o_fw_sec_s">Only what the lab would not guess.</div>
                            </div>
                        </div>
                        <div class="o_fw_sec_l">Modifications</div>
                        <field name="modification" readonly="state != 'draft'"
                               placeholder="e.g. extra clasp on 16"/>
                        <div class="o_fw_sec_l">Special instructions</div>
                        <field name="instruction" readonly="state != 'draft'"
                               placeholder="e.g. deliver before Friday"/>
                        <div class="o_fw_sec_l">Notes for the lab</div>
                        <field name="note" placeholder="Notes for the lab…"/>
                        <div class="o_fw_sec_l">Photo of the case</div>
                        <field name="photo" widget="fw_camera" readonly="state != 'draft'"/>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_case_list" model="ir.ui.view">
        <field name="name">lab.case.list</field>
        <field name="model">lab.case</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'"
                  decoration-success="state == 'registered'"
                  decoration-warning="duplicate_warning and not duplicate_ack">
                <field name="date"/>
                <field name="patient"/>
                <field name="partner_id"/>
                <field name="user_id" optional="show"
                       groups="lab_fieldwork.group_fieldwork_manager"/>
                <field name="line_count" string="Items"/>
                <field name="priority" widget="badge" optional="show"/>
                <field name="sale_order_id" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="duplicate_warning" column_invisible="1"/>
                <field name="duplicate_ack" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_case_kanban" model="ir.ui.view">
        <field name="model">lab.case</field>
        <field name="name">lab.case.kanban</field>
        <field name="arch" type="xml">
            <!-- Ungrouped, for the same reason My Visits is: state columns on a
                 phone are something to swipe between rather than read.
                 (client, 2026-08-24) -->
            <kanban quick_create="false" class="o_fw_kanban" default_order="id desc">
                <field name="state"/>
                <field name="duplicate_ack"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="o_fw_casecard o_fw_cs_#{record.state.raw_value}">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong class="fs-6"><field name="patient"/></strong>
                                <field name="priority" widget="badge"
                                       decoration-danger="priority == 'emergency'"
                                       decoration-warning="priority == 'urgent'"
                                       decoration-info="priority == 'normal'"/>
                            </div>
                            <div class="text-muted small"><i class="fa fa-hospital-o me-1" title="Clinic"/><field name="partner_id"/></div>
                            <div class="d-flex flex-wrap gap-1 mt-1 align-items-center">
                                <span class="o_fw_cs_chip o_fw_cs_items"><i class="fa fa-cubes me-1" title="Items"/><field name="line_count"/> item(s)</span>
                                <span t-if="record.duplicate_warning.raw_value and !record.duplicate_ack.raw_value"
                                      class="o_fw_cs_chip o_fw_cs_dup"><i class="fa fa-clone me-1" title="Possible duplicate"/>Possible duplicate</span>
                                <field name="state" widget="badge" class="ms-auto"
                                       decoration-warning="state == 'draft'"
                                       decoration-info="state == 'submitted'"
                                       decoration-success="state == 'registered'"
                                       decoration-danger="state == 'cancel'"/>
                            </div>
                            <field name="duplicate_warning" invisible="1"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_case_search" model="ir.ui.view">
        <field name="name">lab.case.search</field>
        <field name="model">lab.case</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient" filter_domain="[('patient', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="pending" string="Not Submitted"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="registered" string="Order Created"
                        domain="[('state', '=', 'registered')]"/>
                <separator/>
                <filter name="dups" string="Possible Duplicates"
                        domain="[('duplicate_ack', '=', False)]"/>
                <filter name="this_month" string="This Month" date="date"/>
                <group>
                    <filter name="g_clinic" string="Clinic" context="{'group_by': 'partner_id'}"/>
                    <filter name="g_user" string="Executive" context="{'group_by': 'user_id'}"
                            groups="lab_fieldwork.group_fieldwork_manager"/>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_case_my" model="ir.actions.act_window">
        <field name="name">My Cases</field>
        <field name="res_model">lab.case</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No cases registered yet</p>
            <p>Register a case from the visit you are on. It becomes an order when you
               finish the visit.</p>
        </field>
    </record>

    <record id="action_case_all" model="ir.actions.act_window">
        <field name="name">Case Slips</field>
        <field name="res_model">lab.case</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_g_user': 1}</field>
    </record>
</odoo>
