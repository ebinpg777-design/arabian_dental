<?xml version="1.0" encoding="UTF-8"?>
<!-- Add click function in image widget -->
    <templates xml:space="preserve">
        <t t-name="widget_preview_image.image" t-inherit="web.ImageField" t-inherit-mode="extension">
            <xpath expr="//img" position="attributes">
                <attribute name="t-on-click">this.img_click</attribute>
            </xpath>
        </t>
        <!-- Odoo 20: the product form draws its image with html_editor's
             image_with_media_dialog, a primary copy of web.ImageField made before
             this module's extension above, so the copy is extended as well. -->
        <t t-name="widget_preview_image.image_with_media_dialog" t-inherit="html_editor.ImageFieldWithMediaDialog" t-inherit-mode="extension">
            <xpath expr="//img" position="attributes">
                <attribute name="t-on-click">this.img_click</attribute>
            </xpath>
        </t>
</templates>
