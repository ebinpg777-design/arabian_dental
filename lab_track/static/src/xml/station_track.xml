<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!-- Where is the rest of this case? Asked at the bench with the job card in hand,
     so the number already typed is the one tracked. Read-only: the tracker it opens
     names every record and opens none. (client, 2026-09-17) -->
<t t-inherit="lab_workcenter_scan.Station" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('o_st_type_acts')]/button[hasclass('o_st_type_find')][1]" position="before">
        <button class="o_st_type_find o_st_type_track"
                t-on-click="() => this.action.doAction('lab_track.action_track_floor', {props: {ref: state.typed.trim()}})"
                title="Track the order: every step, delivery and status (read-only)">
            <i class="fa fa-map-marker me-1" title="Track order"/>Track
        </button>
    </xpath>
</t>

</templates>
