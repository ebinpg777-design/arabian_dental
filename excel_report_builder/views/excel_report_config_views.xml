<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Technical Settings with Excel Report Builder configuration -->
    <record id="res_config_settings_view_form_excel_report_builder" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.excel.report.builder</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Excel Report Builder"
                     data-string="Excel Report Builder"
                     name="excel_report_builder">
                    <block title="Button Visibility"
                           name="excel_report_builder_visibility">
                        <setting string="Restrict to Specific Models"
                                 help="Leave empty to show the Excel export button on all list views. Select models to restrict the button to only those views.">
                            <field name="excel_allowed_model_ids"
                                   widget="many2many_tags"
                                   domain="[('transient', '=', False)]"
                                   options="{'no_create': True, 'no_open': True}"
                                   placeholder="All models (no restriction)"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
