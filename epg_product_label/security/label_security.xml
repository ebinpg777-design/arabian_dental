<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_label_builder" model="ir.module.category">
            <field name="name">Label Builder</field>
            <field name="description">Design and print product and address labels.</field>
            <field name="sequence">55</field>
        </record>

        <!--
            Odoo 19 groups a set of related access levels under a privilege, which is
            what turns them into a single dropdown on the user form.
        -->
        <record id="res_groups_privilege_label" model="res.groups.privilege">
            <field name="name">Labels</field>
            <field name="description">Design and print product and address labels.</field>
            <field name="category_id" ref="module_category_label_builder"/>
            <field name="sequence">55</field>
        </record>

        <record id="group_label_user" model="res.groups">
            <field name="name">Print Labels</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_label"/>
            <field name="comment">Print labels with the templates they are allowed to use.</field>
        </record>

        <record id="group_label_designer" model="res.groups">
            <field name="name">Design Labels</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_label"/>
            <field name="implied_ids" eval="[(4, ref('group_label_user'))]"/>
            <field name="comment">Create and edit label templates and their elements.</field>
        </record>

        <!-- Anyone who can already work with stock should be able to print labels. -->
        <record id="stock.group_stock_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('epg_product_label.group_label_user'))]"/>
        </record>
        <record id="stock.group_stock_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('epg_product_label.group_label_designer'))]"/>
        </record>

        <!--
            Multi-company: a template with no company is shared, otherwise it belongs
            to one company and follows the usual allowed-companies rule.
            A rule with no groups is global; 'global' itself is computed in Odoo 19,
            so it must not be written here.
        -->
        <record id="rule_label_template_company" model="ir.rule">
            <field name="name">Label template: multi-company</field>
            <field name="model_id" ref="model_epg_label_template"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_label_element_company" model="ir.rule">
            <field name="name">Label element: multi-company</field>
            <field name="model_id" ref="model_epg_label_element"/>
            <field name="domain_force">['|', ('template_id.company_id', '=', False), ('template_id.company_id', 'in', company_ids)]</field>
        </record>

        <!--
            Restricted templates: someone who can only print sees templates that are
            open to everyone or explicitly assigned to them.  Designers and
            administrators are not restricted, so they can maintain them all.
        -->
        <record id="rule_label_template_user" model="ir.rule">
            <field name="name">Label template: allowed users</field>
            <field name="model_id" ref="model_epg_label_template"/>
            <field name="domain_force">['|', ('user_ids', '=', False), ('user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('epg_product_label.group_label_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_label_template_designer" model="ir.rule">
            <field name="name">Label template: designers see all</field>
            <field name="model_id" ref="model_epg_label_template"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('epg_product_label.group_label_designer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
