<odoo>
    <data noupdate="1">

        <record id="module_category_label_builder" model="ir.module.category">
            <field name="name">Label Builder</field>
            <field name="description">Design and print product and address labels.</field>
            <field name="sequence">55</field>
        </record>

        <!--
            Odoo 19 groups a set of related access levels under a privilege, which is
            what turns them into a single dropdown on the user form.
        -->
        <record id="res_groups_privilege_label" model="res.groups.privilege">
            <field name="name">Labels</field>
            <field name="description">Design and print product and address labels.</field>
            <field name="category_id" ref="module_category_label_builder"/>
            <field name="sequence">55</field>
        </record>

        <record id="group_label_user" model="res.groups">
            <field name="name">Print Labels</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_label"/>
            <field name="comment">Print labels with the templates they are allowed to use.</field>
        </record>

        <record id="group_label_designer" model="res.groups">
            <field name="name">Design Labels</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_label"/>
            <field name="implied_ids" eval="[(4, ref('group_label_user'))]"/>
            <field name="comment">Create and edit label templates and their elements.</field>
        </record>

        <!-- Anyone who can already work with stock should be able to print labels. -->
        <record id="stock.group_stock_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('epg_product_label.group_label_user'))]"/>
        </record>
        <record id="stock.group_stock_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('epg_product_label.group_label_designer'))]"/>
        </record>

        </data>
</odoo>
