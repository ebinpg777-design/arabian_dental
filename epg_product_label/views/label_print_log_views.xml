<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_epg_label_print_log_list" model="ir.ui.view">
        <field name="name">epg.label.print.log.list</field>
        <field name="model">epg.label.print.log</field>
        <field name="arch" type="xml">
            <list string="Print History" create="false" default_order="print_date desc">
                <field name="print_date" widget="datetime"/>
                <field name="template_id"/>
                <field name="label_type" optional="show"/>
                <field name="output_format" widget="badge"
                       decoration-info="output_format == 'pdf'"
                       decoration-success="output_format == 'zpl'"
                       decoration-muted="output_format == 'preview'"/>
                <field name="record_summary" string="Records" optional="show"/>
                <field name="record_count" string="#" sum="Records"/>
                <field name="label_count" sum="Labels"/>
                <field name="page_count" optional="hide" sum="Pages"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_reprint" type="object" string="Print again"
                        icon="fa-repeat" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_epg_label_print_log_form" model="ir.ui.view">
        <field name="name">epg.label.print.log.form</field>
        <field name="model">epg.label.print.log</field>
        <field name="arch" type="xml">
            <form string="Print Run" create="false" edit="false">
                <header>
                    <button name="action_reprint" type="object"
                            string="Print Again" class="btn-primary"/>
                    <button name="action_view_records" type="object"
                            string="View Records" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_summary" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Run">
                            <field name="template_id"/>
                            <field name="label_type"/>
                            <field name="output_format"/>
                            <field name="print_date"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Volume">
                            <field name="record_count"/>
                            <field name="quantity"/>
                            <field name="label_count"/>
                            <field name="page_count"/>
                            <field name="skip_labels"/>
                        </group>
                        <group string="Pricing">
                            <field name="pricelist_id"/>
                            <field name="promo_pricelist_id"/>
                        </group>
                        <group string="Records">
                            <field name="record_summary"/>
                            <field name="res_model" string="Model"/>
                            <field name="printer_url" invisible="not printer_url"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_epg_label_print_log_graph" model="ir.ui.view">
        <field name="name">epg.label.print.log.graph</field>
        <field name="model">epg.label.print.log</field>
        <field name="arch" type="xml">
            <graph string="Labels Printed" type="bar" sample="1">
                <field name="print_date" interval="week"/>
                <field name="template_id"/>
                <field name="label_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_epg_label_print_log_pivot" model="ir.ui.view">
        <field name="name">epg.label.print.log.pivot</field>
        <field name="model">epg.label.print.log</field>
        <field name="arch" type="xml">
            <pivot string="Labels Printed" sample="1">
                <field name="template_id" type="row"/>
                <field name="print_date" interval="month" type="col"/>
                <field name="label_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_epg_label_print_log_search" model="ir.ui.view">
        <field name="name">epg.label.print.log.search</field>
        <field name="model">epg.label.print.log</field>
        <field name="arch" type="xml">
            <search string="Print History">
                <field name="template_id"/>
                <field name="user_id"/>
                <field name="record_summary"/>
                <filter name="filter_mine" string="My Prints"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_today" string="Today"
                        domain="[('print_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter name="filter_week" string="This Week"
                        domain="[('print_date', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_month" string="This Month"
                        domain="[('print_date', '&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_pdf" string="PDF"
                        domain="[('output_format', '=', 'pdf')]"/>
                <filter name="filter_zpl" string="ZPL"
                        domain="[('output_format', '=', 'zpl')]"/>
                <filter name="filter_real" string="Real Prints"
                        domain="[('output_format', '!=', 'preview')]"
                        help="Hide the runs that were only previewed on screen."/>
                <group>
                    <filter name="group_template" string="Template"
                            context="{'group_by': 'template_id'}"/>
                    <filter name="group_user" string="Printed By"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_format" string="Format"
                            context="{'group_by': 'output_format'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'print_date:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_epg_label_print_log" model="ir.actions.act_window">
        <field name="name">Print History</field>
        <field name="res_model">epg.label.print.log</field>
        <field name="view_mode">list,graph,pivot,form</field>
        <field name="search_view_id" ref="view_epg_label_print_log_search"/>
        <field name="context">{'search_default_filter_real': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No labels printed yet</p>
            <p>
                Every run is recorded here with who printed it and how many labels
                it used, and any run can be repeated with one click.
            </p>
        </field>
    </record>

</odoo>
