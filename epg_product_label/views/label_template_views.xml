<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_epg_label_template_form" model="ir.ui.view">
        <field name="name">epg.label.template.form</field>
        <field name="model">epg.label.template</field>
        <field name="arch" type="xml">
            <form string="Label Template">
                <header>
                    <button name="action_open_print_wizard" type="object"
                            string="Print" class="btn-primary"
                            invisible="not element_ids"/>
                    <button name="action_open_assistant" type="object"
                            string="Layout Assistant" class="btn-secondary"
                            icon="fa-magic"/>
                    <button name="action_preview_pdf" type="object"
                            string="Preview PDF" class="btn-secondary"
                            invisible="not element_ids"/>
                    <button name="action_duplicate_template" type="object"
                            string="Duplicate" class="btn-secondary"/>
                    <button name="action_export_xml" type="object"
                            string="Export XML" class="btn-secondary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Predefined" bg_color="text-bg-info"
                            invisible="not is_predefined"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_elements" type="object"
                                class="oe_stat_button" icon="fa-object-group">
                            <field name="element_count" widget="statinfo" string="Elements"/>
                        </button>
                        <button name="action_open_print_wizard" type="object"
                                class="oe_stat_button" icon="fa-print">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Print</span>
                                <span class="o_stat_text">Labels</span>
                            </div>
                        </button>
                        <button name="action_view_print_log" type="object"
                                class="oe_stat_button" icon="fa-history"
                                invisible="not print_log_count">
                            <field name="printed_label_count" widget="statinfo"
                                   string="Labels Printed"/>
                        </button>
                    </div>
                    <field name="print_log_count" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Shelf label 57 x 38 mm"/></h1>
                        <field name="code" placeholder="Reference (optional)"/>
                    </div>
                    <field name="active" invisible="1"/>
                    <field name="is_predefined" invisible="1"/>
                    <field name="model_name" invisible="1"/>
                    <group>
                        <group string="Label">
                            <field name="label_type"/>
                            <field name="unit"/>
                            <label for="label_width" string="Size (W × H)"/>
                            <div class="o_row">
                                <field name="label_width" class="oe_inline"/>
                                <span class="mx-1">×</span>
                                <field name="label_height" class="oe_inline"/>
                                <span class="ms-2 text-muted"><field name="unit" nolabel="1" readonly="1"/></span>
                            </div>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Sheet">
                            <field name="stock_id"
                                   options="{'no_create_edit': True}"
                                   placeholder="e.g. Avery L7160, Dymo 99012…"/>
                            <div colspan="2" class="alert alert-warning py-1 px-2 mb-2"
                                 role="alert" invisible="not stock_mismatch">
                                <i class="fa fa-exclamation-triangle me-1" title="Warning"/>
                                The geometry no longer matches
                                <field name="stock_id" nolabel="1" readonly="1"
                                       class="oe_inline"/>. Re-select the stock to
                                restore it, or clear the field.
                            </div>
                            <field name="stock_mismatch" invisible="1"/>
                            <field name="layout_mode"/>
                            <field name="page_format" invisible="layout_mode == 'roll'"/>
                            <field name="orientation" invisible="layout_mode == 'roll'"/>
                            <label for="page_width" string="Paper (W × H)"/>
                            <div class="o_row">
                                <field name="page_width" class="oe_inline"
                                       readonly="layout_mode == 'roll' or page_format != 'custom'"/>
                                <span class="mx-1">×</span>
                                <field name="page_height" class="oe_inline"
                                       readonly="layout_mode == 'roll' or page_format != 'custom'"/>
                            </div>
                            <field name="auto_grid" invisible="layout_mode == 'roll'"/>
                            <label for="columns" string="Grid (Cols × Rows)"
                                   invisible="layout_mode == 'roll'"/>
                            <div class="o_row" invisible="layout_mode == 'roll'">
                                <field name="columns" class="oe_inline" readonly="auto_grid"/>
                                <span class="mx-1">×</span>
                                <field name="rows" class="oe_inline" readonly="auto_grid"/>
                                <span class="ms-2 text-muted">
                                    = <field name="labels_per_page" nolabel="1" readonly="1"
                                             class="oe_inline"/> per page
                                </span>
                            </div>
                        </group>
                    </group>

                    <notebook>
                        <page string="Designer" name="designer">
                            <field name="element_ids" widget="epg_label_designer" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="element_type"/>
                                    <field name="field_path" optional="show"/>
                                    <field name="text_content" optional="hide"/>
                                    <field name="pos_x" string="X"/>
                                    <field name="pos_y" string="Y"/>
                                    <field name="width" string="W"/>
                                    <field name="height" string="H"/>
                                    <field name="font_size" string="Font" optional="show"/>
                                    <field name="font_bold" string="B" optional="show"/>
                                    <field name="text_align" string="Align" optional="hide"/>
                                    <field name="rotation" optional="hide"/>
                                    <field name="z_index" string="Layer" optional="hide"/>
                                    <field name="condition" optional="hide"/>
                                    <field name="active" widget="boolean_toggle" optional="hide"/>
                                    <!-- Loaded for the canvas, not shown as columns. -->
                                    <field name="opacity" column_invisible="1"/>
                                    <field name="unit" column_invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="Preview" name="preview">
                            <group>
                                <group string="Preview Data">
                                    <field name="preview_product_id"
                                           invisible="label_type != 'product'"
                                           options="{'no_create': True}"/>
                                    <field name="preview_partner_id"
                                           invisible="label_type != 'partner'"
                                           options="{'no_create': True}"/>
                                    <field name="preview_pricelist_id"
                                           options="{'no_create': True}"/>
                                    <field name="preview_promo_pricelist_id"
                                           options="{'no_create': True}"/>
                                </group>
                            </group>
                            <field name="preview_html" nolabel="1" readonly="1"/>
                        </page>

                        <page string="Layout" name="layout">
                            <group>
                                <group string="Margins">
                                    <field name="margin_top"/>
                                    <field name="margin_bottom"/>
                                    <field name="margin_left"/>
                                    <field name="margin_right"/>
                                </group>
                                <group string="Gaps" invisible="layout_mode == 'roll'">
                                    <field name="column_gap"/>
                                    <field name="row_gap"/>
                                </group>
                                <group string="Label Appearance">
                                    <field name="default_font_family"/>
                                    <field name="default_font_size"/>
                                    <field name="label_bg_transparent"/>
                                    <field name="label_bg_color" widget="color"
                                           invisible="label_bg_transparent"/>
                                    <field name="label_border"/>
                                    <field name="label_border_width" invisible="not label_border"/>
                                    <field name="label_border_color" widget="color"
                                           invisible="not label_border"/>
                                    <field name="label_border_radius"/>
                                </group>
                                <group string="Background Image">
                                    <field name="bg_image_source"/>
                                    <field name="bg_image" widget="image"
                                           filename="bg_image_filename"
                                           invisible="bg_image_source != 'static'"/>
                                    <field name="bg_image_filename" invisible="1"/>
                                    <field name="bg_image_field"
                                           invisible="bg_image_source != 'field'"
                                           placeholder="e.g. image_1920"/>
                                    <field name="bg_image_fit"
                                           invisible="bg_image_source == 'none'"/>
                                    <field name="bg_image_opacity"
                                           invisible="bg_image_source == 'none'"/>
                                </group>
                            </group>
                        </page>

                        <page string="Output" name="output">
                            <group>
                                <group string="Formats">
                                    <field name="output_type"/>
                                    <field name="pdf_dpi" invisible="output_type == 'zpl'"/>
                                    <field name="paperformat_id"/>
                                </group>
                                <group string="ZPL (Zebra)" invisible="output_type == 'pdf'">
                                    <field name="zpl_use_global"/>
                                    <field name="zpl_density" invisible="zpl_use_global"/>
                                    <field name="zpl_rotation" invisible="zpl_use_global"/>
                                    <field name="zpl_encoding" invisible="zpl_use_global"/>
                                    <field name="zpl_darkness" invisible="zpl_use_global"/>
                                    <field name="zpl_speed" invisible="zpl_use_global"/>
                                </group>
                            </group>
                            <group string="Raw ZPL" invisible="output_type == 'pdf'">
                                <field name="zpl_prefix" placeholder="e.g. ^MMT^MNY"/>
                                <field name="zpl_suffix"/>
                            </group>
                        </page>

                        <page string="Access" name="access">
                            <group>
                                <group string="Restrictions">
                                    <field name="user_ids" widget="many2many_tags"
                                           options="{'no_create': True}"/>
                                </group>
                            </group>
                            <div class="text-muted">
                                Leave the list empty to make this template available to
                                everyone. Administrators always see every template.
                                A per-user default template is set on the user's own
                                preferences.
                            </div>
                            <group string="Notes">
                                <field name="note" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_epg_label_template_list" model="ir.ui.view">
        <field name="name">epg.label.template.list</field>
        <field name="model">epg.label.template</field>
        <field name="arch" type="xml">
            <list string="Label Templates" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="label_type"/>
                <field name="label_width" string="Width"/>
                <field name="label_height" string="Height"/>
                <field name="unit"/>
                <field name="layout_mode"/>
                <field name="labels_per_page" string="Per Page"/>
                <field name="output_type"/>
                <field name="element_count" string="Elements"/>
                <field name="is_predefined" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <button name="action_open_print_wizard" type="object"
                        string="Print" icon="fa-print" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_epg_label_template_kanban" model="ir.ui.view">
        <field name="name">epg.label.template.kanban</field>
        <field name="model">epg.label.template</field>
        <field name="arch" type="xml">
            <!--
                The gallery shows each template rendered with live data rather than
                a name and a size: picking a label is a visual decision, and the
                thumbnail is produced by the same renderer as the PDF, so what you
                choose is what you get.
            -->
            <kanban sample="1" class="epg_template_kanban">
                <field name="label_type"/>
                <field name="unit"/>
                <field name="element_count"/>
                <field name="output_type"/>
                <field name="is_predefined"/>
                <templates>
                    <t t-name="card">
                        <div class="epg_template_card">
                            <div class="epg_template_thumb_wrap">
                                <field name="thumbnail_html" widget="html"
                                       readonly="1" nolabel="1"/>
                            </div>
                            <div>
                                <strong class="d-block"><field name="name"/></strong>
                                <span class="text-muted small">
                                    <field name="label_width"/> ×
                                    <field name="label_height"/>
                                    <field name="unit"/>
                                </span>
                            </div>
                            <div class="epg_template_meta">
                                <span class="badge text-bg-secondary">
                                    <field name="label_type"/>
                                </span>
                                <span class="badge text-bg-light">
                                    <field name="element_count"/> elements
                                </span>
                                <span class="badge text-bg-light"
                                      invisible="output_type == 'pdf'">ZPL</span>
                                <span class="badge text-bg-info"
                                      invisible="not is_predefined">Predefined</span>
                            </div>
                            <button name="action_open_print_wizard" type="object"
                                    class="btn btn-sm btn-primary w-100">
                                <i class="fa fa-print me-1" title="Print"/>Print
                            </button>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_epg_label_template_search" model="ir.ui.view">
        <field name="name">epg.label.template.search</field>
        <field name="model">epg.label.template</field>
        <field name="arch" type="xml">
            <search string="Label Templates">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="label_type"/>
                <filter name="filter_product" string="Product"
                        domain="[('label_type', '=', 'product')]"/>
                <filter name="filter_partner" string="Address"
                        domain="[('label_type', '=', 'partner')]"/>
                <filter name="filter_lot" string="Lot / Serial"
                        domain="[('label_type', '=', 'lot')]"/>
                <separator/>
                <filter name="filter_sheet" string="Sheets"
                        domain="[('layout_mode', '=', 'sheet')]"/>
                <filter name="filter_roll" string="Roll"
                        domain="[('layout_mode', '=', 'roll')]"/>
                <separator/>
                <filter name="filter_zpl" string="Supports ZPL"
                        domain="[('output_type', 'in', ('zpl', 'both'))]"/>
                <filter name="filter_mine" string="My Templates"
                        domain="[('user_ids', 'in', [uid])]"/>
                <separator/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Label For"
                            context="{'group_by': 'label_type'}"/>
                    <filter name="group_layout" string="Layout"
                            context="{'group_by': 'layout_mode'}"/>
                    <filter name="group_output" string="Output"
                            context="{'group_by': 'output_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_epg_label_template" model="ir.actions.act_window">
        <field name="name">Label Templates</field>
        <field name="res_model">epg.label.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_epg_label_template_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Design your first label template</p>
            <p>
                Set the label size, drop elements onto it - text, fields, prices,
                barcodes, images - and print to PDF or straight to a Zebra printer.
            </p>
        </field>
    </record>

</odoo>
