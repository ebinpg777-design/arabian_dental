<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_label" model="ir.ui.view">
        <field name="name">res.users.form.label</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!-- base leaves this group empty precisely for overrides like this one -->
            <xpath expr="//page[@name='preferences']//group[@name='other_preferences']"
                   position="inside">
                <field name="epg_default_label_template_id"
                       options="{'no_create': True}"
                       groups="epg_product_label.group_label_user"/>
                <field name="epg_allowed_label_template_ids"
                       widget="many2many_tags"
                       options="{'no_create': True}"
                       groups="epg_product_label.group_label_designer"/>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_simple_modif_label" model="ir.ui.view">
        <field name="name">res.users.preferences.form.label</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences_page']//group[@name='other_preferences']"
                   position="inside">
                <field name="epg_default_label_template_id"
                       options="{'no_create': True}" readonly="0"
                       groups="epg_product_label.group_label_user"/>
            </xpath>
        </field>
    </record>

</odoo>
