<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="epg_product_label.LayoutPickerField">
    <div class="epg_layout_picker">
        <t t-foreach="this.options" t-as="option" t-key="option.value">
            <button type="button"
                    t-att-class="'epg_layout_card' + (this.isSelected(option) ? ' epg_layout_card_selected' : '')"
                    t-att-disabled="this.props.readonly"
                    t-on-click="() => this.select(option)">
                <span class="epg_layout_frame">
                    <t t-foreach="option.shapes" t-as="shape" t-key="shape_index">
                        <span t-att-class="this.blockClass(shape)"
                              t-att-style="this.blockStyle(shape)"/>
                    </t>
                </span>
                <span class="epg_layout_name" t-out="option.label"/>
                <span class="epg_layout_tick" t-if="this.isSelected(option)">
                    <i class="fa fa-check"/>
                </span>
            </button>
        </t>
    </div>
</t>

<t t-name="epg_product_label.FieldPathField">
    <div class="epg_field_path" t-custom-ref="root">
        <div class="epg_field_path_input">
            <input type="text" class="o_input"
                   t-att-id="this.props.id"
                   t-att-value="this.pathValue"
                   t-att-readonly="this.props.readonly"
                   t-att-placeholder="this.props.placeholder"
                   t-on-change="(ev) => this.props.record.update({ [this.props.name]: ev.target.value })"
                   t-on-blur="this.onInputBlur"/>
            <button type="button" class="btn btn-sm btn-secondary"
                    title="Browse the fields of this model"
                    t-att-disabled="this.props.readonly"
                    t-on-click.stop="this.togglePicker">
                <i class="fa fa-sitemap"/>
            </button>
        </div>

        <small t-if="this.pickerState.status" t-att-class="'d-block mt-1 ' + this.statusClass">
            <i t-att-class="'fa me-1 ' + (this.pickerState.status.valid ? 'fa-check' : 'fa-times')"/>
            <t t-if="this.pickerState.status.valid">
                <t t-out="this.pickerState.status.label"/>
                <span class="text-muted">(<t t-out="this.pickerState.status.type"/>)</span>
            </t>
            <t t-else="" t-out="this.pickerState.status.error"/>
        </small>

        <div class="epg_field_path_popover" t-if="this.pickerState.open">
            <div class="epg_field_path_head">
                <button type="button" class="btn btn-sm btn-link px-1"
                        t-att-disabled="!this.pickerState.browsePath"
                        t-on-click.stop="this.browseUp">
                    <i class="fa fa-level-up"/>
                </button>
                <span class="epg_field_path_crumbs">
                    <span class="epg_field_path_model" t-out="this.pickerState.model"/>
                    <t t-foreach="this.breadcrumbs" t-as="crumb" t-key="crumb_index">
                        <i class="fa fa-angle-right mx-1 text-muted"/>
                        <span t-out="crumb"/>
                    </t>
                </span>
                <button type="button" class="btn btn-sm btn-link px-1 ms-auto"
                        t-on-click.stop="() => this.pickerState.open = false">
                    <i class="fa fa-times"/>
                </button>
            </div>
            <input type="text" class="o_input epg_field_path_search"
                   placeholder="Search fields…"
                   t-att-value="this.pickerState.query"
                   t-on-input="this.onQueryInput"/>
            <div class="epg_field_path_results">
                <div t-if="this.pickerState.loading" class="text-muted p-2">
                    <i class="fa fa-circle-o-notch fa-spin me-1"/>Loading…
                </div>
                <t t-else="">
                    <div t-if="!this.pickerState.suggestions.length" class="text-muted p-2">
                        No field matches.
                    </div>
                    <t t-foreach="this.pickerState.suggestions" t-as="suggestion"
                       t-key="suggestion.path">
                        <div class="epg_field_path_row">
                            <button type="button" class="epg_field_path_pick"
                                    t-on-click.stop="() => this.choose(suggestion)">
                                <span class="epg_field_path_label" t-out="suggestion.label"/>
                                <span class="epg_field_path_tech" t-out="suggestion.name"/>
                                <span class="epg_field_path_type" t-out="suggestion.type"/>
                            </button>
                            <button type="button" class="epg_field_path_into"
                                    t-if="suggestion.relational"
                                    t-att-title="'Browse ' + suggestion.comodel"
                                    t-on-click.stop="() => this.browseInto(suggestion)">
                                <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                    </t>
                </t>
            </div>
        </div>
    </div>
</t>

<t t-name="epg_product_label.BarcodeStatusField">
    <div class="epg_barcode_status">
        <span t-att-class="'badge ' + this.look.css">
            <i t-att-class="'fa me-1 ' + this.look.icon"/>
            <t t-out="this.message"/>
        </span>
        <div class="epg_barcode_sample" t-if="this.sample">
            <span class="text-muted me-1">Encodes:</span>
            <code t-out="this.sample"/>
        </div>
    </div>
</t>

</templates>
