<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_epg_label" model="ir.actions.report">
        <field name="name">Custom Labels</field>
        <field name="model">epg.label.print</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">epg_product_label.report_label</field>
        <field name="report_file">epg_product_label.report_label</field>
        <field name="print_report_name">'Labels - %s' % (object.template_id.name or '')</field>
        <field name="paperformat_id" ref="paperformat_epg_label_a4"/>
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="action_report_epg_label_zpl" model="ir.actions.report">
        <field name="name">Custom Labels (ZPL)</field>
        <field name="model">epg.label.print</field>
        <field name="report_type">qweb-text</field>
        <field name="report_name">epg_product_label.report_label_zpl</field>
        <field name="report_file">epg_product_label.report_label_zpl</field>
        <field name="print_report_name">'Labels - %s' % (object.template_id.name or '')</field>
        <field name="binding_model_id" eval="False"/>
    </record>

</odoo>
