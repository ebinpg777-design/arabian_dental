<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             101 x 34 mm / 4" x 1-1/3" - 14 per Letter sheet, 2 x 7
             ============================================================ -->
        <record id="label_partner_101x34_sheet" model="epg.label.template">
            <field name="name">Address Label 101 x 34 mm (14 per Letter sheet)</field>
            <field name="code">epg_partner_101x34_letter</field>
            <field name="sequence">110</field>
            <field name="label_type">partner</field>
            <field name="label_width">101</field>
            <field name="label_height">33.9</field>
            <field name="layout_mode">sheet</field>
            <field name="page_format">Letter</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">21.05</field>
            <field name="margin_bottom">21.05</field>
            <field name="margin_left">4.95</field>
            <field name="margin_right">4.95</field>
            <field name="column_gap">4</field>
            <field name="row_gap">0</field>
            <field name="auto_grid" eval="False"/>
            <field name="columns">2</field>
            <field name="rows">7</field>
            <field name="output_type">pdf</field>
            <field name="default_font_size">10</field>
            <field name="is_predefined" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>

        <record id="el_partner_101x34_address" model="epg.label.element">
            <field name="template_id" ref="label_partner_101x34_sheet"/>
            <field name="name">Address</field>
            <field name="element_type">address</field>
            <field name="sequence">10</field>
            <field name="pos_x">4</field><field name="pos_y">4</field>
            <field name="width">70</field><field name="height">26</field>
            <field name="font_size">10</field>
            <field name="line_height">1.25</field>
            <field name="vertical_align">center</field>
            <field name="address_parts">name,street,street2,city,state,zip,country</field>
        </record>
        <record id="el_partner_101x34_vcard" model="epg.label.element">
            <field name="template_id" ref="label_partner_101x34_sheet"/>
            <field name="name">vCard QR Code</field>
            <field name="element_type">vcard</field>
            <field name="sequence">20</field>
            <field name="pos_x">78</field><field name="pos_y">7</field>
            <field name="width">20</field><field name="height">20</field>
            <field name="qr_error_correction">M</field>
        </record>

        <!-- ============================================================
             66 x 25 mm / 2-5/8" x 1" - 30 per Letter sheet, 3 x 10
             ============================================================ -->
        <record id="label_partner_66x25_sheet" model="epg.label.template">
            <field name="name">Address Label 66 x 25 mm (30 per Letter sheet)</field>
            <field name="code">epg_partner_66x25_letter</field>
            <field name="sequence">120</field>
            <field name="label_type">partner</field>
            <field name="label_width">66.7</field>
            <field name="label_height">25.4</field>
            <field name="layout_mode">sheet</field>
            <field name="page_format">Letter</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">12.7</field>
            <field name="margin_bottom">12.7</field>
            <field name="margin_left">4.7</field>
            <field name="margin_right">4.7</field>
            <field name="column_gap">3.2</field>
            <field name="row_gap">0</field>
            <field name="auto_grid" eval="False"/>
            <field name="columns">3</field>
            <field name="rows">10</field>
            <field name="output_type">pdf</field>
            <field name="default_font_size">8</field>
            <field name="is_predefined" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>

        <record id="el_partner_66x25_address" model="epg.label.element">
            <field name="template_id" ref="label_partner_66x25_sheet"/>
            <field name="name">Address</field>
            <field name="element_type">address</field>
            <field name="sequence">10</field>
            <field name="pos_x">2.5</field><field name="pos_y">2</field>
            <field name="width">61</field><field name="height">21</field>
            <field name="font_size">8</field>
            <field name="line_height">1.2</field>
            <field name="vertical_align">center</field>
            <field name="address_parts">name,street,street2,city,state,zip,country</field>
        </record>

    </data>
</odoo>
