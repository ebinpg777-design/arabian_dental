<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.lab.pwa</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="after">
                <block title="Install as an App" id="lab_pwa_settings">
                    <setting id="pwa_enabled" help="Visitors can add this site to their phone's home screen and open it without a browser bar.">
                        <field name="pwa_enabled"/>
                        <div class="content-group" invisible="not pwa_enabled">
                            <div class="row mt16">
                                <label for="pwa_name" class="col-lg-4 o_light_label"/>
                                <field name="pwa_name" placeholder="Defaults to the website name"/>
                            </div>
                            <div class="row">
                                <label for="pwa_short_name" class="col-lg-4 o_light_label"/>
                                <field name="pwa_short_name" placeholder="Shown under the icon"/>
                            </div>
                            <div class="row">
                                <label for="pwa_start_url" class="col-lg-4 o_light_label"/>
                                <field name="pwa_start_url" placeholder="/my/cases"/>
                            </div>
                            <div class="row">
                                <label for="pwa_theme_color" class="col-lg-4 o_light_label"/>
                                <field name="pwa_theme_color" widget="color" placeholder="#714B67"/>
                            </div>
                            <div class="row">
                                <label for="pwa_icon" class="col-lg-4 o_light_label"/>
                                <field name="pwa_icon" widget="image"
                                       options="{'size': [90, 90]}"/>
                            </div>
                            <div class="mt8 text-warning small"
                                 invisible="not pwa_icon_warning">
                                <i class="fa fa-exclamation-triangle me-1"/>
                                <field name="pwa_icon_warning" readonly="1" nolabel="1"/>
                            </div>
                            <div class="mt8 text-muted small">
                                A square PNG of 512x512 or more. Without one the
                                company logo is used, then the favicon — both are
                                usually far too small to survive being an app icon.
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
