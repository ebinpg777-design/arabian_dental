<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_lab_delivery" model="ir.sequence">
            <field name="name">Lab Delivery</field>
            <field name="code">lab.delivery</field>
            <field name="prefix">DLV/%(year)s/</field>
            <field name="padding">5</field>
        </record>

        <record id="seq_lab_pickup" model="ir.sequence">
            <field name="name">Lab Pickup (to lab)</field>
            <field name="code">lab.delivery.pickup</field>
            <field name="prefix">PCK/%(year)s/</field>
            <field name="padding">5</field>
        </record>
    </data>
</odoo>
