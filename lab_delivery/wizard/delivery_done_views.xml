<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_done_wizard" model="ir.ui.view">
        <field name="name">lab.delivery.done.wizard.form</field>
        <field name="model">lab.delivery.done.wizard</field>
        <field name="arch" type="xml">
            <form string="Mark Delivered">
                <field name="delivery_id" invisible="1"/>
                <group>
                    <field name="delivery_outcome" widget="radio"/>
                    <field name="near_place_name" required="delivery_outcome == 'near_place'"
                           invisible="delivery_outcome != 'near_place'"/>
                    <field name="received_by"/>
                    <field name="proof_image" widget="image" class="oe_avatar"/>
                </group>
                <footer>
                    <button string="Confirm" name="action_confirm" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
