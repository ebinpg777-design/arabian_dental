<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ courier master -->
    <record id="view_courier_list" model="ir.ui.view">
        <field name="name">lab.courier.list</field>
        <field name="model">lab.courier</field>
        <field name="arch" type="xml">
            <list string="Couriers">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="phone"/>
                <field name="transit_days"/>
                <field name="tracking_url" optional="show"/>
                <field name="delivery_count" string="Consignments"/>
            </list>
        </field>
    </record>

    <record id="view_courier_form" model="ir.ui.view">
        <field name="name">lab.courier.form</field>
        <field name="model">lab.courier</field>
        <field name="arch" type="xml">
            <form string="Courier">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_deliveries" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="delivery_count == 0">
                            <field name="delivery_count" widget="statinfo"
                                   string="Consignments"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Blue Dart"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. BD"/>
                            <field name="transit_days"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="website" widget="url"/>
                        </group>
                    </group>
                    <group string="Tracking">
                        <field name="tracking_url" nolabel="1" colspan="2"
                               placeholder="https://example.com/track?no={awb}"/>
                    </group>
                    <group string="Consignment numbers"
                           help="What this courier's numbers look like. Used to recognise the number on a scanned receipt and to warn on a typed one — never to refuse it.">
                        <field name="awb_pattern" placeholder="^[0-9]{8,11}$"/>
                        <field name="awb_example" placeholder="12345678901"/>
                        <field name="awb_s10"/>
                    </group>
                    <group>
                        <div colspan="2" class="text-muted">
                            Put <code>{awb}</code> where the consignment number goes.
                            Couriers change these pages from time to time — correct it
                            here once and every parcel follows.
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_courier_search" model="ir.ui.view">
        <field name="name">lab.courier.search</field>
        <field name="model">lab.courier</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="inactive" string="Archived" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_courier" model="ir.actions.act_window">
        <field name="name">Couriers</field>
        <field name="res_model">lab.courier</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the couriers the lab actually uses</p>
            <p>Give each one its tracking page and a consignment number turns into a link
               anybody in the office — or the doctor — can open.</p>
        </field>
    </record>

    <!-- ============================================================ tracking events -->
    <record id="view_courier_event_list" model="ir.ui.view">
        <field name="name">lab.courier.event.list</field>
        <field name="model">lab.courier.event</field>
        <field name="arch" type="xml">
            <list string="Tracking" create="0"
                  decoration-danger="status in ('exception','returned')"
                  decoration-success="status == 'delivered'">
                <field name="event_datetime"/>
                <field name="status"/>
                <field name="location"/>
                <field name="note"/>
                <field name="source" optional="hide"/>
                <field name="user_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_courier_event_search" model="ir.ui.view">
        <field name="name">lab.courier.event.search</field>
        <field name="model">lab.courier.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="awb"/>
                <field name="courier_id"/>
                <field name="delivery_id"/>
                <filter name="trouble" string="Exceptions"
                        domain="[('status','in',('exception','returned'))]"/>
                <group>
                    <filter name="by_courier" string="Courier"
                            context="{'group_by':'courier_id'}"/>
                    <filter name="by_status" string="Status"
                            context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_courier_events" model="ir.actions.act_window">
        <field name="name">Consignment Tracking</field>
        <field name="res_model">lab.courier.event</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_by_courier': 1}</field>
    </record>

    <!-- ============================================================ wizards -->
    <record id="view_courier_dispatch_wizard_form" model="ir.ui.view">
        <field name="name">lab.courier.dispatch.wizard.form</field>
        <field name="model">lab.courier.dispatch.wizard</field>
        <field name="arch" type="xml">
            <form string="Send by Courier">
                <!-- The receipt first: photograph it and the two fields below fill
                     themselves. Typing remains the fallback, not the default.
                     (client, 2026-08-28) -->
                <field name="receipt_image" widget="courier_receipt_scan" nolabel="1"
                       options="{'awb': 'courier_awb', 'courier': 'courier_id',
                                 'source': 'awb_source', 'dispatched': 'dispatched_at'}"/>
                <field name="awb_source" invisible="1"/>
                <field name="awb_example" invisible="1"/>
                <field name="awb_looks_wrong" invisible="1"/>
                <group>
                    <group>
                        <field name="delivery_id" invisible="1"/>
                        <field name="courier_id" options="{'no_quick_create': True}"/>
                        <field name="courier_awb"
                               placeholder="Number on the receipt"/>
                    </group>
                    <group>
                        <field name="dispatched_at"/>
                        <field name="expected_date"/>
                    </group>
                </group>
                <field name="tracking_url" invisible="1"/>
                <div class="alert alert-info mb-0" role="status"
                     invisible="not tracking_url">
                    This will be trackable at
                    <field name="tracking_url" widget="url" nolabel="1"
                           class="oe_inline" readonly="1"/>
                </div>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not courier_id or tracking_url or not courier_awb">
                    This courier has no tracking page set up, so the number will be
                    recorded but not clickable.
                </div>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not awb_looks_wrong">
                    <strong>Check the number.</strong> It does not look like this
                    courier's consignment numbers
                    (<span invisible="not awb_example">e.g. <field name="awb_example"
                        class="oe_inline" readonly="1"/></span>).
                    You can still send it if the receipt says so.
                </div>
                <group>
                    <field name="notify_doctor"/>
                </group>
                <footer>
                    <button string="Send" name="action_confirm" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_courier_event_wizard_form" model="ir.ui.view">
        <field name="name">lab.courier.event.wizard.form</field>
        <field name="model">lab.courier.event.wizard</field>
        <field name="arch" type="xml">
            <form string="Tracking Update">
                <field name="delivery_id" invisible="1"/>
                <field name="tracking_url" invisible="1"/>
                <div class="alert alert-info" role="status" invisible="not tracking_url">
                    Read it off the courier's page:
                    <field name="tracking_url" widget="url" nolabel="1"
                           class="oe_inline" readonly="1"/>
                </div>
                <group>
                    <group>
                        <field name="status"/>
                        <field name="event_datetime"/>
                    </group>
                    <group>
                        <field name="location" placeholder="e.g. Kochi hub"/>
                        <field name="note" placeholder="What the page said"/>
                    </group>
                </group>
                <footer>
                    <button string="Record" name="action_confirm" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
