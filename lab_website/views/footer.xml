<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo's default footer ships with placeholder copy ("We are a team of passionate
         people…", info@yourcompany.example.com, +1 555-555-5556) and links to "#". The
         lab's own words and numbers go in instead. The block stays an editable
         oe_structure, so anything the lab changes in the website editor afterwards is
         copied per website and kept. -->
    <template id="footer_lab" inherit_id="website.footer_custom" name="Footer: Arabian Dental Lab">

        <xpath expr="//div[@id='footer']//h5[text()='Useful Links']/following-sibling::ul" position="replace">
            <ul class="list-unstyled">
                <li><a href="/">Home</a></li>
                <li><a href="/restorations">What we make</a></li>
                <li><a href="/academy">ADL Dental Academy</a></li>
                <li><a href="/about-us">About us</a></li>
                <li><a href="/my/cases">Doctor login</a></li>
                <li><a href="/contactus">Contact us</a></li>
            </ul>
        </xpath>

        <xpath expr="//div[@id='footer']//h5[text()='About us']/following-sibling::p" position="replace">
            <p>Arabian Dental Lab is a dental laboratory in Manjeri, Kerala, making crowns,
               bridges, dentures and implant prosthetics to your prescription — collected
               from your clinic by our own executives and delivered back on the date we
               promised.
               <br/><br/>Home of the ADL Dental Academy and the Crown Conference Hall.</p>
        </xpath>

        <xpath expr="//div[@id='footer']//h5[text()='Connect with us']/following-sibling::ul" position="replace">
            <ul class="list-unstyled">
                <li><i class="fa fa-map-marker fa-fw me-2"/>Nilambur – Malappuram Road, Melakkam, Manjeri 676123</li>
                <li><i class="fa fa-phone fa-fw me-2"/><a href="tel:+919447849858"><span class="o_force_ltr">+91 94478 49858</span></a></li>
                <li><i class="fa fa-phone fa-fw me-2"/><a href="tel:+918078102515"><span class="o_force_ltr">+91 80781 02515</span></a></li>
                <li><i class="fa fa-clock-o fa-fw me-2"/>Mon – Sat, 9:00 AM – 6:00 PM</li>
                <li><i class="fa fa-comment fa-fw me-2"/><a href="/contactus">Contact us</a></li>
            </ul>
        </xpath>

        <!-- Only the channels the lab actually has. The instagram link resolves through
             Odoo's /website/social/ redirect, so the handle lives in Website settings. -->
        <xpath expr="//div[@id='footer']//div[hasclass('s_social_media')]" position="replace">
            <div class="s_social_media text-start o_not_editable" data-snippet="s_social_media" data-name="Social Media" contenteditable="false">
                <h5 class="s_social_media_title d-none" contenteditable="true">Follow us</h5>
                <a href="/website/social/instagram" class="s_social_media_instagram" target="_blank" aria-label="Instagram">
                    <i class="fa fa-instagram rounded-circle shadow-sm o_editable_media"/>
                </a>
                <a href="https://www.google.com/maps/search/?api=1&amp;query=Arabian+Dental+Lab+Manjeri" class="text-800" target="_blank" aria-label="Google Maps">
                    <i class="fa fa-map-marker rounded-circle shadow-sm o_editable_media"/>
                </a>
            </div>
        </xpath>
    </template>
</odoo>
