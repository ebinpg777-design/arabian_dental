<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================ OVERVIEW -->
    <template id="page_services" name="Services">
        <t t-call="website.layout"
            additional_title.f="What we make"
            website_meta_description.f="Crown and bridge, implant prosthetics, veneers, dentures, digital dentistry and orthodontic appliances from Arabian Dental Lab, Manjeri.">
            <div id="wrap" class="oe_structure o_lab">
                <t t-call="lab_website.page_hero"
                    hero_img.f="/lab_website/static/src/img/zirconia-bridge.jpg"
                    hero_kicker.f="Our services"
                    hero_title.f="Everything a clinic sends, under one roof"
                    hero_text.f="Six service lines, one quality gate. Where a count is shown it is live from our own catalogue, not a brochure figure."/>

                <!-- Jump nav: six services is too many to scroll past on a phone looking
                     for one. Sticks under the header. -->
                <nav class="o_lab_jump" aria-label="Jump to a service">
                    <div class="container">
                        <a t-foreach="services" t-as="s" t-attf-href="##{s['slug']}" class="o_lab_jump_i">
                            <i t-attf-class="fa #{s['icon']}"/><span t-out="s['title']"/>
                            <b t-if="s['count']" t-out="s['count']"/>
                        </a>
                    </div>
                </nav>

                <section class="o_lab_sec">
                    <div class="container">
                        <div t-foreach="services" t-as="s" t-att-id="s['slug']"
                             t-attf-class="o_lab_svcrow o_lab_reveal #{'o_lab_svcrow_alt' if s_index % 2 else ''}">
                            <a t-attf-href="/services/#{s['slug']}" class="o_lab_svcrow_img">
                                <img t-att-src="s['img']" t-att-alt="s['title']" loading="lazy"/>
                                <span t-if="s['count']" class="o_lab_pill"><b t-out="s['count']"/> designs</span>
                            </a>
                            <div class="o_lab_svcrow_body">
                                <span class="o_lab_kicker" t-out="s['kicker']"/>
                                <h2><i t-attf-class="fa #{s['icon']} me-2"/><t t-out="s['title']"/></h2>
                                <p class="o_lab_lead" t-out="s['summary']"/>
                                <div class="o_lab_chips">
                                    <span t-foreach="s['materials'][:5]" t-as="m" class="o_lab_chip" t-out="m"/>
                                </div>
                                <div class="o_lab_cta">
                                    <a t-attf-href="/services/#{s['slug']}" class="btn o_lab_btn">About <t t-out="s['title']"/></a>
                                    <a href="/send-a-case" class="btn o_lab_link_btn">Send a case <i class="fa fa-long-arrow-right ms-1"/></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <t t-call="lab_website.cta_band"
                    cta_title.f="Not sure which material fits?"
                    cta_text.f="Send us the case. We will recommend a design and tell you what it costs before we start."/>
            </div>
        </t>
    </template>

    <!-- ================================================================== DETAIL -->
    <template id="page_service" name="Service">
        <t t-set="lab" t-value="env['website'].sudo().lab_info()"/>
        <t t-call="website.layout"
            additional_title="service['title']"
            website_meta_description="service['summary']">
            <div id="wrap" class="oe_structure o_lab">
                <t t-call="lab_website.page_hero"
                    hero_img="service['img']"
                    hero_kicker="service['kicker']"
                    hero_title="service['title']"
                    hero_text="service['summary']"
                    hero_cta="('Send a case', '/send-a-case')"
                    hero_cta2="('Ask a question', '/contactus')"/>

                <section class="o_lab_sec">
                    <div class="container">
                        <div class="row g-5">
                            <div class="col-lg-7 o_lab_reveal">
                                <span class="o_lab_kicker">How we make it</span>
                                <h2 class="o_lab_h2">Made to the prescription, checked on the model</h2>
                                <p t-foreach="service['body']" t-as="para" class="o_lab_lead" t-out="para"/>

                                <h3 class="o_lab_h3 mt-5">What we offer</h3>
                                <div class="o_lab_materials">
                                    <div t-foreach="service['materials']" t-as="m" class="o_lab_material">
                                        <i class="fa fa-check-circle"/><span t-out="m"/>
                                    </div>
                                </div>

                                <t t-if="service.get('products')">
                                    <h3 class="o_lab_h3 mt-5">From the catalogue</h3>
                                    <p class="text-muted">A few of the <t t-out="service['count']"/> designs in this line, straight from the lab's own price list.</p>
                                    <div class="o_lab_chips">
                                        <span t-foreach="service['products']" t-as="p" class="o_lab_chip" t-out="p"/>
                                        <span t-if="service['count'] &gt; len(service['products'])" class="o_lab_chip o_lab_chip_ghost">+<t t-out="service['count'] - len(service['products'])"/> more</span>
                                    </div>
                                </t>
                            </div>
                            <div class="col-lg-5">
                                <div class="o_lab_sticky">
                                    <div class="o_lab_panel o_lab_reveal">
                                        <h4><i class="fa fa-list-ul me-2"/>What to send</h4>
                                        <ol class="o_lab_checklist">
                                            <li t-foreach="service['send']" t-as="item" t-out="item"/>
                                        </ol>
                                        <a href="/send-a-case" class="btn o_lab_btn w-100 mt-3">How to send a case</a>
                                        <a t-attf-href="https://wa.me/#{lab['whatsapp']}?text=#{wa_text}" target="_blank" rel="noopener" class="btn o_lab_btn_outline w-100 mt-2"><i class="fa fa-whatsapp me-2"/>Ask on WhatsApp</a>
                                    </div>
                                    <div class="o_lab_panel o_lab_panel_soft mt-3 o_lab_reveal">
                                        <h4>Already sending us cases?</h4>
                                        <p>Track every case, see which bench it is on and when it ships.</p>
                                        <a href="/my/cases" class="o_lab_link">Doctor login <i class="fa fa-long-arrow-right ms-1"/></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Prev / next: a reader who came for one service often wants the next. -->
                <section class="o_lab_prevnext">
                    <div class="container">
                        <a t-attf-href="/services/#{prev_service['slug']}" class="o_lab_prevnext_i">
                            <small><i class="fa fa-long-arrow-left me-1"/>Previous</small>
                            <strong t-out="prev_service['title']"/>
                        </a>
                        <a href="/services" class="o_lab_prevnext_all"><i class="fa fa-th-large"/></a>
                        <a t-attf-href="/services/#{next_service['slug']}" class="o_lab_prevnext_i text-end">
                            <small>Next<i class="fa fa-long-arrow-right ms-1"/></small>
                            <strong t-out="next_service['title']"/>
                        </a>
                    </div>
                </section>

                <t t-call="lab_website.services_rail" skip_slug="service['slug']"/>
                <t t-call="lab_website.cta_band"/>
            </div>
        </t>
    </template>

</odoo>
