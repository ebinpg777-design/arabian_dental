<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo's contact page: its parallax title and its "My Company / 3575 Fake Buena
         Vista Avenue / +1 555-555-5556" sidebar are typed into the page, not read from
         the company. Both go; the form itself — Odoo's own, editable — stays. -->
    <template id="contactus_lab" inherit_id="website.contactus" name="Contact: Arabian Dental Lab">
        <xpath expr="//section[hasclass('s_title')]" position="replace">
            <t t-set="lab" t-value="env['website'].sudo().lab_info()"/>
            <div class="o_lab">
                <t t-call="lab_website.page_hero">
                    <t t-set="hero_img" t-value="'/lab_website/static/src/img/crowns-on-model.jpg'"/>
                    <t t-set="hero_kicker" t-value="'Contact'"/>
                    <t t-set="hero_title" t-value="'Talk to the lab'"/>
                    <t t-set="hero_text" t-value="'A question about a case, a material or a course — write here, ring, or message us on WhatsApp.'"/>
                </t>
            </div>
        </xpath>
        <xpath expr="//section[hasclass('s_text_block')]" position="attributes">
            <attribute name="class">s_text_block pt40 pb40 o_colored_level o_lab o_lab_contactpage</attribute>
        </xpath>
        <xpath expr="//h5[text()='My Company']/parent::div" position="replace">
            <div class="col-lg-4 offset-lg-1 mt-4 mt-lg-0">
                <t t-set="lab" t-value="env['website'].sudo().lab_info()"/>
                <div class="o_lab_panel">
                    <h4>Arabian Dental Lab</h4>
                    <t t-call="lab_website.contact_rows"/>
                    <a t-attf-href="https://wa.me/#{lab['whatsapp']}" target="_blank" rel="noopener" class="btn o_lab_btn w-100"><i class="fa fa-whatsapp me-2"/>WhatsApp the lab</a>
                    <p class="mt-3 mb-0 small text-muted">Already sending us cases? <a href="/my/cases">Log in</a> to track them.</p>
                </div>
                <div class="o_lab_map o_lab_map_sm mt-3">
                    <iframe t-att-src="lab['maps_embed']" title="Arabian Dental Lab on Google Maps" loading="lazy" referrerpolicy="no-referrer-when-downgrade"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
