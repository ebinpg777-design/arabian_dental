<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo's contact page. In Odoo 20 it is one "form aside" section (title, lead,
         form, and a stock photo beside it) followed by a marketing band ("50,000+
         companies use our services"), a generic FAQ and a map of San Francisco with
         directions by train - all typed into the page, none of it read from the
         company. The title becomes the lab's hero, the photo becomes the lab's panel
         and map, the demo bands go; the form itself - Odoo's own, editable - stays. -->
    <template id="contactus_lab" inherit_id="website.contactus" name="Contact: Arabian Dental Lab">
        <xpath expr="//section[hasclass('s_form_aside')]" position="before">
            <t t-set="lab" t-value="env['website'].sudo().lab_info()"/>
            <div class="o_lab">
                <t t-call="lab_website.page_hero"
                    hero_img.f="/lab_website/static/src/img/crowns-on-model.jpg"
                    hero_kicker.f="Contact"
                    hero_title.f="Talk to the lab"
                    hero_text.f="A question about a case, a material or a course — write here, ring, or message us on WhatsApp."/>
            </div>
        </xpath>
        <xpath expr="//section[hasclass('s_form_aside')]" position="attributes">
            <attribute name="class">s_form_aside pt40 pb40 o_colored_level o_lab o_lab_contactpage</attribute>
            <attribute name="data-oe-shape-data"/>
            <attribute name="style"/>
        </xpath>
        <xpath expr="//section[hasclass('s_form_aside')]/div[hasclass('o_we_shape')]" position="replace"/>
        <!-- The hero above already says "Talk to the lab". -->
        <xpath expr="//section[hasclass('s_form_aside')]//h1" position="replace"/>
        <xpath expr="//section[hasclass('s_form_aside')]//form[@id='contactus_form']/../../.." position="attributes">
            <attribute name="class">col-12 col-lg-7 order-lg-0</attribute>
        </xpath>
        <!-- The placeholder is Odoo's demo number. -->
        <xpath expr="//input[@id='contact2']" position="attributes">
            <attribute name="placeholder">+91 94478 49858</attribute>
        </xpath>
        <xpath expr="//img[@src='/web/image/website.s_form_aside_default_image']/.." position="replace">
            <div class="col-12 col-lg-4 offset-lg-1 mt-4 mt-lg-0 order-lg-0" style="order: 2;">
                <t t-set="lab" t-value="env['website'].sudo().lab_info()"/>
                <div class="o_lab_panel">
                    <h4>Arabian Dental Lab</h4>
                    <t t-call="lab_website.contact_rows"/>
                    <a t-attf-href="https://wa.me/#{lab['whatsapp']}" target="_blank" rel="noopener" class="btn o_lab_btn w-100"><i class="fa fa-whatsapp me-2"/>WhatsApp the lab</a>
                    <p class="mt-3 mb-0 small text-muted">Already sending us cases? <a href="/my/cases">Log in</a> to track them.</p>
                </div>
                <div class="o_lab_map o_lab_map_sm mt-3">
                    <iframe t-att-src="lab['maps_embed']" title="Arabian Dental Lab on Google Maps" loading="lazy" referrerpolicy="no-referrer-when-downgrade"/>
                </div>
            </div>
        </xpath>
        <!-- Odoo 20's demo bands: the "50,000+ companies" title, the generic FAQ, the
             separator and the San Francisco map with its directions. -->
        <xpath expr="//section[hasclass('s_title')]" position="replace"/>
        <xpath expr="//section[hasclass('s_faq_list')]" position="replace"/>
        <xpath expr="//div[hasclass('s_hr')]" position="replace"/>
        <xpath expr="//section[hasclass('s_accordion_image')]" position="replace"/>
    </template>
</odoo>
