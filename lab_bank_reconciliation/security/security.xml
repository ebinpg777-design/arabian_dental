<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- A bank belongs to a company; so do its statements, what was cleared, the
             undo trail and the queries raised with the bank. -->
        <record id="rule_bank_reconciliation_company" model="ir.rule">
            <field name="name">Bank reconciliation: own companies</field>
            <field name="model_id" ref="model_bank_reconciliation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_bank_clearance_company" model="ir.rule">
            <field name="name">Bank clearance: own companies</field>
            <field name="model_id" ref="model_bank_clearance"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_bank_reconciliation_step_company" model="ir.rule">
            <field name="name">Bank reconciliation undo step: own companies</field>
            <field name="model_id" ref="model_bank_reconciliation_step"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_bank_line_query_company" model="ir.rule">
            <field name="name">Bank line query: own companies</field>
            <field name="model_id" ref="model_bank_line_query"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
