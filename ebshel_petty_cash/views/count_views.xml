<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_count_form" model="ir.ui.view">
        <field name="name">ebshel.petty.cash.count.form</field>
        <field name="model">ebshel.petty.cash.count</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_load_denominations" type="object" string="Load Denominations"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_post_difference" type="object" string="Post Difference" class="btn-primary"
                            invisible="state != 'confirmed'" groups="ebshel_petty_cash.group_petty_cash_manager"/>
                    <button name="%(action_report_petty_cash_count)d" type="action" string="Print"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('confirmed', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move" type="object" class="oe_stat_button" icon="book"
                                invisible="not move_id" groups="account.group_account_readonly" string="Journal Entry"/>
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="fund_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="counted_by_id" widget="many2one_avatar_user" readonly="state != 'draft'"/>
                            <field name="witness_id" widget="many2one_avatar_user" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="manual_amount" invisible="line_ids" readonly="state != 'draft'"/>
                            <field name="counted_amount"/>
                            <field name="current_book_balance" invisible="state != 'draft'"/>
                            <field name="expected_difference" invisible="state != 'draft'"
                                   decoration-danger="expected_difference != 0"/>
                            <field name="book_balance" invisible="state == 'draft'"/>
                            <field name="difference" invisible="state == 'draft'"
                                   decoration-danger="difference != 0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Denominations" name="denominations">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="denomination_id" options="{'no_create': True}"/>
                                    <field name="quantity"/>
                                    <field name="subtotal" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Explanation" name="explanation">
                            <field name="note" placeholder="Explain any difference between the cash and the books..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_count_list" model="ir.ui.view">
        <field name="name">ebshel.petty.cash.count.list</field>
        <field name="model">ebshel.petty.cash.count</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-danger="difference != 0">
                <field name="name"/>
                <field name="date"/>
                <field name="fund_id"/>
                <field name="counted_by_id" widget="many2one_avatar_user"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="counted_amount"/>
                <field name="book_balance"/>
                <field name="difference" sum="Total"/>
                <field name="state" widget="badge" decoration-warning="state == 'confirmed'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_count_search" model="ir.ui.view">
        <field name="name">ebshel.petty.cash.count.search</field>
        <field name="model">ebshel.petty.cash.count</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="fund_id"/>
                <filter name="with_difference" string="With Difference" domain="[('difference', '!=', 0)]"/>
                <filter name="to_post" string="Difference to Post" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_fund" string="Fund" context="{'group_by': 'fund_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_count" model="ir.actions.act_window">
        <field name="name">Cash Counts</field>
        <field name="res_model">ebshel.petty.cash.count</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Count a cash box</p>
            <p>Count the notes and coins; the count is compared with the ledger balance.</p>
        </field>
    </record>

</odoo>
