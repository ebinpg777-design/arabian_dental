<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_transfer_form" model="ir.ui.view">
        <field name="name">ebshel.petty.cash.transfer.form</field>
        <field name="model">ebshel.petty.cash.transfer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object" string="Post" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancelled'"
                            confirm="Cancel this transfer? A posted one is reversed in the books."/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move" type="object" class="oe_stat_button" icon="book"
                                invisible="not move_id" groups="account.group_account_readonly" string="Journal Entry"/>
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="fund_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="dest_fund_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="amount" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="move_id" groups="account.group_account_readonly"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Reason for the transfer..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_transfer_list" model="ir.ui.view">
        <field name="name">ebshel.petty.cash.transfer.list</field>
        <field name="model">ebshel.petty.cash.transfer</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="fund_id"/>
                <field name="dest_fund_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"/>
            </list>
        </field>
    </record>

    <record id="action_transfer" model="ir.actions.act_window">
        <field name="name">Fund Transfers</field>
        <field name="res_model">ebshel.petty.cash.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Move cash between two funds</p>
        </field>
    </record>

</odoo>
