<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_denomination_list" model="ir.ui.view">
        <field name="name">ebshel.petty.cash.denomination.list</field>
        <field name="model">ebshel.petty.cash.denomination</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="currency_id"/>
                <field name="value"/>
                <field name="kind"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_denomination_search" model="ir.ui.view">
        <field name="name">ebshel.petty.cash.denomination.search</field>
        <field name="model">ebshel.petty.cash.denomination</field>
        <field name="arch" type="xml">
            <search>
                <field name="currency_id"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_currency" string="Currency" context="{'group_by': 'currency_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_denomination" model="ir.actions.act_window">
        <field name="name">Denominations</field>
        <field name="res_model">ebshel.petty.cash.denomination</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_currency': 1}</field>
    </record>

</odoo>
