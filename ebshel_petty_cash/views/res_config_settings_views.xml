<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.petty.cash</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="95"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Petty Cash" string="Petty Cash" name="ebshel_petty_cash"
                     groups="ebshel_petty_cash.group_petty_cash_manager">
                    <block title="Approval" name="petty_cash_approval">
                        <setting string="Approval Levels"
                                 help="The approval matrix: which levels a voucher, advance or replenishment goes through, by amount, fund and category.">
                            <button name="%(ebshel_petty_cash.action_approval_level)d" type="action" string="Approval Levels"
                                    class="btn-link"/>
                        </setting>
                        <setting string="Self-Approval" company_dependent="1"
                                 help="Approvers may approve the requests they raised themselves.">
                            <field name="petty_cash_self_approval"/>
                        </setting>
                        <setting string="One Level per Approver" company_dependent="1"
                                 help="Segregation of duties: whoever approved one level of a document cannot approve another level of it.">
                            <field name="petty_cash_distinct_approvers"/>
                        </setting>
                        <setting string="Risk-Based Review" company_dependent="1"
                                 help="High-risk vouchers (duplicates, split spending, just under a threshold...) get an extra review by a petty cash administrator.">
                            <field name="petty_cash_risk_review"/>
                        </setting>
                    </block>
                    <block title="Controls" name="petty_cash_controls">
                        <setting string="Duplicate Vouchers" company_dependent="1"
                                 help="Warn about vouchers with the same amount and payee or receipt reference within this many days (0: off).">
                            <field name="petty_cash_duplicate_days"/>
                        </setting>
                        <setting string="Late Submissions" company_dependent="1"
                                 help="Flag vouchers submitted more than this many days after the spending (0: off).">
                            <field name="petty_cash_late_days"/>
                        </setting>
                        <setting string="Advance Settlement" company_dependent="1"
                                 help="Days an advance holder has to settle; overdue holders cannot get a new advance.">
                            <field name="petty_cash_advance_due_days"/>
                        </setting>
                        <setting string="Advance Account" company_dependent="1"
                                 help="Receivable account holding the advances until settled (created on first use when empty).">
                            <field name="petty_cash_advance_account_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_petty_cash_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'ebshel_petty_cash'}</field>
    </record>

</odoo>
