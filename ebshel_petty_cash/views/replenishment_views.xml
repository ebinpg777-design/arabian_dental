<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_replenishment_form" model="ir.ui.view">
        <field name="name">ebshel.petty.cash.replenishment.form</field>
        <field name="model">ebshel.petty.cash.replenishment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_load_expenses" type="object" string="Load Vouchers"
                            invisible="kind != 'replenish' or state not in ('draft', 'to_approve')"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="not can_approve"/>
                    <button name="action_post" type="object" string="Post" class="btn-primary"
                            invisible="state != 'approved'" groups="ebshel_petty_cash.group_petty_cash_manager"/>
                    <button name="action_refuse" type="object" string="Refuse"
                            invisible="state not in ('to_approve', 'approved')"
                            groups="ebshel_petty_cash.group_petty_cash_manager"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('to_approve', 'refused', 'cancelled')"/>
                    <button name="%(action_report_petty_cash_replenishment)d" type="action" string="Print"
                            invisible="state == 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('refused', 'cancelled')"
                            confirm="Cancel this replenishment? A posted one is reversed in the books."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,approved,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move" type="object" class="oe_stat_button" icon="book"
                                invisible="not move_id" groups="account.group_account_readonly" string="Journal Entry"/>
                    </div>
                    <field name="can_approve" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="fund_journal_id" invisible="1"/>
                    <div class="alert alert-danger mb-2" role="alert" invisible="state != 'refused'">
                        <strong>Refused:</strong> <field name="refuse_reason" class="d-inline"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="fund_id" readonly="state not in ('draft', 'to_approve')" options="{'no_create': True}"/>
                            <field name="kind" widget="radio" options="{'horizontal': true}"
                                   readonly="state not in ('draft', 'to_approve')"/>
                            <field name="amount" readonly="state not in ('draft', 'to_approve')"/>
                            <field name="suggested_amount" invisible="kind != 'replenish'"/>
                        </group>
                        <group>
                            <field name="date" readonly="state not in ('draft', 'to_approve')"/>
                            <field name="requested_by_id" widget="many2one_avatar_user" readonly="state != 'draft'"/>
                            <field name="source_journal_id" readonly="state not in ('draft', 'to_approve')"
                                   groups="account.group_account_readonly"/>
                            <field name="counterpart_account_id" readonly="state not in ('draft', 'to_approve')"
                                   groups="account.group_account_readonly"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Vouchers Covered" name="vouchers" invisible="kind != 'replenish'">
                            <field name="expense_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="description"/>
                                    <field name="partner_id"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="amount_total" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="expense_total"/>
                            </group>
                        </page>
                        <page string="Approval" name="approval">
                            <group>
                                <field name="approver_id"/>
                                <field name="approval_date"/>
                                <field name="move_id" groups="account.group_account_readonly"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_replenishment_list" model="ir.ui.view">
        <field name="name">ebshel.petty.cash.replenishment.list</field>
        <field name="model">ebshel.petty.cash.replenishment</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('cancelled', 'refused')" sample="1">
                <field name="name"/>
                <field name="date"/>
                <field name="fund_id"/>
                <field name="kind"/>
                <field name="requested_by_id" widget="many2one_avatar_user" optional="show"/>
                <field name="source_journal_id" optional="show" groups="account.group_account_readonly"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'to_approve'" decoration-warning="state == 'approved'"
                       decoration-success="state == 'posted'" decoration-danger="state == 'refused'"/>
            </list>
        </field>
    </record>

    <record id="view_replenishment_search" model="ir.ui.view">
        <field name="name">ebshel.petty.cash.replenishment.search</field>
        <field name="model">ebshel.petty.cash.replenishment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="fund_id"/>
                <filter name="to_approve" string="To Approve" domain="[('state', '=', 'to_approve')]"/>
                <filter name="to_post" string="To Post" domain="[('state', '=', 'approved')]"/>
                <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <separator/>
                <filter name="replenish" string="Top-Ups" domain="[('kind', '=', 'replenish')]"/>
                <filter name="withdraw" string="Returns to Bank" domain="[('kind', '=', 'withdraw')]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_fund" string="Fund" context="{'group_by': 'fund_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_replenishment" model="ir.actions.act_window">
        <field name="name">Replenishments</field>
        <field name="res_model">ebshel.petty.cash.replenishment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Top up a fund</p>
            <p>Bring the fund back to its float from the bank, listing the vouchers it covers.</p>
        </field>
    </record>

</odoo>
