<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="report_count_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Cash Count <span t-field="doc.name"/></h2>
                <div class="row mt-3 mb-3">
                    <div class="col-6">
                        <strong>Fund:</strong> <span t-field="doc.fund_id"/><br/>
                        <strong>Counted by:</strong> <span t-field="doc.counted_by_id"/><br/>
                        <t t-if="doc.witness_id"><strong>Witness:</strong> <span t-field="doc.witness_id"/></t>
                    </div>
                    <div class="col-6 text-end">
                        <strong>Date:</strong> <span t-field="doc.date"/><br/>
                        <strong>Status:</strong> <span t-field="doc.state"/>
                    </div>
                </div>
                <table t-if="doc.line_ids" class="table table-sm o_main_table">
                    <thead>
                        <tr><th>Denomination</th><th class="text-end">Quantity</th><th class="text-end">Amount</th></tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.line_ids.filtered('quantity')" t-as="line">
                            <td><span t-field="line.denomination_id"/></td>
                            <td class="text-end"><span t-field="line.quantity"/></td>
                            <td class="text-end"><span t-field="line.subtotal"/></td>
                        </tr>
                    </tbody>
                </table>
                <div class="row">
                    <div class="col-6 ms-auto">
                        <table class="table table-sm">
                            <tr class="fw-bold"><td>Cash counted</td><td class="text-end"><span t-field="doc.counted_amount"/></td></tr>
                            <t t-if="doc.state == 'draft'">
                                <tr><td>Ledger balance (now)</td><td class="text-end"><span t-field="doc.current_book_balance"/></td></tr>
                                <tr><td>Difference</td><td class="text-end"><span t-field="doc.expected_difference"/></td></tr>
                            </t>
                            <t t-else="">
                                <tr><td>Ledger balance</td><td class="text-end"><span t-field="doc.book_balance"/></td></tr>
                                <tr><td>Difference</td><td class="text-end"><span t-field="doc.difference"/></td></tr>
                            </t>
                        </table>
                    </div>
                </div>
                <p t-if="doc.note"><strong>Explanation:</strong> <span t-field="doc.note"/></p>
                <t t-set="signatures" t-value="['Counted by', 'Witness', 'Reviewed by']"/>
                <t t-call="ebshel_petty_cash.report_signatures"/>
            </div>
        </t>
    </template>

    <template id="report_count">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="ebshel_petty_cash.report_count_document"/>
            </t>
        </t>
    </template>

</odoo>
