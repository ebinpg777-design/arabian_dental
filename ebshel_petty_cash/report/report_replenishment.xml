<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="report_replenishment_document">
        <t t-call="web.external_layout">
            <t t-call="ebshel_petty_cash.report_style"/>
            <div class="page o_pc_report">
                <div class="row">
                    <div class="col-8">
                        <h2>
                            <t t-if="doc.kind == 'replenish'">Replenishment Claim</t>
                            <t t-else="">Return to Bank</t>
                            <t t-call="ebshel_petty_cash.report_state_badge"/>
                        </h2>
                        <div class="o_pc_sub"><span t-field="doc.name"/> - <span t-field="doc.fund_id"/></div>
                    </div>
                    <div class="col-4">
                        <div class="o_pc_amount_box">
                            <div class="small text-muted" t-if="doc.kind == 'replenish'">AMOUNT CLAIMED</div>
                            <div class="small text-muted" t-else="">AMOUNT RETURNED</div>
                            <div class="o_pc_big"><span t-field="doc.amount"/></div>
                        </div>
                    </div>
                </div>
                <table class="o_pc_facts">
                    <tr>
                        <td class="o_pc_label">Custodian</td><td><span t-field="doc.fund_id.custodian_id"/></td>
                        <td class="o_pc_label">Date</td><td><span t-field="doc.date"/></td>
                    </tr>
                    <tr>
                        <td class="o_pc_label">Float</td><td><span t-field="doc.fund_id.float_amount"/></td>
                        <td class="o_pc_label">Bank journal</td><td><span t-field="doc.sudo().source_journal_id.name"/></td>
                    </tr>
                </table>
                <t t-if="doc.kind == 'replenish' and doc.expense_ids">
                    <h6 class="o_pc_section">Spending by category</h6>
                    <table class="table table-sm o_pc_table">
                        <tr t-foreach="doc._category_summary()" t-as="item">
                            <t t-set="share" t-value="doc.expense_total and item[1] / doc.expense_total * 100 or 0"/>
                            <td style="width: 35%;"><span t-out="item[0]"/></td>
                            <td style="width: 40%; vertical-align: middle;">
                                <div class="o_pc_bar"><div t-att-style="'width: {}%;'.format(min(share, 100))"/></div>
                            </td>
                            <td class="text-end small text-muted"><span t-out="'{:.0f}%'.format(share)"/></td>
                            <td class="text-end"><span t-out="item[1]" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                        </tr>
                        <tr class="fw-bold">
                            <td colspan="3">Total of the vouchers</td>
                            <td class="text-end"><span t-field="doc.expense_total"/></td>
                        </tr>
                    </table>
                    <h6 class="o_pc_section">Vouchers covered</h6>
                    <table class="table table-sm o_main_table o_pc_table">
                        <thead>
                            <tr><th>Voucher</th><th>Date</th><th>Description</th><th>Payee</th><th class="text-end">Total</th></tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.expense_ids" t-as="expense">
                                <td><span t-field="expense.name"/></td>
                                <td><span t-field="expense.date"/></td>
                                <td><span t-field="expense.description"/></td>
                                <td><span t-field="expense.partner_id"/></td>
                                <td class="text-end"><span t-field="expense.amount_total"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
                <p class="small"><strong>Amount in words:</strong> <span t-out="doc.currency_id.amount_to_text(doc.amount)"/></p>
                <div class="row">
                    <div class="col-10"><t t-call="ebshel_petty_cash.report_approval_trail"/></div>
                    <div class="col-2"><t t-call="ebshel_petty_cash.report_qr"/></div>
                </div>
                <t t-set="signatures" t-value="['Custodian', 'Approved by', 'Accounts']"/>
                <t t-call="ebshel_petty_cash.report_signatures"/>
            </div>
        </t>
    </template>

    <template id="report_replenishment">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="ebshel_petty_cash.report_replenishment_document"/>
            </t>
        </t>
    </template>

</odoo>
