<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="report_expense_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.requested_by_id.lang or user.lang)"/>
            <t t-call="ebshel_petty_cash.report_style"/>
            <div class="page o_pc_report">
                <div class="row">
                    <div class="col-8">
                        <h2>Petty Cash Voucher <t t-call="ebshel_petty_cash.report_state_badge"/></h2>
                        <div class="o_pc_sub"><span t-field="doc.name"/> - <span t-field="doc.description"/></div>
                    </div>
                    <div class="col-4">
                        <div class="o_pc_amount_box">
                            <div class="small text-muted">TOTAL PAID</div>
                            <div class="o_pc_big"><span t-field="doc.amount_total"/></div>
                        </div>
                    </div>
                </div>
                <table class="o_pc_facts">
                    <tr>
                        <td class="o_pc_label">Fund</td><td><span t-field="doc.fund_id"/></td>
                        <td class="o_pc_label">Date</td><td><span t-field="doc.date"/></td>
                    </tr>
                    <tr>
                        <td class="o_pc_label">Payee</td><td><span t-field="doc.partner_id"/></td>
                        <td class="o_pc_label">Receipt</td><td><span t-field="doc.reference"/></td>
                    </tr>
                    <tr>
                        <td class="o_pc_label">Requested by</td><td><span t-field="doc.requested_by_id"/></td>
                        <td class="o_pc_label">Paid</td>
                        <td>
                            <t t-if="doc.paid_date"><span t-field="doc.paid_date" t-options="{'widget': 'date'}"/> by <span t-field="doc.paid_by_id"/></t>
                        </td>
                    </tr>
                    <tr t-if="doc.advance_id">
                        <td class="o_pc_label">Against advance</td><td colspan="3"><span t-field="doc.advance_id"/></td>
                    </tr>
                </table>
                <table class="table table-sm o_main_table o_pc_table">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Taxes</th>
                            <th class="text-end">Untaxed</th>
                            <th class="text-end">Tax</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.line_ids" t-as="line">
                            <td><span t-field="line.category_id"/></td>
                            <td><span t-field="line.name"/></td>
                            <td><span t-out="', '.join(line.tax_ids.mapped('name'))"/></td>
                            <td class="text-end"><span t-field="line.amount_untaxed"/></td>
                            <td class="text-end"><span t-field="line.amount_tax"/></td>
                            <td class="text-end"><span t-field="line.amount_total"/></td>
                        </tr>
                    </tbody>
                </table>
                <div class="row">
                    <div class="col-7">
                        <p class="small">
                            <strong>Amount in words:</strong>
                            <span t-out="doc.currency_id.amount_to_text(doc.amount_total)"/>
                        </p>
                        <p class="small text-muted">Receipts attached: <span t-out="doc.attachment_count"/></p>
                    </div>
                    <div class="col-5">
                        <table class="table table-sm">
                            <tr><td>Untaxed</td><td class="text-end"><span t-field="doc.amount_untaxed"/></td></tr>
                            <tr><td>Taxes</td><td class="text-end"><span t-field="doc.amount_tax"/></td></tr>
                            <tr class="fw-bold"><td>Total</td><td class="text-end"><span t-field="doc.amount_total"/></td></tr>
                        </table>
                    </div>
                </div>
                <div class="row">
                    <div class="col-10"><t t-call="ebshel_petty_cash.report_approval_trail"/></div>
                    <div class="col-2"><t t-call="ebshel_petty_cash.report_qr"/></div>
                </div>
                <t t-set="signatures" t-value="['Requested by', 'Approved by', 'Paid by (custodian)', 'Received by']"/>
                <t t-call="ebshel_petty_cash.report_signatures"/>
            </div>
        </t>
    </template>

    <template id="report_expense">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="ebshel_petty_cash.report_expense_document"/>
            </t>
        </t>
    </template>

</odoo>
