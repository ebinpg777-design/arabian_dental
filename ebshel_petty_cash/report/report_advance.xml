<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="report_advance_document">
        <t t-call="web.external_layout">
            <t t-call="ebshel_petty_cash.report_style"/>
            <div class="page o_pc_report">
                <div class="row">
                    <div class="col-8">
                        <h2>Cash Advance <t t-call="ebshel_petty_cash.report_state_badge"/></h2>
                        <div class="o_pc_sub"><span t-field="doc.name"/> - <span t-field="doc.purpose"/></div>
                    </div>
                    <div class="col-4">
                        <div class="o_pc_amount_box">
                            <div class="small text-muted">AMOUNT ADVANCED</div>
                            <div class="o_pc_big"><span t-field="doc.amount"/></div>
                        </div>
                    </div>
                </div>
                <table class="o_pc_facts">
                    <tr>
                        <td class="o_pc_label">Fund</td><td><span t-field="doc.fund_id"/></td>
                        <td class="o_pc_label">Date</td><td><span t-field="doc.date"/></td>
                    </tr>
                    <tr>
                        <td class="o_pc_label">Paid to</td><td><span t-field="doc.holder_id"/></td>
                        <td class="o_pc_label">Settle by</td>
                        <td><span t-field="doc.due_date"/> <span t-if="doc.is_overdue" class="o_pc_badge bad">Overdue</span></td>
                    </tr>
                </table>
                <div class="row mb-3">
                    <div class="col-4"><div class="o_pc_kpi"><div class="o_pc_label">Advanced</div><div class="o_pc_big"><span t-field="doc.amount"/></div></div></div>
                    <div class="col-4"><div class="o_pc_kpi"><div class="o_pc_label">Accounted for</div><div class="o_pc_big"><span t-field="doc.amount_spent"/></div></div></div>
                    <div class="col-4">
                        <div class="o_pc_kpi">
                            <t t-if="doc.state == 'settled'">
                                <div class="o_pc_label">Settled <span t-field="doc.settled_date"/></div>
                                <div class="o_pc_big"><span t-field="doc.settlement_amount"/></div>
                                <div class="small text-muted">returned (+) / reimbursed (-)</div>
                            </t>
                            <t t-else="">
                                <div class="o_pc_label">Still to account for</div>
                                <div class="o_pc_big"><span t-field="doc.amount_due"/></div>
                            </t>
                        </div>
                    </div>
                </div>
                <p class="small"><strong>Amount in words:</strong> <span t-out="doc.currency_id.amount_to_text(doc.amount)"/></p>
                <t t-if="doc.expense_ids">
                    <h6 class="o_pc_section">Vouchers against the advance</h6>
                    <table class="table table-sm o_main_table o_pc_table">
                        <thead>
                            <tr><th>Voucher</th><th>Date</th><th>Description</th><th>Status</th><th class="text-end">Total</th></tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.expense_ids" t-as="expense">
                                <td><span t-field="expense.name"/></td>
                                <td><span t-field="expense.date"/></td>
                                <td><span t-field="expense.description"/></td>
                                <td><span t-field="expense.state"/></td>
                                <td class="text-end"><span t-field="expense.amount_total"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
                <p class="small">
                    I acknowledge receiving the amount above and undertake to account for it with receipts,
                    and to return any unspent cash, by the settlement date.
                </p>
                <div class="row">
                    <div class="col-10"><t t-call="ebshel_petty_cash.report_approval_trail"/></div>
                    <div class="col-2"><t t-call="ebshel_petty_cash.report_qr"/></div>
                </div>
                <t t-set="signatures" t-value="['Received by', 'Approved by', 'Paid by (custodian)']"/>
                <t t-call="ebshel_petty_cash.report_signatures"/>
            </div>
        </t>
    </template>

    <template id="report_advance">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="ebshel_petty_cash.report_advance_document"/>
            </t>
        </t>
    </template>

</odoo>
