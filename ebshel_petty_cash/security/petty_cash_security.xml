<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!--
        Three rights.

        User     - custodians and requesters: the funds they hold or belong to,
                   their own vouchers and advances, the counts and
                   replenishment requests of the funds they hold.
        Approver - approves vouchers and advances; sees every fund.
        Manager  - configures funds and categories, approves and posts
                   replenishments, posts count differences, second approval.
    -->
    <record id="res_groups_privilege_petty_cash" model="res.groups.privilege">
        <field name="name">Petty Cash</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="sequence" eval="8"/>
    </record>

    <record id="group_petty_cash_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence" eval="10"/>
        <field name="privilege_id" ref="res_groups_privilege_petty_cash"/>
        <field name="comment">Raises vouchers and advance requests; custodians pay them and count their fund.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_petty_cash_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="sequence" eval="20"/>
        <field name="privilege_id" ref="res_groups_privilege_petty_cash"/>
        <field name="comment">Approves vouchers and advances of every fund.</field>
        <field name="implied_ids" eval="[(4, ref('group_petty_cash_user'))]"/>
    </record>

    <record id="group_petty_cash_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence" eval="30"/>
        <field name="privilege_id" ref="res_groups_privilege_petty_cash"/>
        <field name="comment">Configures the funds, gives the second approval, approves and posts replenishments and count differences.</field>
        <!-- Administrators see the journals, accounts and entries they configure and audit. -->
        <field name="implied_ids" eval="[(4, ref('group_petty_cash_approver')), (4, ref('account.group_account_readonly'))]"/>
    </record>

    <!-- Accounting administrators run petty cash out of the box. -->
    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('ebshel_petty_cash.group_petty_cash_manager'))]"/>
    </record>

    <!-- Record access (permissions and the multi-company restrictions) is in ir.access.csv. -->

</odoo>
