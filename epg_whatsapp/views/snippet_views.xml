<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_snippet_list" model="ir.ui.view">
        <field name="name">epg.whatsapp.snippet.list</field>
        <field name="model">epg.whatsapp.snippet</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="body"/>
                <field name="model_id" options="{'no_create': True}"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_snippet" model="ir.actions.act_window">
        <field name="name">Saved Replies</field>
        <field name="res_model">epg.whatsapp.snippet</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">The sentences you type every day</p>
            <p>Opening hours, "your case will be ready on…", "please share a photo": saved
               once, dropped into any message with one pick. Use {{name}} and other
               fields in double braces.</p>
        </field>
    </record>

    <menuitem id="menu_snippets" name="Saved Replies" parent="menu_config"
              action="action_snippet" sequence="15"/>
</odoo>
