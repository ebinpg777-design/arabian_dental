<odoo>
    <data noupdate="0">
        <record id="group_whatsapp_user" model="res.groups">
            <field name="name">WhatsApp: send</field>
            <field name="comment">Can send WhatsApp messages and read the log.</field>
        </record>
        <record id="group_whatsapp_admin" model="res.groups">
            <field name="name">WhatsApp: configure</field>
            <field name="implied_ids" eval="[(4, ref('group_whatsapp_user'))]"/>
            <field name="comment">Owns the senders and the templates. The access token is
                a paid credential, so configuring is deliberately separate from sending.</field>
        </record>
        <record id="base.user_admin" model="res.users">
            <field name="group_ids" eval="[(4, ref('group_whatsapp_admin'))]"/>
        </record>
    </data>
</odoo>
