<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="stock_value_daily_view_list" model="ir.ui.view">
        <field name="name">asr.stock.value.daily.list</field>
        <field name="model">asr.stock.value.daily</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="day"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="product_id"/>
                <field name="cost_method"/>
                <field name="closing_qty"/>
                <field name="avg_cost" groups="ebshel_stock_reports.group_see_values"/>
                <field name="closing_value" sum="Total" groups="ebshel_stock_reports.group_see_values"/>
                <field name="revaluation_value" sum="Total" groups="ebshel_stock_reports.group_see_values" optional="hide"/>
                <field name="exact_slow_path" optional="hide"/>
                <field name="computed_at" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="stock_value_daily_view_search" model="ir.ui.view">
        <field name="name">asr.stock.value.daily.search</field>
        <field name="model">asr.stock.value.daily</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="day"/>
                <filter name="slow_path" string="Read from Odoo (lot valuated)" domain="[('exact_slow_path', '=', True)]"/>
                <group>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'day:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="stock_value_daily_action" model="ir.actions.act_window">
        <field name="name">Daily Valuation Summary</field>
        <field name="res_model">asr.stock.value.daily</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
