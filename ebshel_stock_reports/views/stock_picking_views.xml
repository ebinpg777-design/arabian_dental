<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Odoo 20 has no return wizard: a return is a draft transfer made from the picking, and
         its reason is chosen there (it used to be asked by stock.return.picking). -->
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.asr</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="asr_reason_id" options="{'no_create': True}" invisible="not return_id"/>
            </field>
        </field>
    </record>
</odoo>
