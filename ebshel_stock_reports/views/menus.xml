    <menuitem id="menu_advanced" name="Advanced Reports" parent="stock.menu_stock_root" sequence="95"
              groups="ebshel_stock_reports.group_user"/>

    <!-- Stock -->
    <menuitem id="menu_stock" name="Stock" parent="menu_advanced" sequence="10"/>
    <menuitem id="menu_report_stock_ledger" name="Stock Ledger / Card" parent="menu_stock" sequence="10"
