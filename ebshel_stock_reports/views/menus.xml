    <menuitem id="menu_report_abc_xyz" name="ABC / XYZ Analysis" parent="menu_stock" sequence="40"
              action="action_report_abc_xyz"/>
    <menuitem id="menu_report_turnover" name="Turnover / Days of Cover" parent="menu_stock" sequence="50"
              action="action_report_turnover"/>
    <menuitem id="menu_report_count_variance" name="Valued Count Variance" parent="menu_stock" sequence="60"
              action="action_report_count_variance"/>
    <menuitem id="menu_report_scrap_return" name="Scrap and Returns by Reason" parent="menu_stock" sequence="70"
