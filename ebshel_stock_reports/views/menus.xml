    <menuitem id="menu_reasons" name="Reasons" parent="menu_configuration" sequence="10" action="scrap_reason_tag_action"/>
    <menuitem id="menu_product_class" name="ABC / XYZ Classes" parent="menu_configuration" sequence="20" action="product_class_action"/>
    <menuitem id="menu_wip_snapshot" name="WIP Snapshots" parent="menu_configuration" sequence="30" action="wip_snapshot_action"/>
    <menuitem id="menu_move_daily" name="Daily Movement Summary" parent="menu_configuration" sequence="40" action="stock_move_daily_action"/>
    <menuitem id="menu_value_daily" name="Daily Valuation Summary" parent="menu_configuration" sequence="50" action="stock_value_daily_action"/>
    <menuitem id="menu_dirty" name="Recompute Queue" parent="menu_configuration" sequence="60" action="stock_dirty_action"/>

