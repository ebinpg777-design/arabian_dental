    <menuitem id="menu_report_aging" name="Inventory Aging" parent="menu_stock" sequence="20"
              action="action_report_aging"/>
    <menuitem id="menu_report_slow_moving" name="Slow / Non-Moving Stock" parent="menu_stock" sequence="30"
