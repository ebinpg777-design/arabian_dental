<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="stock_move_daily_view_list" model="ir.ui.view">
        <field name="name">asr.stock.move.daily.list</field>
        <field name="model">asr.stock.move.daily</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="day"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="product_id"/>
                <field name="categ_id" optional="hide"/>
                <field name="warehouse_id" optional="show"/>
                <field name="location_id"/>
                <field name="move_type"/>
                <field name="qty_in" sum="Total"/>
                <field name="qty_out" sum="Total"/>
                <field name="value_in" sum="Total" groups="ebshel_stock_reports.group_see_values"/>
                <field name="value_out" sum="Total" groups="ebshel_stock_reports.group_see_values"/>
                <field name="line_count" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="stock_move_daily_view_pivot" model="ir.ui.view">
        <field name="name">asr.stock.move.daily.pivot</field>
        <field name="model">asr.stock.move.daily</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="day" interval="month" type="row"/>
                <field name="move_type" type="col"/>
                <field name="qty_in" type="measure"/>
                <field name="qty_out" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="stock_move_daily_view_search" model="ir.ui.view">
        <field name="name">asr.stock.move.daily.search</field>
        <field name="model">asr.stock.move.daily</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="categ_id"/>
                <field name="location_id"/>
                <field name="warehouse_id"/>
                <field name="day"/>
                <filter name="ledger" string="Ledger Movements" domain="[('move_type', 'not in', ('transfer_in', 'transfer_out', 'consignment', 'dropship'))]"/>
                <filter name="transfers" string="Transfers" domain="[('move_type', 'in', ('transfer_in', 'transfer_out'))]"/>
                <group>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_type" string="Movement Type" context="{'group_by': 'move_type'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'day:day'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'day:month'}"/>
                    <filter name="group_location" string="Location" context="{'group_by': 'location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="stock_move_daily_action" model="ir.actions.act_window">
        <field name="name">Daily Movement Summary</field>
        <field name="res_model">asr.stock.move.daily</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_ledger': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No summary rows yet</p>
            <p>The daily tables are built by the cron after installation. Use the Advanced Stock Reports settings to recompute now.</p>
        </field>
    </record>

</odoo>
