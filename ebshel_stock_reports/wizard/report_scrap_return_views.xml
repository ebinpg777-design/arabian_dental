<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="report_scrap_return_view_form" model="ir.ui.view">
        <field name="name">asr.report.scrap.return.form</field>
        <field name="model">asr.report.scrap.return</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-warning" role="alert" invisible="not engine_warning">
                    <field name="engine_warning" nolabel="1"/>
                </div>
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="kind" widget="radio"/>
                        <field name="group_by" widget="radio" options="{'horizontal': true}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="warehouse_ids" widget="many2many_tags"/>
                        <field name="location_ids" widget="many2many_tags"/>
                        <field name="categ_ids" widget="many2many_tags"/>
                        <field name="product_ids" widget="many2many_tags"/>
                        <field name="row_limit"/>
                        <field name="show_values" invisible="1"/>
                    </group>
                </group>
                <p class="text-muted" invisible="show_values">Value columns are hidden: you are not in the "See Values" group.</p>
                <footer>
                    <button name="action_view" type="object" string="View" class="btn-primary"/>
                    <button name="action_xlsx" type="object" string="Excel" class="btn-secondary" icon="fa-file-excel-o"/>
                    <button name="action_pdf" type="object" string="PDF" class="btn-secondary" icon="fa-file-pdf-o"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="report_scrap_return_line_view_list" model="ir.ui.view">
        <field name="name">asr.report.scrap.return.line.list</field>
        <field name="model">asr.report.scrap.return.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="kind_code"/>
                <field name="reference" optional="show"/>
                <field name="reason_id"/>
                <field name="gst_category" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="product_id"/>
                <field name="lot_id" optional="show"/>
                <field name="quantity" sum="Total"/>
                <field name="uom_id" optional="show"/>
                <field name="value" sum="Total" groups="ebshel_stock_reports.group_see_values"/>
                <field name="location_id" optional="hide"/>
                <field name="location_dest_id" optional="hide"/>
                <field name="month" optional="hide"/>
                <field name="kind" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="report_scrap_return_line_view_pivot" model="ir.ui.view">
        <field name="name">asr.report.scrap.return.line.pivot</field>
        <field name="model">asr.report.scrap.return.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="reason_id" type="row"/>
                <field name="kind_code" type="col"/>
                <field name="quantity" type="measure"/>
                <field name="value" type="measure" groups="ebshel_stock_reports.group_see_values"/>
            </pivot>
        </field>
    </record>

    <record id="report_scrap_return_line_view_graph" model="ir.ui.view">
        <field name="name">asr.report.scrap.return.line.graph</field>
        <field name="model">asr.report.scrap.return.line</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1">
                <field name="reason_id"/>
                <field name="kind_code"/>
                <field name="quantity" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="report_scrap_return_line_view_search" model="ir.ui.view">
        <field name="name">asr.report.scrap.return.line.search</field>
        <field name="model">asr.report.scrap.return.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="reason_id"/>
                <field name="partner_id"/>
                <field name="reference"/>
                <filter name="scraps" string="Scraps" domain="[('kind_code', '=', 'scrap')]"/>
                <filter name="returns" string="Returns" domain="[('kind_code', '!=', 'scrap')]"/>
                <group>
                    <filter name="group_reason" string="Reason" context="{'group_by': 'reason_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'month'}"/>
                    <filter name="group_kind" string="Type" context="{'group_by': 'kind_code'}"/>
                    <filter name="group_gst" string="GST Category" context="{'group_by': 'gst_category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_report_scrap_return" model="ir.actions.act_window">
        <field name="name">Scrap and Returns by Reason</field>
        <field name="res_model">asr.report.scrap.return</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
