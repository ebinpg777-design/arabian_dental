<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="report_wip_view_form" model="ir.ui.view">
        <field name="name">asr.report.wip.form</field>
        <field name="model">asr.report.wip</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-warning" role="alert" invisible="not engine_warning">
                    <field name="engine_warning" nolabel="1"/>
                </div>
                <div class="alert alert-info" role="alert" invisible="not snapshot_warning">
                    <field name="snapshot_warning" nolabel="1"/>
                </div>
                <p class="text-muted">Components issued (picked raw move lines) and work order overhead of the
                    open manufacturing orders at the end of the day. Today is computed live; a past date reads
                    the WIP snapshot taken at that time.</p>
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date"/>
                        <field name="pricing"/>
                        <field name="is_live" invisible="1"/>
                        <field name="snapshot_id" invisible="is_live" readonly="1"/>
                    </group>
                    <group>
                        <field name="warehouse_ids" widget="many2many_tags"/>
                        <field name="categ_ids" widget="many2many_tags" string="Finished Product Categories"/>
                        <field name="product_ids" widget="many2many_tags" string="Finished Products"/>
                        <field name="row_limit"/>
                        <field name="show_values" invisible="1"/>
                    </group>
                </group>
                <p class="text-muted" invisible="show_values">Value columns are hidden: you are not in the "See Values" group.</p>
                <footer>
                    <button name="action_view" type="object" string="View" class="btn-primary"/>
                    <button name="action_xlsx" type="object" string="Excel" class="btn-secondary" icon="fa-file-excel-o"/>
                    <button name="action_pdf" type="object" string="PDF" class="btn-secondary" icon="fa-file-pdf-o"/>
                    <button name="action_take_snapshot" type="object" string="Take snapshot now" class="btn-secondary"
                            icon="fa-camera" groups="ebshel_stock_reports.group_manager"
                            help="Store today's WIP so it can be reported on later."/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="report_wip_line_view_list" model="ir.ui.view">
        <field name="name">asr.report.wip.line.list</field>
        <field name="model">asr.report.wip.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="state" optional="show"/>
                <field name="line_type"/>
                <field name="component_id"/>
                <field name="workcenter_id"/>
                <field name="uom_id" optional="show"/>
                <field name="quantity" sum="Total"/>
                <field name="value" sum="Total" groups="ebshel_stock_reports.group_see_values"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="report_wip_line_view_pivot" model="ir.ui.view">
        <field name="name">asr.report.wip.line.pivot</field>
        <field name="model">asr.report.wip.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="production_id" type="row"/>
                <field name="line_type" type="col"/>
                <field name="value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="report_wip_line_view_search" model="ir.ui.view">
        <field name="name">asr.report.wip.line.search</field>
        <field name="model">asr.report.wip.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="component_id"/>
                <field name="workcenter_id"/>
                <group>
                    <filter name="group_production" string="Manufacturing Order" context="{'group_by': 'production_id'}"/>
                    <filter name="group_product" string="Finished Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'line_type'}"/>
                    <filter name="group_workcenter" string="Work Center" context="{'group_by': 'workcenter_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_report_wip" model="ir.actions.act_window">
        <field name="name">Work in Progress</field>
        <field name="res_model">asr.report.wip</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
