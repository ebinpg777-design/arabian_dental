<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="report_stock_ledger_view_form" model="ir.ui.view">
        <field name="name">asr.report.stock.ledger.form</field>
        <field name="model">asr.report.stock.ledger</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-warning" role="alert" invisible="not engine_warning">
                    <field name="engine_warning" nolabel="1"/>
                </div>
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="mode" widget="radio"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="hide_empty"/>
                    </group>
                    <group>
                        <field name="warehouse_ids" widget="many2many_tags"/>
                        <field name="location_ids" widget="many2many_tags"/>
                        <field name="categ_ids" widget="many2many_tags"/>
                        <field name="product_ids" widget="many2many_tags"/>
                        <field name="row_limit"/>
                        <field name="show_values" invisible="1"/>
                    </group>
                </group>
                <p class="text-muted" invisible="show_values">Value columns are hidden: you are not in the "See Values" group.</p>
                <footer>
                    <button name="action_view" type="object" string="View" class="btn-primary"/>
                    <button name="action_xlsx" type="object" string="Excel" class="btn-secondary" icon="fa-file-excel-o"/>
                    <button name="action_pdf" type="object" string="PDF" class="btn-secondary" icon="fa-file-pdf-o"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="report_stock_ledger_line_view_list" model="ir.ui.view">
        <field name="name">asr.report.stock.ledger.line.list</field>
        <field name="model">asr.report.stock.ledger.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="product_id"/>
                <field name="default_code" optional="show"/>
                <field name="categ_id" optional="hide"/>
                <field name="uom_id" optional="show"/>
                <field name="day" optional="show"/>
                <field name="datetime" optional="hide"/>
                <field name="reference" optional="hide"/>
                <field name="partner_id" optional="hide"/>
                <field name="location_from_id" optional="hide"/>
                <field name="location_to_id" optional="hide"/>
                <field name="move_type" optional="hide"/>
                <field name="qty_opening"/>
                <field name="qty_receipt" sum="Total" optional="show"/>
                <field name="qty_customer_return" sum="Total" optional="hide"/>
                <field name="qty_production" sum="Total" optional="hide"/>
                <field name="qty_count_gain" sum="Total" optional="hide"/>
                <field name="qty_transfer_in" sum="Total" optional="hide"/>
                <field name="qty_other_in" sum="Total" optional="hide"/>
                <field name="qty_in" sum="Total"/>
                <field name="qty_delivery" sum="Total" optional="show"/>
                <field name="qty_vendor_return" sum="Total" optional="hide"/>
                <field name="qty_consumption" sum="Total" optional="hide"/>
                <field name="qty_scrap" sum="Total" optional="hide"/>
                <field name="qty_count_loss" sum="Total" optional="hide"/>
                <field name="qty_transfer_out" sum="Total" optional="hide"/>
                <field name="qty_other_out" sum="Total" optional="hide"/>
                <field name="qty_out" sum="Total"/>
                <field name="qty_closing"/>
                <field name="value_opening" sum="Total" groups="ebshel_stock_reports.group_see_values"/>
                <field name="value_in" sum="Total" groups="ebshel_stock_reports.group_see_values"/>
                <field name="value_out" sum="Total" groups="ebshel_stock_reports.group_see_values"/>
                <field name="value_adjustment" sum="Total" groups="ebshel_stock_reports.group_see_values"/>
                <field name="value_closing" sum="Total" groups="ebshel_stock_reports.group_see_values"/>
                <field name="unit_cost" groups="ebshel_stock_reports.group_see_values"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="report_stock_ledger_line_view_pivot" model="ir.ui.view">
        <field name="name">asr.report.stock.ledger.line.pivot</field>
        <field name="model">asr.report.stock.ledger.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="categ_id" type="row"/>
                <field name="qty_in" type="measure"/>
                <field name="qty_out" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="report_stock_ledger_line_view_search" model="ir.ui.view">
        <field name="name">asr.report.stock.ledger.line.search</field>
        <field name="model">asr.report.stock.ledger.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="categ_id"/>
                <field name="reference"/>
                <group>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_categ" string="Category" context="{'group_by': 'categ_id'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'day:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_report_stock_ledger" model="ir.actions.act_window">
        <field name="name">Stock Ledger / Card</field>
        <field name="res_model">asr.report.stock.ledger</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
