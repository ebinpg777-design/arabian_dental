<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The manufacturing order: the two sheets one click away, and the heading of
        the production sheet on the form - so whoever prints it can see, and
        correct, what it is about to say.
    -->
    <record id="view_production_form_sheet" model="ir.ui.view">
        <field name="name">mrp.production.form.production.sheet</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_job_sheet" type="object" string="Job Sheet"
                        icon="fa-barcode" invisible="state in ('draft', 'cancel')"
                        help="The sheet that travels with the work, with the barcode to scan at a station board."/>
                <button name="action_print_production_report" type="object" string="Production Report"
                        icon="fa-print" invisible="state in ('draft', 'cancel')"
                        help="The Daily Production Report: every stage, who did it and when."/>
            </xpath>
            <!-- The case, on the form itself rather than in a tab: whoever opens a job
                 wants who it is for and what came with it before anything else.
                 (client, 2026-11-24) -->
            <xpath expr="//notebook" position="before">
                <div class="o_lps_case" invisible="not sale_id">
                    <div class="o_lps_head">
                        <div class="o_lps_who">
                            <div class="o_lps_label">Patient</div>
                            <field name="patient" class="o_lps_patient" readonly="1" nolabel="1"/>
                            <div class="o_lps_where">
                                <i class="fa fa-hospital-o" title="Doctor / Clinic"/>
                                <field name="clinic_id" readonly="1" nolabel="1" options="{'no_open': True}"/>
                                <span class="o_lps_dot">·</span>
                                <field name="sale_id" readonly="1" nolabel="1" class="o_lps_order"/>
                            </div>
                        </div>
                        <div class="o_lps_chips">
                            <div class="o_lps_chip o_lps_chip_shade" invisible="not color_scheme">
                                <span class="o_lps_chip_k">Shade</span>
                                <field name="color_scheme" readonly="1" nolabel="1"/>
                            </div>
                            <div class="o_lps_chip" invisible="not ul">
                                <span class="o_lps_chip_k">Jaw</span>
                                <field name="ul" readonly="1" nolabel="1"/>
                            </div>
                            <div class="o_lps_chip o_lps_chip_teeth" invisible="not lab_teeth">
                                <span class="o_lps_chip_k">Teeth</span>
                                <field name="lab_teeth" readonly="1" nolabel="1" widget="fdi_teeth"/>
                            </div>
                        </div>
                    </div>
                    <div class="o_lps_answers">
                        <div class="o_lps_answer o_lps_wide">
                            <div class="o_lps_label">Impression</div>
                            <field name="lab_impression_type" widget="badges_selection" nolabel="1"/>
                        </div>
                        <div class="o_lps_answer o_lps_wide">
                            <div class="o_lps_label">Impression Tray</div>
                            <field name="lab_impression_tray" widget="badges_selection" nolabel="1"/>
                        </div>
                        <div class="o_lps_answer">
                            <div class="o_lps_label">Wax Bite</div>
                            <field name="lab_wax_bite" widget="badges_selection" nolabel="1"/>
                        </div>
                        <div class="o_lps_answer">
                            <div class="o_lps_label">Opposing Model</div>
                            <field name="lab_opposing_model" widget="badges_selection" nolabel="1"/>
                        </div>
                        <div class="o_lps_answer">
                            <div class="o_lps_label">Pre Cutting Model</div>
                            <field name="lab_pre_cutting_model" widget="badges_selection" nolabel="1"/>
                        </div>
                    </div>
                    <div class="o_lps_note">
                        <i class="fa fa-info-circle me-1" title="Saved on the order"/>
                        Saved on the order: every job of this case shows the same answers.
                    </div>
                </div>
            </xpath>
            <!-- shown in the panel above; on the Bill of Material line they were squeezed in -->
            <xpath expr="//field[@name='bom_id']/following-sibling::field[@name='sale_id']" position="attributes">
                <attribute name="invisible">sale_id</attribute>
            </xpath>
            <xpath expr="//field[@name='bom_id']/following-sibling::field[@name='color_scheme']" position="attributes">
                <attribute name="invisible">sale_id</attribute>
            </xpath>
            <xpath expr="//field[@name='bom_id']/following-sibling::field[@name='ul']" position="attributes">
                <attribute name="invisible">sale_id</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_workcenter_form_sheet" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.production.sheet</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="sheet_position"/>
            </xpath>
        </field>
    </record>
</odoo>
