<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The order's Impression group gains what the production sheet asks for. -->
    <record id="view_order_form_production_sheet" model="ir.ui.view">
        <field name="name">sale.order.form.production.sheet</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_custom.view_order_form_sale_custom"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='wax_bite']" position="after">
                <field name="opposing_model"/>
                <field name="pre_cutting_model"/>
            </xpath>
        </field>
    </record>

    <!-- Both sheets for every job of the order, from the order itself. -->
    <record id="view_order_form_sheet_buttons" model="ir.ui.view">
        <field name="name">sale.order.form.production.sheet.buttons</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- "Has this order any job" is asked of `job_card_state`, which anybody who
                 can open the order may read. Not core's `mrp_production_count`: that is
                 for manufacturing users only, and a field executive or a salesman opening
                 the order crashed on it ("field is undefined"). (client, 2026-11-26:
                 "Field executives getting error on clicking view order") -->
            <xpath expr="//header" position="inside">
                <field name="job_card_state" invisible="1"/>
                <button name="action_print_job_sheets" type="object" string="Job Sheet"
                        icon="fa-barcode" invisible="job_card_state in (False, 'none')"
                        help="The technician's sheet of every job of this order, with its barcode."/>
                <button name="action_print_production_reports" type="object" string="Production Report"
                        icon="fa-print" invisible="job_card_state in (False, 'none')"
                        help="The Daily Production Report of every job of this order."/>
            </xpath>
        </field>
    </record>

    <!-- In the order lists: for the orders ticked. -->
    <record id="view_order_list_sheet_buttons" model="ir.ui.view">
        <field name="name">sale.order.list.production.sheet.buttons</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_job_sheets" type="object" string="Job Sheets" icon="fa-barcode"/>
                <button name="action_print_production_reports" type="object" string="Production Reports" icon="fa-print"/>
            </xpath>
        </field>
    </record>
    <!-- WHICH CONFIRMED ORDERS STILL NEED A JOB CARD, and of what kind of work.
         (client, 2026-11-26: "able to filter confirmed orders which are not printed
         job card; also filter by product category") -->
    <record id="view_sales_order_filter_job_card" model="ir.ui.view">
        <field name="name">sale.order.search.job.card</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <search position="inside">
                <filter string="Job Card Not Printed" name="job_card_pending"
                        domain="[('state', '=', 'sale'), ('job_card_pending', '=', True)]"/>
                <filter string="Product Category" name="group_product_category"
                        context="{'group_by': 'product_categ_ids'}"/>
            </search>
        </field>
    </record>

    <record id="view_order_list_job_card" model="ir.ui.view">
        <field name="name">sale.order.list.job.card</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="product_categ_ids" widget="many2many_tags" optional="show"
                       string="Category"/>
                <field name="job_card_state" optional="show" widget="badge"
                       decoration-danger="job_card_state == 'pending'"
                       decoration-warning="job_card_state == 'partial'"
                       decoration-success="job_card_state == 'printed'"
                       decoration-muted="job_card_state == 'none'"/>
            </field>
        </field>
    </record>
</odoo>
