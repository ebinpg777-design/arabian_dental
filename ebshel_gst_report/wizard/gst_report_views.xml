<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="gst_report_wizard_form" model="ir.ui.view">
        <field name="name">gst.report.wizard.form</field>
        <field name="model">gst.report.wizard</field>
        <field name="arch" type="xml">
            <form string="GSTR-1 Register">
                <group>
                    <group>
                        <label for="date_from" string="Period"/>
                        <div class="o_row">
                            <field name="date_from"/>
                            <span class="text-muted">to</span>
                            <field name="date_to"/>
                        </div>
                        <field name="report_type"/>
                    </group>
                    <group>
                        <field name="company_ids" widget="many2many_tags" options="{'no_create': True}"
                               groups="base.group_multi_company"/>
                    </group>
                </group>
                <div class="alert alert-info mb-0" role="status" invisible="not summary">
                    <field name="summary" nolabel="1" class="d-inline"/>
                </div>
                <div class="text-muted small mt-2">
                    Posted customer invoices and credit notes of the period, by invoice date.
                    "All in one" writes every section as its own sheet: B2B, B2B Detailed,
                    B2CS, B2CS Detailed, HSN, HSN B2C-B2B, EXP, CDNR, CDNUR, Docs, Nil Rated
                    and HSN Wise INV-CR.
                </div>
                <footer>
                    <button name="action_download" string="Download Excel" type="object"
                            class="btn-primary" icon="fa-download" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_gst_report" model="ir.actions.act_window">
        <field name="name">GSTR-1 Register</field>
        <field name="res_model">gst.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_gst_reports"
              name="GST Reports"
              parent="account.menu_finance_reports"
              sequence="91"
              groups="account.group_account_invoice"/>
    <menuitem id="menu_gst_report"
              name="GSTR-1 Register"
              parent="menu_gst_reports"
              action="action_gst_report"
              sequence="10"
              groups="account.group_account_invoice"/>

</odoo>
