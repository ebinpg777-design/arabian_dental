<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Multi-company isolation rules for eh_account_dynamic_reports_pro.
    Auto-generated by hardening pass; one ir.rule per concrete model.
-->
<odoo noupdate="0">
    <data>

        <record id="rule_eh_report_builder_company" model="ir.rule">
            <field name="name">eh.report.builder: company isolation</field>
            <field name="model_id" ref="model_eh_report_builder"/>
            <!-- company_id is optional: a company-less builder is shared. -->
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_eh_report_builder_line_company" model="ir.rule">
            <field name="name">eh.report.builder.line: company isolation</field>
            <field name="model_id" ref="model_eh_report_builder_line"/>
            <field name="domain_force">['|', ('builder_id.company_id', '=', False), ('builder_id.company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_eh_report_forecast_company" model="ir.rule">
            <field name="name">eh.report.forecast: company isolation</field>
            <field name="model_id" ref="model_eh_report_forecast"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_eh_report_saved_view_company" model="ir.rule">
            <field name="name">eh.report.saved.view: company isolation</field>
            <field name="model_id" ref="model_eh_report_saved_view"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!--
            Saved view ownership. A shared view is readable by the company,
            but only its owner may edit or delete it: the previous single
            global rule applied own-or-shared to every operation, so any user
            could rewrite or delete a colleague's shared view. Group rules
            OR together per operation; managers keep full access.
        -->
        <record id="rule_eh_report_saved_view_user_read" model="ir.rule">
            <field name="name">eh.report.saved.view: read own or shared</field>
            <field name="model_id" ref="model_eh_report_saved_view"/>
            <field name="groups" eval="[(4, ref('eh_account_base.group_eh_user'))]"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('is_shared', '=', True)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_eh_report_saved_view_user_modify" model="ir.rule">
            <field name="name">eh.report.saved.view: modify own</field>
            <field name="model_id" ref="model_eh_report_saved_view"/>
            <field name="groups" eval="[(4, ref('eh_account_base.group_eh_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_eh_report_saved_view_manager" model="ir.rule">
            <field name="name">eh.report.saved.view: managers all</field>
            <field name="model_id" ref="model_eh_report_saved_view"/>
            <field name="groups" eval="[(4, ref('eh_account_base.group_eh_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_eh_report_schedule_company" model="ir.rule">
            <field name="name">eh.report.schedule: company isolation</field>
            <field name="model_id" ref="model_eh_report_schedule"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!--
            Schedule ownership. A schedule renders under its immutable creator
            (create_uid), so whoever can edit its recipients or webhook URL
            decides where that user's financials are sent. Only the creator
            may modify or delete it; accounting managers keep full access.
            Reading stays company wide (list view). Owner reassignment is
            additionally guarded in eh.report.schedule._eh_guard_owner.
        -->
        <record id="rule_eh_report_schedule_user_modify" model="ir.rule">
            <field name="name">eh.report.schedule: modify own</field>
            <field name="model_id" ref="model_eh_report_schedule"/>
            <field name="groups" eval="[(4, ref('eh_account_base.group_eh_user'))]"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_eh_report_schedule_manager" model="ir.rule">
            <field name="name">eh.report.schedule: managers all</field>
            <field name="model_id" ref="model_eh_report_schedule"/>
            <field name="groups" eval="[(4, ref('eh_account_base.group_eh_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
