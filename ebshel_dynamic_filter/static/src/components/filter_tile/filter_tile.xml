<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="ebshel_dynamic_filter.FilterTile">
        <div t-att-class="{
                 o_dft_broken: this.props.broken,
                 o_dft_active: this.props.active,
                 o_dft_compact: this.props.compact,
                 o_dft_changed: this.state.change,
                 o_dft_loading: this.props.loading,
                 o_dft_manageable: this.props.canManage,
                 o_dft_alerting: this.isAlerting,
                 o_dft_personal: this.props.def.personal,
                 o_dft_selectable: this.props.selectable,
                 o_dft_error: this.props.data and this.props.data.error,
             }"
             t-attf-class="o_dft_tile o_dft_look_{{ this.props.look }} {{ this.widthClass }}"
             t-att-style="this.style"
             t-att-data-tile-id="this.props.def.id"
             t-att-title="this.tooltip"
             t-att-aria-pressed="this.props.active"
             role="button"
             tabindex="0"
             t-on-click="this.onClick"
             t-on-keydown="this.onKeydown">
            <!-- Its filter is something the browser cannot work out, so tapping
                 it would do nothing but explain itself. Said on the tile, in the
                 place a manager will see it. (client, 2026-09-10) -->
            <span t-if="this.props.broken" class="o_dft_broken_flag"
                  title="This tile's filter cannot be applied — edit it and simplify the filter">
                <i class="oi" data-icon="warning" role="img" aria-label="Unusable filter"/>
            </span>

            <span t-if="this.props.canManage" class="o_dft_grip" title="Drag to reorder">
                <i class="oi" data-icon="drag_indicator" role="img" aria-label="Drag handle"/>
            </span>

            <div class="o_dft_body">
                <div class="o_dft_head">
                    <span class="o_dft_icon">
                        <i class="oi" t-att-data-icon="this.iconName" role="img" aria-hidden="true"/>
                    </span>
                    <span class="o_dft_label" t-out="this.props.def.name"/>
                    <!-- Private tile: nobody else has this one. -->
                    <i t-if="this.props.def.personal" class="o_dft_private oi" data-icon="oi_user-secret"
                       role="img" aria-label="Private tile"/>
                    <!-- Grouping tile: one click filters and groups the view. -->
                    <i t-if="this.props.def.group_by" class="o_dft_grouped oi" data-icon="view_list"
                       role="img" aria-label="Groups the view"/>
                    <!-- Past its threshold: the tile says so before anyone asks. -->
                    <i t-if="this.isAlerting" class="o_dft_bell oi oi-filled" data-icon="notifications" role="img"
                       aria-label="Threshold crossed"/>
                    <span t-if="this.delta and !this.props.compact and !this.isAlerting" class="o_dft_delta"
                          t-att-class="{ o_dft_delta_up: this.delta.up }"
                          title="Change vs the previous period">
                        <i class="oi" t-att-data-icon="this.delta.up ? 'arrow_drop_up' : 'arrow_drop_down'"/>
                        <span t-out="this.delta.text"/>
                    </span>
                </div>

                <div class="o_dft_value_row">
                    <span class="o_dft_value" t-out="this.formattedValue"/>
                    <!-- It just moved, under the same filter: say by how much. -->
                    <span t-if="this.state.change" class="o_dft_change"
                          t-att-class="{ o_dft_change_down: this.state.change &lt; 0 }"
                          title="Changed at the last refresh" t-out="this.changeText"/>
                    <span t-if="this.subLabel" class="o_dft_sub" t-out="this.subLabel"/>
                    <i t-if="this.props.active" class="o_dft_check oi oi-filled" data-icon="check_circle" role="img"
                       aria-label="Filter applied"/>
                    <i t-if="this.props.selectable and !this.props.active"
                       class="o_dft_check o_dft_unchecked oi" data-icon="square" role="img"
                       aria-label="Not selected"/>
                </div>

                <!-- Trend mode: sparkline of the last periods. -->
                <div t-if="this.spark" class="o_dft_spark">
                    <svg viewBox="0 0 100 30" preserveAspectRatio="none" aria-hidden="true">
                        <path class="o_dft_spark_area" t-att-d="this.spark.area"/>
                        <path class="o_dft_spark_line" t-att-d="this.spark.line"
                              vector-effect="non-scaling-stroke"/>
                    </svg>
                    <span class="o_dft_spark_dot"
                          t-attf-style="left: {{ this.spark.lastX }}%; bottom: {{ this.spark.lastY }}%;"/>
                </div>
            </div>

            <!-- Goal mode: progress ring towards the tile's target. -->
            <div t-if="this.mode === 'goal'" class="o_dft_ring"
                 t-attf-title="{{ this.goal.percent }}% of target">
                <svg viewBox="0 0 36 36" aria-hidden="true">
                    <circle class="o_dft_ring_track" cx="18" cy="18" t-att-r="this.goal.radius"/>
                    <circle class="o_dft_ring_value" cx="18" cy="18" t-att-r="this.goal.radius"
                            t-att-stroke-dasharray="this.goal.circumference"
                            t-att-stroke-dashoffset="this.goal.offset"
                            transform="rotate(-90 18 18)"/>
                </svg>
                <span class="o_dft_ring_label">
                    <i t-if="this.goal.reached" class="oi" data-icon="trophy"/>
                    <t t-else=""><t t-out="this.goal.percent"/>%</t>
                </span>
            </div>

            <!-- Keyboard hint: Alt + n toggles this tile. -->
            <span t-if="this.props.shortcut and !this.props.compact" class="o_dft_kbd">
                <t t-out="this.props.shortcut"/>
            </span>

            <div class="o_dft_actions">
                <!-- What is inside this tile? -->
                <button t-if="this.props.onBreakdown" class="o_dft_split btn btn-link"
                        title="Break this tile down" t-on-click="this.onBreakdownClick">
                    <i class="oi" data-icon="pie_chart" role="img" aria-label="Break down"/>
                </button>
                <button t-if="this.props.def.editable" class="o_dft_edit btn btn-link"
                        title="Edit this tile" t-on-click="this.onEditClick">
                    <i class="oi" data-icon="edit" role="img" aria-label="Edit tile"/>
                </button>
                <button t-if="this.props.onDelete" class="o_dft_remove btn btn-link"
                        title="Remove this tile" t-on-click="this.onDeleteClick">
                    <i class="oi" data-icon="delete" role="img" aria-label="Remove tile"/>
                </button>
            </div>

            <!-- Share of the records currently in the view. -->
            <span t-if="this.mode !== 'goal'" class="o_dft_share">
                <span class="o_dft_share_fill" t-attf-style="width: {{ this.share }}%;"/>
            </span>

            <!-- Drag the edge to make the tile wider; double-click to reset. -->
            <span t-if="this.props.onResize" class="o_dft_resize"
                  title="Drag to resize · double-click for the standard width"
                  t-on-pointerdown="this.onResizeStart"
                  t-on-dblclick="this.onResizeReset"
                  t-on-click.stop="() => {}"/>
        </div>
    </t>

</templates>
