<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="ebshel_dynamic_filter.FilterTile">
        <div t-att-class="{
                 o_dft_broken: props.broken,
                 o_dft_active: props.active,
                 o_dft_compact: props.compact,
                 o_dft_loading: props.loading,
                 o_dft_manageable: props.canManage,
                 o_dft_alerting: isAlerting,
                 o_dft_personal: props.def.personal,
                 o_dft_selectable: props.selectable,
                 o_dft_error: props.data and props.data.error,
             }"
             t-attf-class="o_dft_tile {{ widthClass }}"
             t-att-style="style"
             t-att-data-tile-id="props.def.id"
             t-att-title="tooltip"
             t-att-aria-pressed="props.active"
             role="button"
             tabindex="0"
             t-on-click="onClick"
             t-on-keydown="onKeydown">

            <!-- Its filter is something the browser cannot work out, so tapping
                 it would do nothing but explain itself. Said on the tile, in the
                 place a manager will see it. (client, 2026-09-10) -->
            <span t-if="props.broken" class="o_dft_broken_flag"
                  title="This tile's filter cannot be applied — edit it and simplify the filter">
                <i class="fa fa-exclamation-triangle" role="img" aria-label="Unusable filter"/>
            </span>
            <span t-if="props.canManage" class="o_dft_grip" title="Drag to reorder">
                <i class="fa fa-ellipsis-v" role="img" aria-label="Drag handle"/>
            </span>

            <div class="o_dft_body">
                <div class="o_dft_head">
                    <span class="o_dft_icon">
                        <i t-attf-class="{{ iconClass }}" role="img" aria-hidden="true"/>
                    </span>
                    <span class="o_dft_label" t-out="props.def.name"/>
                    <!-- Private tile: nobody else has this one. -->
                    <i t-if="props.def.personal" class="o_dft_private fa fa-user-secret"
                       role="img" aria-label="Private tile"/>
                    <!-- Grouping tile: one click filters and groups the view. -->
                    <i t-if="props.def.group_by" class="o_dft_grouped fa fa-th-list"
                       role="img" aria-label="Groups the view"/>
                    <!-- Past its threshold: the tile says so before anyone asks. -->
                    <i t-if="isAlerting" class="o_dft_bell fa fa-bell" role="img"
                       aria-label="Threshold crossed"/>
                    <span t-if="delta and !props.compact and !isAlerting" class="o_dft_delta"
                          t-att-class="{ o_dft_delta_up: delta.up }"
                          title="Change vs the previous period">
                        <i t-attf-class="fa fa-caret-{{ delta.up ? 'up' : 'down' }}"/>
                        <span t-out="delta.text"/>
                    </span>
                </div>

                <div class="o_dft_value_row">
                    <span class="o_dft_value" t-out="formattedValue"/>
                    <span t-if="subLabel" class="o_dft_sub" t-out="subLabel"/>
                    <i t-if="props.active" class="o_dft_check fa fa-check-circle" role="img"
                       aria-label="Filter applied"/>
                    <i t-if="props.selectable and !props.active"
                       class="o_dft_check o_dft_unchecked fa fa-square-o" role="img"
                       aria-label="Not selected"/>
                </div>

                <!-- Trend mode: sparkline of the last periods. -->
                <div t-if="spark" class="o_dft_spark">
                    <svg viewBox="0 0 100 30" preserveAspectRatio="none" aria-hidden="true">
                        <path class="o_dft_spark_area" t-att-d="spark.area"/>
                        <path class="o_dft_spark_line" t-att-d="spark.line"
                              vector-effect="non-scaling-stroke"/>
                    </svg>
                    <span class="o_dft_spark_dot"
                          t-attf-style="left: {{ spark.lastX }}%; bottom: {{ spark.lastY }}%;"/>
                </div>
            </div>

            <!-- Goal mode: progress ring towards the tile's target. -->
            <div t-if="mode === 'goal'" class="o_dft_ring"
                 t-attf-title="{{ goal.percent }}% of target">
                <svg viewBox="0 0 36 36" aria-hidden="true">
                    <circle class="o_dft_ring_track" cx="18" cy="18" t-att-r="goal.radius"/>
                    <circle class="o_dft_ring_value" cx="18" cy="18" t-att-r="goal.radius"
                            t-att-stroke-dasharray="goal.circumference"
                            t-att-stroke-dashoffset="goal.offset"
                            transform="rotate(-90 18 18)"/>
                </svg>
                <span class="o_dft_ring_label">
                    <i t-if="goal.reached" class="fa fa-trophy"/>
                    <t t-else=""><t t-esc="goal.percent"/>%</t>
                </span>
            </div>

            <!-- Keyboard hint: Alt + n toggles this tile. -->
            <span t-if="props.shortcut and !props.compact" class="o_dft_kbd">
                <t t-esc="props.shortcut"/>
            </span>

            <div class="o_dft_actions">
                <!-- What is inside this tile? -->
                <button t-if="props.onBreakdown" class="o_dft_split btn btn-link"
                        title="Break this tile down" t-on-click="onBreakdownClick">
                    <i class="fa fa-pie-chart" role="img" aria-label="Break down"/>
                </button>
                <button t-if="props.def.editable" class="o_dft_edit btn btn-link"
                        title="Edit this tile" t-on-click="onEditClick">
                    <i class="fa fa-pencil" role="img" aria-label="Edit tile"/>
                </button>
                <button t-if="props.onDelete" class="o_dft_remove btn btn-link"
                        title="Remove this tile" t-on-click="onDeleteClick">
                    <i class="fa fa-trash-o" role="img" aria-label="Remove tile"/>
                </button>
            </div>

            <!-- Share of the records currently in the view. -->
            <span t-if="mode !== 'goal'" class="o_dft_share">
                <span class="o_dft_share_fill" t-attf-style="width: {{ share }}%;"/>
            </span>

            <!-- Drag the edge to make the tile wider; double-click to reset. -->
            <span t-if="props.onResize" class="o_dft_resize"
                  title="Drag to resize · double-click for the standard width"
                  t-on-pointerdown="onResizeStart"
                  t-on-dblclick="onResizeReset"
                  t-on-click.stop="() => {}"/>
        </div>
    </t>

</templates>
