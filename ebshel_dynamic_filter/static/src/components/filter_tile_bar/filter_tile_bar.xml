<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="ebshel_dynamic_filter.FilterTileBar">
        <div t-if="this.isVisible" class="o_dft_bar" t-att-class="{
                 o_dft_bar_collapsed: this.state.collapsed,
                 o_dft_bar_compact: this.state.compact,
                 o_dft_bar_empty: !this.state.defs.length,
                 o_dft_bar_resizing: this.state.resizingRow,
             }"
             t-ref="this.rootRef">

            <button class="o_dft_collapse btn btn-link"
                    t-att-title="this.state.collapsed ? 'Show filter tiles' : 'Hide filter tiles'"
                    t-on-click="this.toggleCollapsed">
                <i class="oi" t-att-data-icon="this.state.collapsed ? 'arrow_right' : 'arrow_drop_down'"/>
            </button>

            <!-- One block per row: its own strip, its own scroll, its own height. -->
            <div t-if="!this.state.collapsed" class="o_dft_rows">
                <div class="o_dft_row" t-foreach="this.rows" t-as="rowInfo" t-key="rowInfo.row">
                    <!-- Row caption, standing on its left edge: it costs a few
                         pixels of width instead of a whole line of height.
                         Editable for managers, plain text for everybody else,
                         and absent entirely on a bare one-row bar. -->
                    <div t-if="this.showRowNames" class="o_dft_row_name"
                         t-att-title="rowInfo.name or 'Name this row'">
                        <!-- A textarea rather than an input: a row name is two or
                             three words and has to wrap inside a narrow pane,
                             which an input can never do. Enter saves, it does
                             not insert a line break. -->
                        <textarea t-if="this.state.canManage"
                                  rows="2"
                                  t-att-data-row="rowInfo.row"
                                  t-attf-placeholder="Row {{ rowInfo.row }}"
                                  t-on-change="(ev) => this.renameRow(rowInfo.row, ev.target.value)"
                                  t-on-keydown="this.onRowNameKeydown"><t t-out="rowInfo.name"/></textarea>
                        <span t-else="" t-out="rowInfo.name"/>

                        <button t-if="this.canDeleteRow" class="o_dft_row_delete"
                                t-on-click="() => this.deleteRow(rowInfo)"
                                t-attf-title="Delete row {{ rowInfo.row }} — its tiles move to the next row">
                            <i class="oi" data-icon="close"/>
                        </button>
                    </div>

                    <div t-att-class="{ o_dft_strip_sized: this.state.rowHeights[rowInfo.row] }"
                         t-attf-class="o_dft_strip {{ this.rowSizeClass(rowInfo.row) }}"
                         t-att-data-row="rowInfo.row"
                         t-att-style="this.rowStyle(rowInfo.row)">

                        <FilterTile t-foreach="rowInfo.defs" t-as="def" t-key="def.key"
                                    def="def"
                                    data="this.dataFor(def)"
                                    total="this.state.total"
                                    active="this.isActive(def)"
                                    broken="this.tileIsBroken(def)"
                                    compact="this.state.compact"
                                    look="this.state.look"
                                    contextKey="this.state.contextKey"
                                    canManage="this.state.canManage"
                                    selectable="this.state.multiSelect"
                                    shortcut="this.shortcutFor(def)"
                                    loading="this.state.loading and !this.dataFor(def)"
                                    onSelect="(ev) => this.onTileSelected(def, ev)"
                                    onEdit="() => this.openEditor(def.id)"
                                    onBreakdown="(target) => this.openBreakdown(def, target)"
                                    onResize="def.editable ? ((width) => this.onTileResized(def, width)) : undefined"
                                    onDelete="def.editable ? (() => this.deleteTile(def)) : undefined"/>

                        <!-- Ghost tile: turns whatever is filtered right now into a
                             tile, on this row. -->
                        <button t-if="this.state.canManage or this.state.canPersonalize" class="o_dft_add"
                                t-on-click="() => this.openEditor(false, !this.state.canManage, rowInfo.row)"
                                t-attf-title="Create a tile from the current filter, on row {{ rowInfo.row }}">
                            <i class="oi" data-icon="add"/>
                            <span t-if="!this.state.defs.length" class="o_dft_add_label">
                                Capture this filter as a tile
                            </span>
                        </button>

                        <button t-if="!this.state.defs.length" class="o_dft_dismiss btn btn-link"
                                title="Not here, thanks" t-on-click="this.dismissHint">
                            <i class="oi" data-icon="close"/>
                        </button>
                    </div>

                    <!-- Drag this edge to set how tall the row is. -->
                    <span t-if="this.state.defs.length" class="o_dft_row_resize"
                          title="Drag to set this row's height · double-click to reset"
                          t-on-pointerdown="(ev) => this.onRowResizeStart(rowInfo.row, ev)"
                          t-on-dblclick="() => this.resetRowHeight(rowInfo.row)"/>
                </div>

                <!-- Adding rows and combining tiles mean nothing before the first tile:
                     the empty ribbon is one line, the hint and its dismiss button. -->
                <div t-if="this.state.defs.length" class="o_dft_row_tools">
                    <button t-if="this.canAddRow" class="o_dft_add_row" t-on-click="() => this.addRow()"
                            title="Stack another row of tiles on this view">
                        <i class="oi me-1" data-icon="add"/>Add a row
                    </button>

                    <!-- Multi-select: a real checkbox that is always there, so the
                         option is discoverable before it is on and obvious while it is. -->
                    <label class="o_dft_multi_toggle"
                           t-att-class="{ o_dft_multi_toggle_on: this.state.multiSelect }"
                           title="When on, every click adds a tile to the selection instead of replacing it">
                        <input type="checkbox" t-att-checked="this.state.multiSelect"
                               t-on-change="() => this.toggleMultiSelect()"/>
                        <span>Multi-select</span>
                    </label>
                    <button t-if="this.activeKeys.length > 1" class="o_dft_multi o_dft_multi_mode"
                            t-on-click="() => this.toggleCombineMode()"
                            t-att-title="this.state.combineAll
                                ? 'Records must match every selected tile - click for any'
                                : 'Records may match any selected tile - click for all'">
                        <t t-out="this.state.combineAll ? 'match all' : 'match any'"/>
                    </button>
                    <button t-if="this.activeKeys.length" class="o_dft_multi"
                            t-on-click="() => this.clearTileFacets()"
                            title="Unselect every tile (Alt + 0)">
                        <i class="oi me-1" data-icon="close"/><t t-out="this.activeKeys.length"/> selected
                    </button>
                </div>
            </div>

            <div t-else="" class="o_dft_summary">
                <span class="o_dft_summary_count">
                    <t t-out="this.state.defs.length"/> tiles
                </span>
                <span t-if="this.rows.length > 1" class="o_dft_summary_rows">
                    · <t t-out="this.rows.length"/> rows
                </span>
                <span t-if="this.activeKeys.length" class="o_dft_summary_active">
                    · <t t-out="this.activeKeys.length"/> applied
                </span>
            </div>

            <Dropdown t-if="this.state.canManage or this.state.canPersonalize" menuClass="'o_dft_menu'">
                <button class="o_dft_gear btn btn-link" title="Tile studio">
                    <i class="oi" data-icon="tune"/>
                </button>
                <t t-set-slot="content">
                    <DropdownItem t-if="this.state.canManage"
                                  onSelected="() => this.openEditor(false, false)">
                        <i class="oi oi-fw me-2" data-icon="add"/>New shared tile from this filter
                    </DropdownItem>
                    <DropdownItem onSelected="() => this.openEditor(false, true)">
                        <i class="oi oi-fw me-2" data-icon="oi_user-secret"/>New tile just for me
                    </DropdownItem>
                    <DropdownItem t-if="this.state.canManage" onSelected="() => this.openGenerator()">
                        <i class="oi oi-fw me-2" data-icon="wand_stars"/>Generate a tile set…
                    </DropdownItem>
                    <div class="dropdown-divider" role="separator"/>
                    <DropdownItem t-if="this.canAddRow" onSelected="() => this.addRow()">
                        <i class="oi oi-fw me-2" data-icon="add_box"/>Add a row
                    </DropdownItem>
                    <DropdownItem t-if="this.state.multiSelect or this.activeKeys.length > 1"
                                  onSelected="() => this.toggleCombineMode()">
                        <i class="oi oi-fw me-2"
                           t-att-data-icon="this.state.combineAll ? 'call_merge' : 'fork_right'"/>
                        <t t-out="this.combineLabel"/>
                    </DropdownItem>
                    <div class="dropdown-divider" role="separator"/>
                    <DropdownItem onSelected="() => this.toggleCompact()">
                        <i class="oi oi-fw me-2"
                           t-att-data-icon="this.state.compact ? 'fullscreen' : 'fullscreen_exit'"/>
                        <t t-out="this.state.compact ? 'Comfortable tiles' : 'Compact tiles'"/>
                    </DropdownItem>
                    <div class="dropdown-divider" role="separator"/>
                    <div class="dropdown-header">Tile style</div>
                    <DropdownItem t-foreach="this.tileLooks" t-as="look" t-key="look.key"
                                  onSelected="() => this.setLook(look.key)">
                        <i class="oi oi-fw me-2" t-att-data-icon="this.state.look === look.key ? 'check' : look.icon"/>
                        <t t-out="look.label"/>
                    </DropdownItem>
                    <div class="dropdown-divider" role="separator"/>
                    <DropdownItem onSelected="() => this.cycleRefresh()">
                        <i class="oi oi-fw me-2" data-icon="refresh"
                           t-att-class="{ 'oi-spin': this.state.refreshEvery }"/>
                        <t t-out="this.refreshLabel"/>
                    </DropdownItem>
                    <DropdownItem t-if="this.hasCustomHeights" onSelected="() => this.resetAllRowHeights()">
                        <i class="oi oi-fw me-2" data-icon="height"/>Reset the row heights
                    </DropdownItem>
                    <div class="dropdown-divider" role="separator"/>
                    <DropdownItem t-if="this.state.defs.length" onSelected="() => this.exportTiles()">
                        <i class="oi oi-fw me-2" data-icon="download"/>Export these tiles
                    </DropdownItem>
                    <DropdownItem t-if="this.state.canManage" onSelected="() => this.openImport()">
                        <i class="oi oi-fw me-2" data-icon="upload"/>Import a tile set…
                    </DropdownItem>
                    <DropdownItem onSelected="() => this.openTileList()">
                        <i class="oi oi-fw me-2" data-icon="list_alt"/>Manage all tiles
                    </DropdownItem>
                    <div class="dropdown-divider" role="separator"/>
                    <div class="o_dft_menu_hint text-muted small px-3 py-1">
                        Alt + 1…9 applies a tile, Alt + 0 clears them.
                        Ctrl-click combines several.
                        Drag a tile's right edge to resize it, the bottom of a row to set its
                        height, or a tile onto another row to move it.
                    </div>
                </t>
            </Dropdown>
        </div>
    </t>

</templates>
