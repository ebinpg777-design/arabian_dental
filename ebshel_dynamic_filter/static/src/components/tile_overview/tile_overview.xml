<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="ebshel_dynamic_filter.TileOverview">
        <div class="o_dft_wall o_action">
            <div class="o_dft_wall_head">
                <div class="o_dft_wall_title">
                    <h2>Tile Wall</h2>
                    <span t-if="!this.state.loading" class="text-muted">
                        <t t-out="this.tileCount"/> tiles
                        <t t-if="this.alertCount"> · <span class="o_dft_wall_alerts">
                            <i class="fa fa-bell me-1"/><t t-out="this.alertCount"/> alerting
                        </span></t>
                    </span>
                </div>
                <div class="o_dft_wall_tools">
                    <button class="btn btn-secondary" t-att-class="{ active: this.state.onlyAlerts }"
                            t-on-click="() => this.toggleAlerts()">
                        <i class="fa fa-bell me-1"/>
                        <t t-out="this.state.onlyAlerts ? 'Showing alerts' : 'Only alerts'"/>
                    </button>
                    <button class="btn btn-secondary" t-att-class="{ active: this.state.live }"
                            t-on-click="() => this.toggleLive()"
                            title="Refresh the wall every minute - for a screen on the wall">
                        <i class="fa fa-refresh me-1" t-att-class="{ 'fa-spin': this.state.live }"/>
                        Live
                    </button>
                    <button class="btn btn-primary" t-on-click="() => this.load()">
                        Refresh
                    </button>
                </div>
            </div>

            <div t-if="this.state.loading" class="o_dft_wall_loading">
                <i class="fa fa-circle-o-notch fa-spin fa-2x"/>
            </div>

            <t t-else="">
                <div t-if="!this.state.sections.length" class="o_dft_wall_empty">
                    <i class="fa fa-th-large fa-3x mb-3"/>
                    <p t-out="this.emptyMessage"/>
                </div>

                <div class="o_dft_wall_section" t-foreach="this.state.sections" t-as="section"
                     t-key="section.model">
                    <div class="o_dft_wall_section_head">
                        <button class="btn btn-link" t-on-click="() => this.openSection(section)">
                            <t t-out="section.label"/>
                        </button>
                        <span class="text-muted small"><t t-out="section.total"/> records</span>
                    </div>
                    <div class="o_dft_wall_grid">
                        <FilterTile t-foreach="section.tiles" t-as="tile" t-key="tile.key"
                                    def="tile"
                                    data="tile.data"
                                    total="section.total"
                                    canManage="false"
                                    onSelect="() => this.openTile(section, tile)"/>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
