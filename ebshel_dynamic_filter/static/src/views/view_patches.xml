<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!--
        The ribbon goes between the control panel and the records.

        It cannot simply be inserted *before* the renderer: the Layout puts both
        inside `<main class="o_content">`, and as soon as the view has a search
        panel that main becomes a **row** flex container (search panel | content).
        A bar dropped in there becomes a third column - full height, standing
        next to the records instead of above them.

        So the renderer is wrapped, together with the bar, in a column of its
        own. `$0` re-inserts the original node untouched, which keeps every
        prop of `props.Renderer` (and any patch another module made to it)
        exactly as the view defined them.

        Odoo 20: the renderer carries `t-if="this.model.isReady()"` and is followed
        by a `t-elif` (the offline helper). The wrapper takes over that `t-if`, or
        the `t-elif` would follow a plain div and the controller template would no
        longer compile; `$0` keeps its own copy of the condition, which is then
        always true.
    -->
    <t t-inherit="web.ListView" t-inherit-mode="extension">
        <xpath expr="//t[@t-component='this.props.Renderer']" position="replace">
            <div t-if="this.model.isReady()" class="o_dft_layout">
                <t t-component="this.FilterTileBar" list="this.model.root" viewType="'list'"/>
                <t>$0</t>
            </div>
        </xpath>
    </t>

    <t t-inherit="web.KanbanView" t-inherit-mode="extension">
        <xpath expr="//t[@t-component='this.props.Renderer']" position="replace">
            <div t-if="this.model.isReady()" class="o_dft_layout">
                <t t-component="this.FilterTileBar" list="this.model.root" viewType="'kanban'"/>
                <t>$0</t>
            </div>
        </xpath>
    </t>

</templates>
