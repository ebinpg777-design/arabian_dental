<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="ebshel_dynamic_filter.PanelTilesDialog">
        <Dialog title="'Filter tiles from ' + this.props.sectionName" size="'md'">
            <p class="text-muted">
                One tile per value you tick, in the order you tick them - each one a live
                count and a one-click filter above the list. Up to
                <t t-out="this.props.maxTiles"/> at a time.
            </p>

            <div class="o_dft_pt_toolbar">
                <span class="o_dft_pt_counter">
                    <t t-out="this.state.picked.length"/> / <t t-out="this.props.maxTiles"/> selected
                </span>
                <button class="btn btn-link btn-sm" t-on-click="this.pickTop">
                    <t t-if="this.props.values[0] and this.props.values[0].count !== null">Pick the busiest</t>
                    <t t-else="">Pick the first</t>
                </button>
                <button class="btn btn-link btn-sm" t-on-click="this.pickNone">Pick none</button>
            </div>

            <div class="o_dft_pt_values">
                <button t-foreach="this.props.values" t-as="value" t-key="value.id"
                        class="o_dft_pt_value"
                        t-att-class="{ o_dft_pt_picked: this.isPicked(value) }"
                        t-att-disabled="!this.isPicked(value) and this.isFull"
                        t-att-style="this.chipStyle(value)"
                        t-on-click="() => this.toggle(value)">
                    <i class="oi oi-fw" role="img" aria-hidden="true"
                       t-att-data-icon="this.isPicked(value) ? 'check_box' : 'square'"/>
                    <span class="o_dft_pt_label" t-out="value.label"/>
                    <span t-if="value.count !== null" class="o_dft_pt_count" t-out="value.count"/>
                </button>
            </div>

            <div t-if="this.props.canManage" class="form-check mt-3">
                <input id="dft_pt_personal" class="form-check-input" type="checkbox"
                       t-model.proxy="this.state.personal"/>
                <label class="form-check-label" for="dft_pt_personal">
                    Keep them private - only I will see these tiles
                </label>
            </div>
            <div t-else="" class="text-muted small mt-3">
                <i class="oi me-1" data-icon="oi_user-secret" role="img" aria-hidden="true"/>
                These tiles will be private: only you will see them.
            </div>

            <div t-if="this.props.actionName" class="form-check mt-2">
                <input id="dft_pt_action" class="form-check-input" type="checkbox"
                       t-model.proxy="this.state.thisActionOnly"/>
                <label class="form-check-label" for="dft_pt_action">
                    Only on <b t-out="this.props.actionName"/> - leave unticked to put them on every
                    list and kanban view of this model
                </label>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-primary" t-att-disabled="this.state.saving or !this.state.picked.length"
                        t-on-click="this.confirm">
                    <i class="oi me-1" data-icon="grid_view" role="img" aria-hidden="true"/>
                    Create <t t-out="this.state.picked.length"/> tiles
                </button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>

</templates>
