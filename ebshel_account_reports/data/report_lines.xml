    <record id="cf_fin" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_cash_flow"/>
        <field name="sequence">110</field>
        <field name="name">Cash from financing activities</field>
        <field name="kind">formula</field>
        <field name="balance_mode">flow</field>
        <field name="sign">1</field>
        <field name="display">amount</field>
        <field name="formula">FIN_L + FIN_E</field>
        <field name="code">FIN</field>
        <field name="bold" eval="True"/>
        <field name="unfold_accounts" eval="False"/>
    </record>
    <record id="cf_change" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_cash_flow"/>
        <field name="sequence">120</field>
        <field name="name">Net change in cash</field>
        <field name="kind">formula</field>
        <field name="balance_mode">flow</field>
        <field name="sign">1</field>
        <field name="display">amount</field>
        <field name="formula">OPS + INV + FIN</field>
        <field name="code">CHANGE</field>
        <field name="bold" eval="True"/>
        <field name="unfold_accounts" eval="False"/>
    </record>
    <record id="cf_open" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_cash_flow"/>
        <field name="sequence">130</field>
        <field name="name">Cash at the start of the period</field>
        <field name="kind">sum</field>
        <field name="balance_mode">opening</field>
        <field name="sign">1</field>
        <field name="display">amount</field>
        <field name="account_types">asset_cash,liability_credit_card</field>
        <field name="code">CASH_OPEN</field>
    </record>
    <record id="cf_close" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_cash_flow"/>
        <field name="sequence">140</field>
        <field name="name">Cash at the end of the period</field>
        <field name="kind">sum</field>
        <field name="balance_mode">cumulative</field>
        <field name="sign">1</field>
        <field name="display">amount</field>
        <field name="account_types">asset_cash,liability_credit_card</field>
        <field name="code">CASH_CLOSE</field>
        <field name="bold" eval="True"/>
    </record>
    <record id="cf_check" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_cash_flow"/>
        <field name="sequence">150</field>
        <field name="name">Unexplained difference</field>
        <field name="kind">formula</field>
        <field name="balance_mode">flow</field>
        <field name="sign">1</field>
        <field name="display">check</field>
        <field name="formula">CASH_CLOSE - CASH_OPEN - CHANGE</field>
        <field name="code">CHECK</field>
        <field name="unfold_accounts" eval="False"/>
        <field name="note">Reads Balanced when every balance sheet account is covered above</field>
    </record>
    <record id="es_h_cash" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_executive_summary"/>
        <field name="sequence">10</field>
        <field name="name">Cash and receivables</field>
        <field name="kind">header</field>
        <field name="balance_mode">flow</field>
        <field name="sign">1</field>
        <field name="display">amount</field>
        <field name="bold" eval="True"/>
        <field name="unfold_accounts" eval="False"/>
    </record>
    <record id="es_cash" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_executive_summary"/>
        <field name="sequence">20</field>
        <field name="name">Cash in hand and at bank</field>
        <field name="kind">sum</field>
        <field name="balance_mode">cumulative</field>
        <field name="sign">1</field>
        <field name="display">amount</field>
        <field name="parent_id" ref="es_h_cash"/>
        <field name="account_types">asset_cash,liability_credit_card</field>
        <field name="code">CASH</field>
    </record>
    <record id="es_recv" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_executive_summary"/>
        <field name="sequence">30</field>
        <field name="name">Owed by customers</field>
        <field name="kind">sum</field>
        <field name="balance_mode">cumulative</field>
        <field name="sign">1</field>
        <field name="display">amount</field>
        <field name="parent_id" ref="es_h_cash"/>
        <field name="account_types">asset_receivable</field>
        <field name="code">RECV</field>
    </record>
    <record id="es_pay" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_executive_summary"/>
        <field name="sequence">40</field>
        <field name="name">Owed to suppliers</field>
        <field name="kind">sum</field>
        <field name="balance_mode">cumulative</field>
        <field name="sign">-1</field>
        <field name="display">amount</field>
        <field name="parent_id" ref="es_h_cash"/>
        <field name="account_types">liability_payable</field>
        <field name="code">PAY</field>
    </record>
    <record id="es_h_perf" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_executive_summary"/>
        <field name="sequence">50</field>
        <field name="name">Performance</field>
        <field name="kind">header</field>
        <field name="balance_mode">flow</field>
        <field name="sign">1</field>
        <field name="display">amount</field>
        <field name="bold" eval="True"/>
        <field name="unfold_accounts" eval="False"/>
    </record>
    <record id="es_rev" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_executive_summary"/>
        <field name="sequence">60</field>
        <field name="name">Revenue</field>
        <field name="kind">sum</field>
        <field name="balance_mode">flow</field>
        <field name="sign">-1</field>
        <field name="display">amount</field>
        <field name="parent_id" ref="es_h_perf"/>
        <field name="account_types">income,income_other</field>
        <field name="code">REV</field>
    </record>
    <record id="es_cogs" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_executive_summary"/>
        <field name="sequence">65</field>
        <field name="name">Cost of revenue</field>
        <field name="kind">sum</field>
        <field name="balance_mode">flow</field>
        <field name="sign">1</field>
        <field name="display">amount</field>
        <field name="parent_id" ref="es_h_perf"/>
        <field name="account_types">expense_direct_cost</field>
        <field name="code">COGS</field>
        <field name="hidden" eval="True"/>
    </record>
    <record id="es_exp" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_executive_summary"/>
        <field name="sequence">70</field>
        <field name="name">Expenses</field>
        <field name="kind">sum</field>
        <field name="balance_mode">flow</field>
        <field name="sign">1</field>
        <field name="display">amount</field>
        <field name="parent_id" ref="es_h_perf"/>
        <field name="account_types">expense,expense_other,expense_direct_cost,expense_depreciation</field>
        <field name="code">EXP</field>
    </record>
    <record id="es_net" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_executive_summary"/>
        <field name="sequence">80</field>
        <field name="name">Net profit</field>
        <field name="kind">formula</field>
        <field name="balance_mode">flow</field>
        <field name="sign">1</field>
        <field name="display">amount</field>
        <field name="parent_id" ref="es_h_perf"/>
        <field name="formula">REV - EXP</field>
        <field name="code">NET</field>
        <field name="bold" eval="True"/>
        <field name="unfold_accounts" eval="False"/>
    </record>
    <record id="es_gm" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_executive_summary"/>
        <field name="sequence">90</field>
        <field name="name">Gross margin</field>
        <field name="kind">formula</field>
        <field name="balance_mode">flow</field>
        <field name="sign">1</field>
        <field name="display">percent</field>
        <field name="parent_id" ref="es_h_perf"/>
        <field name="formula">(REV - COGS) / REV * 100</field>
        <field name="code">GM</field>
        <field name="unfold_accounts" eval="False"/>
    </record>
    <record id="es_nm" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_executive_summary"/>
        <field name="sequence">100</field>
        <field name="name">Net margin</field>
        <field name="kind">formula</field>
        <field name="balance_mode">flow</field>
        <field name="sign">1</field>
        <field name="display">percent</field>
        <field name="parent_id" ref="es_h_perf"/>
        <field name="formula">NET / REV * 100</field>
        <field name="code">NM</field>
        <field name="unfold_accounts" eval="False"/>
    </record>
    <record id="es_h_pos" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_executive_summary"/>
        <field name="sequence">110</field>
        <field name="name">Position</field>
        <field name="kind">header</field>
        <field name="balance_mode">flow</field>
        <field name="sign">1</field>
        <field name="display">amount</field>
        <field name="bold" eval="True"/>
        <field name="unfold_accounts" eval="False"/>
    </record>
    <record id="es_cura" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_executive_summary"/>
        <field name="sequence">120</field>
        <field name="name">Current assets</field>
        <field name="kind">sum</field>
        <field name="balance_mode">cumulative</field>
        <field name="sign">1</field>
        <field name="display">amount</field>
        <field name="parent_id" ref="es_h_pos"/>
        <field name="account_types">asset_cash,asset_receivable,asset_current,asset_prepayments</field>
        <field name="code">CUR_A</field>
        <field name="hidden" eval="True"/>
    </record>
    <record id="es_curl" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_executive_summary"/>
        <field name="sequence">130</field>
        <field name="name">Current liabilities</field>
        <field name="kind">sum</field>
        <field name="balance_mode">cumulative</field>
        <field name="sign">-1</field>
        <field name="display">amount</field>
        <field name="parent_id" ref="es_h_pos"/>
        <field name="account_types">liability_payable,liability_current,liability_credit_card</field>
        <field name="code">CUR_L</field>
        <field name="hidden" eval="True"/>
    </record>
    <record id="es_wc" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_executive_summary"/>
        <field name="sequence">140</field>
        <field name="name">Working capital</field>
        <field name="kind">formula</field>
        <field name="balance_mode">cumulative</field>
        <field name="sign">1</field>
        <field name="display">amount</field>
        <field name="parent_id" ref="es_h_pos"/>
        <field name="formula">CUR_A - CUR_L</field>
        <field name="code">WC</field>
        <field name="unfold_accounts" eval="False"/>
    </record>
    <record id="es_cr" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_executive_summary"/>
        <field name="sequence">150</field>
        <field name="name">Current ratio</field>
        <field name="kind">formula</field>
        <field name="balance_mode">cumulative</field>
        <field name="sign">1</field>
        <field name="display">ratio</field>
        <field name="parent_id" ref="es_h_pos"/>
        <field name="formula">CUR_A / CUR_L</field>
        <field name="code">CR</field>
        <field name="unfold_accounts" eval="False"/>
    </record>
    <record id="es_dd" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_executive_summary"/>
        <field name="sequence">160</field>
        <field name="name">Average days customers take to pay</field>
        <field name="kind">formula</field>
        <field name="balance_mode">flow</field>
        <field name="sign">1</field>
        <field name="display">days</field>
        <field name="parent_id" ref="es_h_pos"/>
        <field name="formula">RECV / REV * DAYS</field>
        <field name="code">DD</field>
        <field name="unfold_accounts" eval="False"/>
    </record>
    <record id="es_cd" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_executive_summary"/>
        <field name="sequence">170</field>
        <field name="name">Average days taken to pay suppliers</field>
        <field name="kind">formula</field>
        <field name="balance_mode">flow</field>
        <field name="sign">1</field>
        <field name="display">days</field>
        <field name="parent_id" ref="es_h_pos"/>
        <field name="formula">PAY / EXP * DAYS</field>
        <field name="code">CD</field>
        <field name="unfold_accounts" eval="False"/>
    </record>
