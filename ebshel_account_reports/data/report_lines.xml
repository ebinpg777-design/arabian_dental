    <record id="cf_wc_pay" model="ebshel.fin.report.line">
        <field name="report_id" ref="report_cash_flow"/>
        <field name="sequence">50</field>
        <field name="name">Change in payables</field>
        <field name="kind">sum</field>
        <field name="balance_mode">flow</field>
        <field name="sign">-1</field>
        <field name="display">amount</field>
        <field name="account_types">liability_payable</field>
