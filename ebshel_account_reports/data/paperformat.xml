<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_landscape" model="report.paperformat">
        <field name="name">Financial report (A4 landscape)</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">28</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_spacing">22</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_fin_report_pdf" model="ir.actions.report">
        <field name="name">Financial report</field>
        <field name="model">ebshel.fin.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ebshel_account_reports.fin_report_pdf</field>
        <field name="report_file">ebshel_account_reports.fin_report_pdf</field>
        <field name="paperformat_id" ref="paperformat_landscape"/>
        <field name="print_report_name">(object.name)</field>
        <field name="binding_model_id" eval="False"/>
    </record>
    <record id="seq_report_copy" model="ir.sequence">
        <field name="name">Report copies</field>
        <field name="code">ebshel.fin.report.copy</field>
        <field name="padding">3</field>
    </record>
</odoo>
