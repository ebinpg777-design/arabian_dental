<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_report_view_own_or_shared" model="ir.rule">
        <field name="name">Saved report views: mine, or shared with me</field>
        <field name="model_id" ref="model_ebshel_fin_report_view"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('shared', '=', True)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_readonly'))]"/>
    </record>
    <record id="rule_report_view_manager" model="ir.rule">
        <field name="name">Saved report views: managers see all</field>
        <field name="model_id" ref="model_ebshel_fin_report_view"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_manager'))]"/>
    </record>
    <record id="rule_report_annotation_company" model="ir.rule">
        <field name="name">Report notes: own company</field>
        <field name="model_id" ref="model_ebshel_fin_report_annotation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_report_schedule_company" model="ir.rule">
        <field name="name">Report schedules: own company</field>
        <field name="model_id" ref="model_ebshel_fin_report_schedule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
