<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.ebshel.account.reports</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="accounting_reports" position="after">
                <block title="Dynamic Reports" id="ebshel_account_reports">
                    <setting id="ebshel_fin_totals_last_setting" company_dependent="1"
                             help="The heading of a section stands alone, its lines follow, and 'Total ...' closes it. On the screen, in the PDF and in the workbook.">
                        <field name="ebshel_fin_totals_last"/>
                    </setting>
                    <setting id="ebshel_fin_negative_setting" company_dependent="1"
                             help="How an amount below zero is written in the reports.">
                        <field name="ebshel_fin_negative" class="w-50"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
