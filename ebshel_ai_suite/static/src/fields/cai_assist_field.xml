<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ebshel_ai_suite.CommunityAIAssistField">
        <div class="o_cai_assist_field position-relative">
            <t t-component="this.innerComponent" t-props="this.innerProps"/>
            <div t-if="this.state.enabled and !this.props.readonly" class="o_cai_assist_menu">
                <Dropdown beforeOpen.bind="this.loadOptions" position="'bottom-end'">
                    <button class="btn btn-sm btn-light o_cai_assist_toggle" t-att-disabled="this.state.busy"
                            title="AI writing assistant" aria-label="AI writing assistant">
                        <i t-if="this.state.busy" class="fa fa-circle-o-notch fa-spin"/>
                        <span t-else="" class="o_cai_mark o_cai_mark_sm" aria-hidden="true"/>
                    </button>
                    <t t-set-slot="content">
                        <t t-foreach="this.state.shortcuts" t-as="shortcut" t-key="shortcut.id">
                            <DropdownItem onSelected="() => this.run('custom', { instruction: shortcut.prompt })">
                                <i class="fa fa-bolt me-1 text-muted"/><t t-out="shortcut.title"/>
                            </DropdownItem>
                        </t>
                        <div t-if="this.state.shortcuts.length" class="dropdown-divider"/>
                        <DropdownItem onSelected="() => this.openVoice()">
                            <i class="fa fa-microphone me-1 text-muted"/>Voice transcript…
                        </DropdownItem>
                        <div class="dropdown-divider"/>
                        <t t-foreach="this.state.operations" t-as="op" t-key="op.key">
                            <DropdownItem onSelected="() => this.run(op.key)"><t t-out="op.label"/></DropdownItem>
                        </t>
                        <div class="dropdown-divider"/>
                        <t t-foreach="this.state.languages" t-as="lang" t-key="lang.key">
                            <DropdownItem onSelected="() => this.run('translate', { language: lang.key })">
                                Translate to <t t-out="lang.label"/>
                            </DropdownItem>
                        </t>
                        <t t-if="this.state.previous !== null">
                            <div class="dropdown-divider"/>
                            <DropdownItem onSelected="() => this.undo()"><i class="fa fa-undo me-1"/>Undo AI change</DropdownItem>
                        </t>
                    </t>
                </Dropdown>
            </div>
        </div>
    </t>
</templates>
