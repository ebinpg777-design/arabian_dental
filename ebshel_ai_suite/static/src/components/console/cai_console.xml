<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ebshel_ai_suite.CommunityAIConsole">
        <div t-attf-class="o_cai_console o_cai_console_{{ this.props.mode }} d-flex flex-column">
            <div class="o_cai_console_header d-flex align-items-center gap-2 px-3 py-2 border-bottom">
                <span class="o_cai_mark" aria-hidden="true"/>
                <t t-if="this.state.assistants.length > 1">
                    <select class="form-select form-select-sm o_cai_assistant_select w-auto flex-grow-1"
                            t-on-change="this.onAssistantChange" aria-label="Assistant">
                        <t t-foreach="this.state.assistants" t-as="assistant" t-key="assistant.id">
                            <option t-att-value="assistant.id" t-att-selected="assistant.id === this.state.assistantId"
                                    t-out="assistant.title"/>
                        </t>
                    </select>
                </t>
                <span t-else="" class="fw-bold flex-grow-1 text-truncate" t-out="this.currentAssistant?.title or 'AI'"/>
                <button class="btn btn-sm btn-link text-reset o_cai_history_btn" t-on-click="this.toggleHistory"
                        title="Conversation history" aria-label="Conversation history">
                    <i class="oi" data-icon="history"/>
                </button>
                <button class="btn btn-sm btn-link text-reset o_cai_new_btn" t-on-click="this.newConversation"
                        title="New conversation" aria-label="New conversation">
                    <i class="oi" data-icon="add"/>
                </button>
                <button t-if="this.props.mode === 'overlay'" class="btn btn-sm btn-link text-reset"
                        t-on-click="this.openFullPage" title="Open full page" aria-label="Open full page">
                    <i class="oi" data-icon="fullscreen"/>
                </button>
                <button t-if="this.props.mode === 'overlay'" class="btn btn-sm btn-link text-reset o_cai_close"
                        t-on-click="this.close" title="Close" aria-label="Close">
                    <i class="oi" data-icon="close"/>
                </button>
            </div>

            <t t-if="!this.state.ready">
                <div class="p-4 text-center text-muted"><i class="oi oi-spin" data-icon="progress_activity"/></div>
            </t>
            <t t-elif="!this.state.enabled">
                <div class="p-4 text-muted">AI features are not enabled for your user. Please ask an administrator.</div>
            </t>
            <t t-elif="!this.state.assistants.length">
                <div class="p-4 text-muted">No assistant is available yet.
                    <t t-if="this.state.canConfigure">Create one in Ebshel AI › Configuration › Assistants.</t>
                </div>
            </t>
            <t t-else="">
                <div class="o_cai_console_body d-flex flex-grow-1 overflow-hidden">
                    <div t-if="this.state.showHistory" class="o_cai_history border-end overflow-auto">
                        <div class="px-3 py-2 small text-muted text-uppercase">Recent</div>
                        <t t-if="!this.state.recent.length">
                            <div class="px-3 small text-muted">No conversation yet.</div>
                        </t>
                        <t t-foreach="this.state.recent" t-as="item" t-key="item.id">
                            <button t-attf-class="o_cai_history_item btn btn-link text-start text-reset w-100 px-3 py-2 {{ this.state.session and this.state.session.id === item.id ? 'active' : '' }}"
                                    t-on-click="() => this.openSession(item.id)">
                                <div class="text-truncate" t-out="item.subject"/>
                                <div class="small text-muted text-truncate" t-out="item.assistant.title"/>
                            </button>
                        </t>
                    </div>
                    <div class="d-flex flex-column flex-grow-1 overflow-hidden">
                        <CaiContextBadge context="this.recordContext" enabled="this.state.useContext"
                                         locked="!!this.state.session" onToggle.bind="this.toggleContext"
                                         t-if="this.contextAvailable"/>
                        <CaiMessageList exchanges="this.state.exchanges" busy="this.state.busy"
                                        statusText="this.state.statusText"
                                        onDecide.bind="this.decide" onRetry.bind="this.retry" onNavigate.bind="this.navigate"
                                        onSuggestion.bind="this.send" suggestions="this.suggestions"
                                        onPost.bind="this.postAnswer"/>
                        <div t-if="this.state.error" class="alert alert-danger mx-3 my-2 py-2 small o_cai_error" role="alert">
                            <t t-out="this.state.error"/>
                        </div>
                        <CaiPromptInput busy="this.state.busy or this.state.uploading" onSubmit.bind="this.send" autofocus="true"
                                     onAttach.bind="this.attachFiles" onRemoveFile.bind="this.removeFile"
                                     stagedFiles="this.state.stagedFiles" uploading="this.state.uploading"
                                     placeholder="this.currentAssistant ? 'Ask ' + this.currentAssistant.title + '…' : 'Ask…'"/>
                    </div>
                </div>
            </t>
        </div>
    </t>

    <t t-name="ebshel_ai_suite.CaiMessageList">
        <div class="o_cai_messages flex-grow-1 overflow-auto px-3 py-3" t-ref="this.scrollRef">
            <t t-if="!this.props.exchanges.length">
                <div class="o_cai_welcome text-center text-muted py-4">
                    <span class="o_cai_mark o_cai_mark_lg d-inline-block mb-2" aria-hidden="true"/>
                    <div class="mb-3">How can I help you today?</div>
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <t t-foreach="this.props.suggestions or []" t-as="suggestion" t-key="suggestion_index">
                            <button class="btn btn-sm btn-outline-secondary o_cai_suggestion"
                                    t-att-title="suggestion.prompt"
                                    t-on-click="() => this.props.onSuggestion(suggestion.prompt)" t-out="suggestion.title"/>
                        </t>
                    </div>
                </div>
            </t>
            <t t-foreach="this.visibleExchanges" t-as="ex" t-key="ex.id">
                <div t-if="ex.speaker === 'user'" class="o_cai_message o_cai_message_user ms-auto mb-3">
                    <div class="o_cai_bubble" t-out="ex.body"/>
                    <div t-if="ex.files and ex.files.length" class="o_cai_files d-flex flex-wrap justify-content-end gap-1 mt-1">
                        <t t-foreach="ex.files" t-as="file" t-key="file.id">
                            <img t-if="file.is_image and file.url" t-att-src="file.url" t-att-alt="file.name"
                                 class="o_cai_file_thumb rounded border"/>
                            <span t-else="" class="badge text-bg-light o_cai_file_chip">
                                <i class="oi me-1" data-icon="description"/><t t-out="file.name"/>
                            </span>
                        </t>
                    </div>
                </div>
                <div t-elif="ex.speaker === 'tool'" class="o_cai_tool_step small text-muted mb-2">
                    <i t-attf-class="oi {{ this.toolIconClass(ex) }} me-1" t-att-data-icon="this.toolIcon(ex)"/>
                    <span t-out="ex.tool_label"/>
                    <CaiActionDialogCard t-if="ex.operation" operation="ex.operation" busy="this.props.busy"
                                         onDecide="this.props.onDecide"/>
                </div>
                <div t-else="" t-attf-class="o_cai_message o_cai_message_assistant mb-3 {{ ex.state === 'failed' ? 'o_cai_failed' : '' }}">
                    <div class="o_cai_bubble">
                        <t t-if="ex.state === 'failed'">
                            <i class="oi text-danger me-1" data-icon="warning"/>
                            <span t-out="ex.error"/>
                            <div t-if="ex.id === this.lastFailedId" class="mt-2">
                                <button class="btn btn-sm btn-secondary o_cai_retry" t-on-click="() => this.props.onRetry()"
                                        t-att-disabled="this.props.busy">
                                    <i class="oi me-1" data-icon="refresh"/>Retry
                                </button>
                            </div>
                        </t>
                        <t t-elif="ex.state === 'running' and !ex.body">
                            <span class="o_cai_typing"><span/><span/><span/></span>
                            <span t-if="this.props.statusText" class="o_cai_status_text small text-muted ms-1"
                                  t-out="this.props.statusText"/>
                        </t>
                        <t t-else="">
                            <div class="o_cai_markdown" t-out="this.render(ex.body)"/>
                        </t>
                        <div t-if="ex.media and ex.media.length" class="o_cai_media d-flex flex-wrap gap-2 mt-2">
                            <t t-foreach="ex.media" t-as="item" t-key="item_index">
                                <a t-if="item.type === 'image'" t-att-href="item.url" target="_blank">
                                    <img t-att-src="item.url" t-att-alt="item.name" class="o_cai_generated_image rounded border"/>
                                </a>
                            </t>
                        </div>
                        <div t-if="ex.navigation" class="mt-2">
                            <button class="btn btn-sm btn-primary o_cai_navigate" t-on-click="() => this.props.onNavigate(ex.navigation)">
                                <i class="oi me-1" data-icon="open_in_new"/><t t-out="ex.navigation.name"/>
                            </button>
                        </div>
                        <div t-if="ex.state === 'done' and ex.body" class="o_cai_answer_actions mt-1">
                            <button class="btn btn-link btn-sm p-0 me-2 o_cai_copy" t-on-click="() => this.copy(ex)"
                                    title="Copy" aria-label="Copy"><i class="oi" data-icon="content_copy"/></button>
                            <t t-if="ex.can_post and this.props.onPost">
                                <button class="btn btn-link btn-sm p-0 me-2 o_cai_send_message"
                                        t-on-click="() => this.props.onPost(ex, 'message')">
                                    <i class="oi me-1" data-icon="mail"/>Send as message
                                </button>
                                <button class="btn btn-link btn-sm p-0 o_cai_log_note"
                                        t-on-click="() => this.props.onPost(ex, 'note')">
                                    <i class="oi me-1" data-icon="sticky_note_2"/>Log as note
                                </button>
                            </t>
                        </div>
                        <div t-if="ex.citations and ex.citations.length" class="o_cai_sources mt-2 small">
                            <span class="text-muted me-1">Sources:</span>
                            <t t-foreach="ex.citations" t-as="cite" t-key="cite_index">
                                <span class="badge text-bg-light me-1" t-att-title="cite.excerpt">
                                    <t t-if="cite.ref"><t t-out="cite.ref"/> · </t><t t-out="cite.title"/>
                                </span>
                            </t>
                        </div>
                    </div>
                </div>
            </t>

        </div>
    </t>

    <t t-name="ebshel_ai_suite.CaiActionDialogCard">
        <div t-attf-class="o_cai_operation card mt-2 text-body o_cai_operation_{{ this.props.operation.state }}">
            <div class="card-body p-2">
                <div class="fw-bold mb-1">
                    <i class="oi me-1" data-icon="security"/><t t-out="this.props.operation.title"/>
                </div>
                <div class="o_cai_operation_preview small mb-2" t-out="this.props.operation.preview"/>
                <div t-if="this.props.operation.forced" class="small text-muted mb-2">
                    Confirmation required because this request used record data, documents or tool results.
                </div>
                <t t-if="this.props.operation.state === 'proposed'">
                    <button class="btn btn-sm btn-primary me-2 o_cai_approve" t-att-disabled="this.state.sending or this.props.busy"
                            t-on-click="() => this.decide(true)">
                        <i class="oi me-1" data-icon="check"/>Confirm
                    </button>
                    <button class="btn btn-sm btn-secondary o_cai_reject" t-att-disabled="this.state.sending or this.props.busy"
                            t-on-click="() => this.decide(false)">Cancel</button>
                </t>
                <t t-else="">
                    <span t-attf-class="badge {{ this.props.operation.state === 'executed' ? 'text-bg-success' : 'text-bg-secondary' }} o_cai_operation_state"
                          t-out="this.props.operation.state"/>
                </t>
            </div>
        </div>
    </t>

    <t t-name="ebshel_ai_suite.CaiPromptInput">
        <div t-if="this.props.stagedFiles and this.props.stagedFiles.length" class="o_cai_staged border-top px-2 pt-2 d-flex flex-wrap gap-1">
            <t t-foreach="this.props.stagedFiles" t-as="file" t-key="file.id">
                <span class="badge text-bg-light o_cai_file_chip">
                    <i class="oi me-1" t-att-data-icon="file.is_image ? 'image' : 'description'"/>
                    <t t-out="file.name"/>
                    <i class="oi ms-1 o_cai_file_remove" data-icon="close" role="button" title="Remove"
                       t-on-click="() => this.props.onRemoveFile(file)"/>
                </span>
            </t>
        </div>
        <div class="o_cai_prompt_input border-top p-2 d-flex align-items-end gap-2">
            <t t-if="this.props.onAttach">
                <input type="file" class="d-none o_cai_file_input" t-ref="this.fileRef" multiple="multiple"
                       accept=".pdf,.txt,.md,.csv,.json,.html,.htm,.xml,image/png,image/jpeg,image/webp,image/gif"
                       t-on-change="this.onFilesPicked"/>
                <button class="btn btn-light o_cai_attach" t-on-click="this.pickFiles" t-att-disabled="this.props.busy"
                        title="Attach files" aria-label="Attach files">
                    <i t-attf-class="oi {{ this.props.uploading ? 'oi-spin' : '' }}" t-att-data-icon="this.props.uploading ? 'progress_activity' : 'attach_file'"/>
                </button>
            </t>
            <button t-if="this.canRecord" t-attf-class="btn {{ this.state.recording ? 'btn-danger' : 'btn-light' }} o_cai_dictate"
                    t-on-click="this.toggleDictation" t-att-disabled="this.props.busy or this.state.transcribing"
                    t-att-title="this.state.recording ? 'Stop and transcribe' : 'Dictate'" aria-label="Dictate">
                <i t-attf-class="oi {{ this.state.transcribing ? 'oi-spin' : '' }}" t-att-data-icon="this.state.transcribing ? 'progress_activity' : (this.state.recording ? 'stop' : 'mic')"/>
            </button>
            <textarea t-ref="this.inputRef" class="form-control o_cai_input" rows="1" t-att-placeholder="this.props.placeholder"
                      t-on-input="this.onInput" t-on-keydown="this.onKeydown" t-att-disabled="this.props.busy" aria-label="Message"/>
            <button class="btn btn-primary o_cai_send" t-on-click="this.submit" t-att-disabled="this.props.busy or !this.state.text.trim()"
                    title="Send" aria-label="Send">
                <i t-attf-class="oi {{ this.props.busy ? 'oi-spin' : '' }}" t-att-data-icon="this.props.busy ? 'progress_activity' : 'send'"/>
            </button>
        </div>
    </t>

    <t t-name="ebshel_ai_suite.CaiContextBadge">
        <div class="o_cai_context px-3 py-1 border-bottom small d-flex align-items-center gap-2">
            <i class="oi text-muted" data-icon="description"/>
            <span t-attf-class="text-truncate {{ this.props.enabled ? '' : 'text-decoration-line-through text-muted' }}">
                <t t-out="this.props.context.label or this.props.context.model"/>
            </span>
            <button t-if="!this.props.locked" class="btn btn-link btn-sm p-0 ms-auto o_cai_context_toggle"
                    t-on-click="this.props.onToggle">
                <t t-if="this.props.enabled">Don't use</t><t t-else="">Use this record</t>
            </button>
            <span t-else="" class="ms-auto text-muted">
                <t t-if="this.props.enabled">shared with the assistant</t>
            </span>
        </div>
    </t>
</templates>
