<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ebshel_ai_suite.CommunityAIVoiceDialog">
        <Dialog title.translate="Voice Transcript" size="'lg'">
            <div class="o_cai_voice">
                <div t-if="this.state.error" class="alert alert-warning" role="alert" t-esc="this.state.error"/>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <button t-if="this.state.phase === 'idle' or this.state.phase === 'done'" class="btn btn-danger o_cai_voice_start"
                            t-on-click="this.start"><i class="fa fa-circle me-1"/>Start Recording</button>
                    <button t-if="this.state.phase === 'recording'" class="btn btn-secondary o_cai_voice_stop"
                            t-on-click="this.stop"><i class="fa fa-stop me-1"/>Stop Recording</button>
                    <span t-if="this.state.phase === 'recording'" class="text-danger"><i class="fa fa-circle fa-fade me-1"/><t t-esc="this.elapsedLabel"/></span>
                    <span t-if="this.state.phase === 'processing'" class="text-muted"><i class="fa fa-circle-o-notch fa-spin me-1"/>Transcribing and summarizing…</span>
                </div>
                <div class="small text-muted mb-2">The audio is only used to create the transcript and is not stored.</div>
                <t t-if="this.state.phase === 'done'">
                    <label class="fw-bold">Summary</label>
                    <textarea class="form-control mb-3 o_cai_voice_summary" rows="7" t-custom-model="this.state.summary"/>
                    <label class="fw-bold">Transcript</label>
                    <textarea class="form-control o_cai_voice_transcript" rows="6" t-custom-model="this.state.transcript"/>
                </t>
            </div>
            <t t-set-slot="footer">
                <button t-if="this.props.onInsert" class="btn btn-primary" t-att-disabled="this.state.phase !== 'done'"
                        t-on-click="this.insert">Insert</button>
                <button class="btn btn-secondary" t-on-click="this.props.close">Close</button>
            </t>
        </Dialog>
    </t>
</templates>
