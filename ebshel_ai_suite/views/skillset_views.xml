<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cai_skillset_list" model="ir.ui.view">
        <field name="name">community.ai.skillset.list</field>
        <field name="model">community.ai.skillset</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="summary"/>
                <field name="capability_ids" widget="many2many_tags"/>
                <field name="assistant_ids" widget="many2many_tags" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_cai_skillset_form" model="ir.ui.view">
        <field name="name">community.ai.skillset.form</field>
        <field name="model">community.ai.skillset</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Customer lookup"/></h1>
                        <field name="summary" placeholder="When should an assistant use this skill set?"/>
                    </div>
                    <field name="active" invisible="1"/>
                    <notebook>
                        <page string="Instructions" name="instructions">
                            <field name="instructions" placeholder="Purpose, rules and step-by-step workflow..."/>
                        </page>
                        <page string="Capabilities" name="capabilities">
                            <field name="capability_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="technical_identifier"/>
                                    <field name="model_id"/>
                                    <field name="execution_type" widget="badge" decoration-warning="execution_type == 'write'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Assistants" name="assistants">
                            <field name="assistant_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cai_skillset" model="ir.actions.act_window">
        <field name="name">Skill Sets</field>
        <field name="res_model">community.ai.skillset</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Bundle instructions and capabilities</p>
            <p>A skill set tells an assistant how to perform a kind of task and which capabilities it may use for it.</p>
        </field>
    </record>
</odoo>
