<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cai_job_list" model="ir.ui.view">
        <field name="name">community.ai.job.list</field>
        <field name="model">community.ai.job</field>
        <field name="arch" type="xml">
            <list create="false" decoration-info="state == 'awaiting_approval'" decoration-danger="state == 'failed'">
                <field name="create_date" string="Queued"/>
                <field name="job_kind"/>
                <field name="automation_id" optional="show"/>
                <field name="field_rule_id" optional="hide"/>
                <field name="record_label"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="attempt_count" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-danger="state == 'failed'" decoration-info="state == 'awaiting_approval'"/>
                <button name="action_cai_approve" type="object" icon="fa-check" string="Approve"
                        invisible="state != 'awaiting_approval'" groups="ebshel_ai_suite.group_cai_manager"/>
                <button name="action_cai_reject" type="object" icon="fa-times" string="Reject"
                        invisible="state != 'awaiting_approval'" groups="ebshel_ai_suite.group_cai_manager"/>
            </list>
        </field>
    </record>

    <record id="view_cai_job_form" model="ir.ui.view">
        <field name="name">community.ai.job.form</field>
        <field name="model">community.ai.job</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header>
                    <button name="action_cai_approve" type="object" string="Approve &amp; Apply" class="btn-primary"
                            invisible="state != 'awaiting_approval'" groups="ebshel_ai_suite.group_cai_manager"/>
                    <button name="action_cai_reject" type="object" string="Reject"
                            invisible="state != 'awaiting_approval'" groups="ebshel_ai_suite.group_cai_manager"/>
                    <button name="action_cai_run_now" type="object" string="Run Now"
                            invisible="state != 'queued'" groups="ebshel_ai_suite.group_cai_manager"/>
                    <button name="action_cai_retry" type="object" string="Retry"
                            invisible="state not in ('failed', 'cancelled')" groups="ebshel_ai_suite.group_cai_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="queued,running,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="job_kind"/>
                            <field name="automation_id" invisible="not automation_id"/>
                            <field name="field_rule_id" invisible="not field_rule_id"/>
                            <field name="source_id" invisible="not source_id"/>
                            <field name="record_label"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="attempt_count"/>
                            <field name="next_attempt_at"/>
                            <field name="finished_at"/>
                            <field name="error_public" invisible="not error_public"/>
                        </group>
                    </group>
                    <group string="AI Proposal" invisible="not proposal_text and not summary">
                        <field name="proposal_text" nolabel="1" colspan="2"/>
                        <field name="summary" colspan="2"/>
                    </group>
                    <field name="operation_ids" invisible="not operation_ids" readonly="1"/>
                    <group string="Technical Details" groups="ebshel_ai_suite.group_cai_admin" invisible="not error_public">
                        <field name="error_detail" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cai_job_search" model="ir.ui.view">
        <field name="name">community.ai.job.search</field>
        <field name="model">community.ai.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="automation_id"/>
                <field name="user_id"/>
                <filter name="to_approve" string="Awaiting Approval" domain="[('state', '=', 'awaiting_approval')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="queued" string="Queued" domain="[('state', '=', 'queued')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_kind" string="Type" context="{'group_by': 'job_kind'}"/>
            </search>
        </field>
    </record>

    <record id="action_cai_job" model="ir.actions.act_window">
        <field name="name">Background Jobs</field>
        <field name="res_model">community.ai.job</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_cai_job_approval" model="ir.actions.act_window">
        <field name="name">Automation Proposals</field>
        <field name="res_model">community.ai.job</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
    </record>
</odoo>
