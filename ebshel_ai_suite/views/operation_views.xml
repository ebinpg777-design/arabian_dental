<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cai_operation_list" model="ir.ui.view">
        <field name="name">community.ai.operation.list</field>
        <field name="model">community.ai.operation</field>
        <field name="arch" type="xml">
            <list create="false" decoration-info="state == 'proposed'" decoration-muted="state in ('rejected', 'expired')">
                <field name="create_date" string="Prepared"/>
                <field name="capability_id"/>
                <field name="preview_text"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="forced_by_untrusted_data" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'executed'"
                       decoration-danger="state == 'failed'" decoration-info="state == 'proposed'"/>
                <button name="action_cai_approve" type="object" string="Approve" icon="fa-check"
                        invisible="state != 'proposed'"/>
                <button name="action_cai_reject" type="object" string="Reject" icon="fa-times"
                        invisible="state != 'proposed'"/>
            </list>
        </field>
    </record>

    <record id="view_cai_operation_form" model="ir.ui.view">
        <field name="name">community.ai.operation.form</field>
        <field name="model">community.ai.operation</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header>
                    <button name="action_cai_approve" type="object" string="Approve &amp; Execute" class="btn-primary"
                            invisible="state != 'proposed'"/>
                    <button name="action_cai_reject" type="object" string="Reject" invisible="state != 'proposed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="capability_id"/>
                            <field name="user_id"/>
                            <field name="session_id"/>
                            <field name="job_id"/>
                        </group>
                        <group>
                            <field name="target_model"/>
                            <field name="target_res_id"/>
                            <field name="forced_by_untrusted_data"/>
                            <field name="decided_by"/>
                            <field name="decided_at"/>
                        </group>
                    </group>
                    <group string="What will happen">
                        <field name="preview_text" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Arguments">
                        <field name="arguments" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Result" invisible="not result_summary">
                        <field name="result_summary" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cai_operation_search" model="ir.ui.view">
        <field name="name">community.ai.operation.search</field>
        <field name="model">community.ai.operation</field>
        <field name="arch" type="xml">
            <search>
                <field name="capability_id"/>
                <field name="user_id"/>
                <filter name="pending" string="Awaiting Confirmation" domain="[('state', '=', 'proposed')]"/>
                <filter name="automated" string="From Automations" domain="[('job_id', '!=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_cai_operation" model="ir.actions.act_window">
        <field name="name">Pending Operations</field>
        <field name="res_model">community.ai.operation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
