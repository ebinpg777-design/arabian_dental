<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cai_source_list" model="ir.ui.view">
        <field name="name">community.ai.source.list</field>
        <field name="model">community.ai.source</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="source_kind"/>
                <field name="index_method"/>
                <field name="chunk_count" string="Chunks"/>
                <field name="last_indexed_at" optional="show"/>
                <field name="assistant_ids" widget="many2many_tags" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'ready'" decoration-danger="state == 'error'"
                       decoration-info="state == 'queued'"/>
            </list>
        </field>
    </record>

    <record id="view_cai_source_form" model="ir.ui.view">
        <field name="name">community.ai.source.form</field>
        <field name="model">community.ai.source</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cai_index" type="object" string="Index Now" class="btn-primary"
                            invisible="state in ('ready', 'queued')"/>
                    <button name="action_cai_index" type="object" string="Reprocess" icon="fa-refresh"
                            invisible="state not in ('ready', 'queued')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Warranty policy"/></h1>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'error'">
                        <field name="index_error"/>
                    </div>
                    <group>
                        <group>
                            <field name="source_kind"/>
                            <field name="index_method"/>
                            <field name="embedding_connection_id" invisible="index_method != 'embedding'"/>
                        </group>
                        <group>
                            <field name="chunk_count"/>
                            <field name="last_indexed_at"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group invisible="source_kind != 'url'">
                        <field name="url" widget="url" required="source_kind == 'url'"/>
                    </group>
                    <group invisible="source_kind != 'file'">
                        <field name="file_data" filename="file_name" required="source_kind == 'file'"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                    <group invisible="source_kind != 'record'">
                        <field name="record_ref" required="source_kind == 'record'"/>
                        <div colspan="2" class="text-muted small">
                            The record is indexed as a snapshot of its privacy-filtered fields. It is only used for
                            users who can still read the record.
                        </div>
                    </group>
                    <field name="content_text" invisible="source_kind != 'text'" required="source_kind == 'text'"
                           placeholder="Paste the policy, procedure or documentation text here..."/>
                    <notebook>
                        <page string="Assistants" name="assistants">
                            <field name="assistant_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Chunks" name="chunks">
                            <field name="chunk_ids" readonly="1">
                                <list>
                                    <field name="sequence"/>
                                    <field name="content"/>
                                    <field name="token_estimate"/>
                                    <field name="vector_model" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cai_source" model="ir.actions.act_window">
        <field name="name">Knowledge Sources</field>
        <field name="res_model">community.ai.source</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add knowledge for your assistants</p>
            <p>Text, PDF or text files, web pages and Odoo records can be indexed and retrieved when users ask questions.</p>
        </field>
    </record>
</odoo>
