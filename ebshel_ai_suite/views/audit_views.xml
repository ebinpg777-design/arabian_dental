<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cai_audit_list" model="ir.ui.view">
        <field name="name">community.ai.audit.list</field>
        <field name="model">community.ai.audit</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" decoration-danger="execution_status == 'failed'"
                  decoration-muted="execution_status == 'rejected'">
                <field name="event_time"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="assistant_id" optional="show"/>
                <field name="capability_id" optional="show"/>
                <field name="operation"/>
                <field name="target_model"/>
                <field name="target_res_id" optional="show"/>
                <field name="confirmation_status" optional="show"/>
                <field name="execution_status" widget="badge" decoration-success="execution_status == 'done'"
                       decoration-danger="execution_status == 'failed'"/>
                <field name="result_summary" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_cai_audit_form" model="ir.ui.view">
        <field name="name">community.ai.audit.form</field>
        <field name="model">community.ai.audit</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button name="action_cai_open_target" type="object" string="Open Target Record"
                            invisible="not target_res_id"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="event_time"/>
                            <field name="user_id"/>
                            <field name="assistant_id"/>
                            <field name="capability_id"/>
                            <field name="session_id"/>
                            <field name="operation_id"/>
                        </group>
                        <group>
                            <field name="operation"/>
                            <field name="target_model"/>
                            <field name="target_res_id"/>
                            <field name="confirmation_status"/>
                            <field name="execution_status"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Arguments"><field name="arguments" nolabel="1" colspan="2"/></group>
                    <group string="Result"><field name="result_summary" nolabel="1" colspan="2"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cai_audit_search" model="ir.ui.view">
        <field name="name">community.ai.audit.search</field>
        <field name="model">community.ai.audit</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="capability_id"/>
                <field name="target_model"/>
                <field name="operation"/>
                <filter name="changes" string="Executed Changes"
                        domain="[('execution_status', '=', 'done'), ('confirmation_status', '!=', 'not_required')]"/>
                <filter name="failed" string="Failed or Rejected" domain="[('execution_status', 'in', ['failed', 'rejected'])]"/>
                <separator/>
                <filter name="event_time" string="Date" date="event_time"/>
                <separator/>
                <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                <filter name="group_capability" string="Capability" context="{'group_by': 'capability_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_cai_audit" model="ir.actions.act_window">
        <field name="name">AI Audit Log</field>
        <field name="res_model">community.ai.audit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
