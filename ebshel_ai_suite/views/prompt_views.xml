<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cai_prompt_list" model="ir.ui.view">
        <field name="name">community.ai.prompt.list</field>
        <field name="model">community.ai.prompt</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="purpose"/>
                <field name="output_format"/>
                <field name="placeholder_list" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_cai_prompt_form" model="ir.ui.view">
        <field name="name">community.ai.prompt.form</field>
        <field name="model">community.ai.prompt</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cai_preview" type="object" string="Preview"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="purpose"/>
                            <field name="model_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="output_format"/>
                            <field name="response_language"/>
                            <field name="fixed_lang" invisible="response_language != 'fixed'"/>
                            <field name="placeholder_list"/>
                        </group>
                    </group>
                    <label for="body" string="Template"/>
                    <field name="body" widget="text"
                           placeholder="Customer: {{ record.partner_id.name }}&#10;{% if record.description %}{{ record.description | striphtml | truncate(500) }}{% endif %}"/>
                    <label for="system_part"/>
                    <field name="system_part"/>
                    <div class="text-muted small mt-2">
                        Syntax: <code>{{ variable }}</code>, <code>{{ record.field.subfield }}</code>, filters
                        <code>default("…")</code>, <code>upper</code>, <code>lower</code>, <code>strip</code>,
                        <code>truncate(N)</code>, <code>striphtml</code>, <code>join(", ")</code>, and
                        <code>{% if [not] path %}…{% else %}…{% endif %}</code>. No code is ever evaluated; record
                        fields go through the privacy filter.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cai_prompt" model="ir.actions.act_window">
        <field name="name">Prompt Templates</field>
        <field name="res_model">community.ai.prompt</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
