<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_cai_suite" model="res.groups.privilege">
        <field name="name">Ebshel AI</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_cai_user" model="res.groups">
        <field name="name">Ebshel AI User</field>
        <field name="comment">Can talk to the assistants they are allowed to use and review their own conversations.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_cai_suite"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_cai_manager" model="res.groups">
        <field name="name">Ebshel AI Manager</field>
        <field name="comment">Configures assistants, capabilities, prompts, knowledge, AI fields and automations; reviews usage and audit logs.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_cai_suite"/>
        <field name="implied_ids" eval="[Command.link(ref('group_cai_user'))]"/>
    </record>

    <record id="group_cai_admin" model="res.groups">
        <field name="name">Ebshel AI Administrator</field>
        <field name="comment">Manages provider connections and API secrets, global AI settings and technical error details.</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_cai_suite"/>
        <field name="implied_ids" eval="[Command.link(ref('group_cai_manager'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

</odoo>
