<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ───────────── the doctor's answer, and a call that was not answered ───────────── -->
    <record id="view_doctor_ticket_answer_form" model="ir.ui.view">
        <field name="name">lab.doctor.ticket.answer.form</field>
        <field name="model">lab.doctor.ticket.answer</field>
        <field name="arch" type="xml">
            <form string="What the doctor said">
                <field name="ticket_id" invisible="1"/>
                <field name="in_person" invisible="1"/>
                <div class="alert alert-info mb-3" role="status" invisible="not question">
                    <strong>Asked:</strong> <field name="question" nolabel="1" readonly="1" class="oe_inline"/>
                </div>
                <group>
                    <field name="outcome" widget="radio"/>
                    <field name="channel" widget="radio" options="{'horizontal': true}" invisible="in_person"/>
                </group>
                <field name="answer" placeholder="In the doctor's words: shade A2 on 21, keep the clasp on 16…"/>
                <group>
                    <field name="tell_production" invisible="outcome not in ('as_is', 'change')"/>
                </group>
                <footer>
                    <button string="Close the ticket" name="action_save" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_doctor_ticket_attempt_form" model="ir.ui.view">
        <field name="name">lab.doctor.ticket.attempt.form</field>
        <field name="model">lab.doctor.ticket.attempt</field>
        <field name="arch" type="xml">
            <form string="The call was not answered">
                <field name="ticket_id" invisible="1"/>
                <group>
                    <field name="response" widget="radio"/>
                    <field name="callback_at" required="response == 'callback_requested'"/>
                    <field name="remarks" placeholder="Who picked up, what they said…"/>
                </group>
                <div class="text-muted">With no time set, the ticket comes back to the top of the desk by itself.</div>
                <footer>
                    <button string="Save the attempt" name="action_save" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_doctor_ticket_answer" model="ir.actions.act_window">
        <field name="name">What the doctor said</field>
        <field name="res_model">lab.doctor.ticket.answer</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="action_doctor_ticket_attempt" model="ir.actions.act_window">
        <field name="name">The call was not answered</field>
        <field name="res_model">lab.doctor.ticket.attempt</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ───────────── the ticket ───────────── -->
    <record id="view_doctor_ticket_form" model="ir.ui.view">
        <field name="name">lab.doctor.ticket.form</field>
        <field name="model">lab.doctor.ticket</field>
        <field name="arch" type="xml">
            <form string="Doctor Ticket" create="0" class="o_ddk_form">
                <header>
                    <button name="action_take" type="object" string="Take it" class="btn-primary"
                            invisible="state not in ('new', 'waiting', 'field') or agent_id == uid"
                            groups="lab_doctor_desk.group_doctor_desk_agent"/>
                    <button name="%(action_doctor_ticket_answer)d" type="action" string="The doctor answered"
                            class="btn-success" context="{'default_ticket_id': id}"
                            invisible="state not in ('new', 'taken', 'waiting', 'field')"
                            groups="lab_doctor_desk.group_doctor_desk_agent"/>
                    <button name="%(action_doctor_ticket_attempt)d" type="action" string="No answer"
                            class="btn-warning" context="{'default_ticket_id': id}"
                            invisible="state not in ('new', 'taken', 'waiting')"
                            groups="lab_doctor_desk.group_doctor_desk_agent"/>
                    <button name="action_hand_to_field" type="object" string="Ask in person"
                            invisible="state not in ('new', 'taken', 'waiting')"
                            groups="lab_doctor_desk.group_doctor_desk_agent"/>
                    <button name="action_back_to_desk" type="object" string="Back to the desk"
                            invisible="state not in ('waiting', 'field')"
                            groups="lab_doctor_desk.group_doctor_desk_agent"/>
                    <button name="action_release" type="object" string="Release"
                            invisible="state != 'taken' or not agent_id"
                            groups="lab_doctor_desk.group_doctor_desk_agent"/>
                    <button name="action_escalate" type="object" string="Escalate"
                            invisible="escalated or state not in ('new', 'taken', 'waiting', 'field')"
                            groups="lab_doctor_desk.group_doctor_desk_agent"/>
                    <button name="action_settle_escalation" type="object" string="Escalation dealt with"
                            invisible="not escalated" groups="lab_doctor_desk.group_doctor_desk_lead"/>
                    <button name="action_withdraw" type="object" string="Withdraw"
                            invisible="state not in ('new', 'taken', 'waiting', 'field')"
                            confirm="Withdrawing the ticket lets the order go ahead without the doctor's answer."
                            groups="lab_doctor_desk.group_doctor_desk_lead"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="state not in ('closed', 'cancelled')"
                            groups="lab_doctor_desk.group_doctor_desk_lead"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,taken,waiting,closed"/>
                </header>
                <div class="alert alert-danger m-0 rounded-0" role="alert" invisible="not escalated">
                    <i class="fa fa-exclamation-triangle me-1" title="Escalated"/>
                    <strong>Escalated</strong> — <field name="escalation_note" nolabel="1" readonly="1" class="oe_inline"/>
                </div>
                <div class="alert alert-warning m-0 rounded-0" role="alert" invisible="not overdue">
                    <i class="fa fa-clock-o me-1" title="Late"/>The answer was needed by
                    <field name="deadline" nolabel="1" readonly="1" class="oe_inline" widget="datetime"/>.
                </div>
                <div class="alert alert-info m-0 rounded-0" role="status" invisible="state != 'field'">
                    <i class="fa fa-map-marker me-1" title="In person"/>With
                    <field name="field_user_id" nolabel="1" readonly="1" class="oe_inline" options="{'no_open': True}"/>,
                    to be asked at the clinic.
                    <field name="field_note" nolabel="1" readonly="1" class="oe_inline"/>
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_order" type="object" class="oe_stat_button" icon="fa-file-text-o"
                                groups="sales_team.group_sale_salesman">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="order_name"/></span>
                                <span class="o_stat_text">Order</span>
                            </div>
                        </button>
                        <button name="action_open_desk" type="object" class="oe_stat_button" icon="fa-headphones"
                                groups="lab_doctor_desk.group_doctor_desk_agent">
                            <div class="o_stat_info"><span class="o_stat_text">Open at</span><span class="o_stat_text">the desk</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Closed" bg_color="text-bg-success" invisible="state != 'closed'"/>
                    <widget name="web_ribbon" title="Withdrawn" bg_color="text-bg-secondary" invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <label for="name" string="Doctor Ticket"/>
                        <h1><field name="name"/></h1>
                        <h3 class="text-muted"><field name="partner_id" readonly="1" options="{'no_open': True}"/></h3>
                    </div>
                    <group>
                        <group string="The question">
                            <field name="reason" readonly="state in ('closed', 'cancelled')"/>
                            <field name="question" readonly="state in ('closed', 'cancelled')"
                                   placeholder="What exactly has to be asked?"/>
                            <field name="patient"/>
                            <field name="priority" widget="priority" readonly="state in ('closed', 'cancelled')"/>
                        </group>
                        <group string="Reaching the doctor">
                            <field name="phone" widget="phone" readonly="state in ('closed', 'cancelled')"/>
                            <field name="whatsapp" invisible="not whatsapp"/>
                            <field name="deadline" readonly="state in ('closed', 'cancelled')"/>
                            <field name="callback_at" invisible="state != 'waiting'"/>
                            <field name="sibling_count" invisible="sibling_count == 0"/>
                        </group>
                        <group string="Who">
                            <field name="raised_by_id" options="{'no_open': True}"/>
                            <field name="raised_on"/>
                            <field name="agent_id" options="{'no_open': True, 'no_create': True}"
                                   readonly="state in ('closed', 'cancelled')"
                                   groups="lab_doctor_desk.group_doctor_desk_lead"/>
                            <field name="agent_id" readonly="1" options="{'no_open': True}"
                                   groups="!lab_doctor_desk.group_doctor_desk_lead"/>
                            <field name="salesperson_id" options="{'no_open': True}"/>
                        </group>
                        <group string="The answer" invisible="state != 'closed'">
                            <field name="outcome" readonly="1"/>
                            <field name="answer" readonly="1"/>
                            <field name="channel" readonly="1"/>
                            <field name="closed_by_id" options="{'no_open': True}"/>
                            <field name="closed_on"/>
                            <field name="hours_to_close" widget="float_time"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attempts" name="attempts">
                            <field name="call_ids" readonly="1">
                                <list decoration-success="response == 'answered'" decoration-muted="response == 'wrong_number'">
                                    <field name="call_datetime"/>
                                    <field name="channel"/>
                                    <field name="response" widget="badge" decoration-success="response == 'answered'"
                                           decoration-warning="response != 'answered'"/>
                                    <field name="called_by_id"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="overdue" invisible="1"/>
                    <field name="escalated" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_doctor_ticket_list" model="ir.ui.view">
        <field name="name">lab.doctor.ticket.list</field>
        <field name="model">lab.doctor.ticket</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="overdue" decoration-muted="state in ('closed', 'cancelled')"
                  decoration-bf="escalated">
                <field name="name"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="partner_id"/>
                <field name="patient" optional="show"/>
                <field name="order_name" optional="show"/>
                <field name="reason"/>
                <field name="question" optional="hide"/>
                <field name="raised_by_id" optional="show"/>
                <field name="raised_on" optional="show"/>
                <field name="agent_id" widget="many2one_avatar_user" optional="show"/>
                <field name="attempts" optional="show"/>
                <field name="callback_at" optional="hide"/>
                <field name="deadline" widget="remaining_days" optional="show"/>
                <field name="hours_to_close" widget="float_time" optional="hide" avg="Average"/>
                <field name="outcome" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'new'" decoration-primary="state == 'taken'"
                       decoration-warning="state in ('waiting', 'field')" decoration-success="state == 'closed'"/>
                <field name="overdue" column_invisible="1"/>
                <field name="escalated" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_doctor_ticket_search" model="ir.ui.view">
        <field name="name">lab.doctor.ticket.search</field>
        <field name="model">lab.doctor.ticket</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Ticket, clinic, patient or order"
                       filter_domain="['|', '|', '|', ('name', 'ilike', self), ('partner_id', 'ilike', self), ('patient', 'ilike', self), ('order_name', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="doctor_id"/>
                <field name="agent_id"/>
                <field name="raised_by_id"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('new', 'taken', 'waiting', 'field'))]"/>
                <filter name="mine" string="Mine" domain="[('agent_id', '=', uid)]"/>
                <filter name="pool" string="Not taken" domain="[('state', '=', 'new')]"/>
                <filter name="late" string="Late" domain="[('overdue', '=', True)]"/>
                <filter name="escalated" string="Escalated" domain="[('escalated', '=', True)]"/>
                <separator/>
                <filter name="raised_by_me" string="Raised by me" domain="[('raised_by_id', '=', uid)]"/>
                <filter name="rush" string="Urgent and emergency" domain="[('priority', 'in', ('1', '2'))]"/>
                <separator/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <filter name="closed_on" string="Closed on" date="closed_on"/>
                <group>
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="by_agent" string="Taken by" context="{'group_by': 'agent_id'}"/>
                    <filter name="by_doctor" string="Practice" context="{'group_by': 'doctor_id'}"/>
                    <filter name="by_reason" string="Reason" context="{'group_by': 'reason'}"/>
                    <filter name="by_outcome" string="Outcome" context="{'group_by': 'outcome'}"/>
                    <filter name="by_raiser" string="Raised by" context="{'group_by': 'raised_by_id'}"/>
                    <filter name="by_month" string="Raised in" context="{'group_by': 'raised_on:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_doctor_ticket_pivot" model="ir.ui.view">
        <field name="name">lab.doctor.ticket.pivot</field>
        <field name="model">lab.doctor.ticket</field>
        <field name="arch" type="xml">
            <pivot string="Doctor tickets" sample="1">
                <field name="reason" type="row"/>
                <field name="outcome" type="col"/>
                <field name="hours_to_close" type="measure"/>
                <field name="attempts" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_doctor_ticket_graph" model="ir.ui.view">
        <field name="name">lab.doctor.ticket.graph</field>
        <field name="model">lab.doctor.ticket</field>
        <field name="arch" type="xml">
            <graph string="Doctor tickets" type="bar" sample="1">
                <field name="doctor_id"/>
                <field name="attempts" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_doctor_tickets" model="ir.actions.act_window">
        <field name="name">Doctor Tickets</field>
        <field name="res_model">lab.doctor.ticket</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No doctor is waiting to be called</p>
            <p>A case marked "call the doctor" raises a ticket here by itself. Nothing is created by hand.</p>
        </field>
    </record>
    <record id="action_doctor_tickets_report" model="ir.actions.act_window">
        <field name="name">How the calls went</field>
        <field name="res_model">lab.doctor.ticket</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_closed': 1}</field>
    </record>

    <record id="action_doctor_desk" model="ir.actions.client">
        <field name="name">Doctor Call Desk</field>
        <field name="tag">lab_doctor_desk</field>
    </record>
</odoo>
