<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================== list -->
    <record id="view_material_request_list" model="ir.ui.view">
        <field name="name">material.request.list</field>
        <field name="model">material.request</field>
        <field name="arch" type="xml">
            <list string="Material Requests" decoration-danger="is_late" decoration-muted="state in ('cancelled','rejected')"
                  sample="1" multi_edit="1">
                <field name="priority" widget="priority" nolabel="1" width="40px"/>
                <field name="name" decoration-bf="1"/>
                <field name="date_request" optional="show"/>
                <field name="location_id" string="Deliver To"/>
                <field name="user_id" widget="many2one_avatar_user" string="Requested By"/>
                <field name="date_needed" widget="remaining_days" optional="show"/>
                <field name="line_count" string="Items" optional="show"/>
                <field name="has_shortage" string="Short" widget="boolean_toggle" readonly="1" optional="show"/>
                <field name="progress" widget="progressbar" string="Delivered" optional="show"/>
                <field name="estimated_cost" widget="monetary" optional="hide" sum="Total"/>
                <field name="approver_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'" decoration-warning="state == 'confirm'"
                       decoration-primary="state == 'approved'" decoration-success="state == 'done'"
                       decoration-danger="state == 'rejected'"/>
                <field name="is_late" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ kanban -->
    <record id="view_material_request_kanban" model="ir.ui.view">
        <field name="name">material.request.kanban</field>
        <field name="model">material.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" class="o_mr_kanban"
                    default_order="priority desc, date_needed asc, id desc" sample="1"
                    group_create="false" group_delete="false" group_edit="false">
                <field name="state"/>
                <field name="is_late"/>
                <field name="has_shortage"/>
                <field name="shortage_count"/>
                <field name="progress"/>
                <field name="currency_id"/>
                <progressbar field="priority" colors='{"1": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="o_mr_edge o_mr_edge_#{record.state.raw_value}"/>
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong class="fs-6"><field name="name"/></strong>
                                <div class="text-muted small"><field name="location_id"/></div>
                            </div>
                            <field name="priority" widget="priority"/>
                        </div>
                        <div class="mt-2 small">
                            <span class="me-2"><i class="fa fa-list-ul me-1" title="Items"/><field name="line_count"/> items</span>
                            <span t-if="record.has_shortage.raw_value" class="badge rounded-pill text-bg-warning">
                                <i class="fa fa-exclamation-triangle me-1"/><t t-esc="record.shortage_count.raw_value"/> short
                            </span>
                        </div>
                        <div t-if="['approved','done'].includes(record.state.raw_value)" class="mt-2">
                            <field name="progress" widget="progressbar" options="{'editable': false}"/>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <span t-if="record.date_needed.raw_value"
                                  t-attf-class="small #{record.is_late.raw_value ? 'text-danger fw-bold' : 'text-muted'}">
                                <i class="fa fa-calendar-check-o me-1" title="Needed by"/><field name="date_needed" widget="remaining_days"/>
                            </span>
                            <field name="activity_ids" widget="kanban_activity"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================== form -->
    <record id="view_material_request_form" model="ir.ui.view">
        <field name="name">material.request.form</field>
        <field name="model">material.request</field>
        <field name="arch" type="xml">
            <form string="Material Request">
                <header>
                    <button name="action_confirm" string="Submit for Approval" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve &amp; Transfer" type="object" class="btn-primary"
                            invisible="state != 'confirm'" groups="material_request.material_request_manager"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state not in ('draft', 'confirm')" groups="material_request.material_request_manager"/>
                    <button name="action_mark_done" string="Mark Delivered" type="object"
                            invisible="state != 'approved'" groups="material_request.material_request_manager"/>
                    <button name="action_reorder" string="Request Again" type="object"
                            invisible="state not in ('done', 'cancelled', 'rejected')"/>
                    <button name="action_print_slip" string="Print Slip" type="object" icon="fa-print"
                            invisible="state in ('draft', 'cancelled', 'rejected')"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('confirm', 'rejected', 'cancelled')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancelled', 'rejected')" confirm="Cancel this request? Any open transfer is cancelled with it."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_transfers" type="object" class="oe_stat_button" icon="fa-truck"
                                invisible="not transfer_count">
                            <field name="transfer_count" widget="statinfo" string="Transfers"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Delivered" bg_color="text-bg-success" invisible="state != 'done'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary" invisible="state != 'cancelled'"/>

                    <div class="alert alert-warning d-flex align-items-center mb-3" role="alert"
                         invisible="not has_shortage or state not in ('draft', 'confirm')">
                        <i class="fa fa-exclamation-triangle fa-lg me-2"/>
                        <div>
                            <field name="shortage_count" class="fw-bold"/> line(s) ask for more than the store has on hand.
                            The store can approve a smaller quantity on those lines.
                        </div>
                    </div>
                    <div class="alert alert-danger mb-3" role="alert" invisible="state != 'rejected'">
                        <strong>Rejected:</strong> <field name="rejection_reason" class="d-inline"/>
                    </div>

                    <div class="oe_title">
                        <h1 class="d-flex align-items-center">
                            <field name="priority" widget="priority" class="me-2"/>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Request">
                            <field name="location_id" options="{'no_create': True}"
                                   readonly="state not in ('draft', 'confirm')"/>
                            <field name="user_id" widget="many2one_avatar_user" options="{'no_create': True}"
                                   readonly="state not in ('draft', 'confirm')"/>
                            <field name="date_request" readonly="state not in ('draft', 'confirm')"/>
                            <field name="date_needed" widget="remaining_days" readonly="state not in ('draft', 'confirm')"/>
                            <field name="reason" placeholder="Weekly top-up, a specific case, a new machine…"
                                   readonly="state not in ('draft', 'confirm')"/>
                        </group>
                        <group string="Store">
                            <field name="source_location_id"/>
                            <field name="picking_type_id" invisible="1"/>
                            <field name="approver_id" widget="many2one_avatar_user" invisible="not approver_id"/>
                            <field name="date_approved" invisible="not date_approved"/>
                            <field name="progress" widget="progressbar" invisible="state not in ('approved', 'done')"/>
                            <field name="estimated_cost" widget="monetary" groups="material_request.material_request_manager"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="lines" string="Items">
                            <field name="line_ids" readonly="state not in ('draft', 'confirm')">
                                <list editable="bottom" decoration-warning="availability == 'short'"
                                      decoration-danger="availability == 'none'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="note" optional="show" placeholder="e.g. shade A2, the small pack"/>
                                    <field name="qty_available" string="On Hand" readonly="1"/>
                                    <field name="availability" widget="badge" readonly="1"
                                           decoration-success="availability == 'ok'"
                                           decoration-warning="availability == 'short'"
                                           decoration-danger="availability == 'none'"/>
                                    <field name="quantity"/>
                                    <field name="qty_approved" readonly="parent.state != 'confirm'"
                                           groups="material_request.material_request_manager"/>
                                    <field name="qty_delivered" column_invisible="parent.state not in ('approved', 'done')"/>
                                    <field name="product_uom_id" groups="uom.group_uom"/>
                                    <field name="qty_approved_set" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ search -->
    <record id="view_material_request_search" model="ir.ui.view">
        <field name="name">material.request.search</field>
        <field name="model">material.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="location_id"/>
                <field name="user_id"/>
                <field name="line_ids" string="Product" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <filter name="my" string="My Requests" domain="[('user_id', '=', uid)]"/>
                <filter name="to_approve" string="To Approve" domain="[('state', '=', 'confirm')]"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('draft', 'confirm', 'approved'))]"/>
                <separator/>
                <filter name="urgent" string="Urgent" domain="[('priority', '=', '1')]"/>
                <filter name="late" string="Running Late" domain="[('is_late', '=', True)]"/>
                <filter name="short" string="With Shortage" domain="[('has_shortage', '=', True)]"/>
                <separator/>
                <filter name="this_month" string="Requested On" date="date_request"/>
                <group>
                    <filter name="g_state" string="Stage" context="{'group_by': 'state'}"/>
                    <filter name="g_location" string="Department" context="{'group_by': 'location_id'}"/>
                    <filter name="g_user" string="Requested By" context="{'group_by': 'user_id'}"/>
                    <filter name="g_month" string="Month" context="{'group_by': 'date_request:month'}"/>
                </group>
                <searchpanel>
                    <field name="state" enable_counters="1" icon="fa-tasks"/>
                    <field name="location_id" string="Department" enable_counters="1" icon="fa-building-o"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- ========================================================== calendar -->
    <record id="view_material_request_calendar" model="ir.ui.view">
        <field name="name">material.request.calendar</field>
        <field name="model">material.request</field>
        <field name="arch" type="xml">
            <calendar date_start="date_needed" color="location_id" mode="month" quick_create="0"
                      event_open_popup="1">
                <field name="name"/>
                <field name="location_id"/>
                <field name="state"/>
                <field name="line_count"/>
            </calendar>
        </field>
    </record>

    <!-- ========================================================== activity -->
    <record id="view_material_request_activity" model="ir.ui.view">
        <field name="name">material.request.activity</field>
        <field name="model">material.request</field>
        <field name="arch" type="xml">
            <activity string="Material Requests">
                <field name="location_id"/>
                <templates>
                    <div t-name="activity-box">
                        <div><field name="name" display="full"/></div>
                        <div class="text-muted"><field name="location_id"/></div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <!-- ============================================== consumption analysis -->
    <record id="view_material_request_line_pivot" model="ir.ui.view">
        <field name="name">material.request.lines.pivot</field>
        <field name="model">material.request.lines</field>
        <field name="arch" type="xml">
            <pivot string="Consumption" sample="1">
                <field name="product_id" type="row"/>
                <field name="date_request" interval="month" type="col"/>
                <field name="qty_delivered" type="measure"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_material_request_line_graph" model="ir.ui.view">
        <field name="name">material.request.lines.graph</field>
        <field name="model">material.request.lines</field>
        <field name="arch" type="xml">
            <graph string="Consumption" type="bar" stacked="1" sample="1">
                <field name="location_id"/>
                <field name="qty_delivered" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_material_request_line_list" model="ir.ui.view">
        <field name="name">material.request.lines.list</field>
        <field name="model">material.request.lines</field>
        <field name="arch" type="xml">
            <list string="Requested Items" create="0" edit="0">
                <field name="date_request"/>
                <field name="material_request_id"/>
                <field name="location_id"/>
                <field name="product_id"/>
                <field name="quantity" sum="Requested"/>
                <field name="qty_approved" sum="Approved"/>
                <field name="qty_delivered" sum="Delivered"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_material_request_line_search" model="ir.ui.view">
        <field name="name">material.request.lines.search</field>
        <field name="model">material.request.lines</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="location_id"/>
                <filter name="delivered" string="Delivered" domain="[('state', '=', 'done')]"/>
                <filter name="this_year" string="Requested On" date="date_request"/>
                <group>
                    <filter name="g_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="g_location" string="Department" context="{'group_by': 'location_id'}"/>
                    <filter name="g_month" string="Month" context="{'group_by': 'date_request:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- =========================================================== actions -->
    <record id="material_request_action" model="ir.actions.act_window">
        <field name="name">Material Requests</field>
        <field name="res_model">material.request</field>
        <field name="view_mode">kanban,list,form,calendar,activity</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ask the store for what your department needs</p>
            <p>List the items, submit, and follow the request from approval to delivery. The store sees what is on hand before it approves.</p>
        </field>
    </record>
    <record id="material_request_action_approve" model="ir.actions.act_window">
        <field name="name">To Approve</field>
        <field name="res_model">material.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting for the store</p>
        </field>
    </record>
    <record id="material_request_line_action" model="ir.actions.act_window">
        <field name="name">Consumption Analysis</field>
        <field name="res_model">material.request.lines</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_delivered': 1, 'search_default_this_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">What each department draws from the store</p>
        </field>
    </record>

    <menuitem id="dental_root" name="Material Requests" sequence="35"
              web_icon="material_request,static/description/icon.png"
              groups="material_request.material_request_user"/>
    <menuitem id="material_request" name="Requests" parent="dental_root" action="material_request_action" sequence="1"/>
    <menuitem id="menu_material_request_approve" name="To Approve" parent="dental_root"
              action="material_request_action_approve" sequence="2"
              groups="material_request.material_request_manager"/>
    <menuitem id="menu_material_request_analysis" name="Consumption" parent="dental_root"
              action="material_request_line_action" sequence="3"
              groups="material_request.material_request_manager"/>
    <menuitem id="menu_material_request_config" name="Configuration" parent="dental_root" sequence="9"
              action="stock.action_stock_config_settings" groups="base.group_system"/>
</odoo>
