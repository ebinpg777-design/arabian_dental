<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="privilege_material_request" model="res.groups.privilege">
            <field name="name">Material Requests</field>
            <field name="category_id" ref="base.module_category_inventory_inventory"/>
            <field name="sequence">30</field>
        </record>

        <record id="material_request_user" model="res.groups">
            <field name="name">Material Requests: Request</field>
            <field name="privilege_id" ref="privilege_material_request"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Raise requests for their own department and follow them.</field>
        </record>
        <record id="material_request_manager" model="res.groups">
            <field name="name">Material Requests: Approve</field>
            <field name="privilege_id" ref="privilege_material_request"/>
            <field name="implied_ids" eval="[(4, ref('material_request_user'))]"/>
            <field name="comment">The store: sees every request, approves quantities, rejects and cancels.</field>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('material_request_manager'))]"/>
        </record>

        <!-- A requester sees what they asked for and nothing else; the store sees all. -->
        <record id="rule_material_request_own" model="ir.rule">
            <field name="name">Material Request: own</field>
            <field name="model_id" ref="model_material_request"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('material_request_user'))]"/>
        </record>
        <record id="rule_material_request_all" model="ir.rule">
            <field name="name">Material Request: all</field>
            <field name="model_id" ref="model_material_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('material_request_manager'))]"/>
        </record>
        <record id="rule_material_request_company" model="ir.rule">
            <field name="name">Material Request: company</field>
            <field name="model_id" ref="model_material_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_material_request_line_own" model="ir.rule">
            <field name="name">Material Request Line: own</field>
            <field name="model_id" ref="model_material_request_lines"/>
            <field name="domain_force">[('material_request_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('material_request_user'))]"/>
        </record>
        <record id="rule_material_request_line_all" model="ir.rule">
            <field name="name">Material Request Line: all</field>
            <field name="model_id" ref="model_material_request_lines"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('material_request_manager'))]"/>
        </record>
    </data>
</odoo>
