<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_material_request_reject_form" model="ir.ui.view">
        <field name="name">material.request.reject.form</field>
        <field name="model">material.request.reject</field>
        <field name="arch" type="xml">
            <form>
                <field name="request_id" invisible="1"/>
                <p class="text-muted">The reason is posted on the request, where the person who asked will read it.</p>
                <group>
                    <field name="reason" placeholder="e.g. Not in stock until the next purchase; ask again next week." nolabel="1"/>
                </group>
                <footer>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger"/>
                    <button string="Keep" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
